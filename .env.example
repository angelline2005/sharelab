# Copy to .env once you have real values. Never commit the real .env
# (it's already in .gitignore).

# Google AdSense — fill in after your application is approved.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# Google Tag Manager container, e.g. GTM-ABC1234. Leave empty and the site
# ships no tracking scripts at all. When set, GTM loads with Consent Mode
# defaults denied and is only granted once a visitor accepts the cookie banner.
PUBLIC_GTM_ID=
