# Copy to .env once you have real values. Never commit the real .env
# (it's already in .gitignore).
#
# On the deployed site these come from GitHub repository *variables*, not
# secrets — all of them end up visible in the page source anyway. Set them under
# Settings -> Secrets and variables -> Actions -> Variables. Anything left unset
# is simply omitted from the build.

# Google AdSense — fill in after your application is approved.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# Google Tag Manager container, e.g. GTM-ABC1234. Empty means the site ships no
# tracking scripts at all. When set, GTM loads with Consent Mode defaults denied
# and is only granted once a visitor accepts the cookie banner.
PUBLIC_GTM_ID=

# Google Search Console ownership token — the `content` value from the
# "HTML tag" verification method, not the whole tag. Renders as
# <meta name="google-site-verification"> on every real page.
#
# Note: it will NOT appear on https://angelline2005.github.io/sharelab/ itself,
# which is a bare redirect stub to /vi/ with no <head> of its own. To verify
# that exact URL prefix, use Search Console's "HTML file" method instead and
# drop the googleXXXX.html file it gives you into public/ — files there are
# served from /sharelab/, which is precisely where Google looks.
PUBLIC_GSC_VERIFICATION=
