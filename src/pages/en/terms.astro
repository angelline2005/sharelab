---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';
import { sameSlugLangHrefs } from '../../utils/url';

const t = useTranslations('en');
---

<BaseLayout locale="en" title={t('nav.terms')} description="Terms of use for sharelab" langHrefs={sameSlugLangHrefs('/terms/')} alternates={sameSlugLangHrefs('/terms/')}>
  <h1>Terms of Use</h1>
  <p><em>Last updated: <!-- TODO --> [date]</em></p>
  <p>
    Content on sharelab is shared for reference, based on the author's personal experience. The author is not
    responsible for any damages resulting from applying the site's content in practice — please verify and
    adapt it to your own situation.
  </p>
  <p>
    Unless otherwise noted, post content is copyright the author. You're welcome to quote with a link back to
    the source, but please don't republish full posts without permission.
  </p>
</BaseLayout>
