---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id, data }) => id.startsWith('en/') && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.slice('en/'.length) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const viPosts = await getCollection('posts', ({ id }) => id.startsWith('vi/'));
const otherLocaleSlug = viPosts.find((p) => p.data.translationId === post.data.translationId)?.id.slice(
  'vi/'.length,
);
---

<PostLayout locale="en" post={post} otherLocaleSlug={otherLocaleSlug}>
  <Content />
</PostLayout>
