---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PagefindSearch from '../../components/PagefindSearch.astro';
import { useTranslations } from '../../i18n';

const locale = 'vi';
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t('nav.search')}
  description={t('nav.search')}
  noindex
>
  <h1>{t('nav.search')}</h1>
  <PagefindSearch />
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
  }
</style>
