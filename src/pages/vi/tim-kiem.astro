---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';
import { withBase } from '../../utils/url';

const locale = 'vi';
const t = useTranslations(locale);
const isDev = import.meta.env.DEV;
---

<BaseLayout
  locale={locale}
  title={t('nav.search')}
  description={t('nav.search')}
  langHrefs={{ vi: withBase(`/${locale}/tim-kiem/`), en: withBase('/en/search/') }}
  hideLangSwitcher={true}
>
  <h1>{t('nav.search')}</h1>

  {isDev ? (
    <p style="opacity: 0.6; font-size: 0.9rem;">
      Tìm kiếm hoạt động trong bản dựng đã phát hành. Chạy <code>npm run build</code> để kiểm tra.
    </p>
  ) : (
    <div id="search"></div>
  )}
</BaseLayout>

{!isDev && <link rel="stylesheet" href={withBase('/pagefind/pagefind-ui.css')} />}
{!isDev && <script src={withBase('/pagefind/pagefind-ui.js')}></script>}
{!isDev && (
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: '#search',
          showImages: false,
        });
        const input = document.querySelector('#search input');
        if (input) input.focus();

        const params = new URLSearchParams(window.location.search);
        const q = params.get('q');
        if (q && input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    });
  </script>
)}

<style>
  h1 {
    margin-bottom: 2rem;
  }
  :global(#search) {
    --pf-border-radius: 8px;
    --pf-border-width: 1px;
  }
</style>
