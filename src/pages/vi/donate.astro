---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DonateButton from '../../components/DonateButton.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('vi');
---

<BaseLayout locale="vi" title={t('nav.donate')} description={t('donate.title')} noindex>
  <h1>{t('donate.title')}</h1>
  <p>{t('donate.body')}</p>
  <DonateButton />
  <!-- TODO: thêm ảnh QR MoMo/chuyển khoản ngân hàng ở đây nếu muốn hỗ trợ khách Việt Nam -->
</BaseLayout>
