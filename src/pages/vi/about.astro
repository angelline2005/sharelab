const t = useTranslations('vi');
---

<BaseLayout locale="vi" title={t('nav.about')} description={t('site.tagline')} langHrefs={sameSlugLangHrefs('/about/')}>
  <h1>{t('nav.about')}</h1>
  <p>
    <!-- TODO: viết giới thiệu thật về bạn/blog ở đây -->
    sharelab là nơi mình ghi lại cách xây các dự án nhỏ trong đời sống hằng ngày — từ lên kế hoạch chuyến đi
    đến tự động hoá vài việc lặp lại — chủ yếu làm cùng Claude Code.
  </p>
</BaseLayout>
