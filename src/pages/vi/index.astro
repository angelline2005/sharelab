---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { useTranslations } from '../../i18n';
import { sameSlugLangHrefs } from '../../utils/url';

const t = useTranslations('vi');
const posts = (await getCollection('posts', ({ id, data }) => id.startsWith('vi/') && !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout locale="vi" title={t('site.title')} description={t('site.tagline')} langHrefs={sameSlugLangHrefs('/')}>
  <p class="tagline">{t('site.tagline')}</p>
  <h1 class="section-title">{t('home.latest')}</h1>
  {posts.map((post) => <PostCard post={post} locale="vi" />)}
</BaseLayout>

<style>
  .tagline {
    opacity: 0.75;
  }
  .section-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
    margin: 2rem 0 0;
  }
</style>
