---
// Gyroscopic precession: a bike wheel (M = 1.5 kg, R = 0.3 m, I = MR²) hung
// on an axle of length r from a pivot precesses at Ω = Mgr/(Iω). Sliders for
// spin rate and axle length; the sketch is a side view with a top-view inset.
// Static redraw; flags the regime where Ω approaches ω and the formula dies.
---

<figure class="demo" data-demo="gyro">
  <canvas></canvas>
  <div class="controls">
    <label>Tốc độ quay của bánh (vòng/s) <output data-out="s"></output>
      <input type="range" data-in="s" min="1" max="20" step="0.5" value="10" /></label>
    <label>Chiều dài trục tới điểm treo r (m) <output data-out="r"></output>
      <input type="range" data-in="r" min="0.05" max="0.4" step="0.01" value="0.2" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Bánh xe đạp 1,5 kg bán kính 0,3 m treo lệch một đầu trục. Không quay: rơi
    sập. Đang quay tít: nó từ chối rơi và đi... vòng quanh điểm treo — mô-men
    của trọng lực bị dùng để đổi hướng trục quay thay vì lật đổ nó.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const M = 1.5, R = 0.3, G = 9.81;
  const I = M * R * R;
  const WHEEL = '#2563eb', GRAV = '#dc2626', PREC = '#f59e0b';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const revs = Number(input('s').value), r = Number(input('r').value);
      output('s').textContent = revs.toFixed(1).replace('.', ',');
      output('r').textContent = r.toFixed(2).replace('.', ',');
      const w = revs * 2 * Math.PI;
      const Om = (M * G * r) / (I * w);
      const period = (2 * Math.PI) / Om;
      const shaky = Om > w / 5;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.42);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Side view: pivot post at left-centre, horizontal axle, wheel at the end.
      const px = cssW * 0.24, py = cssH * 0.5;
      const axlePx = 60 + (r / 0.4) * (cssW * 0.24);
      const wx = px + axlePx;

      // Post.
      ctx.strokeStyle = fg; ctx.lineWidth = 4; ctx.globalAlpha = 0.5;
      ctx.beginPath(); ctx.moveTo(px, py - 4); ctx.lineTo(px, cssH - 14); ctx.stroke();
      ctx.globalAlpha = 1; ctx.lineWidth = 1;
      // Axle.
      ctx.strokeStyle = fg; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(wx, py); ctx.stroke();
      ctx.lineWidth = 1;
      // Wheel: ellipse seen edge-on.
      const wr = cssH * 0.22;
      ctx.strokeStyle = WHEEL; ctx.lineWidth = 5;
      ctx.beginPath(); ctx.ellipse(wx, py, wr * 0.22, wr, 0, 0, Math.PI * 2); ctx.stroke();
      ctx.lineWidth = 1;
      // Spin arrow on the wheel.
      ctx.strokeStyle = WHEEL; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(wx, py, wr + 8, -1.1, 1.1); ctx.stroke();
      ctx.fillStyle = WHEEL;
      const ta = 1.1;
      ctx.beginPath();
      ctx.moveTo(wx + (wr + 8) * Math.cos(ta) - 8, py + (wr + 8) * Math.sin(ta) - 2);
      ctx.lineTo(wx + (wr + 8) * Math.cos(ta) + 4, py + (wr + 8) * Math.sin(ta) - 8);
      ctx.lineTo(wx + (wr + 8) * Math.cos(ta) + 2, py + (wr + 8) * Math.sin(ta) + 6);
      ctx.fill(); ctx.lineWidth = 1;

      // Gravity arrow.
      ctx.strokeStyle = GRAV; ctx.fillStyle = GRAV; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(wx, py + wr + 14); ctx.lineTo(wx, py + wr + 44); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(wx, py + wr + 50); ctx.lineTo(wx - 5, py + wr + 41); ctx.lineTo(wx + 5, py + wr + 41); ctx.fill();
      ctx.lineWidth = 1;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Mg', wx + 16, py + wr + 40);
      ctx.fillText(`r = ${r.toFixed(2).replace('.', ',')} m`, (px + wx) / 2, py - 8);
      ctx.globalAlpha = 1;

      // Top-view inset: precession circle.
      const ix = cssW * 0.82, iy = cssH * 0.26, ir = Math.min(cssW * 0.12, cssH * 0.2);
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.35;
      ctx.beginPath(); ctx.arc(ix, iy, ir, 0, Math.PI * 2); ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = PREC; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(ix, iy, ir, -0.4, 1.5); ctx.stroke();
      ctx.fillStyle = PREC;
      ctx.beginPath();
      ctx.moveTo(ix + ir * Math.cos(1.5) - 7, iy + ir * Math.sin(1.5) - 5);
      ctx.lineTo(ix + ir * Math.cos(1.5) + 5, iy + ir * Math.sin(1.5) - 5);
      ctx.lineTo(ix + ir * Math.cos(1.5) - 1, iy + ir * Math.sin(1.5) + 7);
      ctx.fill(); ctx.lineWidth = 1;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.textAlign = 'center';
      ctx.fillText('nhìn từ trên: trục đảo vòng', ix, iy - ir - 8);
      ctx.globalAlpha = 1;

      readout.innerHTML =
        `Ω = Mgr/(Iω) = <b>${Om.toFixed(2).replace('.', ',')} rad/s</b> — trục đảo trọn một vòng hết ` +
        `<b>${period.toFixed(1).replace('.', ',')} s</b>` +
        (shaky ? ' · <b>cảnh báo:</b> quay chậm thế này Ω đã gần ω — công thức gần đúng lung lay, con quay thật bắt đầu gật gù (chương động)' : '');
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="gyro"]').forEach(setup);
</script>
