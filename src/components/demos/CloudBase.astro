---
// Do cao day may doi luu (LCL, cong thuc Espy 1841):
//   z = (T - Td) / (G_dry - G_dew),  G_dry = 9,8 C/km,  G_dew ~ 1,8 C/km
//   => z ~ 125 * (T - Td)  [met]
// G_dew suy ra tu bao toan ti so tron khi khoi khi boc len (tinh lai bang
// Magnus + thuy tinh hoc: 1,70-1,87 C/km trong dai T cua slider).
// Vung dung: may doi luu, khoi khi khong bao hoa nang len tu mat dat,
// T 15-42 C, Td 5-35 C, Td <= T. Doi chieu voi phep tich phan LCL chinh xac
// (Magnus + doan nhiet kho + phuong trinh thuy tinh): lech duoi 4% (< 61 m).
---

<figure class="demo" data-demo="vi-sao-moi-dam-may-tich-co-day-phang-cung-mot-do-cao">
  <canvas></canvas>
  <div class="controls">
    <label>Nhiệt độ mặt đất T (°C) <output data-out="t"></output>
      <input type="range" data-in="t" min="15" max="42" step="0.1" value="34" /></label>
    <label>Điểm sương Td (°C) <output data-out="d"></output>
      <input type="range" data-in="d" min="5" max="35" step="0.1" value="25.5" /></label>
    <label>Độ giảm điểm sương (°C/km) <output data-out="g"></output>
      <input type="range" data-in="g" min="1.5" max="2" step="0.05" value="1.8" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trục ngang là nhiệt độ, trục dọc là độ cao. Đường xanh: khối khí bốc lên
    nguội đi 9,8 °C mỗi km. Đường cam: điểm sương của chính khối khí ấy, chỉ
    tụt ~1,8 °C mỗi km. Hai đường đuổi nhau 8 °C mỗi km và gặp nhau ở đúng
    một độ cao — đó là đáy đám mây, nơi đường xanh gãy khúc vì hơi nước bắt
    đầu ngưng và trả nhiệt lại.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const PARCEL = '#2563eb', MARK = '#dc2626', DEW = '#f59e0b';
  const G_DRY = 9.8, G_MOIST = 6.0;
  const Z_TOP = 5000, T_LO = -20, T_HI = 45;
  const LANDMARKS: Array<[number, string]> = [[1500, 'Sa Pa'], [3143, 'Fansipan']];
  const PUFFS: Array<[number, number]> = [[-0.28, 0.19], [0.02, 0.27], [0.30, 0.18]];

  const es = (T: number) => 6.112 * Math.exp((17.67 * T) / (T + 243.5));
  const vi = (x: number, d = 1) => x.toFixed(d).replace('.', ',').replace('-', '−');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const T = Number(input('t').value);
      const TdRaw = Number(input('d').value);
      const Td = Math.min(TdRaw, T);
      const gd = Number(input('g').value);
      output('t').textContent = vi(T);
      output('d').textContent = vi(TdRaw);
      output('g').textContent = vi(gd, 2);

      const perDeg = 1000 / (G_DRY - gd);        // met cho moi do chenh
      const spread = Math.round((T - Td) * 10) / 10;
      const zBase = Math.max(0, perDeg * spread);
      const tBase = T - (G_DRY * zBase) / 1000;
      const rh = Math.min(100, (100 * es(Td)) / es(T));

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.62);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 44, padB = 28, padT = 14, padR = cssW < 420 ? 26 : 12;
      const X = (t: number) => padL + ((t - T_LO) / (T_HI - T_LO)) * (cssW - padL - padR);
      const Y = (z: number) => cssH - padB - (z / Z_TOP) * (cssH - padB - padT);

      ctx.font = '10px system-ui,sans-serif';
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      for (const t of [-20, -10, 0, 10, 20, 30, 40]) ctx.fillText(`${vi(t, 0)}°`, X(t), cssH - padB + 15);
      ctx.textAlign = 'right';
      for (const z of [1000, 2000, 3000, 4000, 5000]) ctx.fillText(`${z / 1000} km`, padL - 4, Y(z) + 3);
      ctx.fillText('0', padL - 4, Y(0) + 3);
      ctx.globalAlpha = 1;

      // Moc do cao quen thuoc.
      ctx.setLineDash([2, 4]);
      for (const [z, name] of LANDMARKS) {
        ctx.globalAlpha = 0.25; ctx.strokeStyle = fg;
        ctx.beginPath(); ctx.moveTo(padL, Y(z)); ctx.lineTo(cssW - padR, Y(z)); ctx.stroke();
        ctx.globalAlpha = 0.5; ctx.fillStyle = fg; ctx.textAlign = 'right';
        ctx.fillText(name, cssW - padR - 3, Y(z) - 4);
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // Duong diem suong cua khoi khi (cam), tu mat dat len den day may.
      ctx.strokeStyle = DEW; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(X(Td), Y(0)); ctx.lineTo(X(tBase), Y(zBase)); ctx.stroke();

      // Duong nhiet do khoi khi: doan nhiet kho toi day may, roi doan nhiet am.
      const zTopCloud = Math.min(Z_TOP, zBase + 2500);
      ctx.strokeStyle = PARCEL;
      ctx.beginPath(); ctx.moveTo(X(T), Y(0)); ctx.lineTo(X(tBase), Y(zBase)); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(X(tBase), Y(zBase));
      ctx.lineTo(X(tBase - (G_MOIST * (zTopCloud - zBase)) / 1000), Y(zTopCloud));
      ctx.stroke();
      ctx.lineWidth = 1;

      // Dam may: day phang dat dung tai giao diem.
      const cy = Y(zBase);
      // Thu hep dam may khi day may sat mep tren, cho no khong bi cat.
      const w = Math.min((cssW - padL - padR) * 0.24, (cy - padT) / 0.44);
      const cx = Math.min(Math.max(X(tBase), padL + w / 2 + 2), cssW - padR - w / 2 - 2);
      ctx.fillStyle = fg; ctx.globalAlpha = 0.16;
      ctx.beginPath(); ctx.rect(cx - w / 2, cy - w * 0.17, w, w * 0.17); ctx.fill();
      for (const [dx, r] of PUFFS) {
        ctx.beginPath(); ctx.arc(cx + dx * w, cy - w * 0.17, r * w, Math.PI, 0); ctx.fill();
      }
      ctx.globalAlpha = 1;

      // Vach day may.
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.5; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(padL, cy); ctx.lineTo(cssW - padR, cy); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(cx - w / 2, cy); ctx.lineTo(cx + w / 2, cy); ctx.stroke();
      ctx.lineWidth = 1;
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(tBase), cy, 5, 0, Math.PI * 2); ctx.fill();
      ctx.textAlign = 'left';
      ctx.fillText(`đáy mây ${Math.round(zBase).toLocaleString('vi-VN')} m`, padL + 4, cy - 6);

      if (TdRaw >= T) {
        readout.innerHTML =
          `Điểm sương đã bằng nhiệt độ không khí ngay tại mặt đất (RH 100%):` +
          ` <b>đáy mây ở 0 m</b> — đám mây nằm dưới chân bạn, ta gọi nó là sương mù.`;
        return;
      }
      const note = zBase < 305
        ? ' · <b>trần mây dưới 305 m (1 000 ft) — dưới ngưỡng bay bằng mắt</b>'
        : zBase > 3143
          ? ' · <b>đáy mây cao hơn đỉnh Fansipan — kiểu trời khô hạn</b>'
          : '';
      readout.innerHTML =
        `T = ${vi(T)} °C · điểm sương ${vi(Td)} °C (RH ${rh.toFixed(0)}%) → chênh ${vi(spread)} °C` +
        ` × ${Math.round(perDeg)} m/độ → <b>đáy mây ${Math.round(zBase).toLocaleString('vi-VN')} m</b>` +
        `, ở đó không khí còn ${vi(tBase)} °C${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="vi-sao-moi-dam-may-tich-co-day-phang-cung-mot-do-cao"]').forEach(setup);
</script>
