---
// Friis free-space path loss, engineering form (ITU-R P.525 / Friis 1946):
//   L(dB) = 20·log10(d_km) + 20·log10(f_MHz) + 32,44
//   P_rx(dBm) = P_tx(dBm) − L − n_tường · 5 dB
// P_tx cố định 20 dBm (100 mW EIRP, mức trần cho router 2,4 GHz).
// Ngưỡng vẽ: −90 dBm (độ nhạy máy thu ở tốc độ thấp nhất), −67 dBm
// (mức các hướng dẫn thiết kế WLAN đòi hỏi cho thoại/video).
// Hợp lệ ở vùng trường xa, không gian tự do: trong nhà công thức là cận
// dưới của suy hao, ngoài trời qua điểm gãy nó là cận trên.
---

<figure class="demo" data-demo="wifi-5-ghz-nhanh-hon-nhung-di-gan-hon">
  <canvas></canvas>
  <div class="controls">
    <label>Khoảng cách d (m) <output data-out="d"></output>
      <input type="range" data-in="d" min="1" max="100" step="0.5" value="10" /></label>
    <label>Tần số f (GHz) <output data-out="f"></output>
      <input type="range" data-in="f" min="0.7" max="6" step="0.1" value="5" /></label>
    <label>Số tường ngăn <output data-out="w"></output>
      <input type="range" data-in="w" min="0" max="5" step="1" value="0" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Công suất tới máy thu khi router phát 100 mW (20 dBm), trục ngang là
    khoảng cách theo thang lôgarit. Đường cam là băng 2,4 GHz cố định làm
    mốc; đường xanh là tần số bạn chọn. Mỗi tường ngăn nhẹ trừ 5 dB, kéo
    tụt cả đường xuống. Dưới vạch −90 dBm (vùng tô xám) máy thu không còn
    giải mã nổi; dưới −67 dBm thì vẫn nối được nhưng phải hạ tốc độ.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', REF = '#f59e0b';
  const PTX = 20, WALL = 5, FLOOR = -90, GOOD = -67;

  // d in metres, f in GHz.
  const loss = (d: number, f: number) =>
    20 * Math.log10(d / 1000) + 20 * Math.log10(f * 1000) + 32.44;
  const prx = (d: number, f: number, w: number) => PTX - loss(d, f) - w * WALL;
  const num = (x: number, n: number) => x.toFixed(n).replace('-', '−').replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const d = Number(input('d').value);
      const f = Number(input('f').value);
      const w = Number(input('w').value);
      output('d').textContent = num(d, 1);
      output('f').textContent = num(f, 1);
      output('w').textContent = w === 0 ? '0 (−0 dB)' : `${w} (−${w * WALL} dB)`;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.52);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 40, padB = 26, padT = 14, padR = cssW < 420 ? 26 : 12;
      const yHi = 0, yLo = -110;
      const X = (dd: number) => padL + (Math.log10(dd) / 2) * (cssW - padL - padR);
      const Y = (p: number) => padT + ((yHi - p) / (yHi - yLo)) * (cssH - padB - padT);

      // Vùng dưới ngưỡng giải mã.
      ctx.fillStyle = fg; ctx.globalAlpha = 0.09;
      ctx.fillRect(padL, Y(FLOOR), cssW - padL - padR, cssH - padB - Y(FLOOR));
      ctx.globalAlpha = 1;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();

      ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(padL, Y(GOOD)); ctx.lineTo(cssW - padR, Y(GOOD)); ctx.stroke();
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.6;
      ctx.beginPath(); ctx.moveTo(padL, Y(FLOOR)); ctx.lineTo(cssW - padR, Y(FLOOR)); ctx.stroke();
      ctx.setLineDash([]);

      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('−67 dBm: dưới mức này phải hạ tốc độ', padL + 6, Y(GOOD) - 4);
      ctx.fillText('−90 dBm: mất kết nối', padL + 6, Y(FLOOR) + 12);
      ctx.textAlign = 'center';
      for (const t of [1, 2, 5, 10, 20, 50, 100]) ctx.fillText(`${t} m`, X(t), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const p of [0, -20, -40, -60, -80, -100]) ctx.fillText(num(p, 0), padL - 4, Y(p) + 3);
      ctx.fillText('dBm', padL - 4, padT - 3);
      ctx.globalAlpha = 1;

      const curve = (ff: number, colour: string) => {
        ctx.strokeStyle = colour; ctx.lineWidth = 2; ctx.beginPath();
        for (let i = 0; i <= 200; i++) {
          const dd = Math.pow(10, (2 * i) / 200);
          const y = Y(prx(dd, ff, w));
          i ? ctx.lineTo(X(dd), y) : ctx.moveTo(X(dd), y);
        }
        ctx.stroke(); ctx.lineWidth = 1;
      };
      curve(2.4, REF);
      curve(f, CURVE);

      ctx.font = '11px system-ui,sans-serif'; ctx.textAlign = 'right';
      const same = Math.abs(f - 2.4) < 0.05;
      if (!same) {
        ctx.fillStyle = REF;
        ctx.fillText('2,4 GHz', cssW - padR - 2, Y(prx(100, 2.4, w)) - 6);
      }
      ctx.fillStyle = CURVE;
      ctx.fillText(`${num(f, 1)} GHz`, cssW - padR - 2, Y(prx(100, f, w)) + (same ? -6 : 14));

      const p = prx(d, f, w);
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(d), Y(p), 6, 0, Math.PI * 2); ctx.fill();

      const p24 = prx(d, 2.4, w);
      const gap = loss(d, f) - loss(d, 2.4);
      const zone = p < FLOOR ? ' · <b>dưới ngưỡng: mất kết nối</b>'
        : p < GOOD ? ' · <b>còn nối được nhưng phải hạ tốc độ</b>' : '';
      readout.innerHTML =
        `d = ${num(d, 1)} m · ${w} tường (−${w * WALL} dB) · 2,4 GHz: suy hao ${num(loss(d, 2.4), 1)} dB → ` +
        `<b>${num(p24, 1)} dBm</b> · ${num(f, 1)} GHz: ${num(loss(d, f), 1)} dB → <b>${num(p, 1)} dBm</b> · ` +
        `chênh ${num(gap, 1)} dB · dư so với ngưỡng −90 dBm: ${num(p - FLOOR, 1)} dB${zone}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="wifi-5-ghz-nhanh-hon-nhung-di-gan-hon"]').forEach(setup);
</script>
