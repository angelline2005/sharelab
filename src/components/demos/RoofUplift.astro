---
// Wind load on a low-rise building: F = C_p · ½ρv² · A, ρ = 1,225 kg/m³.
// External pressure coefficients from EN 1991-1-4 (Eurocode 1, part 1-4),
// Table 7.2 (flat roof, sharp eaves) and Table 7.4a (duopitch, wind normal
// to the ridge), c_pe,10:
//   windward eave strip, zone G: 0°/5° −1,2 · 15° −0,8 · 30° −0,5 · 45° 0,0
//   windward slope interior, zone H: 0° −0,7 · 5° −0,6 · 15° −0,3 · 30° −0,2 · 45° 0,0
//   leeward slope (zones I/J): taken constant −0,5, inside the Eurocode spread.
// Whole-roof uplift coefficient = mean of the two slopes (equal areas).
// Windward wall +0,8 and leeward wall −0,5 are the standard wall values.
// Linear interpolation between table rows; valid for low-rise buildings,
// pitch 0–45°, wind normal to the ridge, open suburban terrain, and for the
// MEAN wind speed (gusts and internal pressure are handled in the article).
---

<figure class="demo" data-demo="bao-cap-12-de-len-cua-kinh-bao-nhieu">
  <canvas></canvas>
  <div class="controls">
    <label>Tốc độ gió (m/s) <output data-out="v"></output>
      <input type="range" data-in="v" min="5" max="60" step="0.1" value="33" /></label>
    <label>Diện tích mái (m²) <output data-out="a"></output>
      <input type="range" data-in="a" min="10" max="120" step="1" value="60" /></label>
    <label>Độ dốc mái (°) <output data-out="p"></output>
      <input type="range" data-in="p" min="0" max="45" step="1" value="5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Mũi tên xanh là áp dương (gió đẩy vào bề mặt), mũi tên đỏ là áp âm (gió
    hút bề mặt ra); độ dài tỉ lệ với hệ số áp C_p. Chỉ mặt tường đón gió bị
    đẩy — mái và mọi mặt còn lại đều bị hút. Đồ thị dưới so lực nhấc mái với
    trọng lượng hai loại mái: chỗ đường cong cắt đường ngang là tốc độ gió
    mà mái tự bay nếu chỉ có trọng lượng giữ nó. Hệ số lấy từ EN 1991-1-4,
    ρ = 1,225 kg/m³ (không khí bão nóng ẩm loãng hơn ~7%).
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const PUSH = '#2563eb', SUCK = '#dc2626', LINE = '#f59e0b';
  const RHO = 1.225, G = 9.81;
  const EDGE: Array<[number, number]> = [[0, -1.2], [5, -1.2], [15, -0.8], [30, -0.5], [45, 0]];
  const SLOPE: Array<[number, number]> = [[0, -0.7], [5, -0.6], [15, -0.3], [30, -0.2], [45, 0]];
  const LEE = -0.5, WALL_UP = 0.8, WALL_DOWN = -0.5;
  const LB = [0, 0.3, 1.6, 3.4, 5.5, 8, 10.8, 13.9, 17.2, 20.8, 24.5, 28.5, 32.7, 37, 41.5, 46.2, 51, 56.1];

  const vn = (x: number, n = 1) => x.toFixed(n).replace('.', ',').replace('-', '−');
  const q = (v: number) => 0.5 * RHO * v * v;
  const beaufort = (v: number) => { let k = 0; for (let i = 0; i < LB.length; i++) if (v >= LB[i]) k = i; return k; };
  function lerp(T: Array<[number, number]>, a: number) {
    for (let i = 1; i < T.length; i++) {
      if (a <= T[i][0]) return T[i - 1][1] + (T[i][1] - T[i - 1][1]) * (a - T[i - 1][0]) / (T[i][0] - T[i - 1][0]);
    }
    return T[T.length - 1][1];
  }
  const cpRoof = (a: number) => (lerp(SLOPE, a) + LEE) / 2;
  const niceStep = (max: number) => {
    const raw = max / 4, p = Math.pow(10, Math.floor(Math.log10(raw))), n = raw / p;
    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * p;
  };

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function arrow(x0: number, y0: number, dx: number, dy: number, color: string) {
      const len = Math.hypot(dx, dy);
      if (len < 2) return;
      const ux = dx / len, uy = dy / len;
      ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x0 + dx, y0 + dy); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x0 + dx, y0 + dy);
      ctx.lineTo(x0 + dx - 6 * ux + 3.5 * uy, y0 + dy - 6 * uy - 3.5 * ux);
      ctx.lineTo(x0 + dx - 6 * ux - 3.5 * uy, y0 + dy - 6 * uy + 3.5 * ux);
      ctx.closePath(); ctx.fill();
      ctx.lineWidth = 1;
    }

    function draw() {
      const v = Number(input('v').value), A = Number(input('a').value), al = Number(input('p').value);
      output('v').textContent = vn(v);
      output('a').textContent = String(A);
      output('p').textContent = String(al);

      const cpE = lerp(EDGE, al), cpR = cpRoof(al), cpS = lerp(SLOPE, al);
      const pr = q(v);
      const pEdge = Math.abs(cpE) * pr, pWall = WALL_UP * pr;
      const lift = Math.abs(cpR) * pr * A;
      const wTon = 15 * A * G, wNgoi = 60 * A * G;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.62);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- top panel: house cross-section with pressure arrows ----------
      const hTop = Math.round(cssH * 0.44);
      const cx = cssW / 2, gy = hTop - 10;
      const hw = Math.min(80, cssW * 0.13), wh = Math.round(hTop * 0.30);
      const rad = (al * Math.PI) / 180;
      const rise = hw * Math.tan(rad);
      const eaveY = gy - wh, ridgeY = eaveY - rise;
      const L = (cp: number) => 26 * Math.abs(cp);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.35;
      ctx.beginPath(); ctx.moveTo(8, gy); ctx.lineTo(cssW - 8, gy); ctx.stroke();
      ctx.globalAlpha = 0.75; ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(cx - hw, gy); ctx.lineTo(cx - hw, eaveY); ctx.lineTo(cx, ridgeY);
      ctx.lineTo(cx + hw, eaveY); ctx.lineTo(cx + hw, gy);
      ctx.stroke(); ctx.lineWidth = 1; ctx.globalAlpha = 1;

      // wind indicator
      ctx.fillStyle = fg; ctx.globalAlpha = 0.55; ctx.textAlign = 'left';
      ctx.fillText(`gió ${vn(v)} m/s · cấp ${beaufort(v)}`, 10, gy - wh - rise - 6);
      ctx.globalAlpha = 0.4;
      for (const yy of [gy - 14, gy - wh * 0.6, eaveY - 6]) {
        ctx.strokeStyle = fg;
        ctx.beginPath(); ctx.moveTo(10, yy); ctx.lineTo(cx - hw - L(WALL_UP) - 14, yy); ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // windward wall: pressure pushing in
      arrow(cx - hw - L(WALL_UP) - 6, eaveY + wh / 2, L(WALL_UP), 0, PUSH);
      // leeward wall: suction pulling out
      arrow(cx + hw + 6, eaveY + wh / 2, L(WALL_DOWN), 0, SUCK);
      // windward slope: suction along outward normal
      const nwx = -Math.sin(rad), nwy = -Math.cos(rad);
      const mwx = cx - hw / 2, mwy = eaveY - rise / 2;
      arrow(mwx + nwx * 5, mwy + nwy * 5, nwx * L(cpS), nwy * L(cpS), SUCK);
      // leeward slope
      const nlx = Math.sin(rad), nly = -Math.cos(rad);
      arrow(cx + hw / 2 + nlx * 5, eaveY - rise / 2 + nly * 5, nlx * L(LEE), nly * L(LEE), SUCK);
      // windward eave strip: the peak suction
      arrow(cx - hw + nwx * 5, eaveY + nwy * 5, nwx * L(cpE), nwy * L(cpE), SUCK);

      ctx.fillStyle = fg; ctx.globalAlpha = 0.7;
      ctx.textAlign = 'right';
      ctx.fillText(`tường +0,80`, cx - hw - 8, eaveY + wh / 2 + 16);
      ctx.fillText(`mép mái ${vn(cpE, 2)}`, cx - hw - 6, eaveY - 16);
      ctx.textAlign = 'left';
      ctx.fillText(`${vn(WALL_DOWN, 2)}`, cx + hw + L(WALL_DOWN) + 10, eaveY + wh / 2 + 4);
      ctx.fillText(`mặt mái ${vn(cpS, 2)}`, cx + 6, ridgeY - 8);
      ctx.globalAlpha = 1;

      // ---------- bottom panel: lift force vs wind speed ----------
      const padL = 46, padR = cssW < 420 ? 26 : 12, padB = 24, top = hTop + 16;
      const yMax = Math.max(Math.abs(cpR) * q(60) * A, wNgoi) * 1.08 / 1000;
      const X = (vv: number) => padL + ((vv - 5) / 55) * (cssW - padL - padR);
      const Y = (kn: number) => cssH - padB - (kn / yMax) * (cssH - padB - top);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, top); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'center';
      for (const k of [10, 20, 30, 40, 50, 60]) ctx.fillText(`${k} m/s`, X(k), cssH - padB + 14);
      ctx.textAlign = 'right';
      const st = niceStep(yMax);
      for (let k = st; k <= yMax; k += st) ctx.fillText(`${vn(k, st < 1 ? 1 : 0)} kN`, padL - 4, Y(k) + 3);
      ctx.globalAlpha = 1;

      // weight thresholds
      ctx.setLineDash([4, 3]); ctx.strokeStyle = LINE;
      for (const [wt, lab] of [[wTon, 'trọng lượng mái tôn + xà gồ (15 kg/m²)'], [wNgoi, 'trọng lượng mái ngói (60 kg/m²)']] as Array<[number, string]>) {
        const y = Y(wt / 1000);
        if (y < top || y > cssH - padB) continue;
        ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(cssW - padR, y); ctx.stroke();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'left';
        ctx.fillText(lab, padL + 6, y - 4); ctx.globalAlpha = 1;
      }
      ctx.setLineDash([]);

      // lift curve
      ctx.strokeStyle = PUSH; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 200; i++) {
        const vv = 5 + (55 * i) / 200, y = Y(Math.abs(cpR) * q(vv) * A / 1000);
        i ? ctx.lineTo(X(vv), y) : ctx.moveTo(X(vv), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = SUCK;
      ctx.beginPath(); ctx.arc(X(v), Math.max(top, Y(lift / 1000)), 6, 0, Math.PI * 2); ctx.fill();

      const verdict = lift > wNgoi
        ? ' ⇒ <b>nhấc nổi cả mái ngói</b>'
        : lift > wTon
          ? ' ⇒ <b>mái tôn không bắt vít thì BAY</b>'
          : ' ⇒ trọng lượng mái tôn còn giữ được';
      readout.innerHTML =
        `Gió ${vn(v)} m/s (cấp ${beaufort(v)}) · mái ${A} m², dốc ${al}° · áp động ½ρv² = <b>${vn(pr, 0)} Pa</b><br />` +
        `Mép mái C_p = ${vn(cpE, 2)} → hút <b>${vn(pEdge, 0)} Pa = ${vn(pEdge / G, 0)} kg mỗi m²</b>` +
        ` · tường đón gió +0,80 → đẩy ${vn(pWall, 0)} Pa = ${vn(pWall / G, 0)} kg mỗi m²<br />` +
        `Cả mái (C_p trung bình ${vn(cpR, 2)}): lực nhấc <b>${vn(lift / 1000, 1)} kN = ${vn(lift / G / 1000, 2)} tấn</b>` +
        ` · mái tôn 15 kg/m² nặng ${vn(wTon / G / 1000, 2)} tấn${verdict}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="bao-cap-12-de-len-cua-kinh-bao-nhieu"]').forEach(setup);
</script>
