---
// Lumped heat-capacity budget for a skillet taking cold food:
//   Q = m_ăn·c_ăn·(70 − 5)      với c_ăn = 3 500 J/(kg·K)
//   ΔT = Q / (m_chảo·c_chảo)     t_hồi = (T_đặt − T_đáy)·C_chảo / P_bếp
// Sàn nhiệt độ được chặn ở nhiệt độ cân bằng chảo–thức ăn
//   T_eq = (C·T_đặt + m_ăn·c_ăn·T_lạnh)/(C + m_ăn·c_ăn),
// vì chảo không thể nguội hơn mức cân bằng với chính miếng thịt.
// Giá trị vật liệu: nhôm 900, thép 490, gang 460, đồng 385 J/(kg·K)
// (CRC Handbook). Bếp cố định 2 000 W, chảo đặt sẵn 200 °C, thịt 5 °C.
// Mô hình bỏ qua mất mát ra không khí và giả thiết cả khối chảo cùng
// tham gia — đúng như một cận trên năng lượng trong vài chục giây đầu.
---

<figure class="demo" data-demo="chao-mong-tut-126-do-khi-tha-mieng-thit">
  <canvas></canvas>
  <div class="controls">
    <label>Khối lượng chảo (kg) <output data-out="m"></output>
      <input type="range" data-in="m" min="0.2" max="3" step="0.05" value="0.4" /></label>
    <label>Nhiệt dung riêng vật liệu (J/kg·K) <output data-out="c"></output>
      <input type="range" data-in="c" min="380" max="900" step="5" value="900" /></label>
    <label>Thức ăn thả vào (g) <output data-out="f"></output>
      <input type="range" data-in="f" min="50" max="500" step="5" value="200" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh là mặt chảo bạn chỉnh, đường cam là chảo gang 2 kg đối
    chứng với cùng lượng thức ăn. Cả hai đứng ở 200 °C, sụt thẳng đứng
    đúng lúc thịt lạnh chạm chảo, rồi bò lên lại theo bếp 2 000 W. Vạch
    140 °C là ngưỡng phản ứng Maillard, vạch 100 °C là điểm sôi: rơi
    xuống dưới nó, nước không bay đi nữa mà đọng lại và món trở thành
    món luộc.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', REF = '#f59e0b';
  const TSET = 200, TCOLD = 5, TDONE = 70, CFOOD = 3500, POWER = 2000;
  const MAILLARD = 140, TBOIL = 100, TMAX = 60;
  const MATS: Array<[number, string]> = [[385, 'đồng'], [460, 'gang'], [490, 'thép'], [900, 'nhôm']];
  const vn = (x: number, d = 0) => x.toFixed(d).replace('.', ',');

  function pan(C: number, mf: number) {
    const Q = mf * CFOOD * (TDONE - TCOLD);
    const raw = TSET - Q / C;
    const Teq = (C * TSET + mf * CFOOD * TCOLD) / (C + mf * CFOOD);
    const dip = Math.max(raw, Teq);
    return { Q, dip, Teq, rec: ((TSET - dip) * C) / POWER };
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const m = Number(input('m').value);
      const c = Number(input('c').value);
      const mf = Number(input('f').value) / 1000;
      const C = m * c;

      const near = MATS.find(([v]) => Math.abs(v - c) <= 8);
      output('m').textContent = vn(m, 2);
      output('c').textContent = near ? `${c} (${near[1]})` : String(c);
      output('f').textContent = String(Math.round(mf * 1000));

      const me = pan(C, mf);
      const ref = pan(920, mf);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 44, padB = 26, padT = 12, padR = cssW < 420 ? 26 : 10;
      const X = (t: number) => padL + ((t + 5) / (TMAX + 5)) * (cssW - padL - padR);
      const Y = (T: number) => cssH - padB - (T / 210) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.setLineDash([4, 4]);
      for (const T of [MAILLARD, TBOIL]) {
        ctx.beginPath(); ctx.moveTo(padL, Y(T)); ctx.lineTo(cssW - padR, Y(T)); ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('140 °C — ngưỡng Maillard', padL + 6, Y(MAILLARD) - 4);
      ctx.fillText('100 °C — điểm sôi', padL + 6, Y(TBOIL) - 4);
      ctx.textAlign = 'center';
      for (const t of [0, 15, 30, 45, 60]) ctx.fillText(`${t} s`, X(t), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const T of [0, 50, 100, 150, 200]) ctx.fillText(`${T}°`, padL - 4, Y(T) + 3);
      ctx.globalAlpha = 1;

      const trace = (s: { dip: number }, Cp: number, col: string) => {
        ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.beginPath();
        ctx.moveTo(X(-5), Y(TSET)); ctx.lineTo(X(0), Y(TSET)); ctx.lineTo(X(0), Y(s.dip));
        for (let i = 0; i <= 180; i++) {
          const t = (TMAX * i) / 180;
          ctx.lineTo(X(t), Y(Math.min(TSET, s.dip + (POWER * t) / Cp)));
        }
        ctx.stroke(); ctx.lineWidth = 1;
      };
      trace(ref, 920, REF);
      trace(me, C, CURVE);

      ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'left';
      ctx.fillText('gang 2 kg (đối chứng)', X(32), Y(ref.dip) + 14);
      ctx.globalAlpha = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(0), Y(me.dip), 6, 0, Math.PI * 2); ctx.fill();

      const drop = TSET - me.dip;
      const regime = me.dip >= MAILLARD
        ? 'vẫn trong vùng Maillard — <b>món áp chảo</b>'
        : me.dip >= TBOIL
          ? 'dưới ngưỡng Maillard — cạnh thịt không kịp cháy vàng'
          : '<b>dưới điểm sôi — nước đọng lại, món thành món luộc</b>';
      const stall = me.Teq < TDONE
        ? ` · nhiệt tích trong chảo không đủ đưa thức ăn lên 70 °C (cân bằng ở ${vn(me.Teq)} °C) — từ đây trở đi mọi thứ trông vào bếp`
        : '';

      readout.innerHTML =
        `Chảo ${vn(m, 2)} kg × ${c} J/kg·K = <b>${vn(C)} J/K</b> · ${Math.round(mf * 1000)} g thức ăn từ 5 °C lên 70 °C rút ` +
        `<b>${vn(me.Q / 1000, 1)} kJ</b> → mặt chảo tụt <b>${vn(drop)} °C</b>, còn ${vn(me.dip)} °C: ${regime}. ` +
        `Bếp 2 000 W kéo về 200 °C sau ${vn(me.rec)} s (gang 2 kg: tụt ${vn(TSET - ref.dip)} °C, còn ${vn(ref.dip)} °C)${stall}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="chao-mong-tut-126-do-khi-tha-mieng-thit"]').forEach(setup);
</script>
