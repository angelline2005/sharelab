---
// Quỹ đạo đồng bộ Mặt Trời — tuế sai nút do J2 (lý thuyết thế kỷ bậc 1, quỹ đạo tròn):
//   dΩ/dt = −(3/2)·J2·(R_E/a)²·n·cos i,  n = sqrt(GM/a³)
//   Đồng bộ khi dΩ/dt = 360°/365,2422 ngày = 0,985647 °/ngày
//   → cos i = −2·ω_S·a^3,5 / (3·J2·R_E²·sqrt(GM))
// Hằng số: J2 = 1,08262668e−3 (EGM96), R_E = 6378,137 km, GM = 398600,4418 km³/s².
// Miền hợp lệ: quỹ đạo gần tròn, 200–1500 km (dưới ngưỡng |cos i| = 1 ở h ≈ 5974 km);
// bỏ qua lực cản khí quyển, nhiễu Mặt Trăng–Mặt Trời và các hệ số điều hoà bậc cao.
---

<figure class="demo" data-demo="quy-dao-dong-bo-mat-troi-nghieng-98-do">
  <canvas></canvas>
  <div class="controls">
    <label>Độ cao quỹ đạo (km) <output data-out="h"></output>
      <input type="range" data-in="h" min="200" max="1500" step="1" value="700" /></label>
    <label>Góc nghiêng i (°) <output data-out="i"></output>
      <input type="range" data-in="i" min="90" max="104" step="0.01" value="98.19" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh: góc nghiêng mà quỹ đạo phải có để mặt phẳng của nó xoay đúng
    0,9856 °/ngày — bằng nhịp Mặt Trời trôi trên nền sao. Vạch cam là góc bạn
    đang chọn; nó cắt đường xanh đúng ở độ cao mà góc ấy đồng bộ. Mặt đồng hồ
    bên phải nhìn từ cực Bắc xuống: sau nửa năm, tia cam là hướng Mặt Trời,
    tia xanh là mặt phẳng quỹ đạo — khe hở giữa chúng chính là số giờ mà thời
    điểm chụp ảnh đã trôi đi.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', SUN = '#f59e0b';
  const J2 = 1.08262668e-3, RE = 6378.137, GM = 398600.4418;
  const YEAR = 365.2421897, HALF = YEAR / 2;
  const WSUN_DEG = 360 / YEAR;                       // °/ngày, chuyển động biểu kiến Mặt Trời
  const WSUN = (WSUN_DEG * Math.PI / 180) / 86400;   // rad/s
  const D2R = Math.PI / 180;
  const LANDMARKS: Array<[number, string]> = [
    [475, 'Planet Dove'], [705, 'Landsat 9'], [824, 'Suomi NPP'],
  ];

  const nOf = (a: number) => Math.sqrt(GM / (a * a * a));              // rad/s
  // Tuế sai nút, °/ngày
  const nodeRate = (h: number, i: number) => {
    const a = RE + h;
    return -1.5 * J2 * Math.pow(RE / a, 2) * nOf(a) * Math.cos(i * D2R) * (180 / Math.PI) * 86400;
  };
  // Góc nghiêng đồng bộ Mặt Trời tại độ cao h, ° (NaN nếu |cos i| > 1)
  const incReq = (h: number) => {
    const a = RE + h;
    const c = (-2 * WSUN * Math.pow(a, 3.5)) / (3 * J2 * RE * RE * Math.sqrt(GM));
    return Math.abs(c) > 1 ? NaN : Math.acos(c) / D2R;
  };
  const fmt = (x: number, d: number) => {
    const v = Math.abs(x) < Math.pow(10, -d) / 2 ? 0 : x;   // tránh "−0,0000"
    return v.toFixed(d).replace('-', '−').replace('.', ',');
  };

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const h = Number(input('h').value), i = Number(input('i').value);
      output('h').textContent = h.toLocaleString('vi-VN');
      output('i').textContent = fmt(i, 2);

      const rate = nodeRate(h, i);
      const need = incReq(h);
      const driftHalf = ((rate - WSUN_DEG) * HALF) / 15;   // giờ, sau nửa năm
      const driftYear = driftHalf * 2;                     // giờ mỗi năm
      const period = (2 * Math.PI / nOf(RE + h)) / 60;     // phút

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.52);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padL = 46, padT = 14, padB = 26;
      const wide = cssW > 400;
      const PR = wide ? Math.round(cssW * 0.60) : cssW - 10;
      const yLo = 89, yHi = 105;
      const X = (hh: number) => padL + ((hh - 200) / 1300) * (PR - padL);
      const Y = (ii: number) => padT + ((yHi - ii) / (yHi - yLo)) * (cssH - padB - padT);

      // Trục
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(PR, cssH - padB);
      ctx.stroke();
      // Mốc 90°: tuế sai bằng 0
      ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(padL, Y(90)); ctx.lineTo(PR, Y(90)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'left';
      ctx.fillText('90° — không tuế sai', padL + 6, Y(90) - 5);
      ctx.textAlign = 'center';
      for (const k of [400, 700, 1000, 1300]) ctx.fillText(`${k} km`, X(k), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const c of [90, 94, 98, 102]) ctx.fillText(`${c}°`, padL - 4, Y(c) + 3);
      ctx.globalAlpha = 1;

      // Vạch cam: góc nghiêng đang chọn
      ctx.strokeStyle = SUN; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(padL, Y(i)); ctx.lineTo(PR, Y(i)); ctx.stroke();

      // Đường cong i_đồng-bộ(h)
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let k = 0; k <= 240; k++) {
        const hh = 200 + (1300 * k) / 240;
        const yy = Y(incReq(hh));
        k ? ctx.lineTo(X(hh), yy) : ctx.moveTo(X(hh), yy);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Vệ tinh thật
      LANDMARKS.forEach(([hh, lab], k) => {
        ctx.fillStyle = SUN;
        ctx.beginPath(); ctx.arc(X(hh), Y(incReq(hh)), 3.5, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'center';
        ctx.fillText(lab, X(hh), Y(incReq(hh)) - 8 - (k % 2) * 11);
        ctx.globalAlpha = 1;
      });

      // Chấm đỏ: yêu cầu tại độ cao đang chọn
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(h), Y(need), 6, 0, Math.PI * 2); ctx.fill();

      // Mặt đồng hồ: nhìn từ cực Bắc, sau nửa năm
      if (wide) {
        const insetL = PR + 14, insetR = cssW - 6;
        const cx = (insetL + insetR) / 2;
        const cy = padT + (cssH - padB - padT) / 2 + 6;
        const r = Math.min((insetR - insetL) / 2 - 10, (cssH - padB - padT) / 2 - 16);
        if (r > 22) {
          ctx.strokeStyle = fg; ctx.globalAlpha = 0.25;
          ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
          ctx.beginPath(); ctx.arc(cx, cy, r * 0.22, 0, Math.PI * 2); ctx.fill();
          ctx.globalAlpha = 0.6; ctx.fillStyle = fg; ctx.textAlign = 'center';
          ctx.fillText('sau nửa năm', cx, cy - r - 6);
          ctx.globalAlpha = 1;

          // Tia Mặt Trời (mốc cố định, bên phải)
          ctx.strokeStyle = SUN; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + r, cy); ctx.stroke();
          ctx.fillStyle = SUN;
          ctx.beginPath(); ctx.arc(cx + r, cy, 4, 0, Math.PI * 2); ctx.fill();

          // Mặt phẳng quỹ đạo sau nửa năm
          let th = ((rate - WSUN_DEG) * HALF) % 360;
          if (th > 180) th -= 360;
          if (th < -180) th += 360;
          const t = th * D2R;
          ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(cx - r * Math.cos(t), cy + r * Math.sin(t));
          ctx.lineTo(cx + r * Math.cos(t), cy - r * Math.sin(t));
          ctx.stroke();
          ctx.fillStyle = MARK;
          ctx.beginPath(); ctx.arc(cx + r * Math.cos(t), cy - r * Math.sin(t), 4, 0, Math.PI * 2); ctx.fill();

          // Cung khe hở
          ctx.strokeStyle = MARK; ctx.globalAlpha = 0.8; ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.arc(cx, cy, r * 0.55, 0, -t, th > 0); ctx.stroke();
          ctx.globalAlpha = 1; ctx.lineWidth = 1;
          ctx.fillStyle = fg; ctx.globalAlpha = 0.75; ctx.textAlign = 'center';
          ctx.fillText(`${fmt(Math.abs(driftHalf), 1)} h`, cx, cy + r + 14);
          ctx.globalAlpha = 1;
        }
      }

      const off = Math.abs(driftYear);
      const tag = off < 0.25
        ? ' · <b>đồng bộ Mặt Trời</b>'
        : (off > 6 ? ' · <b>mất đồng bộ hoàn toàn</b>' : '');
      readout.innerHTML =
        `Ở ${h.toLocaleString('vi-VN')} km (chu kỳ ${fmt(period, 1)} phút), đồng bộ đòi ` +
        `i = <b>${fmt(need, 2)}°</b>. Bạn chọn ${fmt(i, 2)}° → tuế sai ` +
        `<b>${fmt(rate, 4)} °/ngày</b> (cần 0,9856) · giờ chụp trôi ` +
        `<b>${fmt(Math.abs(driftHalf), 2)} giờ</b> sau nửa năm, ${fmt(Math.abs(driftYear), 2)} giờ mỗi năm${tag}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="quy-dao-dong-bo-mat-troi-nghieng-98-do"]').forEach(setup);
</script>
