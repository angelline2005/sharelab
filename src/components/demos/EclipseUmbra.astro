---
// Hình học nón bóng tối của Mặt Trăng khi nhật thực.
//   Đường kính góc:  theta = 2·arctan(R / d)          (rad → phút cung)
//   Chiều dài nón:   L = R_trăng · d_MT / (R_trời − R_trăng)
//     với d_MT = d(Trái Đất–Mặt Trời) − d(Trái Đất–Mặt Trăng): lúc sóc,
//     Mặt Trăng nằm giữa nên gần Mặt Trời hơn Trái Đất đúng một khoảng d_EM.
// Hằng số: R_trời = 695 700 km (IAU 2015), R_trăng = 1 737,4 km, R_đất = 6 371 km.
// Phạm vi trượt phủ đúng cận/viễn điểm thật của hai quỹ đạo (356 500–406 700 km;
// 147,1–152,1 triệu km); công thức tiếp tuyến ngoài đúng trên toàn dải đó.
// Cho ra L = 367 260–379 904 km, khớp dải 367 000–379 800 km trong tài liệu nhật thực.
---

<figure class="demo" data-demo="nhat-thuc-toan-phan-va-trung-hop-400-lan">
  <canvas></canvas>
  <div class="controls">
    <label>Khoảng cách Trái Đất–Mặt Trăng (km) <output data-out="m"></output>
      <input type="range" data-in="m" min="356500" max="406700" step="100" value="384400" /></label>
    <label>Khoảng cách Trái Đất–Mặt Trời (triệu km) <output data-out="s"></output>
      <input type="range" data-in="s" min="1471" max="1521" step="1" value="1496" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trên: mặt cắt nón bóng tối, hai tiếp tuyến ngoài từ mép Mặt Trời vòng qua
    mép Mặt Trăng khép lại ở đầu nón. Trục ngang đúng tỉ lệ km, trục dọc phóng
    đại khoảng 200 lần cho nhìn thấy được. Dải mờ là bề mặt Trái Đất: mép trái
    là điểm ngay dưới Mặt Trăng, mép phải là rìa đĩa — chênh nhau đúng một bán
    kính Trái Đất, 6 371 km. Dưới: hai đĩa vẽ đúng đường kính góc nhìn từ mặt
    đất. Đầu nón cắm qua dải mờ thì toàn phần, dừng trước nó thì vành khuyên.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CONE = '#2563eb', MARK = '#dc2626', SUN = '#f59e0b';
  const RS = 695700, RM = 1737.4, RE = 6371;
  const XMAX = 412000;

  const arcmin = (R: number, d: number) => (2 * Math.atan(R / d) * 180 / Math.PI) * 60;
  const umbra = (dES: number, dEM: number) => (RM * (dES - dEM)) / (RS - RM);
  const NUM = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  const D2 = (x: number) => x.toFixed(2).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const dEM = Number(input('m').value);
      const dES = Number(input('s').value) * 1e5;      // slider đếm theo 0,1 triệu km
      output('m').textContent = NUM(dEM);
      output('s').textContent = D2(dES / 1e6);

      const L = umbra(dES, dEM);
      const sNear = dEM - RE;                          // điểm dưới chân Mặt Trăng
      const gap = L - sNear;                           // >0: nón cắm qua mặt đất
      // Góc nhìn từ chính điểm ấy: gap ≥ 0 tương đương thMoon ≥ thSun, đúng tuyệt đối.
      const thSun = arcmin(RS, dES - RE), thMoon = arcmin(RM, sNear);
      const width = gap > 0 ? (2 * RM * gap) / L : 0;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.60);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padL = 30, padR = 14, padT = 16;
      const coneH = Math.round(cssH * 0.55), yAx = padT + coneH, yc = padT + coneH / 2;
      const YMAX = 2300;
      const X = (km: number) => padL + (km / XMAX) * (cssW - padL - padR);
      const Y = (r: number) => yc - (r / YMAX) * (coneH / 2 - 4);

      // Trục ngang và vạch chia khoảng cách.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, yAx); ctx.lineTo(cssW - padR, yAx); ctx.stroke();
      ctx.setLineDash([3, 4]);
      ctx.beginPath(); ctx.moveTo(padL, Y(0)); ctx.lineTo(cssW - padR, Y(0)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'center';
      for (const km of [100000, 200000, 300000, 400000]) {
        ctx.fillText(`${NUM(km)} km`, X(km), yAx + 14);
      }
      ctx.textAlign = 'left';
      ctx.fillText('1 737 km', padL + 3, Y(RM) - 4);
      ctx.globalAlpha = 1;

      // Dải mặt đất: từ điểm dưới chân Mặt Trăng tới rìa đĩa Trái Đất.
      ctx.fillStyle = fg; ctx.globalAlpha = 0.14;
      ctx.fillRect(X(sNear), padT, X(dEM) - X(sNear), coneH);
      ctx.globalAlpha = 0.5; ctx.textAlign = 'center';
      ctx.fillText('mặt đất', (X(sNear) + X(dEM)) / 2, padT + 10);
      ctx.globalAlpha = 1;

      // Nón bóng tối: hai tiếp tuyến ngoài khép về đầu nón tại x = L.
      ctx.fillStyle = CONE; ctx.globalAlpha = 0.18;
      ctx.beginPath();
      ctx.moveTo(X(0), Y(RM)); ctx.lineTo(X(L), Y(0)); ctx.lineTo(X(0), Y(-RM)); ctx.closePath(); ctx.fill();
      ctx.globalAlpha = 1; ctx.strokeStyle = CONE; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(X(0), Y(RM)); ctx.lineTo(X(L), Y(0)); ctx.lineTo(X(0), Y(-RM)); ctx.stroke();

      // Vùng nửa tối phía sau đầu nón (bóng vành khuyên) — nét đứt loe ra.
      ctx.strokeStyle = SUN; ctx.lineWidth = 1.5; ctx.setLineDash([4, 4]);
      const tail = (XMAX - L) * (RM / L);
      ctx.beginPath();
      ctx.moveTo(X(L), Y(0)); ctx.lineTo(X(XMAX), Y(tail));
      ctx.moveTo(X(L), Y(0)); ctx.lineTo(X(XMAX), Y(-tail));
      ctx.stroke(); ctx.setLineDash([]); ctx.lineWidth = 1;

      // Mặt Trăng và đầu nón.
      ctx.fillStyle = fg;
      ctx.fillRect(X(0) - 2, Y(RM), 5, Y(-RM) - Y(RM));
      ctx.globalAlpha = 0.6; ctx.textAlign = 'left';
      ctx.fillText('Mặt Trăng', X(0) + 6, Y(-RM) - 5);
      ctx.globalAlpha = 1;
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(L), Y(0), 5, 0, Math.PI * 2); ctx.fill();

      // Hai đĩa nhìn từ mặt đất, đúng tỉ lệ đường kính góc.
      const bandH = cssH - yAx - 18;
      const cx = cssW / 2, cy = yAx + 20 + bandH / 2;
      const rSun = Math.min(bandH / 2 - 2, cssH * 0.15);
      const rMoon = rSun * (thMoon / thSun);
      ctx.fillStyle = SUN;
      ctx.beginPath(); ctx.arc(cx, cy, rSun, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = fg;
      ctx.beginPath(); ctx.arc(cx, cy, rMoon, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.6; ctx.textAlign = 'right';
      ctx.fillText(`Mặt Trời ${D2(thSun)}′`, cx - rSun - 8, cy - 3);
      ctx.textAlign = 'left';
      ctx.fillText(`Mặt Trăng ${D2(thMoon)}′`, cx + rSun + 8, cy - 3);
      ctx.globalAlpha = 1;

      // Kết luận: nón vượt cả rìa đĩa → toàn phần khắp dải; hụt hẳn → vành khuyên.
      let verdict: string;
      if (gap >= RE) {
        verdict = `→ <b>nhật thực toàn phần</b>, dải toàn phần rộng ${NUM(width)} km`;
      } else if (gap > 0) {
        verdict = `→ <b>nhật thực lai</b>: toàn phần giữa dải (rộng ${NUM(width)} km), vành khuyên ở hai đầu`;
      } else {
        const open = 100 * (1 - (thMoon / thSun) ** 2);
        verdict = `→ <b>nhật thực vành khuyên</b>, còn hở ${D2(open)}% diện tích đĩa Mặt Trời`;
      }
      const tip = gap >= 0
        ? `cắm qua mặt đất ${NUM(gap)} km`
        : `hụt ${NUM(-gap)} km trên đỉnh đầu`;
      readout.innerHTML =
        `Đĩa Mặt Trời ${D2(thSun)}′ · đĩa Mặt Trăng ${D2(thMoon)}′ · nón bóng tối dài ` +
        `<b>${NUM(L)} km</b>, đầu nón ${tip} ${verdict}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="nhat-thuc-toan-phan-va-trung-hop-400-lan"]').forEach(setup);
</script>
