---
// Why metal "feels cold": it isn't colder, it conducts faster. The material
// slider sets thermal conductivity k; the sketch shows heat flux streaming
// from a 37°C hand into a 20°C slab, with flux arrows scaled by Fourier's
// q = k·ΔT/d. Everything at the same temperature — only k differs.
---

<figure class="demo" data-demo="conduction">
  <canvas></canvas>
  <div class="controls">
    <label>Vật liệu chạm vào <output data-out="mat"></output>
      <input type="range" data-in="mat" min="0" max="3" step="1" value="3" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Bàn tay 37 °C chạm vào vật 20 °C — bốn vật liệu CÙNG nhiệt độ. Mũi tên là
    dòng nhiệt rời khỏi da theo định luật Fourier; cảm giác "lạnh" của bạn là
    cảm biến đo dòng này, không phải đo nhiệt độ.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const MATS: [string, number][] = [
    ['xốp cách nhiệt', 0.03],
    ['gỗ', 0.15],
    ['gạch đá', 0.7],
    ['thép', 50],
  ];
  const HAND = '#dc2626', FLOW = '#f59e0b';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="mat"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="mat"]') as HTMLOutputElement;

    let phase = 0, raf = 0, last = 0;

    function draw() {
      const [name, k] = MATS[Number(slider.value)];
      out.textContent = `${name} (k = ${k} W/m·K)`;
      // Log-scaled arrow count so 0.03 → 50 stays drawable.
      const strength = (Math.log10(k) + 2) / 3.7; // 0..~1

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.38);
      if (canvas.width !== cssW * dpr) { canvas.width = cssW * dpr; canvas.height = cssH * dpr; canvas.style.height = `${cssH}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Hand (left, warm) and slab (right).
      const handW = cssW * 0.3, gap = cssW * 0.06, slabX = handW + gap;
      ctx.fillStyle = HAND; ctx.globalAlpha = 0.7;
      ctx.fillRect(10, cssH * 0.25, handW - 10, cssH * 0.5);
      ctx.globalAlpha = 1;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.5;
      ctx.font = '11px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('tay · 37 °C', handW / 2, cssH * 0.2);
      ctx.fillText(`${name} · 20 °C`, slabX + (cssW - slabX) / 2, cssH * 0.2);
      ctx.globalAlpha = 0.35;
      ctx.strokeStyle = fg;
      ctx.strokeRect(slabX, cssH * 0.25, cssW - slabX - 10, cssH * 0.5);
      ctx.globalAlpha = 1;

      // Heat-flux arrows crossing the gap, count and speed by strength.
      const rows = 1 + Math.round(strength * 4);
      for (let r = 0; r < rows; r++) {
        const y = cssH * (0.32 + (0.36 * (r + 0.5)) / rows);
        const prog = (phase * (0.4 + strength * 1.6) + r * 0.19) % 1;
        const x = handW - 6 + (gap + 24) * prog;
        ctx.strokeStyle = FLOW; ctx.fillStyle = FLOW;
        ctx.globalAlpha = 0.9; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(x - 12, y); ctx.lineTo(x, y); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(x + 5, y); ctx.lineTo(x - 2, y - 4); ctx.lineTo(x - 2, y + 4); ctx.fill();
        ctx.globalAlpha = 1; ctx.lineWidth = 1;
      }

      const rel = k / 0.15;
      readout.innerHTML =
        `Cùng 20 °C — nhưng ${name} rút nhiệt khỏi da ` +
        (rel >= 1 ? `nhanh gấp <b>${rel.toFixed(0)} lần</b> gỗ` : `chỉ bằng <b>${(rel * 100).toFixed(0)}%</b> gỗ`) +
        ` · cảm giác của bạn: <b>${k >= 10 ? 'lạnh buốt' : k >= 0.5 ? 'mát' : k >= 0.1 ? 'trung tính' : 'ấm'}</b>`;
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      phase += Math.min((now - last) / 1000, 0.05); last = now;
      draw();
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) { last = 0; raf = requestAnimationFrame(frame); }
        else cancelAnimationFrame(raf);
      }
    });
    io.observe(root);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="conduction"]').forEach(setup);
</script>
