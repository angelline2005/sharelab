---
// Second moment of area of a rectangle: I = b·h³/12 (mm⁴).
// Mid-span deflection of a simply supported beam, central point load:
//   δ(x) = F·x·(3L² − 4x²)/(48·E·I) for x ≤ L/2, symmetric beyond.
//   δ_max = F·L³/(48·E·I).
// Lateral-torsional buckling of a narrow rectangle, simply supported, central
// load at the centroid (Timoshenko, Theory of Elastic Stability):
//   P_cr = 16.94·√(E·I_y·G·J)/L², with J = β·h·b³,
//   β = (1/3)·[1 − 0.630(b/h) + 0.052(b/h)⁵], valid for h ≥ b.
// Fixed: F = 100 kg = 981 N, softwood E = 10 GPa, G ≈ E/16.
// Slider ranges keep the beam slender (L ≥ 8h) so Euler–Bernoulli holds and
// shear deflection stays under a few percent.
---

<figure class="demo" data-demo="dam-dat-dung-cung-gap-nam-lan">
  <canvas></canvas>
  <div class="controls">
    <label>Bề rộng tiết diện b (mm) <output data-out="b"></output>
      <input type="range" data-in="b" min="10" max="120" step="1" value="38" /></label>
    <label>Chiều cao tiết diện h (mm) <output data-out="h"></output>
      <input type="range" data-in="h" min="10" max="300" step="1" value="89" /></label>
    <label>Nhịp L (m) <output data-out="l"></output>
      <input type="range" data-in="l" min="0.5" max="6" step="0.1" value="2" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trái: cùng một tiết diện, dựng đứng và đặt nằm, vẽ đúng tỉ lệ. Vật liệu
    tô đậm theo bình phương khoảng cách tới trục trung hoà — phần xa trục
    làm gần hết việc, phần giữa gần như ngồi chơi. Phải: đường võng của
    dầm kê hai đầu, người 100 kg đứng giữa nhịp, gỗ thông E = 10 GPa.
    Đổi b và h mà giữ nguyên tích b·h là giữ nguyên khối lượng gỗ.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const EDGE = '#2563eb', FLAT = '#dc2626', LIMIT = '#f59e0b';
  const E = 10e9, G = 10e9 / 16, F = 100 * 9.81;

  const vn = (x: number, n: number) => x.toFixed(n).replace('.', ',');
  const group = (x: number) => Math.round(x).toLocaleString('vi-VN').replace(/\./g, ' ');
  // I of a rectangle, width w and height ht in mm, about the horizontal axis.
  const Imm = (w: number, ht: number) => (w * ht * ht * ht) / 12;
  const beta = (r: number) => (1 / 3) * (1 - 0.63 / r + 0.052 / Math.pow(r, 5));

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const b = Number(input('b').value);
      const h = Number(input('h').value);
      const L = Number(input('l').value);
      output('b').textContent = String(b);
      output('h').textContent = String(h);
      output('l').textContent = vn(L, 1);

      const Iedge = Imm(b, h), Iflat = Imm(h, b);      // mm⁴
      const defl = (I4: number, x: number) =>          // metres
        (F * x * (3 * L * L - 4 * x * x)) / (48 * E * I4 * 1e-12);
      const dEdge = (F * L ** 3) / (48 * E * Iedge * 1e-12) * 1000;  // mm
      const dFlat = (F * L ** 3) / (48 * E * Iflat * 1e-12) * 1000;  // mm
      const limit = (L * 1000) / 240;                                // mm
      const ratio = Iedge / Iflat;

      // Lateral-torsional buckling only threatens the upright section (h > b).
      let Pcr = Infinity;
      if (h > b) {
        const B = b / 1000, H = h / 1000;
        const Iy = (H * B * B * B) / 12, J = beta(h / b) * H * B * B * B;
        Pcr = (16.94 * Math.sqrt(E * Iy * G * J)) / (L * L);
      }

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padT = 14, padB = 26;
      const leftW = Math.min(190, Math.round(cssW * 0.36));

      // ---------- left panel: the two cross-sections, one common scale ----------
      const secTop = padT + 2, secBot = cssH - padB;
      const availH = secBot - secTop - 36, availW = leftW - 24;
      const s = Math.min(availW / Math.max(b, h), availH / (b + h));
      const cx = leftW / 2;

      function section(w: number, ht: number, top: number, color: string, label: string) {
        const px = cx - (w * s) / 2, py = top, pw = w * s, ph = ht * s;
        const N = 26;
        for (let i = 0; i < N; i++) {
          const yc = ((i + 0.5) / N - 0.5) * ph;          // px from neutral axis
          const a = 0.10 + 0.85 * Math.pow(Math.abs(yc) / (ph / 2), 2);
          ctx.globalAlpha = a; ctx.fillStyle = color;
          ctx.fillRect(px, py + (i * ph) / N, pw, ph / N + 0.6);
        }
        ctx.globalAlpha = 1;
        ctx.strokeStyle = color; ctx.strokeRect(px + 0.5, py + 0.5, pw, ph);
        ctx.setLineDash([3, 3]); ctx.strokeStyle = fg; ctx.globalAlpha = 0.6;
        ctx.beginPath(); ctx.moveTo(px - 6, py + ph / 2); ctx.lineTo(px + pw + 6, py + ph / 2); ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = 0.75; ctx.fillStyle = fg; ctx.textAlign = 'center';
        ctx.fillText(label, cx, py - 4);
        ctx.globalAlpha = 1;
      }

      const topEdge = secTop + 12;
      section(b, h, topEdge, EDGE, `dựng đứng · I = ${group(Iedge)} mm⁴`);
      section(h, b, topEdge + h * s + 24, FLAT, `đặt nằm · I = ${group(Iflat)} mm⁴`);

      // ---------- right panel: the two deflection curves ----------
      const padL = leftW + 44, padR = cssW < 420 ? 26 : 12;
      const nice = (v: number) => {
        const p = Math.pow(10, Math.floor(Math.log10(v)));
        for (const m of [1, 2, 5, 10]) if (v <= m * p) return m * p;
        return 10 * p;
      };
      const dMax = nice(Math.max(dFlat, limit * 1.2, 0.1));
      const X = (x: number) => padL + (x / L) * (cssW - padL - padR);
      const Y = (d: number) => padT + (d / dMax) * (cssH - padT - padB);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(cssW - padR, padT); ctx.stroke();
      ctx.globalAlpha = 0.6; ctx.fillStyle = fg; ctx.textAlign = 'right';
      for (let k = 0; k <= 4; k++) {
        const d = (dMax * k) / 4;
        ctx.fillText(k === 0 ? '0' : vn(d, dMax < 4 ? 1 : 0), padL - 5, Y(d) + 3);
      }
      ctx.textAlign = 'center';
      for (const x of [0, L / 2, L]) ctx.fillText(`${vn(x, 1)} m`, X(x), cssH - padB + 14);
      ctx.textAlign = 'left';
      ctx.fillText('độ võng (mm) — dầm chưa tải là đường trên cùng', padL + 6, padT + 12);
      ctx.globalAlpha = 1;

      // serviceability limit L/240
      if (limit <= dMax) {
        ctx.strokeStyle = LIMIT; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(padL, Y(limit)); ctx.lineTo(cssW - padR, Y(limit)); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = LIMIT; ctx.textAlign = 'right';
        ctx.fillText(`L/240 = ${vn(limit, 1)} mm`, cssW - padR, Y(limit) - 4);
      }

      for (const [I4, col] of [[Iflat, FLAT], [Iedge, EDGE]] as Array<[number, string]>) {
        ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.beginPath();
        for (let i = 0; i <= 120; i++) {
          const x = (L * i) / 120;
          const d = Math.min(defl(I4, Math.min(x, L - x)) * 1000, dMax * 1.02);
          i ? ctx.lineTo(X(x), Y(d)) : ctx.moveTo(X(x), Y(d));
        }
        ctx.stroke(); ctx.lineWidth = 1;
      }
      ctx.fillStyle = EDGE; ctx.beginPath(); ctx.arc(X(L / 2), Y(Math.min(dEdge, dMax)), 4.5, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = FLAT; ctx.beginPath(); ctx.arc(X(L / 2), Y(Math.min(dFlat, dMax)), 4.5, 0, Math.PI * 2); ctx.fill();

      // ---------- readout ----------
      // Bending stress σ = M·c/I with M = F·L/4; softwood breaks near 40 MPa,
      // beyond which the elastic deflection formula describes nothing real.
      const M = (F * L) / 4, SIG = 40e6;
      const sEdge = (M * (h / 2000)) / (Iedge * 1e-12);
      const sFlat = (M * (b / 2000)) / (Iflat * 1e-12);

      const head = `Tiết diện ${b} × ${h} mm · nhịp ${vn(L, 1)} m · tải 100 kg giữa nhịp → `;
      if (sEdge > SIG) {
        readout.innerHTML = head +
          `xoay đứng vẫn cứng gấp <b>${vn(ratio, 2)} lần</b>, nhưng ứng suất uốn ` +
          `<b>${vn(sEdge / 1e6, 0)} MPa</b> vượt sức bền gỗ ~40 MPa: ` +
          `<b>thanh gãy, công thức độ võng hết hiệu lực</b>`;
      } else {
        let note: string;
        if (Pcr < F)
          note = ` · <b>oằn lật ngang ở ${group(Pcr)} N (${vn(Pcr / 9.81, 0)} kg) — lật trước khi chịu nổi tải, phải giằng</b>`;
        else if (dEdge > limit)
          note = ` · dựng đứng vẫn vượt giới hạn võng L/240 = ${vn(limit, 1)} mm`;
        else
          note = ` · dựng đứng đạt giới hạn võng L/240 = ${vn(limit, 1)} mm`;
        const flatStr = sFlat > SIG
          ? `<b>gãy (${vn(sFlat / 1e6, 0)} MPa > 40)</b>`
          : `võng <b>${vn(dFlat, 1)} mm</b>`;
        readout.innerHTML = head +
          `đặt nằm ${flatStr}, dựng đứng võng <b>${vn(dEdge, 1)} mm</b> ` +
          `(cứng gấp <b>${vn(ratio, ratio >= 100 ? 0 : 2)} lần</b>)${note}`;
      }
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dam-dat-dung-cung-gap-nam-lan"]').forEach(setup);
</script>
