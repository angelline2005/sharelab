---
// Hyperfocal distance: H = f²/(N·c). When focused at H, depth of field extends
// from H/2 to infinity. Valid for ordinary photography (not macro). Sources: Ray
// (1992), Kerr (2000). DOF and CoC calculations follow standard lens theory.
---

<figure class="demo" data-demo="khoang-cach-sieu-tieu-va-do-sau-truong-anh">
  <canvas></canvas>
  <div class="controls">
    <label>Tiêu cự f (mm) <output data-out="f"></output>
      <input type="range" data-in="f" min="4" max="200" step="0.5" value="50" /></label>
    <label>Khẩu độ N <output data-out="n"></output>
      <input type="range" data-in="n" min="1.4" max="22" step="0.1" value="8" /></label>
    <label>Vòng mờ c (mm) <output data-out="c"></output>
      <input type="range" data-in="c" min="0.003" max="0.033" step="0.001" value="0.030" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trục hoành là khoảng cách lấy nét theo thang log. Dải màu xanh lá ghi vùng nét
    (từ cận giới hạn tới viễn giới hạn) khi lấy nét tại khoảng cách siêu tiêu H.
    Đường cong dưới là đường kính vòng mờ theo khoảng cách; khi nó vượt ngưỡng c,
    ảnh trở nên mờ. Smartphone với c rất nhỏ nên H cũng nhỏ, và luôn nét ở khoảng
    cách thường ngày — nó buộc phải xoá phông bằng điều chỉnh hậu kỳ.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', DOF = '#10b981', THRESHOLD = '#f59e0b';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    // Compute circle of confusion and hyperfocal distance
    const computeCoC = (d: number, f: number, N: number, H: number) => {
      if (Math.abs(d - H) < 0.001) return 0;
      const m = f / H; // magnification ratio
      return (2 * (N * 0.030 / (1 + H / f)) * Math.abs(d - H)) / d / 1000; // normalized to c=0.030
    };

    function draw() {
      const f = Number(input('f').value);
      const N = Number(input('n').value);
      const c = Number(input('c').value);

      // Output current values
      output('f').textContent = f.toFixed(1).replace('.', ',');
      output('n').textContent = 'f/' + N.toFixed(1).replace('.', ',');
      output('c').textContent = (c * 1000).toFixed(2).replace('.', ',') + ' µm';

      // Hyperfocal distance (in meters)
      const H = (f * f) / (N * c) / 1000;
      const nearLimit = H / 2;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32;
      const cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 48, padB = 32, padT = 16, padR = 12;
      const plotW = cssW - padL - padR;
      const plotH = cssH - padB - padT;

      // Log scale: 0.3 to 100+ meters (log10: -0.52 to 2)
      const logMin = Math.log10(0.3);
      const logMax = Math.log10(100);
      const X = (d: number) => {
        const logD = d >= 100 ? logMax + 0.3 : Math.log10(Math.max(0.3, d));
        return padL + ((logD - logMin) / (logMax + 0.3 - logMin)) * plotW;
      };

      // Y scales: top half for DOF indicator, bottom half for CoC curve
      const dofY = padT + plotH * 0.35;
      const cocPlotH = plotH * 0.65;
      const cocMax = 0.15; // in mm, for visualization
      const CocY = (cocMm: number) => {
        const cssH_coc = padT + plotH - (cocMm / cocMax) * cocPlotH;
        return Math.max(padT + plotH * 0.4, cssH_coc);
      };

      // Draw axes
      ctx.strokeStyle = fg;
      ctx.globalAlpha = 0.3;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padL, padT);
      ctx.lineTo(padL, cssH - padB);
      ctx.lineTo(cssW - padR, cssH - padB);
      ctx.stroke();

      // Draw axis labels and ticks
      ctx.globalAlpha = 0.55;
      ctx.fillStyle = fg;
      ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';

      // Distance labels on x-axis
      const distLabels = [
        [0.3, '0,3 m'],
        [1, '1 m'],
        [3, '3 m'],
        [10, '10 m'],
        [30, '30 m'],
        [100, '100 m'],
      ];
      for (const [d, label] of distLabels) {
        const xx = X(d);
        ctx.fillText(label, xx, cssH - padB + 14);
      }

      // Add infinity marker
      ctx.textAlign = 'right';
      ctx.fillText('∞', cssW - padR - 2, cssH - padB + 14);

      ctx.textAlign = 'right';
      ctx.fillStyle = fg;

      // Right side CoC scale labels
      for (const coc_mm of [0, 0.05, 0.1, 0.15]) {
        ctx.fillText(
          (coc_mm * 1000).toFixed(0) + ' µm',
          padL - 4,
          CocY(coc_mm) + 3
        );
      }
      ctx.globalAlpha = 1;

      // Draw DOF band (top section)
      if (H < 200) {
        ctx.fillStyle = DOF;
        ctx.globalAlpha = 0.4;
        ctx.fillRect(X(nearLimit), dofY - 8, X(200) - X(nearLimit), 16);
        ctx.globalAlpha = 1;
        ctx.strokeStyle = DOF;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(X(nearLimit), dofY);
        ctx.lineTo(X(Math.min(200, H * 2)), dofY);
        ctx.stroke();
      }

      // Draw CoC curve
      ctx.strokeStyle = CURVE;
      ctx.lineWidth = 2;
      ctx.beginPath();
      let first = true;
      for (let i = 0; i <= 150; i++) {
        const d = 0.3 * Math.pow(100 / 0.3, i / 150);
        const coc_actual = (c / 0.030) * computeCoC(d, f, N, H); // scale to actual c
        const y = CocY(coc_actual);
        if (first) {
          ctx.moveTo(X(d), y);
          first = false;
        } else {
          ctx.lineTo(X(d), y);
        }
      }
      ctx.stroke();
      ctx.lineWidth = 1;

      // Draw threshold line at c
      ctx.strokeStyle = THRESHOLD;
      ctx.globalAlpha = 0.7;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(padL, CocY(c));
      ctx.lineTo(cssW - padR, CocY(c));
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;

      // Mark hyperfocal distance
      ctx.fillStyle = MARK;
      ctx.beginPath();
      ctx.arc(X(H), dofY, 5, 0, Math.PI * 2);
      ctx.fill();

      // Readout
      readout.innerHTML =
        `<b>${f.toFixed(1).replace('.', ',')} mm · f/${N.toFixed(1).replace('.', ',')} · c = ${(c * 1000).toFixed(2).replace('.', ',')} µm</b> → H = ${H.toFixed(2).replace('.', ',')} m<br>` +
        `lấy nét ở H: nét từ ${nearLimit.toFixed(2).replace('.', ',')} m tới ∞`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }

  document.querySelectorAll<HTMLElement>('[data-demo="khoang-cach-sieu-tieu-va-do-sau-truong-anh"]').forEach(setup);
</script>
