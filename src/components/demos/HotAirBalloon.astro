---
// Hot-air balloon lift: air density from the ideal gas law ρ = PM/RT; lift is
// Archimedes in air, (ρ_out − ρ_in)·V. Outside air fixed at 20 °C, sea level.
// Sliders: inside temperature and envelope volume. Static redraw.
---

<figure class="demo" data-demo="balloon">
  <canvas></canvas>
  <div class="controls">
    <label>Nhiệt độ khí trong khoang T (°C) <output data-out="t"></output>
      <input type="range" data-in="t" min="20" max="120" step="1" value="100" /></label>
    <label>Thể tích vỏ khí cầu V (m³) <output data-out="v"></output>
      <input type="range" data-in="v" min="500" max="5000" step="50" value="2800" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Không khí ngoài 20 °C nặng 1,204 kg/m³. Hơ nóng khí trong khoang là làm
    nó loãng đi — phần chênh khối lượng ấy, nhân thể tích, chính là sức nâng
    Archimedes. Vỏ + giỏ + bình gas ăn mất ~250 kg; còn lại chở người (80 kg/người).
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const RHO = (Tc: number) => (101325 * 0.028964) / (8.314 * (Tc + 273.15));
  const RIG_KG = 250, PAX_KG = 80, T_OUT = 20;
  const ENV = '#f59e0b', HOT = '#dc2626', BASKET = '#2563eb';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const T = Number(input('t').value), V = Number(input('v').value);
      output('t').textContent = String(T);
      output('v').textContent = V.toLocaleString('vi-VN');
      const dRho = RHO(T_OUT) - RHO(T);
      const gross = dRho * V;
      const net = gross - RIG_KG;
      const pax = Math.max(0, Math.floor(net / PAX_KG));

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.44);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const cx = cssW / 2;
      const R = (cssH * 0.26) * Math.cbrt(V / 2800);
      const by = cssH * 0.06 + R;

      // Envelope, tinted hotter with temperature.
      const heat = (T - 20) / 100;
      ctx.fillStyle = HOT; ctx.globalAlpha = 0.15 + heat * 0.55;
      ctx.beginPath(); ctx.arc(cx, by, R, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = ENV; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(cx, by, R, 0, Math.PI * 2); ctx.stroke();
      ctx.lineWidth = 1;

      // Basket and lines.
      const gy = Math.min(cssH - 24, by + R + cssH * 0.16);
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.6;
      ctx.beginPath(); ctx.moveTo(cx - R * 0.5, by + R * 0.85); ctx.lineTo(cx - 14, gy); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cx + R * 0.5, by + R * 0.85); ctx.lineTo(cx + 14, gy); ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.fillStyle = BASKET; ctx.globalAlpha = 0.8;
      ctx.fillRect(cx - 16, gy, 32, 20);
      ctx.globalAlpha = 1;

      // Passenger count as dots by the basket.
      ctx.fillStyle = fg; ctx.globalAlpha = 0.7;
      for (let i = 0; i < Math.min(pax, 8); i++) {
        ctx.beginPath(); ctx.arc(cx + 26 + (i % 4) * 11, gy + 5 + Math.floor(i / 4) * 11, 4, 0, Math.PI * 2); ctx.fill();
      }
      ctx.font = '10px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(`ρ trong = ${RHO(T).toFixed(3).replace('.', ',')} kg/m³`, cx, by + 4);
      ctx.globalAlpha = 1;

      const verdict = net < 80 ? ' — <b>chưa đủ chở nổi một người</b>' : ` — chở được <b>${pax} người</b>`;
      readout.innerHTML =
        `Δρ = <b>${dRho.toFixed(3).replace('.', ',')} kg/m³</b> · sức nâng thô ` +
        `<b>${gross.toFixed(0)} kg</b> · trừ vỏ+giỏ+gas 250 kg: còn ${Math.max(0, net).toFixed(0)} kg${verdict}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="balloon"]').forEach(setup);
</script>
