---
// Heating curve of 1 kg of water on a 1000 W burner, from −20 °C ice to the
// last drop boiled away. Piecewise closed form: warm ice (42 s), melt (334 s),
// warm water (419 s), boil off (2260 s). Slider scrubs time. Static redraw.
---

<figure class="demo" data-demo="latent-heat">
  <canvas></canvas>
  <div class="controls">
    <label>Thời gian đun t (s) <output data-out="t"></output>
      <input type="range" data-in="t" min="0" max="3055" step="5" value="400" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    1 kg nước đá −20 °C trên bếp 1000 W (hấp thụ trọn). Hai đoạn nằm ngang là
    lúc nhiệt kế "chết đứng": năng lượng vẫn rót vào đều đặn nhưng dồn hết cho
    việc bẻ liên kết — nhiệt ẩn nóng chảy rồi nhiệt ẩn hoá hơi.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  // 1 kg, 1000 W: segment boundaries in seconds.
  const T1 = 41.8, T2 = T1 + 334, T3 = T2 + 418.6, T4 = T3 + 2260;
  const CURVE = '#2563eb', MARK = '#dc2626', PLATEAU = '#f59e0b';

  function tempAt(t: number): number {
    if (t <= T1) return -20 + (20 * t) / T1;
    if (t <= T2) return 0;
    if (t <= T3) return (100 * (t - T2)) / (T3 - T2);
    return 100;
  }
  function stateAt(t: number): string {
    if (t <= T1) return 'nước đá đang ấm lên';
    if (t <= T2) return `đang tan — ${(((t - T1) / 334) * 100).toFixed(0)}% đã thành nước, nhiệt kế đứng im`;
    if (t <= T3) return 'nước lỏng đang nóng lên';
    if (t < T4) return `đang sôi — ${(((t - T3) / 2260) * 100).toFixed(0)}% đã bay hơi, nhiệt kế vẫn đứng im`;
    return 'cạn nồi';
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="t"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="t"]') as HTMLOutputElement;

    function draw() {
      const t = Number(slider.value);
      out.textContent = String(t);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.44);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 40, padB = 26, padT = 12, padR = cssW < 420 ? 26 : 10;
      const X = (s: number) => padL + (s / T4) * (cssW - padL - padR);
      const Y = (c: number) => cssH - padB - ((c + 20) / 140) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif'; ctx.textAlign = 'right';
      for (const c of [-20, 0, 100]) ctx.fillText(`${c}°`, padL - 4, Y(c) + 3);
      ctx.textAlign = 'center';
      for (const s of [500, 1500, 2500]) ctx.fillText(`${s}s`, X(s), cssH - padB + 14);
      ctx.globalAlpha = 1;

      // Plateau highlights.
      ctx.fillStyle = PLATEAU; ctx.globalAlpha = 0.15;
      ctx.fillRect(X(T1), padT, X(T2) - X(T1), cssH - padB - padT);
      ctx.fillRect(X(T3), padT, X(T4) - X(T3), cssH - padB - padT);
      ctx.globalAlpha = 0.7; ctx.fillStyle = fg; ctx.textAlign = 'center';
      ctx.fillText('tan (334 s)', (X(T1) + X(T2)) / 2, padT + 12);
      ctx.fillText('sôi cạn (2260 s)', (X(T3) + X(T4)) / 2, padT + 12);
      ctx.globalAlpha = 1;

      // Heating curve.
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 400; i++) {
        const s = (T4 * i) / 400;
        i ? ctx.lineTo(X(s), Y(tempAt(s))) : ctx.moveTo(X(s), Y(tempAt(s)));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Marker.
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(t), Y(tempAt(t)), 5, 0, Math.PI * 2); ctx.fill();

      readout.innerHTML =
        `t = ${t} s: nhiệt độ <b>${tempAt(t).toFixed(1).replace('.', ',')} °C</b> — ${stateAt(t)}` +
        ` · đã rót vào <b>${(t).toLocaleString('vi-VN')} kJ</b>`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="latent-heat"]').forEach(setup);
</script>
