---
// Cân bằng công suất của xe máy chạy đều trên đường bằng:
//   P_cản  = (C_lăn·m·g + ½·ρ·C_dA·v²)·v        [W]
//   P_xăng = (L_100/100)·v·LHV/3600             [W]   (L_100 tính L/100 km, v tính km/h)
//   η = P_cản / P_xăng
// Hằng số dùng trong demo: C_lăn = 0,025 (lốp xe máy trên nhựa khô),
// ρ = 1,18 kg/m³ (không khí ~30 °C, mặt biển), C_dA = 0,66 m² (người ngồi
// thẳng trên xe tay ga), LHV xăng = 32,3 MJ/L (43,4 MJ/kg × 0,745 kg/L).
// Nguồn: mô hình road-load tiêu chuẩn (SAE J2263 / ECE R83), LHV theo US DOE.
// Chỉ đúng cho chạy đều, đường bằng, lặng gió, không tăng tốc, 20–90 km/h.
---

<figure class="demo" data-demo="xe-may-muoi-lam-phan-tram-xang-huu-ich">
  <canvas></canvas>
  <div class="controls">
    <label>Tốc độ đều (km/h) <output data-out="v"></output>
      <input type="range" data-in="v" min="20" max="90" step="0.2" value="40" /></label>
    <label>Mức tiêu thụ (L/100 km) <output data-out="l"></output>
      <input type="range" data-in="l" min="1.5" max="4" step="0.1" value="2" /></label>
    <label>Khối lượng xe + người (kg) <output data-out="m"></output>
      <input type="range" data-in="m" min="120" max="350" step="5" value="200" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường cam là công suất hoá học của xăng bạn đang đốt; đường xanh là công
    suất thật sự dùng để thắng ma sát lốp và không khí. Khoảng cách giữa hai
    đường — mảng tô nhạt — là nhiệt bạn chở theo suốt quãng đường. Đường xanh
    đứt nét là phần ma sát lăn: chỗ nó cắt nửa đường xanh liền chính là tốc độ
    mà gió bắt đầu tốn hơn lốp.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', FUEL = '#f59e0b';
  const G = 9.81, RHO = 1.18, CDA = 0.66, CR = 0.025, LHV = 32.3e6;
  const B = 0.5 * RHO * CDA;
  const VMIN = 20, VMAX = 90;

  const ms = (kmh: number) => kmh / 3.6;
  const fRoll = (m: number) => CR * m * G;
  const fAero = (kmh: number) => B * ms(kmh) * ms(kmh);
  const pRoad = (kmh: number, m: number) => (fRoll(m) + fAero(kmh)) * ms(kmh);
  const pFuel = (kmh: number, L: number) => ((L / 100) * kmh * LHV) / 3600;
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function niceStep(raw: number) {
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    const n = raw / p;
    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * p;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const v = Number(input('v').value);
      const L = Number(input('l').value);
      const m = Number(input('m').value);
      const vTxt = Number.isInteger(v) ? String(v) : vn(v, 1);
      output('v').textContent = vTxt;
      output('l').textContent = vn(L, 1);
      output('m').textContent = String(m);

      const roll = fRoll(m), aero = fAero(v);
      const road = pRoad(v, m), fuel = pFuel(v, L);
      const eta = (100 * road) / fuel;
      const waste = fuel - road;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.52);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 46, padB = 26, padT = 26, padR = 10;
      const top = Math.max(pFuel(VMAX, L), pRoad(VMAX, 350)) / 1000;
      const step = niceStep(top / 5);
      const yMax = Math.ceil(top / step) * step;
      const X = (kmh: number) => padL + ((kmh - VMIN) / (VMAX - VMIN)) * (cssW - padL - padR);
      const Y = (kW: number) => cssH - padB - (kW / yMax) * (cssH - padB - padT);

      // Mảng nhiệt thải: giữa đường xăng và đường cản đường.
      ctx.beginPath();
      for (let i = 0; i <= 140; i++) {
        const vv = VMIN + ((VMAX - VMIN) * i) / 140;
        const y = Y(pFuel(vv, L) / 1000);
        i ? ctx.lineTo(X(vv), y) : ctx.moveTo(X(vv), y);
      }
      for (let i = 140; i >= 0; i--) {
        const vv = VMIN + ((VMAX - VMIN) * i) / 140;
        ctx.lineTo(X(vv), Y(pRoad(vv, m) / 1000));
      }
      ctx.closePath();
      ctx.fillStyle = FUEL; ctx.globalAlpha = 0.13; ctx.fill();

      // Mảng công có ích: dưới đường cản đường.
      ctx.beginPath();
      ctx.moveTo(X(VMIN), Y(0));
      for (let i = 0; i <= 140; i++) {
        const vv = VMIN + ((VMAX - VMIN) * i) / 140;
        ctx.lineTo(X(vv), Y(pRoad(vv, m) / 1000));
      }
      ctx.lineTo(X(VMAX), Y(0)); ctx.closePath();
      ctx.fillStyle = CURVE; ctx.globalAlpha = 0.22; ctx.fill();
      ctx.globalAlpha = 1;

      // Trục và vạch chia.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB);
      ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const k of [20, 40, 60, 80]) ctx.fillText(`${k} km/h`, X(k), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (let p = step; p <= yMax + 1e-9; p += step) {
        ctx.fillText(`${Number.isInteger(p) ? p : vn(p, 1)} kW`, padL - 4, Y(p) + 3);
      }
      ctx.globalAlpha = 1;

      // Đường công suất xăng (cam) — tuyến tính vì L/100 km giữ cố định.
      ctx.strokeStyle = FUEL; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(X(VMIN), Y(pFuel(VMIN, L) / 1000));
      ctx.lineTo(X(VMAX), Y(pFuel(VMAX, L) / 1000));
      ctx.stroke();

      // Đường ma sát lăn (xanh đứt nét).
      ctx.strokeStyle = CURVE; ctx.globalAlpha = 0.45; ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(X(VMIN), Y((roll * ms(VMIN)) / 1000));
      ctx.lineTo(X(VMAX), Y((roll * ms(VMAX)) / 1000));
      ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // Đường cản đường tổng (xanh liền).
      ctx.strokeStyle = CURVE; ctx.beginPath();
      for (let i = 0; i <= 200; i++) {
        const vv = VMIN + ((VMAX - VMIN) * i) / 200;
        const y = Y(pRoad(vv, m) / 1000);
        i ? ctx.lineTo(X(vv), y) : ctx.moveTo(X(vv), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Cột nhiệt thải tại tốc độ đang chọn.
      ctx.strokeStyle = MARK; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(X(v), Y(road / 1000)); ctx.lineTo(X(v), Y(fuel / 1000)); ctx.stroke();
      ctx.lineWidth = 1;
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(v), Y(road / 1000), 5, 0, Math.PI * 2); ctx.fill();

      ctx.textAlign = X(v) > cssW * 0.6 ? 'right' : 'left';
      const dx = X(v) > cssW * 0.6 ? -8 : 8;
      ctx.fillText(`nhiệt thải ${vn(waste / 1000, 2)} kW`, X(v) + dx, (Y(road / 1000) + Y(fuel / 1000)) / 2);

      // Chú giải.
      ctx.font = '10px system-ui,sans-serif'; ctx.textAlign = 'left';
      ctx.fillStyle = FUEL; ctx.fillText('công suất xăng đốt', padL + 4, padT - 14);
      ctx.fillStyle = CURVE; ctx.fillText('công đẩy xe (cản đường)', padL + 4, padT - 3);

      const regime = Math.abs(aero - roll) / roll < 0.02
        ? '<b>điểm hoà</b>: lốp và gió cản ngang nhau'
        : aero > roll
          ? `<b>vùng gió trội</b> (gió ${vn(aero, 0)} N &gt; lăn ${vn(roll, 0)} N)`
          : `<b>vùng lốp trội</b> (lăn ${vn(roll, 0)} N &gt; gió ${vn(aero, 0)} N)`;
      readout.innerHTML =
        `${vTxt} km/h · ${vn(L, 1)} L/100 km · ${m} kg → xăng <b>${vn(fuel / 1000, 2)} kW</b>,` +
        ` cản đường <b>${vn(road / 1000, 2)} kW</b> (${vn(roll, 0)} N lăn + ${vn(aero, 0)} N gió)` +
        ` → η = <b>${vn(eta, 1)}%</b>, nhiệt thải ${vn(waste / 1000, 2)} kW · ${regime}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="xe-may-muoi-lam-phan-tram-xang-huu-ich"]').forEach(setup);
</script>
