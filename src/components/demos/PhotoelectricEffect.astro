---
// The photoelectric effect, Einstein 1905: E_k = hf − A. The wavelength slider
// crosses the threshold where electrons stop coming out entirely; the
// intensity slider changes how MANY come out but never how fast — the two
// facts classical wave physics could not explain. Sodium cathode, A = 2.28 eV.
---

<figure class="demo" data-demo="photoelectric">
  <canvas></canvas>
  <div class="controls">
    <label>Bước sóng ánh sáng <output data-out="lam"></output>
      <input type="range" data-in="lam" min="200" max="700" step="1" value="400" /></label>
    <label>Cường độ chùm sáng <output data-out="i"></output>
      <input type="range" data-in="i" min="1" max="10" step="1" value="5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Tấm kim loại natri, công thoát A = 2,28 eV. Mỗi photon một electron —
    hoặc đủ tiền chuộc thì bứt ra ngay, hoặc thiếu thì không gì xảy ra, chiếu
    mạnh đến đâu và lâu đến đâu cũng vậy.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const H_EV = 4.1357e-15; // eV·s
  const C = 3e8;
  const A_WORK = 2.28; // eV, sodium
  const ELECTRON = '#dc2626';

  // Rough wavelength → display colour.
  function lamColour(nm: number) {
    if (nm < 380) return '#a78bfa'; // UV, shown violet-ish
    if (nm < 450) return '#7c3aed';
    if (nm < 495) return '#2563eb';
    if (nm < 570) return '#16a34a';
    if (nm < 590) return '#eab308';
    if (nm < 620) return '#f97316';
    return '#dc2626';
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    let phase = 0, raf = 0, last = 0;

    function draw() {
      const lam = Number(input('lam').value);
      const inten = Number(input('i').value);
      output('lam').textContent = `${lam} nm${lam < 380 ? ' (tử ngoại)' : ''}`;
      output('i').textContent = `${inten}`;

      const eV = (H_EV * C) / (lam * 1e-9);
      const ek = eV - A_WORK;
      const emits = ek > 0;
      const lam0 = (H_EV * C) / A_WORK * 1e9; // threshold wavelength

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.42);
      if (canvas.width !== cssW * dpr) { canvas.width = cssW * dpr; canvas.height = cssH * dpr; canvas.style.height = `${cssH}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Metal plate on the left.
      const plateX = cssW * 0.22;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.35;
      ctx.fillRect(plateX - 8, cssH * 0.15, 8, cssH * 0.7);
      ctx.globalAlpha = 0.6; ctx.font = '11px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('Na', plateX - 4, cssH * 0.1);
      ctx.globalAlpha = 1;

      // Incoming photons: count ∝ intensity, colour by wavelength.
      const pc = lamColour(lam);
      for (let k = 0; k < inten; k++) {
        const y = cssH * (0.2 + (0.6 * (k + 0.5)) / inten);
        const prog = (phase * 1.2 + k * 0.13) % 1;
        const x = cssW - (cssW - plateX) * prog;
        ctx.strokeStyle = pc; ctx.globalAlpha = 0.85;
        // little wavy arrow
        ctx.beginPath();
        for (let s = 0; s <= 16; s++) {
          const xx = x + s * 2.2, yy = y + Math.sin(s * 1.4 + phase * 10) * 3;
          s ? ctx.lineTo(xx, yy) : ctx.moveTo(xx, yy);
        }
        ctx.stroke(); ctx.globalAlpha = 1;
      }

      // Ejected electrons: only past threshold, speed ∝ √Ek.
      if (emits) {
        const speed = Math.sqrt(ek);
        for (let k = 0; k < inten; k++) {
          const y = cssH * (0.2 + (0.6 * (k + 0.5)) / inten);
          const prog = (phase * (0.35 + 0.4 * speed) + k * 0.17) % 1;
          const x = plateX + (cssW * 0.7) * prog;
          ctx.fillStyle = ELECTRON;
          ctx.beginPath(); ctx.arc(x, y + 6, 3.5, 0, Math.PI * 2); ctx.fill();
        }
      }

      readout.innerHTML =
        `Photon ${lam} nm mang <b>${eV.toFixed(2)} eV</b> · công thoát 2,28 eV → ` +
        (emits
          ? `electron bay ra với động năng cực đại <b>${ek.toFixed(2)} eV</b>; tăng cường độ chỉ tăng <b>số lượng</b>, không tăng tốc độ.`
          : `<b>không electron nào bật ra</b> — thiếu ${(-ek).toFixed(2)} eV mỗi photon, và ${inten} photon thiếu không góp chung được. Ngưỡng: <b>${lam0.toFixed(0)} nm</b>.`);
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      phase += Math.min((now - last) / 1000, 0.05); last = now;
      draw();
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) { last = 0; raf = requestAnimationFrame(frame); }
        else cancelAnimationFrame(raf);
      }
    });
    io.observe(root);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="photoelectric"]').forEach(setup);
</script>
