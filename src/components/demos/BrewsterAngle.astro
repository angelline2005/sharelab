---
// Fresnel reflectance for the two polarizations, air → medium of index n.
// Rs never dies; Rp hits exactly zero at Brewster's angle tanθ_B = n. Sliders
// for incidence angle and index; both curves drawn from the closed forms.
---

<figure class="demo" data-demo="brewster">
  <canvas></canvas>
  <div class="controls">
    <label>Góc tới θ (°) <output data-out="th"></output>
      <input type="range" data-in="th" min="0" max="89" step="0.5" value="45" /></label>
    <label>Chiết suất n <output data-out="n"></output>
      <input type="range" data-in="n" min="1.2" max="2.5" step="0.01" value="1.5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Phần trăm ánh sáng bị mặt phân cách hắt lại, tách theo hai phương phân
    cực. Đường xanh (dao động trong mặt phẳng tới) chạm đáy <em>bằng không</em>
    tại góc Brewster — góc mà tia phản xạ và tia khúc xạ vuông góc nhau.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const SCOL = '#dc2626', PCOL = '#2563eb', BREW = '#f59e0b';

  // Air → n. Returns [Rs, Rp].
  function fresnel(thDeg: number, n: number): [number, number] {
    const th = (thDeg * Math.PI) / 180;
    const tht = Math.asin(Math.sin(th) / n);
    const Rs = ((Math.cos(th) - n * Math.cos(tht)) / (Math.cos(th) + n * Math.cos(tht))) ** 2;
    const Rp = ((Math.cos(tht) - n * Math.cos(th)) / (Math.cos(tht) + n * Math.cos(th))) ** 2;
    return [Rs, Rp];
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const th = Number(input('th').value), n = Number(input('n').value);
      output('th').textContent = th.toFixed(1).replace('.', ',');
      output('n').textContent = n.toFixed(2).replace('.', ',');
      const thB = (Math.atan(n) * 180) / Math.PI;
      const [Rs, Rp] = fresnel(th, n);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 40, padB = 26, padT = 12, padR = cssW < 420 ? 26 : 10;
      const X = (deg: number) => padL + (deg / 90) * (cssW - padL - padR);
      const Y = (r: number) => cssH - padB - r * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const d of [0, 30, 60, 90]) ctx.fillText(`${d}°`, X(d), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const r of [0.5, 1]) ctx.fillText(`${r * 100}%`, padL - 4, Y(r) + 3);
      ctx.globalAlpha = 1;

      // Rs and Rp curves.
      for (const [idx, colour] of [[0, SCOL], [1, PCOL]] as Array<[number, string]>) {
        ctx.strokeStyle = colour; ctx.lineWidth = 2; ctx.beginPath();
        for (let i = 0; i <= 300; i++) {
          const d = (89.9 * i) / 300;
          const r = fresnel(d, n)[idx];
          i ? ctx.lineTo(X(d), Y(r)) : ctx.moveTo(X(d), Y(r));
        }
        ctx.stroke(); ctx.lineWidth = 1;
      }
      ctx.font = '11px system-ui,sans-serif'; ctx.textAlign = 'left';
      ctx.fillStyle = SCOL; ctx.fillText('R⊥ (vuông góc mặt tới)', padL + 8, padT + 12);
      ctx.fillStyle = PCOL; ctx.fillText('R∥ (trong mặt tới)', padL + 8, padT + 26);

      // Brewster marker.
      ctx.fillStyle = BREW;
      ctx.beginPath(); ctx.arc(X(thB), Y(0), 5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.75; ctx.fillStyle = fg; ctx.textAlign = 'center';
      ctx.fillText(`θ_B = ${thB.toFixed(1).replace('.', ',')}°`, X(thB), Y(0) - 10);
      ctx.globalAlpha = 1;

      // Current angle line.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.4; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(X(th), padT); ctx.lineTo(X(th), cssH - padB); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      const pc = (r: number) => (r * 100).toFixed(r < 0.01 ? 2 : 1).replace('.', ',');
      readout.innerHTML =
        `Tại θ = ${th.toFixed(1).replace('.', ',')}°: R⊥ = <b>${pc(Rs)}%</b>, R∥ = <b>${pc(Rp)}%</b>` +
        ` · góc Brewster của n = ${n.toFixed(2).replace('.', ',')}: <b>${thB.toFixed(1).replace('.', ',')}°</b>`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="brewster"]').forEach(setup);
</script>
