---
// Dòng thăng đối lưu và trần kích thước mưa đá.
//   w = eff · √(2·CAPE)                      (lý thuyết bọc khí, parcel theory)
//   v_rơi(D) = √(4·ρ_đá·g·D / (3·ρ_kk·Cd))   (cân bằng lực cản – trọng lượng)
//   D_max = 3·ρ_kk·Cd·w² / (4·ρ_đá·g)        (giao điểm của hai đường)
// Nguồn: parcel theory trong giáo trình khí tượng đối lưu; hệ số eff ~0,3–0,6 do
// cuốn hút khí khô, tải nước và gradient áp suất nhiễu động (đo bằng radar Doppler).
// Hằng số: ρ_đá = 900 kg/m³ (đá đặc; hạt thật 700–900), Cd = 0,5 (hạt đá thật 0,45–0,8).
// Miền đúng: Re ≈ 10⁴–10⁶ (chế độ cản Newton, Cd gần như không đổi với hạt xù xì).
---

<figure class="demo" data-demo="cape-nang-luong-cua-cot-khi-va-tran-kich-thuoc-mua-da">
  <canvas></canvas>
  <div class="controls">
    <label>CAPE (J/kg) <output data-out="cape"></output>
      <input type="range" data-in="cape" min="300" max="5000" step="50" value="4000" /></label>
    <label>Hiệu suất dòng thăng (%) <output data-out="eff"></output>
      <input type="range" data-in="eff" min="30" max="100" step="1" value="100" /></label>
    <label>Khối lượng riêng không khí ở tầng đá (kg/m³) <output data-out="rho"></output>
      <input type="range" data-in="rho" min="0.5" max="1" step="0.01" value="0.7" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh: tốc độ rơi tới hạn của viên đá theo đường kính — càng to càng
    rơi nhanh, theo căn bậc hai. Đường cam: tốc độ dòng thăng mà CAPE tạo ra.
    Bên trái giao điểm, dòng khí thắng — viên đá bị giữ lơ lửng và tiếp tục
    lớn; bên phải, nó rơi. Giao điểm chính là viên đá lớn nhất cơn dông này
    nuôi nổi. Vạch đứt là kỷ lục thế giới 20,3 cm (Vivian, South Dakota, 2010).
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', WIND = '#f59e0b';
  const G = 9.81, RHO_ICE = 900, CD = 0.5, RECORD = 0.203;

  // Tốc độ rơi tới hạn của quả cầu đá đường kính D (m) trong không khí ρ.
  const vFall = (D: number, rho: number) => Math.sqrt((4 * RHO_ICE * G * D) / (3 * rho * CD));
  const vec = (n: number, d = 1) => n.toFixed(d).replace('.', ',');

  function sizeName(cm: number) {
    if (cm < 1) return 'hạt đậu';
    if (cm < 2.5) return 'hạt ngô đến đồng xu';
    if (cm < 4.5) return 'quả bóng bàn';
    if (cm < 7) return 'quả bóng tennis';
    if (cm < 12) return 'nắm tay';
    if (cm < 20.3) return 'quả bưởi';
    return 'vượt kỷ lục thế giới';
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const cape = Number(input('cape').value);
      const eff = Number(input('eff').value) / 100;
      const rho = Number(input('rho').value);
      output('cape').textContent = cape.toLocaleString('vi-VN');
      output('eff').textContent = String(Math.round(eff * 100));
      output('rho').textContent = vec(rho, 2);

      const wIdeal = Math.sqrt(2 * cape);
      const w = eff * wIdeal;
      const dMax = (3 * rho * CD * w * w) / (4 * RHO_ICE * G); // m

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 46, padB = 28, padT = 14, padR = 12;
      const xHi = 0.40, yHi = 140;
      const X = (d: number) => padL + (d / xHi) * (cssW - padL - padR);
      const Y = (v: number) => cssH - padB - (v / yHi) * (cssH - padB - padT);

      // Vùng viên đá bị giữ lơ lửng.
      ctx.fillStyle = WIND; ctx.globalAlpha = 0.12;
      ctx.fillRect(padL, Y(w), Math.max(0, Math.min(X(dMax), cssW - padR) - padL), cssH - padB - Y(w));
      ctx.globalAlpha = 1;

      // Trục và nhãn.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const cm of [10, 20, 30, 40]) ctx.fillText(`${cm} cm`, X(cm / 100), cssH - padB + 15);
      ctx.textAlign = 'right';
      for (const v of [25, 50, 75, 100, 125]) ctx.fillText(`${v}`, padL - 5, Y(v) + 3);
      ctx.textAlign = 'left';
      ctx.fillText('m/s', padL + 4, padT + 9);
      ctx.globalAlpha = 1;

      // Kỷ lục thế giới 20,3 cm.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.45; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(X(RECORD), padT); ctx.lineTo(X(RECORD), cssH - padB); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = fg; ctx.textAlign = 'left';
      ctx.fillText('kỷ lục 20,3 cm', X(RECORD) + 4, padT + 9);
      ctx.globalAlpha = 1;

      // Đường ngang: dòng thăng.
      ctx.strokeStyle = WIND; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(padL, Y(w)); ctx.lineTo(cssW - padR, Y(w)); ctx.stroke();
      ctx.fillStyle = WIND; ctx.textAlign = 'right';
      ctx.fillText(`dòng thăng ${vec(w)} m/s`, cssW - padR - 2, Y(w) - 5);

      // Đường cong: tốc độ rơi tới hạn theo đường kính.
      ctx.strokeStyle = CURVE; ctx.beginPath();
      let started = false;
      for (let i = 0; i <= 240; i++) {
        const d = (xHi * i) / 240, v = vFall(d, rho);
        if (v > yHi) break;
        started ? ctx.lineTo(X(d), Y(v)) : (ctx.moveTo(X(d), Y(v)), started = true);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Giao điểm.
      if (dMax <= xHi) {
        ctx.fillStyle = MARK;
        ctx.beginPath(); ctx.arc(X(dMax), Y(w), 6, 0, Math.PI * 2); ctx.fill();
        ctx.textAlign = X(dMax) > cssW * 0.75 ? 'right' : 'left';
        ctx.fillText(`${vec(dMax * 100)} cm`, X(dMax) + (X(dMax) > cssW * 0.75 ? -10 : 10), Y(w) + 15);
      }

      const cm = dMax * 100;
      const note = cm >= 20.3
        ? ' · <b>vượt kỷ lục thế giới 20,3 cm</b>'
        : cm < 1
          ? ' · <b>tan hết trước khi chạm đất</b>'
          : cm >= 2.5 ? ' · <b>cỡ làm thủng mái tôn</b>' : '';
      readout.innerHTML =
        `CAPE ${cape.toLocaleString('vi-VN')} J/kg → dòng thăng lý thuyết ${vec(wIdeal)} m/s ` +
        `(${vec(wIdeal * 3.6, 0)} km/h); hiệu suất ${Math.round(eff * 100)}% → <b>${vec(w)} m/s</b> ` +
        `→ đá tối đa <b>${vec(cm)} cm</b> (cỡ ${sizeName(cm)})${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="cape-nang-luong-cua-cot-khi-va-tran-kich-thuoc-mua-da"]').forEach(setup);
</script>
