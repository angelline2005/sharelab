---
// Tốc độ rơi tới hạn của giọt nước trong không khí.
// Stokes (đứt nét): v = 2·ρ_w·g·r² / (9·η)  — chỉ đúng khi Re = 2rvρ_a/η < 1,
//   tức r ≲ 39,4 µm với ρ_w = 1000 kg/m³, ρ_a = 1,225 kg/m³, η = 1,81·10⁻⁵ Pa·s (15 °C).
// Đường liền: giải cân bằng trọng lực – lực cản với hệ số cản Schiller–Naumann
//   C_d = (24/Re)(1 + 0,15·Re^0,687), dùng tốt cho Re < ~800:
//   v² = 8·r·(ρ_w − ρ_a)·g / (3·ρ_a·C_d), giải lặp.
// Kiểm chứng với bảng Gunn–Kinzer (1949) ở mực nước biển:
//   đường kính 0,2 mm → 0,72 m/s (mô hình 0,70) · 1 mm → 4,03 (3,84) · 2 mm → 6,49 (6,89).
// Khối lượng mây: 1 km³ × LWC (g/m³) = LWC × 1000 tấn nước lỏng.
---

<figure class="demo" data-demo="dam-may-nam-tram-tan-roi-mot-centimet-moi-giay">
  <canvas></canvas>
  <div class="controls">
    <label>Bán kính giọt r <output data-out="r"></output>
      <input type="range" data-in="r" min="0" max="300" step="1" value="100" /></label>
    <label>Dòng thăng (cm/s) <output data-out="w"></output>
      <input type="range" data-in="w" min="0" max="10" step="0.1" value="2" /></label>
    <label>Hàm lượng nước lỏng (g/m³) <output data-out="q"></output>
      <input type="range" data-in="q" min="0.1" max="3" step="0.1" value="0.5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trục log–log: bán kính giọt theo tốc độ rơi tới hạn. Đường liền xanh là
    lời giải thật (cân bằng trọng lực với lực cản), đường vàng đứt nét là
    công thức Stokes ngoại suy — hai đường trùng khít ở cỡ giọt mây rồi tách
    nhau từ Re = 1 trở đi. Vạch đỏ nằm ngang là tốc độ dòng thăng: giọt nào
    có đường cong nằm dưới vạch đó thì không rơi được, nó bị không khí đẩy lên.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', STK = '#f59e0b';
  const RW = 1000, RA = 1.225, G = 9.81, ETA = 1.81e-5;

  // Stokes: v = 2·ρ_w·g·r²/(9η)  (r tính bằng mét)
  const stokes = (r: number) => (2 * RW * G * r * r) / (9 * ETA);
  const reynolds = (r: number, v: number) => (2 * r * v * RA) / ETA;

  // Cân bằng đầy đủ với C_d Schiller–Naumann, giải bằng lặp có giảm chấn.
  function vTerm(r: number) {
    let v = stokes(r);
    for (let i = 0; i < 400; i++) {
      const re = Math.max(1e-9, reynolds(r, v));
      const cd = (24 / re) * (1 + 0.15 * Math.pow(re, 0.687));
      const next = Math.sqrt((8 * r * (RW - RA) * G) / (3 * RA * cd));
      v += 0.35 * (next - v);
    }
    return v;
  }

  // Bán kính nơi Re = 1: r³ = 9η²/(4·ρ_w·ρ_a·g)
  const R_CRIT = Math.cbrt((9 * ETA * ETA) / (4 * RW * RA * G)); // ≈ 3,94e−5 m

  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function speedLabel(v: number) {
    if (v < 0.01) return `${vn(v * 1000, 2)} mm/s`;
    if (v < 1) return `${vn(v * 100, 2)} cm/s`;
    return `${vn(v, 2)} m/s`;
  }

  function timeLabel(sec: number) {
    if (sec < 3600) return `${vn(sec / 60, 1)} phút`;
    if (sec < 3600 * 72) return `${vn(sec / 3600, 1)} giờ`;
    return `${vn(sec / 86400, 0)} ngày`;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const s = Number(input('r').value);          // 0..300 → log10(r/µm) × 100
      const rUm = Math.pow(10, s / 100);
      const r = rUm * 1e-6;
      const w = Number(input('w').value) / 100;    // cm/s → m/s
      const q = Number(input('q').value);          // g/m³

      const rTxt = rUm < 10 ? `${vn(rUm, 1)} µm` : rUm < 1000 ? `${Math.round(rUm)} µm` : '1 mm';
      output('r').textContent = rTxt;
      output('w').textContent = vn(w * 100, 1);
      output('q').textContent = vn(q, 1);

      const v = vTerm(r), vs = stokes(r), re = reynolds(r, v);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 58, padB = 26, padT = 12, padR = 12;
      const plotW = cssW - padL - padR, plotH = cssH - padT - padB;
      const X = (um: number) => padL + (Math.log10(um) / 3) * plotW;          // 1 µm … 1000 µm
      const Y = (ms: number) => padT + (1 - (Math.log10(ms) + 4) / 5) * plotH; // 1e−4 … 10 m/s

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB);
      ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const [um, lab] of [[1, '1 µm'], [10, '10 µm'], [100, '100 µm'], [1000, '1 mm']] as Array<[number, string]>)
        ctx.fillText(lab, X(um), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const [ms, lab] of [[1e-4, '0,1 mm/s'], [1e-3, '1 mm/s'], [1e-2, '1 cm/s'], [1e-1, '10 cm/s'], [1, '1 m/s'], [10, '10 m/s']] as Array<[number, string]>)
        ctx.fillText(lab, padL - 5, Y(ms) + 3);
      ctx.globalAlpha = 1;

      ctx.save();
      ctx.beginPath(); ctx.rect(padL, padT, plotW, plotH); ctx.clip();

      // Stokes ngoại suy (vàng, đứt nét) — vọt khỏi khung ở cỡ hạt mưa.
      ctx.strokeStyle = STK; ctx.lineWidth = 2; ctx.setLineDash([5, 4]); ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const um = Math.pow(10, (3 * i) / 240);
        const y = Y(stokes(um * 1e-6));
        i ? ctx.lineTo(X(um), y) : ctx.moveTo(X(um), y);
      }
      ctx.stroke(); ctx.setLineDash([]);

      // Lời giải thật (xanh, liền nét).
      ctx.strokeStyle = CURVE; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const um = Math.pow(10, (3 * i) / 240);
        const y = Y(vTerm(um * 1e-6));
        i ? ctx.lineTo(X(um), y) : ctx.moveTo(X(um), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Ngưỡng Re = 1.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.35; ctx.setLineDash([2, 3]);
      ctx.beginPath(); ctx.moveTo(X(R_CRIT * 1e6), padT); ctx.lineTo(X(R_CRIT * 1e6), cssH - padB); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.7; ctx.fillStyle = fg; ctx.textAlign = 'left';
      ctx.fillText('Re = 1', X(R_CRIT * 1e6) + 4, padT + 25);

      // Ba vùng kích thước.
      ctx.globalAlpha = 0.5; ctx.textAlign = 'center';
      for (const [um, lab] of [[5, 'giọt mây'], [79, 'mưa phùn'], [500, 'hạt mưa']] as Array<[number, string]>)
        ctx.fillText(lab, X(um), cssH - padB - 7);

      // Khối lượng nước của một kilômét khối mây.
      ctx.globalAlpha = 0.75; ctx.textAlign = 'left';
      ctx.fillText(`1 km³ mây = ${Math.round(q * 1000).toLocaleString('vi-VN')} tấn nước`, padL + 6, padT + 11);
      ctx.globalAlpha = 1;

      // Vạch dòng thăng.
      if (w > 1e-5) {
        ctx.strokeStyle = MARK; ctx.globalAlpha = 0.75; ctx.setLineDash([6, 4]);
        ctx.beginPath(); ctx.moveTo(padL, Y(w)); ctx.lineTo(cssW - padR, Y(w)); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
      }

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(rUm), Y(v), 6, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      const held = w >= v;
      const mass = Math.round(q * 1000).toLocaleString('vi-VN');
      const nPerM3 = (q * 1e-3) / ((4 / 3) * Math.PI * r * r * r * RW);
      const nPerCm3 = nPerM3 / 1e6;
      const nTxt = nPerCm3 >= 10
        ? `${Math.round(nPerCm3).toLocaleString('vi-VN')} giọt mỗi cm³`
        : nPerCm3 >= 1
          ? `${vn(nPerCm3, 1)} giọt mỗi cm³`
          : `${Math.round(nPerM3).toLocaleString('vi-VN')} giọt mỗi m³`;
      const stokesNote = re > 1
        ? ` — Stokes sẽ đoán <b>${speedLabel(vs)}</b>, cao gấp ${vn(vs / v, 1)} lần: công thức đã hết hiệu lực`
        : ' — Stokes vẫn đúng ở đây';

      readout.innerHTML =
        `r = ${rTxt} → v = <b>${speedLabel(v)}</b> · Re = ${re < 0.001 ? '&lt; 0,001' : re < 1 ? vn(re, 3) : vn(re, 1)}${stokesNote}<br />` +
        (held
          ? `Dòng thăng ${vn(w * 100, 1)} cm/s ≥ v: <b>giọt không xuống được, mây treo vô hạn</b> — lặng gió mới rơi hết 1 km trong ${timeLabel(1000 / v)}. `
          : `Dòng thăng ${vn(w * 100, 1)} cm/s < v: giọt tụt ròng ${speedLabel(v - w)}, rơi hết 1 km trong <b>${timeLabel(1000 / (v - w))}</b>. `) +
        `Mây 1 km³ chứa ${mass} tấn nước, chia thành ${nTxt}.`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dam-may-nam-tram-tan-roi-mot-centimet-moi-giay"]').forEach(setup);
</script>
