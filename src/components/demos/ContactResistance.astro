---
// Kohlrausch / Holm "voltage–temperature" (φ–θ) relation for a current
// constriction between two metal contacts:
//   T_max² = T₀² + U²/(4L),  L = 2,45×10⁻⁸ V²/K² (số Lorenz, Wiedemann–Franz)
// U = sụt áp toàn phần ngang qua chỗ tiếp xúc, T₀ = nhiệt độ khối kim loại.
// Giả thiết: toàn bộ nhiệt Joule thoát đi qua chính hai vật dẫn (mặt tiếp xúc
// đoạn nhiệt), Wiedemann–Franz đúng, mặt đẳng thế trùng mặt đẳng nhiệt.
// Kiểm chứng: U_mềm(Cu) tính ra 0,112 V (bảng Holm: 0,12 V);
// U_chảy(Cu) tính ra 0,415 V (bảng Holm: 0,43 V) — sai số ~5%.
// Bán kính đốm tiếp xúc quy đổi: R = ρ/(2a), ρ_Cu = 1,72×10⁻⁸ Ω·m.
---

<figure class="demo" data-demo="dien-tro-tiep-xuc-o-cam-long-gay-chay">
  <canvas></canvas>
  <div class="controls">
    <label>Sụt áp tại chỗ tiếp xúc U (V) <output data-out="u"></output>
      <input type="range" data-in="u" min="0.01" max="1" step="0.01" value="0.1" /></label>
    <label>Dòng tải I (A) <output data-out="i"></output>
      <input type="range" data-in="i" min="1" max="20" step="0.5" value="10" /></label>
    <label>Nhiệt độ trong hộp ổ cắm (°C) <output data-out="t"></output>
      <input type="range" data-in="t" min="25" max="45" step="1" value="30" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Bên trái: hai mặt đồng chạm nhau qua một đốm nhỏ xíu, dòng điện phải chen
    qua đó và đốt nóng đúng chỗ ấy. Bên phải: nhiệt độ đốm theo sụt áp — trục
    dọc chia theo thang loga vì nó leo rất nhanh. Ba vạch cam là ngưỡng nhựa
    PVC mềm, thiếc hàn chảy và đồng chảy. Đường cong không hỏi diện tích tiếp
    xúc, cũng không hỏi dòng điện: chỉ hỏi sụt áp.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const LZ = 2.45e-8;          // số Lorenz, V²/K²
  const RHO_CU = 1.72e-8;      // Ω·m
  const vi = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  // T_max theo sụt áp U và nhiệt độ khối T0 (cả hai đều °C ở giao diện).
  const Tmax = (U: number, T0c: number) =>
    Math.sqrt((T0c + 273.15) ** 2 + (U * U) / (4 * LZ)) - 273.15;

  const LIMITS: Array<[number, string]> = [
    [100, 'nhựa PVC mềm 100 °C'],
    [232, 'thiếc hàn chảy 232 °C'],
    [1085, 'đồng chảy 1 085 °C'],
  ];

  // Thang màu theo nhiệt độ: xám nguội → đỏ sẫm → cam → vàng trắng.
  const STOPS: Array<[number, number[]]> = [
    [25, [110, 122, 140]], [100, [150, 80, 40]], [232, [200, 55, 30]],
    [700, [240, 140, 20]], [1085, [252, 220, 120]], [3000, [255, 255, 250]],
  ];
  function heat(T: number) {
    if (T <= STOPS[0][0]) return `rgb(${STOPS[0][1].join(',')})`;
    for (let i = 1; i < STOPS.length; i++) {
      if (T <= STOPS[i][0]) {
        const [a, ca] = STOPS[i - 1], [b, cb] = STOPS[i];
        const f = (T - a) / (b - a);
        const c = ca.map((v, k) => Math.round(v + f * (cb[k] - v)));
        return `rgb(${c.join(',')})`;
      }
    }
    return 'rgb(255,255,250)';
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const U = Number(input('u').value);
      const I = Number(input('i').value);
      const T0 = Number(input('t').value);
      output('u').textContent = vi(U, 2);
      output('i').textContent = vi(I, 1);
      output('t').textContent = String(T0);

      const R = U / I;                       // Ω
      const P = U * I;                       // W
      const T = Tmax(U, T0);                 // °C
      const aUm = (RHO_CU / (2 * R)) * 1e6;  // bán kính đốm quy đổi, µm

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- Bảng trái: chỗ tiếp xúc phóng to ----------
      const pL = 4;
      const panelW = Math.min(150, (cssW - pL) * 0.3);
      const cx = pL + panelW / 2, top = 14, axisY = cssH - 26;
      const cy = (top + axisY) / 2;
      const barW = Math.min(64, panelW - 16);

      ctx.fillStyle = fg; ctx.globalAlpha = 0.28;
      ctx.fillRect(cx - barW / 2, top + 4, barW, cy - 4 - (top + 4));
      ctx.fillRect(cx - barW / 2, cy + 4, barW, axisY - 8 - (cy + 4));
      ctx.globalAlpha = 1;

      // Cầu dẫn bé xíu + quầng sáng theo nhiệt độ.
      const col = heat(T);
      const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 24);
      g.addColorStop(0, col);
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.globalAlpha = Math.min(1, 0.25 + T / 900);
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(cx, cy, 24, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
      ctx.fillStyle = col;
      ctx.fillRect(cx - 3, cy - 5, 6, 10);

      ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.textAlign = 'center';
      ctx.fillText('đồng', cx, top + 16);
      ctx.fillText(`bán kính ~${aUm >= 1 ? vi(aUm, 1) : vi(aUm, 2)} µm`, cx, axisY - 6);
      ctx.globalAlpha = 1;
      ctx.fillStyle = T > 600 ? col : fg;
      ctx.fillText(`${Math.round(T)} °C`, cx, cy + 22);

      // ---------- Bảng phải: T theo sụt áp, trục dọc loga ----------
      const x0 = pL + panelW + 42, x1 = cssW - 8;
      const yLo = 20, yHi = 3500;
      const lg = Math.log10(yHi / yLo);
      const X = (u: number) => x0 + (u / 1) * (x1 - x0);
      const Y = (c: number) =>
        top + ((Math.log10(yHi) - Math.log10(Math.max(c, yLo))) / lg) * (axisY - top);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(x0, top); ctx.lineTo(x0, axisY); ctx.lineTo(x1, axisY); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      for (const u of [0.2, 0.4, 0.6, 0.8, 1]) ctx.fillText(`${vi(u, 1)} V`, X(u), axisY + 14);
      ctx.textAlign = 'right';
      for (const c of [50, 100, 300, 1000, 3000])
        ctx.fillText(c >= 1000 ? `${c / 1000} 000°` : `${c}°`, x0 - 4, Y(c) + 3);
      ctx.globalAlpha = 1;

      // Ba ngưỡng vật liệu.
      ctx.setLineDash([4, 3]);
      for (const [c, lab] of LIMITS) {
        ctx.strokeStyle = LM; ctx.globalAlpha = 0.75;
        ctx.beginPath(); ctx.moveTo(x0, Y(c)); ctx.lineTo(x1, Y(c)); ctx.stroke();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'left';
        ctx.fillText(lab, x0 + 5, Y(c) - 4);
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // Đường cong T(U) tại T0 hiện tại.
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const u = 0.01 + (0.99 * i) / 240;
        const y = Y(Tmax(u, T0));
        i ? ctx.lineTo(X(u), y) : ctx.moveTo(X(u), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(U), Y(T), 6, 0, Math.PI * 2); ctx.fill();

      let note = ' · dưới mọi ngưỡng vật liệu';
      if (T >= 1085) note = ' · <b>đồng nóng chảy: cầu kim loại đứt, sinh hồ quang</b>';
      else if (T >= 232) note = ' · <b>quá điểm chảy thiếc hàn — thừa sức mồi lửa gỗ và giấy</b>';
      else if (T >= 100) note = ' · <b>vỏ nhựa PVC bắt đầu mềm và biến dạng</b>';

      readout.innerHTML =
        `U = <b>${vi(U, 2)} V</b> · I = ${vi(I, 1)} A → R = ${vi(R * 1000, 1)} mΩ · ` +
        `công suất chỉ <b>${vi(P, 2)} W</b> · nhiệt độ điểm tiếp xúc: <b>${Math.round(T)} °C</b>${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dien-tro-tiep-xuc-o-cam-long-gay-chay"]').forEach(setup);
</script>
