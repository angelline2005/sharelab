---
// Faraday's law made visual: a magnet falls through a coil, the induced EMF
// spikes once on entry and once (reversed) on exit. Flux is modelled as a
// gaussian in magnet position; EMF is its exact derivative times speed. The
// speed slider shows the trade the law enforces: faster → taller and narrower
// spikes, with the pulse AREA (= NΔΦ) pinned constant.
---

<figure class="demo" data-demo="faraday">
  <canvas></canvas>
  <div class="controls">
    <label>Tốc độ thả nam châm <output data-out="v"></output>
      <input type="range" data-in="v" min="0.5" max="3" step="0.1" value="1" /></label>
    <button type="button" data-btn="drop">Thả lại</button>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Nam châm rơi qua cuộn dây; đồng hồ đo suất điện động cảm ứng. Hai cú hích
    ngược dấu — vào và ra — và diện tích mỗi xung không đổi theo tốc độ: thả
    nhanh chỉ đổi "cao và hẹp" lấy "thấp và rộng".
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; align-items: end; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input[type='range'] { width: 100%; }
  .controls button { border: 1px solid rgba(128,128,128,.5); background: transparent; color: inherit; border-radius: 6px; padding: .4rem .9rem; cursor: pointer; font-size: .85rem; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const MAG = '#dc2626', EMF = '#2563eb';
  const SIG = 0.5; // gaussian width of the coupling, in magnet-position units

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="v"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="v"]') as HTMLOutputElement;

    let z = -4, raf = 0, last = 0;
    let trace: { t: number; e: number }[] = [];
    let simT = 0;

    // Flux Φ(z) ∝ exp(−z²/2σ²); EMF = −dΦ/dt = −Φ'(z)·v.
    const dPhi = (zz: number) => (-zz / (SIG * SIG)) * Math.exp((-zz * zz) / (2 * SIG * SIG));

    function reset() { z = -4; trace = []; simT = 0; last = 0; }

    function draw() {
      const v = Number(slider.value);
      out.textContent = `${v.toFixed(1)} v₀`;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      if (canvas.width !== cssW * dpr) { canvas.width = cssW * dpr; canvas.height = cssH * dpr; canvas.style.height = `${cssH}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Left: coil + falling magnet.
      const colX = cssW * 0.16, topY = 20, botY = cssH - 20;
      const coilY = (topY + botY) / 2, coilH = 46;
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.6;
      for (let k = -3; k <= 3; k++) {
        ctx.beginPath();
        ctx.ellipse(colX, coilY + k * 7, 20, 5, 0, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      const zy = coilY + (z / 4) * (botY - topY) * 0.5;
      ctx.fillStyle = MAG;
      ctx.fillRect(colX - 8, zy - 14, 16, 28);
      ctx.fillStyle = '#fff'; ctx.font = 'bold 10px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('N', colX, zy - 4); ctx.fillText('S', colX, zy + 10);

      // Right: EMF vs time.
      const gx = cssW * 0.32, gw = cssW - gx - 12, gy = 14, gh = cssH - 40, mid = gy + gh / 2;
      const TSPAN = 9;
      const X = (t: number) => gx + (t / TSPAN) * gw;
      const Y = (e: number) => mid - e * gh * 0.42;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(gx, mid); ctx.lineTo(gx + gw, mid); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '11px system-ui,sans-serif';
      ctx.textAlign = 'left'; ctx.fillText('EMF', gx + 2, gy + 8);
      ctx.globalAlpha = 1;

      ctx.strokeStyle = EMF; ctx.lineWidth = 1.8; ctx.beginPath();
      let started = false;
      for (const p of trace) {
        started ? ctx.lineTo(X(p.t), Y(p.e)) : ctx.moveTo(X(p.t), Y(p.e));
        started = true;
      }
      ctx.stroke(); ctx.lineWidth = 1;

      const peak = 0.61 * Number(slider.value) / (SIG); // max of |dPhi|·v (analytic ≈ e^{-1/2}/σ² · σ · v)
      readout.innerHTML =
        `Đỉnh xung tỉ lệ tốc độ: nhanh ×2 → đỉnh ×2, bề rộng ÷2 · ` +
        `diện tích xung = N·ΔΦ — <b>bất biến</b>, vì nam châm nào cũng mang đúng chừng ấy từ thông qua cuộn`;
      void peak;
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      const v = Number(slider.value);
      if (z < 4.2) {
        z += v * dt * 1.2;
        simT += dt;
        trace.push({ t: simT, e: -dPhi(z) * v * 0.55 });
      }
      draw();
    }

    slider.addEventListener('input', () => { reset(); });
    (root.querySelector('[data-btn="drop"]') as HTMLButtonElement).addEventListener('click', reset);
    addEventListener('resize', draw);
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) { last = 0; raf = requestAnimationFrame(frame); }
        else cancelAnimationFrame(raf);
      }
    });
    io.observe(root);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="faraday"]').forEach(setup);
</script>
