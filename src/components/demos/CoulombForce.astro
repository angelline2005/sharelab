---
// Coulomb's law made tactile: two charges on a line, F = k·q₁q₂/r². Sliders
// for both charges (sign included) and separation; the arrows flip between
// attraction and repulsion and the readout carries the surprising absolute
// numbers — two 1 µC "dust specks" 10 cm apart pull with ~1 newton.
---

<figure class="demo" data-demo="coulomb">
  <canvas></canvas>
  <div class="controls">
    <label>Điện tích q₁ <output data-out="q1"></output>
      <input type="range" data-in="q1" min="-5" max="5" step="0.1" value="1" /></label>
    <label>Điện tích q₂ <output data-out="q2"></output>
      <input type="range" data-in="q2" min="-5" max="5" step="0.1" value="1" /></label>
    <label>Khoảng cách r <output data-out="r"></output>
      <input type="range" data-in="r" min="2" max="50" step="0.5" value="10" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Mũi tên là lực trên mỗi điện tích — luôn bằng nhau và ngược chiều, đúng
    định luật III Newton, dù hai điện tích chênh nhau bao nhiêu lần. Chiều dài
    mũi tên theo thang log vì r² trong mẫu số khiến lực trải quá nhiều bậc.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const K = 8.99e9;
  const POS = '#dc2626', NEG = '#2563eb';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    function draw() {
      const q1 = Number(input('q1').value);
      const q2 = Number(input('q2').value);
      const rCm = Number(input('r').value);
      output('q1').textContent = `${q1.toFixed(1)} µC`;
      output('q2').textContent = `${q2.toFixed(1)} µC`;
      output('r').textContent = `${rCm.toFixed(1)} cm`;

      const F = (K * Math.abs(q1 * q2) * 1e-12) / Math.pow(rCm / 100, 2);
      const repel = q1 * q2 > 0;
      const neutral = q1 === 0 || q2 === 0;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.3);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const midY = cssH / 2;
      const sep = (rCm / 50) * cssW * 0.55 + 40;
      const x1 = cssW / 2 - sep / 2, x2 = cssW / 2 + sep / 2;

      const chargeDot = (x: number, q: number) => {
        const rad = 8 + Math.abs(q) * 2.2;
        ctx.fillStyle = q >= 0 ? POS : NEG;
        ctx.globalAlpha = q === 0 ? 0.3 : 0.9;
        ctx.beginPath(); ctx.arc(x, midY, rad, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1; ctx.fillStyle = '#fff';
        ctx.font = 'bold 13px system-ui,sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(q > 0 ? '+' : q < 0 ? '−' : '0', x, midY + 5);
      };

      // Log-scaled arrow length so 4 decades of force stay drawable.
      const len = neutral ? 0 : Math.max(0, (Math.log10(F) + 2) * 26);
      const arrow = (x: number, dir: number) => {
        if (len < 2) return;
        ctx.strokeStyle = fg; ctx.fillStyle = fg; ctx.lineWidth = 2.4;
        ctx.beginPath(); ctx.moveTo(x, midY); ctx.lineTo(x + dir * len, midY); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(x + dir * (len + 8), midY);
        ctx.lineTo(x + dir * len, midY - 5); ctx.lineTo(x + dir * len, midY + 5); ctx.fill();
        ctx.lineWidth = 1;
      };
      // Repulsion points the arrows outward, attraction inward.
      const off = 16;
      arrow(x1 + (repel ? -off : off), repel ? -1 : 1);
      arrow(x2 + (repel ? off : -off), repel ? 1 : -1);

      chargeDot(x1, q1);
      chargeDot(x2, q2);

      readout.innerHTML = neutral
        ? `Một điện tích bằng 0 — không có lực. Định luật cần cả hai bên tham gia.`
        : `F = k·|q₁q₂|/r² = <b>${F >= 1 ? F.toFixed(2) + ' N' : F >= 1e-3 ? (F * 1e3).toFixed(1) + ' mN' : (F * 1e6).toFixed(1) + ' µN'}</b> · ` +
          `${repel ? 'đẩy nhau' : 'hút nhau'} · hai lực <b>luôn bằng nhau</b> dù |q₁| ${Math.abs(q1) === Math.abs(q2) ? '=' : '≠'} |q₂|`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="coulomb"]').forEach(setup);
</script>
