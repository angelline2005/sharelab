---
// Radiation pressure: F = 2IA/c for a perfect mirror in full sunlight
// (I = 1361 W/m²). Sliders: sail area (log) and areal density. Readout gives
// force, acceleration, and Δv per day — the patient engine. Static redraw.
---

<figure class="demo" data-demo="light-pressure">
  <canvas></canvas>
  <div class="controls">
    <label>Diện tích buồm A = 10^x m², chọn x <output data-out="a"></output>
      <input type="range" data-in="a" min="0" max="6" step="0.1" value="2.3" /></label>
    <label>Khối lượng mỗi m² buồm (g/m²) <output data-out="s"></output>
      <input type="range" data-in="s" min="1" max="100" step="1" value="10" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Ánh sáng mang động lượng p = E/c; gương phản xạ nhận cú hích gấp đôi kẻ
    hấp thụ. Lực bé đến buồn cười — nhưng nắng không bao giờ tắt, không cần
    chở nhiên liệu, và cộng dồn 24/7 là thứ động cơ hoá học nào cũng ghen tị.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const I = 1361, C = 2.998e8;
  const SAIL = '#f59e0b', RAYS = '#dc2626', TXT = '#2563eb';

  const fmtF = (n: number) =>
    n >= 1 ? `${n.toFixed(1).replace('.', ',')} N` : n >= 1e-3 ? `${(n * 1000).toFixed(1).replace('.', ',')} mN` : `${(n * 1e6).toFixed(1).replace('.', ',')} µN`;

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const ax = Number(input('a').value), sig = Number(input('s').value);
      const A = Math.pow(10, ax);
      output('a').textContent = A >= 1e4 ? `${(A / 1e6).toFixed(2).replace('.', ',')} km²` : `${Math.round(A).toLocaleString('vi-VN')} m²`;
      output('s').textContent = String(sig);
      const F = (2 * I * A) / C;
      const m = (A * sig) / 1000; // kg
      const acc = F / m;
      const dvDay = acc * 86400;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.34);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Sun rays from the left hitting a tilted square sail.
      const sx = cssW * 0.62, sy = cssH / 2;
      const half = 16 + (ax / 6) * (cssH * 0.32);
      ctx.strokeStyle = SAIL; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(sx - 8, sy - half); ctx.lineTo(sx + 8, sy + half); ctx.stroke();
      ctx.lineWidth = 1;
      for (let k = -2; k <= 2; k++) {
        const y = sy + k * half * 0.42;
        ctx.strokeStyle = RAYS; ctx.globalAlpha = 0.6;
        ctx.beginPath(); ctx.moveTo(20, y); ctx.lineTo(sx - 14 + k * 3, y); ctx.stroke();
        // reflected
        ctx.setLineDash([3, 3]);
        ctx.beginPath(); ctx.moveTo(sx - 14 + k * 3, y); ctx.lineTo(20, y - half * 0.35); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
      }
      // Thrust arrow.
      ctx.strokeStyle = TXT; ctx.fillStyle = TXT; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(sx + 16, sy); ctx.lineTo(sx + 60, sy); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(sx + 68, sy); ctx.lineTo(sx + 56, sy - 6); ctx.lineTo(sx + 56, sy + 6); ctx.fill();
      ctx.lineWidth = 1;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('lực đẩy', sx + 42, sy - 10);
      ctx.fillText('nắng', 34, sy - half * 0.5 - 8);
      ctx.globalAlpha = 1;

      readout.innerHTML =
        `F = 2IA/c = <b>${fmtF(F)}</b> · buồm nặng ${m >= 1000 ? `${(m / 1000).toFixed(1).replace('.', ',')} tấn` : `${m.toFixed(1).replace('.', ',')} kg`}` +
        ` → a = ${(acc * 1000).toFixed(2).replace('.', ',')} mm/s² · <b>cộng dồn ${dvDay.toFixed(0)} m/s mỗi ngày</b>`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="light-pressure"]').forEach(setup);
</script>
