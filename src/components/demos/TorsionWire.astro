---
// Torsion constant of a solid round wire: κ = π·G·d⁴/(32·L) (κ = G·J/L with
// J = π·d⁴/32, Saint-Venant torsion of a circular shaft). Period of the
// torsion pendulum: T = 2π√(I/κ) with I = 2·m·r², r = 0,10 m fixed.
// Steel, G = 79 GPa. Valid while the wire stays linear-elastic: the surface
// shear stress τ = G·d·θ/(2L) must stay under ~500 MPa, which the readout
// flags as a maximum twist angle. Bar and wire inertia neglected.
// Slider ranges land exactly on d = 0,50 / 1,00 / 2,00 mm, L = 1,00 m and
// m = 50 g used in the article.
---

<figure class="demo" data-demo="dao-dong-xoan-va-luat-luy-thua-bon">
  <canvas></canvas>
  <div class="controls">
    <label>Đường kính dây d (mm) <output data-out="d"></output>
      <input type="range" data-in="d" min="0.1" max="2" step="0.05" value="0.5" /></label>
    <label>Chiều dài dây L (m) <output data-out="l"></output>
      <input type="range" data-in="l" min="0.1" max="2" step="0.05" value="1" /></label>
    <label>Khối lượng mỗi đầu (g), cách trục 10 cm <output data-out="m"></output>
      <input type="range" data-in="m" min="10" max="200" step="5" value="50" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đồ thị: độ cứng xoắn κ theo đường kính dây (xanh, trục trái) và chu kỳ
    dao động T đi ngược lại (cam, trục phải). Cả hai trục đứng đều là thang
    loga — chỉ có cách đó mới nhét nổi sáu bậc độ lớn của κ vào một khung.
    Kéo d từ 0,50 lên 1,00 mm: κ nhân 16, T chia 4. Trên màn hình rộng còn
    thêm bảng bên trái — mặt cắt sợi dây vẽ đúng tỉ lệ (vòng mờ là dây
    2,0 mm để so sánh) và cảnh thanh tạ nhìn từ trên xuống lúc xoắn 30°.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', SECOND = '#f59e0b';
  const G = 79e9, TAU_Y = 500e6, ARM = 0.1;

  // κ = π·G·d⁴/(32·L), d in metres.
  const kappa = (dmm: number, L: number) => (Math.PI * G * Math.pow(dmm * 1e-3, 4)) / (32 * L);
  const inertia = (mg: number) => 2 * (mg / 1000) * ARM * ARM;
  const period = (dmm: number, L: number, mg: number) =>
    2 * Math.PI * Math.sqrt(inertia(mg) / kappa(dmm, L));

  const vi = (x: number, n: number) => x.toFixed(n).replace('.', ',');
  const SUP: Record<string, string> = {
    '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴',
    '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹', '-': '⁻',
  };
  function expo(x: number, n = 2) {
    const e = Math.floor(Math.log10(Math.abs(x)));
    if (e >= -2 && e <= 2) return vi(x, Math.max(0, 2 - e));
    const mant = x / Math.pow(10, e);
    const digits = String(e).split('').map((c) => SUP[c]).join('');
    return `${vi(mant, n)}×10${digits}`;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const d = Number(input('d').value);
      const L = Number(input('l').value);
      const m = Number(input('m').value);
      output('d').textContent = vi(d, 2);
      output('l').textContent = vi(L, 2);
      output('m').textContent = String(m);

      const k = kappa(d, L), I = inertia(m), T = period(d, L, m);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32;
      const cssH = Math.max(Math.round(cssW * 0.52), 210);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- left panel: wire cross-section + top view of the bar ----------
      // Dropped below 460 px so the graph keeps a usable width on phones.
      const panelW = cssW < 460 ? 0 : Math.max(150, Math.round(cssW * 0.29));
      if (panelW) {
        const cx = panelW / 2;
        ctx.textAlign = 'center';
        ctx.fillStyle = fg; ctx.globalAlpha = 0.55;
        ctx.fillText('mặt cắt dây', cx, 14);
        ctx.globalAlpha = 1;

        const rMax = 24, cyWire = 22 + rMax;
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.25;
        ctx.beginPath(); ctx.arc(cx, cyWire, rMax, 0, Math.PI * 2); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.fillStyle = CURVE;
        ctx.beginPath(); ctx.arc(cx, cyWire, Math.max(0.9, (rMax * d) / 2), 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7;
        ctx.fillText(`d = ${vi(d, 2)} mm`, cx, cyWire + rMax + 14);
        ctx.globalAlpha = 1;

        // The two caption lines are pinned to the bottom; the bar takes the
        // vertical room left between them and the cross-section above.
        const labY1 = cssH - 30, labY2 = cssH - 18;
        const topY = cyWire + rMax + 22;
        const half = Math.max(14, (labY1 - 14 - topY) / 2);
        const cyBar = topY + half;
        const rBall = Math.min(4 + 8 * Math.cbrt(m / 200), half * 0.45);
        const barR = Math.max(12, Math.min(cx - 14, 58, (half - rBall) / Math.sin(Math.PI / 6)));
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.22;
        ctx.beginPath(); ctx.moveTo(cx - barR, cyBar); ctx.lineTo(cx + barR, cyBar); ctx.stroke();
        ctx.globalAlpha = 1;

        const th = Math.PI / 6; // reference twist of 30° for the sketch
        const ux = Math.cos(th), uy = Math.sin(th);
        ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(cx - barR * ux, cyBar - barR * uy);
        ctx.lineTo(cx + barR * ux, cyBar + barR * uy);
        ctx.stroke(); ctx.lineWidth = 1;
        ctx.fillStyle = MARK;
        ctx.beginPath(); ctx.arc(cx + barR * ux, cyBar + barR * uy, rBall, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(cx - barR * ux, cyBar - barR * uy, rBall, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.5;
        ctx.beginPath(); ctx.arc(cx, cyBar, barR * 0.55, 0, th); ctx.stroke();
        ctx.globalAlpha = 1;

        ctx.fillStyle = fg; ctx.globalAlpha = 0.7;
        ctx.fillText('mô-men ở 30°', cx, labY1);
        ctx.fillText(`${expo(k * th)} N·m`, cx, labY2);
        ctx.globalAlpha = 1;
      }

      // ---------- right panel: κ(d) and T(d) on log axes ----------
      const padL = panelW + 46, padR = 44, padT = 18, padB = 26;
      const X = (dd: number) => padL + ((dd - 0.1) / 1.9) * (cssW - padL - padR);
      const KLO = -7, KHI = 1;               // log10 κ, N·m/rad
      const TLO = -1.4, THI = 3;             // log10 T, s
      const YK = (kk: number) =>
        cssH - padB - ((Math.log10(kk) - KLO) / (KHI - KLO)) * (cssH - padB - padT);
      const YT = (tt: number) =>
        cssH - padB - ((Math.log10(tt) - TLO) / (THI - TLO)) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(cssW - padR, padT); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();

      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      const dTicks = cssW - padL - padR < 230 ? [0.5, 1, 2] : [0.5, 1, 1.5, 2];
      for (const dd of dTicks) ctx.fillText(`${vi(dd, 1)} mm`, X(dd), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const p of [-6, -4, -2, 0]) {
        const lab = p === 0 ? '1' : `10${String(p).split('').map((c) => SUP[c]).join('')}`;
        ctx.fillText(lab, padL - 4, YK(Math.pow(10, p)) + 3);
      }
      ctx.textAlign = 'left';
      for (const tt of [0.1, 1, 10, 100, 1000]) {
        const lab = tt < 1 ? '0,1 s' : `${tt} s`;
        ctx.fillText(lab, cssW - padR + 4, YT(tt) + 3);
      }
      ctx.globalAlpha = 1;

      // T(d) first, so the κ curve sits on top.
      ctx.strokeStyle = SECOND; ctx.lineWidth = 2; ctx.globalAlpha = 0.75;
      ctx.beginPath();
      for (let i = 0; i <= 220; i++) {
        const dd = 0.1 + (1.9 * i) / 220;
        const y = YT(period(dd, L, m));
        i ? ctx.lineTo(X(dd), y) : ctx.moveTo(X(dd), y);
      }
      ctx.stroke(); ctx.globalAlpha = 1;

      ctx.strokeStyle = CURVE; ctx.beginPath();
      for (let i = 0; i <= 220; i++) {
        const dd = 0.1 + (1.9 * i) / 220;
        const y = YK(kappa(dd, L));
        i ? ctx.lineTo(X(dd), y) : ctx.moveTo(X(dd), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.textAlign = 'left';
      ctx.fillStyle = CURVE; ctx.fillText('κ (N·m/rad)', padL + 6, padT + 10);
      ctx.fillStyle = SECOND; ctx.fillText('T (chu kỳ)', padL + 6, padT + 23);

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(d), YK(k), 6, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.6;
      ctx.beginPath(); ctx.arc(X(d), YT(T), 4.5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;

      // ---------- readout ----------
      const thMax = (2 * L * TAU_Y) / (G * d * 1e-3);   // rad before the steel yields
      const turns = thMax / (2 * Math.PI);
      const warn = turns < 1
        ? ` · <b>chỉ xoắn được ±${(thMax * 180 / Math.PI).toFixed(0)}° trước khi thép chảy dẻo</b>`
        : ` · còn đàn hồi tới ${vi(turns, 1)} vòng xoắn`;
      const tTxt = T >= 60
        ? `<b>${vi(T, 0)} s</b> (${vi(T / 60, 1)} phút)`
        : `<b>${vi(T, 2)} s</b>`;
      readout.innerHTML =
        `d = ${vi(d, 2)} mm · L = ${vi(L, 2)} m · ${m} g mỗi đầu → κ = <b>${expo(k)} N·m/rad</b>` +
        ` · I = ${expo(I)} kg·m² → T = ${tTxt}${warn}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dao-dong-xoan-va-luat-luy-thua-bon"]').forEach(setup);
</script>
