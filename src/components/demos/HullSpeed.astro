---
// Hull speed (wave resistance): v_hull = √(g·L/(2π)) ≈ 1.25√L
// Valid for displacement hulls in planing regime (Fr < ~0.5 to Fr > ~1)
// At hull speed, wavelength equals ship length: λ = L
---

<figure class="demo" data-demo="toc-do-than-tau-va-buc-tuong-song">
  <canvas></canvas>
  <div class="controls">
    <label>Chiều dài đường nước L (m) <output data-out="l"></output>
      <input type="range" data-in="l" min="3" max="40" step="0.5" value="10" /></label>
    <label>Tốc độ (m/s) <output data-out="v"></output>
      <input type="range" data-in="v" min="0.5" max="7" step="0.1" value="2.5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Mỗi tàu tạo ra con sóng mũi với bước sóng λ = 2πv²/g. Khi λ bằng chiều
    dài thân (L/λ = 1), tàu phải trèo lên chính cái dốc nước nó vừa tạo ra
    — đó là hull speed, một trần vật lý không phải công suất.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const g = 9.81;
  const CURVE = '#2563eb', MARK = '#dc2626', HULL = '#f59e0b';

  // Wavelength generated by moving ship: λ = 2π·v²/g
  const wavelength = (v: number) => (2 * Math.PI * v * v) / g;
  // Hull speed for length L: v_hull = √(g·L/(2π))
  const hullSpeed = (L: number) => Math.sqrt((g * L) / (2 * Math.PI));
  // Froude number: Fr = v / √(g·L)
  const froude = (v: number, L: number) => v / Math.sqrt(g * L);

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const L = Number(input('l').value);
      const v = Number(input('v').value);
      output('l').textContent = L.toFixed(1).replace('.', ',');
      output('v').textContent = v.toFixed(1).replace('.', ',');

      const lambda = wavelength(v);
      const v_hull = hullSpeed(L);
      const Fr = froude(v, L);
      const ratio = L / lambda;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const boatY = cssH * 0.45;
      const boatLen = (L / 40) * (cssW - 100);  // Scale to fit
      const boatX = (cssW - boatLen) / 2;

      // Water surface
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.2; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, boatY); ctx.lineTo(cssW, boatY); ctx.stroke();

      // Draw waves as sinusoid
      if (lambda > 0.5) {
        ctx.strokeStyle = CURVE; ctx.globalAlpha = 0.4; ctx.lineWidth = 1.5;
        ctx.beginPath();
        const waveAmpl = 15;
        for (let x = 0; x <= cssW; x += 1) {
          const phase = (2 * Math.PI * x) / ((lambda / L) * boatLen);
          const y = boatY - waveAmpl * Math.sin(phase);
          if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      // Draw boat as simple hull
      ctx.fillStyle = '#8B4513'; ctx.globalAlpha = 0.8;
      ctx.beginPath();
      ctx.moveTo(boatX, boatY);
      ctx.lineTo(boatX + boatLen, boatY);
      ctx.lineTo(boatX + boatLen * 0.9, boatY + 20);
      ctx.lineTo(boatX + boatLen * 0.1, boatY + 20);
      ctx.closePath();
      ctx.fill();

      // Small flag at bow showing motion
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.6; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(boatX + boatLen * 0.85, boatY - 5);
      ctx.lineTo(boatX + boatLen * 0.85 + 8, boatY - 10);
      ctx.stroke();

      // Labels and axes
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '11px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`χ = ${lambda.toFixed(2)} m`, cssW / 2, 20);

      // L/λ indicator bar below boat
      const barY = boatY + 50;
      const barLen = 200;
      const barX0 = (cssW - barLen) / 2;
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.4; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(barX0, barY); ctx.lineTo(barX0 + barLen, barY); ctx.stroke();

      // L/λ value (clamped to display range)
      const ratioClamp = Math.min(ratio, 10);
      const ratioPos = barX0 + (ratioClamp / 10) * barLen;
      ctx.fillStyle = MARK; ctx.globalAlpha = 0.9;
      ctx.beginPath(); ctx.arc(ratioPos, barY, 5, 0, Math.PI * 2); ctx.fill();

      // Red line at L/λ = 1 (hull speed point)
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.5; ctx.lineWidth = 2;
      const hullPos = barX0 + (1 / 10) * barLen;
      ctx.beginPath(); ctx.moveTo(hullPos, barY - 10); ctx.lineTo(hullPos, barY + 10); ctx.stroke();

      ctx.globalAlpha = 0.6; ctx.textAlign = 'center'; ctx.fillStyle = fg;
      ctx.fillText('L/χ', barX0 - 30, barY + 4);
      ctx.fillText('0', barX0, barY + 16);
      ctx.fillText('1', hullPos, barY + 16);
      ctx.fillText('10', barX0 + barLen, barY + 16);

      // Readout line
      const regime = ratio > 1.2 ? ' · đã vượt hull speed' : ratio > 0.8 ? ' · gần hull speed' : '';
      readout.innerHTML =
        `L = <b>${L.toFixed(1).replace('.', ',')} m</b> · v = <b>${v.toFixed(2).replace('.', ',')} m/s</b> (${(v * 3.6).toFixed(1).replace('.', ',')} km/h)` +
        ` · χ = ${lambda.toFixed(2)} m · L/χ = <b>${ratio.toFixed(2).replace('.', ',')}</b> · Fr = ${Fr.toFixed(3).replace('.', ',')}` +
        ` · hull speed = <b>${v_hull.toFixed(2).replace('.', ',')} m/s</b> (${(v_hull * 3.6).toFixed(1).replace('.', ',')} km/h)${regime}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="toc-do-than-tau-va-buc-tuong-song"]').forEach(setup);
</script>
