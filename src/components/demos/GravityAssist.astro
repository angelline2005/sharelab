---
// Gravity assist (patched-conic flyby), planet frame + heliocentric frame.
// Hyperbolic excess v∞, periapsis r_p → eccentricity e = 1 + r_p·v∞²/µ,
// turn angle sin(δ/2) = 1/e, vector change |Δv| = 2·v∞·sin(δ/2)
// (Bate–Mueller–White, "Fundamentals of Astrodynamics", ch. 1 & 8).
// Heliocentric speed gain = max over approach direction of |Vp+v∞out| − |Vp+v∞in|,
// scanned numerically; it is bounded above by 2·min(v∞, v_planet).
// Exact for a two-body flyby with r_p above the surface (slider starts at 1,05 R);
// ignores solar gravity during the encounter and the planet's orbital eccentricity.
// µ, R from JPL planetary constants; v_planet = sqrt(µ_Sun/a) at mean distance.
---

<figure class="demo" data-demo="tro-luc-hap-dan-muon-toc-do-hanh-tinh">
  <canvas></canvas>
  <div class="controls">
    <label>Hành tinh <output data-out="p"></output>
      <input type="range" data-in="p" min="0" max="3" step="1" value="2" /></label>
    <label>Tốc độ tiếp cận v∞ (km/s) <output data-out="v"></output>
      <input type="range" data-in="v" min="2" max="20" step="0.01" value="10" /></label>
    <label>Cận điểm (bán kính hành tinh) <output data-out="r"></output>
      <input type="range" data-in="r" min="1.05" max="20" step="0.01" value="2" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trái: quỹ đạo hyperbol trong khung của hành tinh — tàu vào và ra cùng một
    tốc độ v∞, chỉ bị bẻ hướng một góc δ giữa hai đường tiệm cận.
    Phải: tam giác vectơ vận tốc nhìn từ Mặt Trời. Hai vectơ v∞ dài bằng nhau
    nên cùng nằm trên vòng tròn đứt nét quanh mũi vectơ vận tốc hành tinh;
    xoay nó đi δ là đủ kéo dài vectơ nhật tâm. Đoạn đỏ Δv chính là khoản lãi,
    lấy trong hình học tiếp cận có lợi nhất.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', THIRD = '#f59e0b';
  const CRAFT = 800; // kg, khối lượng tàu dùng cho phép tính giật lùi

  type Planet = { name: string; mu: number; R: number; vp: number; M: number };
  const PLANETS: Planet[] = [
    { name: 'Sao Kim', mu: 3.24859e5, R: 6051.8, vp: 35.02, M: 4.8675e24 },
    { name: 'Trái Đất', mu: 3.986004418e5, R: 6371, vp: 29.79, M: 5.9722e24 },
    { name: 'Sao Mộc', mu: 1.26686534e8, R: 71492, vp: 13.06, M: 1.8982e27 },
    { name: 'Sao Thổ', mu: 3.7931187e7, R: 60268, vp: 9.63, M: 5.6834e26 },
  ];

  const f = (x: number, d = 1) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function arrow(x0: number, y0: number, x1: number, y1: number, col: string, w: number) {
      const a = Math.atan2(y1 - y0, x1 - x0), L = Math.hypot(x1 - x0, y1 - y0);
      if (L < 1) return;
      const h = Math.min(9, L * 0.4);
      ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = w;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x1 - h * Math.cos(a - 0.4), y1 - h * Math.sin(a - 0.4));
      ctx.lineTo(x1 - h * Math.cos(a + 0.4), y1 - h * Math.sin(a + 0.4));
      ctx.closePath(); ctx.fill();
      ctx.lineWidth = 1;
    }

    function draw() {
      const pl = PLANETS[Number(input('p').value)];
      const vinf = Number(input('v').value);
      const rr = Number(input('r').value);
      const rp = rr * pl.R;
      output('p').textContent = pl.name;
      output('v').textContent = f(vinf, 2);
      output('r').textContent = f(rr, 2);

      // Hyperbolic flyby geometry.
      const e = 1 + (rp * vinf * vinf) / pl.mu;
      const sinHalf = 1 / e;
      const delta = 2 * Math.asin(sinHalf);          // rad
      const dvVec = 2 * vinf * sinHalf;              // km/s, |Δv| vectơ
      const ceiling = 2 * Math.min(vinf, pl.vp);     // trần cứng cho độ lãi tốc độ

      // Hướng tiếp cận cho độ lãi tốc độ nhật tâm lớn nhất.
      let gain = -1e9, th0 = 0;
      for (let i = 0; i < 720; i++) {
        const th = (i * 2 * Math.PI) / 720;
        const a = Math.hypot(pl.vp + vinf * Math.cos(th), vinf * Math.sin(th));
        const b = Math.hypot(pl.vp + vinf * Math.cos(th + delta), vinf * Math.sin(th + delta));
        if (b - a > gain) { gain = b - a; th0 = th; }
      }
      const vIn = { x: pl.vp + vinf * Math.cos(th0), y: vinf * Math.sin(th0) };
      const vOut = { x: pl.vp + vinf * Math.cos(th0 + delta), y: vinf * Math.sin(th0 + delta) };
      const sIn = Math.hypot(vIn.x, vIn.y), sOut = Math.hypot(vOut.x, vOut.y);
      const recoil = (CRAFT * dvVec * 1000) / pl.M; // m/s, đối ứng của |Δv| vectơ

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * (cssW < 480 ? 0.62 : 0.46));
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const halfW = cssW / 2;

      // ---------- Bảng trái: hyperbol trong khung hành tinh ----------
      const pad = 14, LT = pad, LB = cssH - 20, LL = pad, LR = halfW - pad / 2;
      const nuInf = Math.acos(-1 / e);
      const semi = rp * (1 + e);
      const rCap = 12 * rp;
      const pts: Array<[number, number]> = [];
      for (let i = 0; i <= 400; i++) {
        const nu = -nuInf * 0.999 + (2 * nuInf * 0.999 * i) / 400;
        const r = semi / (1 + e * Math.cos(nu));
        if (r > 0 && r <= rCap) pts.push([r * Math.cos(nu), r * Math.sin(nu)]);
      }
      let bx = 2.2 * pl.R, by = 2.2 * pl.R;
      for (const [x, y] of pts) { bx = Math.max(bx, Math.abs(x)); by = Math.max(by, Math.abs(y)); }
      const sc = Math.min((LR - LL) / (2.2 * bx), (LB - LT) / (2.2 * by));
      const cx = (LL + LR) / 2, cy = (LT + LB) / 2;
      const PX = (x: number) => cx + x * sc, PY = (y: number) => cy - y * sc;

      ctx.save();
      ctx.beginPath(); ctx.rect(LL, LT, LR - LL, LB - LT); ctx.clip();

      // Hai đường tiệm cận, cắt qua tâm hyperbol tại x = a·e.
      const aH = rp / (e - 1), cH = aH * e, big = 40 * Math.max(bx, by);
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.35; ctx.setLineDash([4, 4]);
      for (const s of [1, -1]) {
        const ux = Math.cos(nuInf), uy = s * Math.sin(nuInf);
        ctx.beginPath();
        ctx.moveTo(PX(cH - big * ux), PY(-big * uy));
        ctx.lineTo(PX(cH + big * ux), PY(big * uy));
        ctx.stroke();
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // Đĩa hành tinh.
      ctx.fillStyle = fg; ctx.globalAlpha = 0.18;
      ctx.beginPath(); ctx.arc(PX(0), PY(0), Math.max(2, pl.R * sc), 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.5; ctx.strokeStyle = fg;
      ctx.beginPath(); ctx.arc(PX(0), PY(0), Math.max(2, pl.R * sc), 0, Math.PI * 2); ctx.stroke();
      ctx.globalAlpha = 1;

      // Quỹ đạo.
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      pts.forEach(([x, y], i) => (i ? ctx.lineTo(PX(x), PY(y)) : ctx.moveTo(PX(x), PY(y))));
      ctx.stroke(); ctx.lineWidth = 1;
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(PX(rp), PY(0), 4, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      // Thước tỉ lệ theo bán kính hành tinh.
      let tick = 1;
      while ((bx / pl.R) / tick > 4) tick *= 2;
      const barR = tick * pl.R * sc;
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.beginPath();
      ctx.moveTo(LL + 4, LB + 4); ctx.lineTo(LL + 4 + barR, LB + 4);
      ctx.moveTo(LL + 4, LB); ctx.lineTo(LL + 4, LB + 8);
      ctx.moveTo(LL + 4 + barR, LB); ctx.lineTo(LL + 4 + barR, LB + 8);
      ctx.stroke();
      ctx.textAlign = 'left';
      ctx.fillText(`${tick} × bán kính`, LL + 8 + barR, LB + 8);
      ctx.fillText(`cận điểm ${f(rr, 2)} R · e ${f(e, 3)}`, LL + 4, LT + 10);

      // Đồng hồ góc quay δ.
      const dx = LR - 34, dy = LT + 34, dR = 22;
      ctx.globalAlpha = 0.55;
      ctx.beginPath(); ctx.moveTo(dx, dy); ctx.lineTo(dx + dR, dy); ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(dx, dy);
      ctx.lineTo(dx + dR * Math.cos(delta), dy - dR * Math.sin(delta)); ctx.stroke();
      ctx.lineWidth = 1;
      ctx.strokeStyle = MARK;
      ctx.beginPath(); ctx.arc(dx, dy, dR * 0.55, -delta, 0); ctx.stroke();
      ctx.fillStyle = MARK; ctx.textAlign = 'center';
      ctx.fillText(`δ = ${f(delta * 180 / Math.PI)}°`, dx - 4, dy + dR + 10);

      // ---------- Bảng phải: tam giác vectơ vận tốc ----------
      const RL = halfW + pad / 2, RR = cssW - pad, RT = pad, RB = cssH - 20;
      const vMax = pl.vp + vinf;
      const vs = Math.min((RR - RL) / (2.3 * vMax), (RB - RT) / (2.3 * vMax));
      const ox = (RL + RR) / 2, oy = (RT + RB) / 2;
      const VX = (x: number) => ox + x * vs, VY = (y: number) => oy - y * vs;

      ctx.save();
      ctx.beginPath(); ctx.rect(RL, RT, RR - RL, RB - RT); ctx.clip();

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(RL, VY(0)); ctx.lineTo(RR, VY(0));
      ctx.moveTo(VX(0), RT); ctx.lineTo(VX(0), RB);
      ctx.stroke();
      let vt = 5;
      while (vMax / vt > 4) vt += 5;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.55; ctx.textAlign = 'center';
      for (let k = -2; k <= 2; k++) {
        if (!k) continue;
        const q = k * vt;
        if (Math.abs(q) > 1.15 * vMax) continue;
        ctx.beginPath(); ctx.moveTo(VX(q), VY(0) - 3); ctx.lineTo(VX(q), VY(0) + 3); ctx.stroke();
        ctx.fillText(`${q}`, VX(q), VY(0) + 14);
        ctx.beginPath(); ctx.moveTo(VX(0) - 3, VY(q)); ctx.lineTo(VX(0) + 3, VY(q)); ctx.stroke();
      }
      ctx.textAlign = 'left';
      ctx.fillText('km/s', VX(0) + 5, RT + 10);
      ctx.globalAlpha = 1;

      // Vòng tròn v∞ quanh mũi vectơ vận tốc hành tinh.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.arc(VX(pl.vp), VY(0), vinf * vs, 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      arrow(VX(0), VY(0), VX(pl.vp), VY(0), fg, 1.5);
      arrow(VX(0), VY(0), VX(vIn.x), VY(vIn.y), THIRD, 2);
      arrow(VX(0), VY(0), VX(vOut.x), VY(vOut.y), CURVE, 2);
      arrow(VX(vIn.x), VY(vIn.y), VX(vOut.x), VY(vOut.y), MARK, 2);
      ctx.globalAlpha = 0.5; ctx.strokeStyle = fg;
      ctx.beginPath();
      ctx.moveTo(VX(pl.vp), VY(0)); ctx.lineTo(VX(vIn.x), VY(vIn.y));
      ctx.moveTo(VX(pl.vp), VY(0)); ctx.lineTo(VX(vOut.x), VY(vOut.y));
      ctx.stroke(); ctx.globalAlpha = 1;
      ctx.restore();

      ctx.textAlign = 'left';
      ctx.fillStyle = THIRD; ctx.fillText('trước', RL + 2, RB + 8);
      ctx.fillStyle = CURVE; ctx.fillText('sau', RL + 44, RB + 8);
      ctx.fillStyle = MARK; ctx.fillText('Δv', RL + 78, RB + 8);

      const flag = gain > 0.9 * ceiling
        ? ` · <b>đã sát trần 2·v hành tinh</b>`
        : gain < 1 ? ` · <b>gần như không lãi gì</b>` : '';
      readout.innerHTML =
        `${pl.name} (chạy ${f(pl.vp, 2)} km/s) · v∞ = ${f(vinf, 2)} km/s, cận điểm ${f(rr, 2)} R → bẻ hướng ` +
        `<b>${f(delta * 180 / Math.PI)}°</b>, đổi vectơ vận tốc ${f(dvVec)} km/s.` +
        ` Nhìn từ Mặt Trời: ${f(sIn)} → <b>${f(sOut)} km/s</b>, lãi <b>${f(gain)} km/s</b>` +
        ` (trần cứng ${f(ceiling)})${flag}.` +
        ` Tàu ${CRAFT} kg trả lại: hành tinh chậm đi ${recoil.toExponential(1).replace('.', ',')} m/s.`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="tro-luc-hap-dan-muon-toc-do-hanh-tinh"]').forEach(setup);
</script>
