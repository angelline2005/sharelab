---
// Hydrostatics in the circulatory system: Δp = ρgh with ρ_blood = 1050 kg/m³,
// expressed in mmHg. Slider = height relative to the heart; landmarks for
// feet, brain, and a giraffe's head. Static redraw.
---

<figure class="demo" data-demo="blood">
  <canvas></canvas>
  <div class="controls">
    <label>Độ cao so với tim h (m) <output data-out="h"></output>
      <input type="range" data-in="h" min="-1.5" max="2.5" step="0.05" value="0.4" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Máu là cột chất lỏng: cứ lên cao 10 cm so với tim, áp suất hụt ~8 mmHg;
    xuống thấp 10 cm, dôi ~8 mmHg. Con số huyết áp "120/80" của bạn chỉ đúng
    ở đúng một độ cao — ngang tim.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const RHO = 1050, G = 9.81, MMHG = 133.322, BASE = 93; // mean arterial ~93 mmHg at heart
  const SCALE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const MARKS: Array<[number, string]> = [
    [-1.3, 'mắt cá chân'], [0, 'tim'], [0.4, 'não người đứng'], [2, 'não hươu cao cổ'],
  ];

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="h"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="h"]') as HTMLOutputElement;

    function draw() {
      const h = Number(slider.value);
      out.textContent = h.toFixed(2).replace('.', ',');
      const dp = (-RHO * G * h) / MMHG; // above heart: negative

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Vertical body scale on the left, pressure bar on the right.
      const x0 = cssW * 0.3;
      const Y = (hh: number) => cssH * 0.86 - ((hh + 1.5) / 4) * (cssH * 0.74);

      ctx.strokeStyle = SCALE; ctx.lineWidth = 3; ctx.globalAlpha = 0.6;
      ctx.beginPath(); ctx.moveTo(x0, Y(-1.5)); ctx.lineTo(x0, Y(2.5)); ctx.stroke();
      ctx.globalAlpha = 1; ctx.lineWidth = 1;

      ctx.font = '10px system-ui,sans-serif';
      MARKS.forEach(([hh, lab]) => {
        const p = BASE - (RHO * G * hh) / MMHG;
        ctx.fillStyle = LM;
        ctx.beginPath(); ctx.arc(x0, Y(hh), 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'left';
        ctx.fillText(`${lab}: ${p.toFixed(0)} mmHg`, x0 + 12, Y(hh) + 3);
        ctx.globalAlpha = 1;
      });

      // Current marker.
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(x0, Y(h), 6, 0, Math.PI * 2); ctx.fill();

      // Pressure bar at right for the current point.
      const p = BASE + dp;
      const bx = cssW * 0.74, bw = 34, bBase = cssH * 0.86;
      const bh = Math.max(2, (Math.max(0, p) / 250) * (cssH * 0.74));
      ctx.fillStyle = MARK; ctx.globalAlpha = 0.75;
      ctx.fillRect(bx, bBase - bh, bw, bh);
      ctx.globalAlpha = 1; ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'center';
      ctx.fillText(`${p.toFixed(0)} mmHg`, bx + bw / 2, bBase - bh - 8);
      ctx.fillText('áp suất động mạch', bx + bw / 2, bBase + 14);
      ctx.fillText('trung bình tại đó', bx + bw / 2, bBase + 26);
      ctx.globalAlpha = 1;

      readout.innerHTML =
        `Tại h = ${h.toFixed(2).replace('.', ',')} m so với tim: áp suất ${dp >= 0 ? 'dôi thêm' : 'hụt đi'} ` +
        `<b>${Math.abs(dp).toFixed(0)} mmHg</b> → động mạch tại đó ~<b>${p.toFixed(0)} mmHg</b>` +
        (p < 40 ? ' — <b>não thiếu máu: ngất</b>' : '');
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="blood"]').forEach(setup);
</script>
