---
// One-dimensional collision, elastic or perfectly inelastic, with the closed
// formulas — animation replays what the algebra already fixed. Momentum is
// conserved in both; kinetic energy only in the elastic case, and the readout
// shows exactly how much the sticky collision destroys.
---

<figure class="demo" data-demo="collision">
  <canvas></canvas>
  <div class="controls">
    <label>Khối lượng xe đỏ <output data-out="m1"></output>
      <input type="range" data-in="m1" min="0.5" max="10" step="0.1" value="1" /></label>
    <label>Khối lượng xe xanh <output data-out="m2"></output>
      <input type="range" data-in="m2" min="0.5" max="10" step="0.1" value="1" /></label>
    <label class="inline"><input type="checkbox" data-in="sticky" /> Va chạm mềm (dính nhau)</label>
    <button type="button" data-btn="replay">Chạy lại</button>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Xe đỏ lao vào xe xanh đang đứng yên với 5 m/s. Mũi tên là vectơ vận tốc
    sau va chạm, tính bằng công thức đóng; hoạt cảnh chỉ chiếu lại kết quả.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; align-items: end; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls label.inline { flex-direction: row; align-items: center; gap: .4rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input[type='range'] { width: 100%; }
  .controls button { border: 1px solid rgba(128,128,128,.5); background: transparent; color: inherit; border-radius: 6px; padding: .4rem .9rem; cursor: pointer; font-size: .85rem; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const V1 = 5; // m/s, incoming speed of cart 1; cart 2 starts at rest
  const C1 = '#dc2626', C2 = '#2563eb';

  function outcome(m1: number, m2: number, sticky: boolean) {
    if (sticky) { const v = (m1 * V1) / (m1 + m2); return { v1: v, v2: v }; }
    return { v1: ((m1 - m2) * V1) / (m1 + m2), v2: (2 * m1 * V1) / (m1 + m2) };
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    // Replay state: cart positions in metres, cart 2 sits at x=0.
    let t = -1.4, collided = false, raf = 0, last = 0;

    function params() {
      const m1 = Number(input('m1').value), m2 = Number(input('m2').value);
      const sticky = input('sticky').checked;
      return { m1, m2, sticky, ...outcome(m1, m2, sticky) };
    }

    function positions(p: ReturnType<typeof params>) {
      if (t < 0) return { x1: V1 * t, x2: 0 };
      return { x1: p.v1 * t, x2: p.v2 * t };
    }

    function draw() {
      const p = params();
      output('m1').textContent = `${p.m1.toFixed(1)} kg`;
      output('m2').textContent = `${p.m2.toFixed(1)} kg`;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.3);
      if (canvas.width !== cssW * dpr) { canvas.width = cssW * dpr; canvas.height = cssH * dpr; canvas.style.height = `${cssH}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const midY = cssH * 0.55, scale = cssW / 22;
      const px = (x: number) => cssW * 0.55 + x * scale;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.25;
      ctx.beginPath(); ctx.moveTo(0, midY + 16); ctx.lineTo(cssW, midY + 16); ctx.stroke();
      ctx.globalAlpha = 1;

      const { x1, x2 } = positions(p);
      const w = (m: number) => 16 + m * 3.2; // cart size hints at mass
      const cart = (x: number, m: number, colour: string) => {
        const cw = w(m), ch = 12 + m * 1.6;
        ctx.fillStyle = colour;
        ctx.fillRect(px(x) - cw / 2, midY + 16 - ch, cw, ch);
      };
      // Keep the incoming cart from overlapping before impact.
      const gap = (w(p.m1) + w(p.m2)) / 2 / scale;
      cart(Math.min(x1, x2 - gap), p.m1, C1);
      cart(x2, p.m2, C2);

      // Post-collision velocity vectors.
      if (collided) {
        const arrow = (x: number, v: number, colour: string, dy: number) => {
          if (Math.abs(v) < 0.01) return;
          const y0 = midY - 26 + dy, len = v * scale * 0.5;
          ctx.strokeStyle = colour; ctx.fillStyle = colour; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.moveTo(px(x), y0); ctx.lineTo(px(x) + len, y0); ctx.stroke();
          const s = Math.sign(len);
          ctx.beginPath(); ctx.moveTo(px(x) + len, y0);
          ctx.lineTo(px(x) + len - 6 * s, y0 - 4); ctx.lineTo(px(x) + len - 6 * s, y0 + 4); ctx.fill();
          ctx.lineWidth = 1;
        };
        arrow(x1, p.v1, C1, 0);
        arrow(x2, p.v2, C2, -14);
      }

      const ke0 = 0.5 * p.m1 * V1 * V1;
      const ke1 = 0.5 * p.m1 * p.v1 * p.v1 + 0.5 * p.m2 * p.v2 * p.v2;
      readout.innerHTML =
        `Sau va chạm: xe đỏ <b>${p.v1.toFixed(2)}</b> · xe xanh <b>${p.v2.toFixed(2)} m/s</b> · ` +
        `động lượng <b>giữ nguyên</b> · động năng còn <b>${((ke1 / ke0) * 100).toFixed(0)}%</b>` +
        (p.sticky ? ` — phần mất thành nhiệt và biến dạng` : '');
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      t += dt * 0.9;
      if (t >= 0) collided = true;
      if (t > 1.6) { t = -1.4; collided = false; }
      draw();
    }
    const replay = () => { t = -1.4; collided = false; draw(); };

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', replay));
    (root.querySelector('[data-btn="replay"]') as HTMLButtonElement).addEventListener('click', replay);
    addEventListener('resize', draw);

    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) { last = 0; raf = requestAnimationFrame(frame); }
        else cancelAnimationFrame(raf);
      }
    });
    io.observe(root);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="collision"]').forEach(setup);
</script>
