---
// Snell's law at a single interface, drawn from the formulas: the refracted
// angle from n₁·sinθ₁ = n₂·sinθ₂ and the reflected share from the Fresnel
// equations (unpolarised average), so the ray weights are physical rather than
// decorative. Past the critical angle the transmitted ray vanishes and the
// interface becomes a perfect mirror — total internal reflection.
---

<figure class="demo" data-demo="snell">
  <canvas></canvas>
  <div class="controls">
    <label>Góc tới <output data-out="ang"></output>
      <input type="range" data-in="ang" min="0" max="89" step="0.5" value="35" /></label>
    <label>Chiết suất môi trường dưới <output data-out="n1"></output>
      <input type="range" data-in="n1" min="1.2" max="1.8" step="0.01" value="1.33" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Tia sáng đi từ môi trường chiết suất n₁ (dưới, ví dụ nước 1,33) lên mặt
    phân cách với không khí. Độ đậm của mỗi tia đúng bằng phần năng lượng nó
    mang, tính theo công thức Fresnel.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const RAY = '#dc2626', MEDIUM = '#2563eb';

  // Unpolarised Fresnel reflectance for n1 → n2 at incidence θ1.
  function reflectance(n1: number, n2: number, th1: number) {
    const s = (n1 / n2) * Math.sin(th1);
    if (s >= 1) return 1; // total internal reflection
    const th2 = Math.asin(s);
    const rs = (n1 * Math.cos(th1) - n2 * Math.cos(th2)) / (n1 * Math.cos(th1) + n2 * Math.cos(th2));
    const rp = (n1 * Math.cos(th2) - n2 * Math.cos(th1)) / (n1 * Math.cos(th2) + n2 * Math.cos(th1));
    return (rs * rs + rp * rp) / 2;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    function draw() {
      const deg = Number(input('ang').value);
      const n1 = Number(input('n1').value);
      const n2 = 1.0; // air above
      output('ang').textContent = `${deg.toFixed(1)}°`;
      output('n1').textContent = n1.toFixed(2);

      const th1 = (deg * Math.PI) / 180;
      const critDeg = (Math.asin(n2 / n1) * 180) / Math.PI;
      const tir = deg > critDeg;
      const R = reflectance(n1, n2, th1);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const cx = cssW / 2, cy = cssH / 2, L = Math.min(cssW, cssH) * 0.42;

      // Lower medium tint + interface + normal.
      ctx.fillStyle = MEDIUM; ctx.globalAlpha = 0.1;
      ctx.fillRect(0, cy, cssW, cssH - cy);
      ctx.globalAlpha = 0.4; ctx.strokeStyle = fg;
      ctx.beginPath(); ctx.moveTo(0, cy); ctx.lineTo(cssW, cy); ctx.stroke();
      ctx.setLineDash([3, 5]);
      ctx.beginPath(); ctx.moveTo(cx, cy - L); ctx.lineTo(cx, cy + L); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      const ray = (angleFromNormal: number, up: boolean, weight: number, arrowIn: boolean) => {
        if (weight < 0.005) return;
        const dx = Math.sin(angleFromNormal) * L;
        const dy = Math.cos(angleFromNormal) * L * (up ? -1 : 1);
        ctx.strokeStyle = RAY;
        ctx.globalAlpha = 0.15 + 0.85 * weight;
        ctx.lineWidth = 1 + 2.2 * weight;
        ctx.beginPath();
        if (arrowIn) { ctx.moveTo(cx - dx, cy - dy); ctx.lineTo(cx, cy); }
        else { ctx.moveTo(cx, cy); ctx.lineTo(cx + dx, cy + dy); }
        ctx.stroke();
        ctx.globalAlpha = 1; ctx.lineWidth = 1;
      };

      // Incident from lower-left; reflected back down-right; refracted up-right.
      ray(th1, false, 1, true);
      ray(-th1, false, R, false);
      if (!tir) {
        const th2 = Math.asin((n1 / n2) * Math.sin(th1));
        ray(th2, true, 1 - R, false);
      }

      ctx.fillStyle = fg; ctx.globalAlpha = 0.55;
      ctx.font = '11px system-ui,sans-serif';
      ctx.fillText('không khí (n = 1,00)', 10, cy - 10);
      ctx.fillText(`n = ${n1.toFixed(2)}`, 10, cy + 18);
      ctx.globalAlpha = 1;

      readout.innerHTML = tir
        ? `<b>Phản xạ toàn phần</b> — vượt góc tới hạn <b>${critDeg.toFixed(1)}°</b>, ` +
          `100% ánh sáng quay lại: mặt phân cách thành gương hoàn hảo.`
        : `Góc khúc xạ <b>${((Math.asin((n1 / n2) * Math.sin(th1)) * 180) / Math.PI).toFixed(1)}°</b> · ` +
          `phản xạ <b>${(R * 100).toFixed(1)}%</b>, truyền qua <b>${((1 - R) * 100).toFixed(1)}%</b> · ` +
          `góc tới hạn: <b>${critDeg.toFixed(1)}°</b>`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="snell"]').forEach(setup);
</script>
