---
// Frequency-of-seeing curve, Hecht–Shlaer–Pirenne (J. Gen. Physiol. 25, 1942).
// P(thấy) = 1 − Σ_{k<n} e^(−m)·m^k/k!  — xác suất một chớp sáng có trung bình
// m photon HẤP THỤ đạt hay vượt ngưỡng n. m = (photon tới giác mạc) × hiệu suất.
// Poisson đúng vì các photon tới độc lập nhau; hợp lệ khi m nhỏ so với số tế
// bào que trong vùng chớp (~500), lúc đó mỗi photon rơi vào một tế bào riêng.
---

<figure class="demo" data-demo="mat-nguoi-thay-duoc-bao-nhieu-photon">
  <canvas></canvas>
  <div class="controls">
    <label>Ngưỡng n (số photon phải hấp thụ) <output data-out="n"></output>
      <input type="range" data-in="n" min="1" max="20" step="1" value="6" /></label>
    <label>Photon tới giác mạc mỗi chớp <output data-out="q"></output>
      <input type="range" data-in="q" min="20" max="200" step="1" value="90" /></label>
    <label>Hiệu suất hấp thụ (%) <output data-out="e"></output>
      <input type="range" data-in="e" min="5" max="15" step="0.5" value="7" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trục ngang (thang log) là số photon <em>hấp thụ</em> trung bình mỗi chớp;
    trục dọc là tỉ lệ số lần bạn báo "thấy". Đường xanh là ngưỡng bạn đang
    chọn, hai đường cam là n = 2 và n = 12 để so sánh. Ngưỡng càng cao đường
    càng dốc — và chính độ dốc ấy, chứ không phải máy đếm photon nào, là thứ
    Hecht dùng để đọc ra con số ngưỡng của mắt người năm 1942.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', REF = '#f59e0b';
  const MMIN = 1, MMAX = 30;

  // P(K >= n) với K ~ Poisson(m), cộng dồn từng số hạng để khỏi tràn giai thừa.
  const seen = (n: number, m: number) => {
    let term = Math.exp(-m), sum = 0;
    for (let k = 0; k < n; k++) { sum += term; term *= m / (k + 1); }
    return 1 - sum;
  };
  // Cường độ m cho xác suất thấy p (chia đôi — seen() tăng đơn điệu theo m).
  const invSeen = (n: number, p: number) => {
    let lo = 1e-6, hi = 300;
    for (let i = 0; i < 60; i++) { const mid = (lo + hi) / 2; if (seen(n, mid) < p) lo = mid; else hi = mid; }
    return (lo + hi) / 2;
  };
  const vi = (x: number, d = 1) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const n = Number(input('n').value);
      const q = Number(input('q').value);
      const eff = Number(input('e').value);
      output('n').textContent = String(n);
      output('q').textContent = String(q);
      output('e').textContent = vi(eff);

      const m = q * eff / 100;
      const p = seen(n, m);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 42, padB = 28, padT = 14, padR = cssW < 420 ? 26 : 12;
      const LOG = Math.log(MMAX / MMIN);
      const X = (mm: number) => padL + (Math.log(mm / MMIN) / LOG) * (cssW - padL - padR);
      const Y = (pp: number) => padT + (1 - pp) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.18; ctx.setLineDash([4, 4]);
      for (const pp of [0.1, 0.9]) { ctx.beginPath(); ctx.moveTo(padL, Y(pp)); ctx.lineTo(cssW - padR, Y(pp)); ctx.stroke(); }
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const t of [1, 2, 3, 5, 10, 20, 30]) ctx.fillText(String(t), X(t), cssH - padB + 14);
      ctx.fillText('photon hấp thụ trung bình mỗi chớp', (padL + cssW) / 2, cssH - padB + 25);
      ctx.textAlign = 'right';
      for (const pp of [0, 0.25, 0.5, 0.75, 1]) ctx.fillText(`${pp * 100}%`, padL - 4, Y(pp) + 3);
      ctx.globalAlpha = 1;

      const curve = (nn: number, color: string, width: number, alpha: number) => {
        ctx.strokeStyle = color; ctx.lineWidth = width; ctx.globalAlpha = alpha;
        ctx.beginPath();
        for (let i = 0; i <= 240; i++) {
          const mm = MMIN * Math.pow(MMAX / MMIN, i / 240);
          i ? ctx.lineTo(X(mm), Y(seen(nn, mm))) : ctx.moveTo(X(mm), Y(seen(nn, mm)));
        }
        ctx.stroke(); ctx.globalAlpha = 1; ctx.lineWidth = 1;
      };

      for (const nn of [2, 12]) {
        curve(nn, REF, 1.2, 0.65);
        ctx.fillStyle = REF; ctx.globalAlpha = 0.9; ctx.font = '10px system-ui,sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(`n = ${nn}`, X(invSeen(nn, 0.5)) + 4, Y(0.5) - 5);
        ctx.globalAlpha = 1;
      }
      curve(n, CURVE, 2.2, 1);
      ctx.fillStyle = CURVE; ctx.textAlign = 'right';
      ctx.fillText(`ngưỡng đang chọn: n = ${n}`, cssW - padR, padT + 10);

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(Math.min(Math.max(m, MMIN), MMAX)), Y(p), 6, 0, Math.PI * 2); ctx.fill();

      const ratio = invSeen(n, 0.9) / invSeen(n, 0.1);
      const other = n === 2 ? 12 : 2;
      readout.innerHTML =
        `Ngưỡng n = <b>${n}</b> · ${q} photon tới giác mạc × ${vi(eff)}% → trung bình ` +
        `<b>${vi(m)} photon hấp thụ</b> → thấy <b>${vi(100 * p)}%</b> số lần chớp` +
        ` · cùng chớp ấy với ngưỡng n = ${other}: ${vi(100 * seen(other, m))}%` +
        `<br />Từ "thấy 10%" lên "thấy 90%" chỉ cần tăng cường độ <b>${vi(ratio, 2)}×</b>` +
        (n >= 4 ? ' — đường dốc như vậy là dấu vân tay của ngưỡng cao' : ' — đường thoải, ngưỡng thấp');
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="mat-nguoi-thay-duoc-bao-nhieu-photon"]').forEach(setup);
</script>
