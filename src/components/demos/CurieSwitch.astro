---
// Nồi cơm điện + công tắc điểm Curie.
// (1) Hồ sơ nhiệt độ đáy nồi, mô hình cân bằng năng lượng đơn giản:
//     t1 = (C + m·c_w)·(100 − 25)/P   — hâm nước + nồi lên điểm sôi
//     t2 = m·L_v/P                    — quãng "khoá" bay hơi ở 100 °C
//     t3 = C·(T_C − 100)/P            — leo nốt tới điểm Curie sau khi cạn
//     C = 4 400 J/K (nồi nhôm 0,5 kg + ~1,2 kg cơm ẩm), c_w = 4 186 J/(kg·K),
//     L_v = 2 257 kJ/kg (nước, 100 °C, 101,325 kPa). Bỏ qua tổn thất ra vỏ nồi,
//     nên t1/t2 là cận dưới của thời gian thật.
// (2) Từ độ theo luật trường trung bình (Weiss): M/M₀ = √(1 − T/T_C), T tính
//     bằng KELVIN. Đây là dạng tiệm cận chỉ đúng sát T_C (β = 1/2); ferrite
//     thật có β ≈ 0,36 nên tụt thoải hơn một chút ở xa T_C. Dùng để thấy hình
//     dạng "vách đứng", không phải để tra giá trị chính xác.
// Miền hợp lệ: áp suất thường (điểm sôi 100 °C). Đổi áp suất là mốc 100 °C đổi
// theo, xem phần "trường hợp biên" của bài.
---

<figure class="demo" data-demo="noi-com-dien-va-nam-cham-quen-tu-tinh">
  <canvas></canvas>
  <div class="controls">
    <label>Nước tự do trong nồi (g) <output data-out="m"></output>
      <input type="range" data-in="m" min="20" max="300" step="5" value="100" /></label>
    <label>Công suất mâm nhiệt (W) <output data-out="p"></output>
      <input type="range" data-in="p" min="300" max="900" step="25" value="600" /></label>
    <label>Điểm Curie của viên ferrite (°C) <output data-out="tc"></output>
      <input type="range" data-in="tc" min="95" max="115" step="1" value="103" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh là nhiệt độ đáy nồi theo thời gian: leo lên, rồi <b>nằm ngang</b>
    suốt quãng nước bay hơi — mâm nhiệt vẫn rót đủ công suất nhưng nhiệt ẩn nuốt
    hết. Đường cam là từ độ của viên nam châm, tụt về 0 đúng tại điểm Curie.
    Chấm đỏ là chỗ đường xanh cắt ngưỡng Curie: khoảnh khắc nam châm buông và lò
    xo đẩy công tắc sang chế độ hâm. Kéo điểm Curie xuống dưới 100 °C để xem
    công tắc bật khi nước còn nguyên.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', MAG = '#f59e0b';
  const LV = 2257000, CW = 4186, CPOT = 4400, TSTART = 25, TBOIL = 100, ZERO = 273.15;
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const mg = Number(input('m').value), P = Number(input('p').value), TC = Number(input('tc').value);
      output('m').textContent = String(mg);
      output('p').textContent = String(P);
      output('tc').textContent = String(TC);

      const m = mg / 1000;
      const t1 = (CPOT + m * CW) * (TBOIL - TSTART) / P;
      const t2 = m * LV / P;
      const t3 = CPOT * (TC - TBOIL) / P;
      const tEnd = t1 + t2 + CPOT * 15 / P;
      const early = TC <= TBOIL;
      const tCut = early ? t1 * (TC - TSTART) / (TBOIL - TSTART) : t1 + t2 + t3;

      const temp = (t: number) =>
        t <= t1 ? TSTART + (TBOIL - TSTART) * t / t1
          : t <= t1 + t2 ? TBOIL
            : TBOIL + (t - t1 - t2) * P / CPOT;
      const mag = (t: number) => Math.sqrt(Math.max(0, 1 - (temp(t) + ZERO) / (TC + ZERO)));

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 42, padR = cssW < 420 ? 26 : 52, padT = 16, padB = 26;
      const X = (t: number) => padL + (t / tEnd) * (cssW - padL - padR);
      const Y = (T: number) => padT + ((120 - T) / 100) * (cssH - padT - padB);
      const YM = (u: number) => padT + (1 - u) * (cssH - padT - padB);

      ctx.font = '10px system-ui,sans-serif';
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cssW - padR, padT); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();

      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'right';
      for (const T of [25, 50, 75, 100]) ctx.fillText(`${T}°`, padL - 4, Y(T) + 3);
      ctx.textAlign = 'center';
      const mins = tEnd / 60;
      const stepMin = mins > 40 ? 10 : mins > 16 ? 5 : mins > 8 ? 2 : 1;
      for (let k = 0; k * stepMin * 60 <= tEnd; k++) ctx.fillText(`${k * stepMin}`, X(k * stepMin * 60), cssH - padB + 14);
      ctx.textAlign = 'left';
      ctx.fillText('phút', padL + 2, cssH - padB + 14);
      ctx.globalAlpha = 1;

      ctx.fillStyle = MAG; ctx.globalAlpha = 0.75; ctx.textAlign = 'left';
      for (const u of [0, 0.5, 1]) ctx.fillText(`${u * 100}%`, cssW - padR + 5, YM(u) + 3);
      ctx.globalAlpha = 1;

      // Ngưỡng Curie.
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.6; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(padL, Y(TC)); ctx.lineTo(cssW - padR, Y(TC)); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;
      ctx.fillStyle = MARK; ctx.textAlign = 'left';
      ctx.fillText(`điểm Curie ${TC} °C`, padL + 5, Y(TC) - 5);

      // Từ độ M/M₀.
      ctx.strokeStyle = MAG; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const t = (tEnd * i) / 240;
        i ? ctx.lineTo(X(t), YM(mag(t))) : ctx.moveTo(X(t), YM(mag(t)));
      }
      ctx.stroke();

      // Nhiệt độ đáy nồi.
      ctx.strokeStyle = CURVE; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const t = (tEnd * i) / 240;
        i ? ctx.lineTo(X(t), Y(temp(t))) : ctx.moveTo(X(t), Y(temp(t)));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = CURVE; ctx.textAlign = 'left';
      ctx.fillText('nhiệt độ đáy nồi', padL + 5, Y(TSTART) - 6);
      ctx.fillStyle = MAG;
      ctx.fillText('từ độ M/M₀', padL + 5, YM(mag(0)) - 6);

      // Nhãn quãng khoá.
      if (X(t1 + t2) - X(t1) > 46) {
        ctx.fillStyle = fg; ctx.globalAlpha = 0.75; ctx.textAlign = 'center';
        ctx.fillText(`khoá ${vn(t2 / 60, 1)} phút`, (X(t1) + X(t1 + t2)) / 2, Y(TBOIL) - 6);
        ctx.globalAlpha = 1;
      }

      // Điểm ngắt.
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.45; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(X(tCut), Y(TC)); ctx.lineTo(X(tCut), cssH - padB); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(tCut), Y(TC), 6, 0, Math.PI * 2); ctx.fill();

      const head = `${mg} g nước tự do · ${P} W · điểm Curie ${TC} °C → `;
      readout.innerHTML = early
        ? head + `nam châm buông ngay ở <b>${TC} °C</b>, phút thứ ${vn(tCut / 60, 1)} — ` +
          `<b>nồi tắt khi ${mg} g nước còn nguyên trong lòng, cơm sống</b>`
        : head + `đáy nồi bị ghim ở 100 °C suốt <b>${vn(t2 / 60, 1)} phút</b>, cạn nước rồi leo ` +
          `${TC - TBOIL} °C nữa mất <b>${vn(t3, 0)} giây</b> — công tắc bật ở phút thứ ${vn(tCut / 60, 1)}` +
          (t3 > 60 ? ' · <b>vùng cháy đáy: nung khô hơn một phút</b>' : '');
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="noi-com-dien-va-nam-cham-quen-tu-tinh"]').forEach(setup);
</script>
