---
// Block and tackle: n supporting rope strands → hand force W/n, rope pulled
// n× the lift height. Slider picks n; the sketch draws the strands and the
// load. Static redraw.
---

<figure class="demo" data-demo="pulley">
  <canvas></canvas>
  <div class="controls">
    <label>Số nhánh dây đỡ vật n <output data-out="n"></output>
      <input type="range" data-in="n" min="1" max="6" step="1" value="4" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Vật 100 kg treo trên n nhánh dây — mỗi nhánh chỉ phải giữ 1/n trọng
    lượng, và tay bạn cầm đúng một nhánh. Đổi lại, nâng vật 1 mét phải thu
    về n mét dây: cùng bản hợp đồng lực-đổi-đường-đi của đòn bẩy.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const ROPE = '#2563eb', LOAD = '#f59e0b', HAND = '#dc2626';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="n"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="n"]') as HTMLOutputElement;

    function draw() {
      const n = Number(slider.value);
      out.textContent = String(n);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.4);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const topY = 18, cx = cssW * 0.42;
      const span = Math.min(cssW * 0.3, 30 + n * 18);
      // Ceiling.
      ctx.strokeStyle = fg; ctx.lineWidth = 3; ctx.globalAlpha = 0.5;
      ctx.beginPath(); ctx.moveTo(cx - span, topY); ctx.lineTo(cx + span + 40, topY); ctx.stroke();
      ctx.globalAlpha = 1; ctx.lineWidth = 1;

      const blockY = cssH * 0.6;
      // n strands between ceiling and load block.
      ctx.strokeStyle = ROPE; ctx.lineWidth = 2;
      for (let i = 0; i < n; i++) {
        const x = cx - span * 0.8 + (i * span * 1.6) / Math.max(1, n - 1 || 1);
        const xs = n === 1 ? cx : x;
        ctx.beginPath(); ctx.moveTo(xs, topY); ctx.lineTo(xs, blockY); ctx.stroke();
        // small pulley wheels at alternating ends
        ctx.fillStyle = fg; ctx.globalAlpha = 0.45;
        ctx.beginPath(); ctx.arc(xs, i % 2 === 0 ? topY + 4 : blockY - 4, 5, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
      }
      // Hand rope off the last pulley.
      const hx = cx + span + 26;
      ctx.strokeStyle = HAND;
      ctx.beginPath(); ctx.moveTo(cx + span * 0.8, topY); ctx.lineTo(hx, topY); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(hx, topY); ctx.lineTo(hx, cssH * 0.5); ctx.stroke();
      ctx.fillStyle = HAND;
      ctx.beginPath(); ctx.moveTo(hx, cssH * 0.5 + 8); ctx.lineTo(hx - 5, cssH * 0.5 - 2); ctx.lineTo(hx + 5, cssH * 0.5 - 2); ctx.fill();
      ctx.lineWidth = 1;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`tay kéo ${(100 / n).toFixed(1).replace('.', ',')} kg`, hx, cssH * 0.5 + 24);
      ctx.globalAlpha = 1;

      // Load.
      ctx.fillStyle = LOAD; ctx.globalAlpha = 0.85;
      ctx.fillRect(cx - 30, blockY, 60, 34);
      ctx.globalAlpha = 1; ctx.fillStyle = '#00000090';
      ctx.font = 'bold 11px system-ui,sans-serif';
      ctx.fillText('100 kg', cx, blockY + 21);

      readout.innerHTML =
        `n = ${n} nhánh: tay chỉ cần <b>${(100 / n).toFixed(1).replace('.', ',')} kg lực</b>` +
        ` · nâng vật 1 m phải kéo <b>${n} m dây</b> — công hai đầu bằng nhau`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="pulley"]').forEach(setup);
</script>
