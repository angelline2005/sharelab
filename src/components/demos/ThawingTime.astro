---
// Plank's equation for an infinite slab, applied to THAWING:
//   t = (ρ·L_f / ΔT) · ( a/(2h) + a²/(8k) )
// ρ = 1050 kg/m³, L_f = 250 kJ/kg (thịt nạc ~75% nước), k = 0,48 W/m·K
// (thịt ĐÃ TAN — lớp dẫn nhiệt khi rã đông là lớp ngoài đã tan, không
// phải lõi còn đông), ΔT = T_môi trường − T_đóng băng với T_f = −1 °C.
// Nguồn: Plank 1913; hằng số vật liệu theo ASHRAE Refrigeration Handbook,
// chương Thermal Properties of Foods.
// Miền hợp lệ: tấm phẳng dày a, hai mặt cùng trao đổi nhiệt, thịt xuất
// phát ở đúng điểm đóng băng, bỏ qua nhiệt hiện. Sai số thực tế 10–20%,
// và luôn là ước lượng THIẾU với miếng thịt bắt đầu từ −18 °C.
---

<figure class="demo" data-demo="ra-dong-thit-ngam-nuoc-nhanh-gap-bay-lan">
  <canvas></canvas>
  <div class="controls">
    <label>Bề dày miếng thịt (cm) <output data-out="a"></output>
      <input type="range" data-in="a" min="1" max="12" step="0.1" value="2" /></label>
    <label>Hệ số truyền nhiệt mặt h (W/m²K) <output data-out="h"></output>
      <input type="range" data-in="h" min="5" max="200" step="1" value="100" /></label>
    <label>Nhiệt độ môi trường (°C) <output data-out="t"></output>
      <input type="range" data-in="t" min="4" max="35" step="1" value="20" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh là thời gian rã đông theo bề dày ở hệ số truyền nhiệt bạn
    chọn; hai đường mờ là hai mốc quen thuộc — không khí lặng (h ≈ 8) và
    ngâm nước (h ≈ 100). Thanh ngang phía trên tách thời gian thành phần
    "qua lớp mặt" và phần "vào ruột". Đổi h là đổi môi trường chứ không
    đổi nhiệt độ: cùng 20 °C, hai đường cách nhau nhiều lần.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', ALT = '#f59e0b';
  const RHO = 1050, LF = 250000, K = 0.48, TFRZ = -1;

  // Hai số hạng của Plank, tính bằng giây. a mét, h W/m²K, T °C.
  const surf = (a: number, h: number, T: number) => (RHO * LF / (T - TFRZ)) * (a / (2 * h));
  const core = (a: number, T: number) => (RHO * LF / (T - TFRZ)) * (a * a / (8 * K));
  const plank = (a: number, h: number, T: number) => surf(a, h, T) + core(a, T);

  const vi = (x: number, d: number) => x.toFixed(d).replace('.', ',');
  function dur(s: number) {
    if (s < 3600) return `${vi(s / 60, 0)} phút`;
    if (s < 48 * 3600) return `${vi(s / 3600, 1)} giờ`;
    return `${vi(s / 86400, 1)} ngày`;
  }
  function niceMax(v: number) {
    const e = Math.pow(10, Math.floor(Math.log10(v)));
    const m = v / e;
    const s = m <= 1 ? 1 : m <= 2 ? 2 : m <= 4 ? 4 : m <= 5 ? 5 : 10;
    return s * e;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const aCm = Number(input('a').value);
      const h = Number(input('h').value);
      const T = Number(input('t').value);
      const a = aCm / 100;
      output('a').textContent = vi(aCm, 1);
      output('h').textContent = String(h);
      output('t').textContent = String(T);

      const tS = plank(a, h, T);
      const fSurf = surf(a, h, T) / tS;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 50, padB = 26, padT = 40, padR = 12;
      const hoursAt12 = Math.max(plank(0.12, h, T), plank(0.12, 8, T)) / 3600;
      const yMax = niceMax(hoursAt12);
      const X = (cm: number) => padL + ((cm - 1) / 11) * (cssW - padL - padR);
      const Y = (hr: number) => padT + (1 - Math.min(hr, yMax) / yMax) * (cssH - padB - padT);

      // Trục.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB);
      ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const cm of [2, 4, 6, 8, 10, 12]) ctx.fillText(`${cm} cm`, X(cm), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (let i = 1; i <= 4; i++) {
        const hr = (yMax * i) / 4;
        ctx.fillText(hr >= 10 ? `${vi(hr, 0)} h` : `${vi(hr, 1)} h`, padL - 4, Y(hr) + 3);
      }
      ctx.globalAlpha = 1;

      // Hai đường mốc: không khí lặng và ngâm nước.
      const refs: Array<[number, string]> = [[8, 'không khí lặng'], [100, 'ngâm nước']];
      ctx.setLineDash([4, 3]); ctx.globalAlpha = 0.35; ctx.strokeStyle = fg;
      for (const [hr0, lab] of refs) {
        ctx.beginPath();
        for (let i = 0; i <= 160; i++) {
          const cm = 1 + (11 * i) / 160;
          const y = Y(plank(cm / 100, hr0, T) / 3600);
          i ? ctx.lineTo(X(cm), y) : ctx.moveTo(X(cm), y);
        }
        ctx.stroke();
        const yEnd = Y(plank(0.12, hr0, T) / 3600);
        ctx.textAlign = 'right'; ctx.fillStyle = fg;
        ctx.fillText(lab, cssW - padR - 2, Math.max(yEnd - 5, padT + 9));
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // Đường cong ở h đang chọn.
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 220; i++) {
        const cm = 1 + (11 * i) / 220;
        const y = Y(plank(cm / 100, h, T) / 3600);
        i ? ctx.lineTo(X(cm), y) : ctx.moveTo(X(cm), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Chấm đỏ ở bề dày đang chọn.
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(aCm), Y(tS / 3600), 6, 0, Math.PI * 2); ctx.fill();

      // Thanh tách hai số hạng, góc trên bên trái.
      const bx = padL + 4, by = 12, bw = Math.min(220, (cssW - padL - padR) * 0.5), bh = 12;
      ctx.fillStyle = CURVE; ctx.fillRect(bx, by, bw * fSurf, bh);
      ctx.fillStyle = ALT; ctx.fillRect(bx + bw * fSurf, by, bw * (1 - fSurf), bh);
      ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'left';
      ctx.fillText(`qua mặt ${vi(100 * fSurf, 0)}% · vào ruột ${vi(100 - 100 * fSurf, 0)}%`,
        bx, by + bh + 11);
      ctx.globalAlpha = 1;

      const moi = h <= 12 ? 'không khí lặng' : h <= 40 ? 'không khí có quạt'
        : h <= 130 ? 'ngâm nước' : 'nước chảy / đảo liên tục';
      const risk = T >= 20 && tS > 2 * 3600
        ? ' · <b>bề mặt nằm quá 2 giờ trong vùng vi khuẩn</b>' : '';
      readout.innerHTML =
        `Dày ${vi(aCm, 1)} cm · ${moi} (h = ${h}) · môi trường ${T} °C → rã đông <b>${dur(tS)}</b>` +
        ` · qua lớp mặt chiếm ${vi(100 * fSurf, 0)}% thời gian${risk}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="ra-dong-thit-ngam-nuoc-nhanh-gap-bay-lan"]').forEach(setup);
</script>
