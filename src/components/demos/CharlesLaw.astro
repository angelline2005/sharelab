---
// Charles's law under Chuong trinh GDPT 2018: the ISOBARIC process, V/T = const.
// V(T) = nRT/p, a straight line through the origin of the Kelvin axis.
// Slope dV/dT = nR/p, so changing p ROTATES the line about T = 0 K without
// moving the intercept. Solid over 200-500 K (where the sample is honestly a
// gas); dashed from 0 K up to 200 K, so the crossing at -273,15 C reads as a
// consequence of the straight line rather than as a definition.
// Ghost lines at the two pressure extremes (50 and 200 kPa) at the current n.
// Check against scripts/verify-vatly12.mjs section 3: at n = 1 mol the slope is
// 1.663e-1 L/K at 50 kPa, 8.314e-2 L/K at 100 kPa, 4.157e-2 L/K at 200 kPa.
---

<figure class="demo" data-demo="dinh-luat-charles-dang-ap-va-do-khong-tuyet-doi">
  <canvas></canvas>
  <div class="controls">
    <label>Nhiệt độ T (K) <output data-out="t"></output>
      <input type="range" data-in="t" min="200" max="500" step="5" value="300" /></label>
    <label>Áp suất p (kPa) — giữ không đổi <output data-out="p"></output>
      <input type="range" data-in="p" min="50" max="200" step="5" value="100" /></label>
    <label>Lượng khí n (mol) <output data-out="n"></output>
      <input type="range" data-in="n" min="0.6" max="1.2" step="0.05" value="1" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh là quá trình đẳng áp: kéo thanh nhiệt độ, điểm đỏ chạy dọc một
    đường thẳng. Kéo thanh áp suất, đường thẳng <em>xoay</em> — dốc hơn khi p
    nhỏ, thoải hơn khi p lớn — nhưng chân nó vẫn ghim ở đúng một chỗ. Đoạn nét
    đứt dưới 200 K là phần ngoại suy: đường thẳng vẫn vẽ tiếp theo mô hình, còn
    khí thật thì rời khỏi nó trước khi tới 0 K — không khí hoá lỏng ở khoảng 80 K.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', GHOST = '#f59e0b';
  const R = 8.314;      // J/(mol*K)
  const T0 = 273.15;    // K
  const T_MAX = 500, V_MAX = 105, T_SOLID = 200;

  // V in litres from p in kPa.
  const volL = (n: number, p: number, T: number) => (n * R * T) / p;
  // House number style: decimal comma, and a true minus U+2212 in rendered
  // output. Written as an escape so this source file stays pure ASCII — a
  // literal minus character pasted into a script has broken this build before.
  const MINUS = '\u2212';
  const vi = (x: number, d: number) => x.toFixed(d).replace('.', ',').replace('-', MINUS);

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const T = Number(input('t').value);
      const p = Number(input('p').value);
      const n = Number(input('n').value);
      output('t').textContent = String(T);
      output('p').textContent = String(p);
      output('n').textContent = vi(n, 2);

      const V = volL(n, p, T);
      const slope = volL(n, p, 1);   // dV/dT = nR/p, in L/K

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.56);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      const small = cssW < 420;
      const font = small ? '9px system-ui,sans-serif' : '10px system-ui,sans-serif';

      const padL = 52, padB = 42, padT = 16, padR = small ? 30 : 14;
      const X = (t: number) => padL + (t / T_MAX) * (cssW - padL - padR);
      const Y = (v: number) => padT + ((V_MAX - v) / V_MAX) * (cssH - padB - padT);

      // Axes. X(0) and Y(0) land exactly on the corner, which is the pivot.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB);
      ctx.stroke();

      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = font;
      ctx.textAlign = 'center';
      for (const k of [0, 100, 200, 300, 400, 500]) {
        ctx.fillText(String(k), X(k), cssH - padB + 14);
        ctx.fillText(vi(k - T0, 0), X(k), cssH - padB + 27);
      }
      ctx.textAlign = 'left';
      ctx.fillText('K', 2, cssH - padB + 14);
      ctx.fillText('°C', 2, cssH - padB + 27);
      ctx.textAlign = 'right';
      for (const v of [0, 20, 40, 60, 80, 100]) ctx.fillText(`${v} L`, padL - 5, Y(v) + 3);
      ctx.globalAlpha = 1;

      // Ghost lines at the two ends of the pressure slider, same n.
      ctx.strokeStyle = GHOST; ctx.globalAlpha = 0.5; ctx.lineWidth = 1.5;
      for (const gp of [50, 200]) {
        ctx.beginPath(); ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(T_MAX), Y(volL(n, gp, T_MAX))); ctx.stroke();
      }
      ctx.fillStyle = GHOST; ctx.font = font; ctx.textAlign = 'right';
      ctx.fillText('50 kPa', cssW - padR - 2, Y(volL(n, 50, T_MAX)) + 11);
      ctx.fillText('200 kPa', cssW - padR - 2, Y(volL(n, 200, T_MAX)) - 5);
      ctx.globalAlpha = 1;

      // The isobar itself: dashed below 200 K, where a schoolroom apparatus
      // cannot go and a real gas leaves the line (air condenses near 80 K).
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
      ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(T_SOLID), Y(volL(n, p, T_SOLID))); ctx.stroke();
      ctx.setLineDash([]);
      ctx.beginPath(); ctx.moveTo(X(T_SOLID), Y(volL(n, p, T_SOLID))); ctx.lineTo(X(T_MAX), Y(volL(n, p, T_MAX))); ctx.stroke();
      ctx.lineWidth = 1;

      // Droplines from the marker to both axes.
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.45; ctx.setLineDash([2, 3]);
      ctx.beginPath();
      ctx.moveTo(X(T), cssH - padB); ctx.lineTo(X(T), Y(V)); ctx.lineTo(padL, Y(V));
      ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(T), Y(V), 5.5, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(X(0), Y(0), 3.5, 0, Math.PI * 2); ctx.fill();

      ctx.fillStyle = fg; ctx.globalAlpha = 0.6; ctx.textAlign = 'left'; ctx.font = font;
      ctx.fillText('mọi đường cùng chụm về 0 K', padL + 7, cssH - padB - 9);
      ctx.globalAlpha = 1;

      const mant = slope.toExponential(3).split('e');
      readout.innerHTML =
        `n = ${vi(n, 2)} mol · p = ${p} kPa · T = ${T} K (tức ${vi(T - T0, 1)} °C) ` +
        `→ V = <b>${vi(V, 1)} L</b> · V/T = <b>${mant[0].replace('.', ',')}·10<sup>${mant[1].replace('-', MINUS)}</sup> L/K</b>` +
        ` — kéo thanh nhiệt độ, V đổi nhưng V/T thì không.`;
    }

    root.querySelectorAll('input').forEach((el) => {
      el.addEventListener('input', draw);
      el.addEventListener('change', draw);
    });
    addEventListener('resize', draw);
    draw();
  }
  document
    .querySelectorAll<HTMLElement>('[data-demo="dinh-luat-charles-dang-ap-va-do-khong-tuyet-doi"]')
    .forEach(setup);
</script>
