---
// Fan/pump scaling law: Q ∝ n, Δp ∝ n², P ∝ n³
// Source: Centrifugal fan/pump similarity laws from ISO 1768, BS 848
// Validity: steady-state operation at constant conditions. Valid from ~40% to 100% speed.
---

<figure class="demo" data-demo="quat-tran-giam-toc-mot-nac-cat-nua-dien">
  <canvas></canvas>
  <div class="controls">
    <label>Tốc độ so với định mức (%) <output data-out="n"></output>
      <input type="range" data-in="n" min="40" max="100" step="1" value="100" /></label>
    <label>Công suất định mức (W) <output data-out="p0"></output>
      <input type="range" data-in="p0" min="30" max="150" step="10" value="75" /></label>
    <label>Giờ chạy mỗi ngày (h) <output data-out="hrs"></output>
      <input type="range" data-in="hrs" min="2" max="24" step="1" value="10" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Lưu lượng tỉ lệ tốc độ (đường xanh), áp suất tỉ lệ bình phương (đường cam),
    công suất tỉ lệ lập phương (đường đỏ). Ba đường cùng xuất phát từ 100% tốc
    độ ở góc phải. Bên cạnh là chi phí điện hàng tháng ở hai chế độ: định mức
    và tốc độ hiện tại. Giảm tốc 20% từ 75 W cắt 48,8% công suất — từ 56 000
    đồng xuống còn 28 800 đồng mỗi tháng.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE_Q = '#2563eb', CURVE_P = '#dc2626', CURVE_DP = '#f59e0b';
  const COST_RATE = 2500; // VND per kWh (matches article example)

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const n = Number(input('n').value) / 100; // speed ratio 0.4 to 1.0
      const p0 = Number(input('p0').value); // nominal power in W
      const hrs = Number(input('hrs').value); // hours per day

      output('n').textContent = String(Number(input('n').value));
      output('p0').textContent = String(p0);
      output('hrs').textContent = String(hrs);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.44);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 48, padB = 26, padT = 12, padR = 10;
      const X = (nn: number) => padL + ((nn - 0.4) / 0.6) * (cssW - padL - padR);
      const Y = (val: number) => padT + ((1 - val) / 1.0) * (cssH - padB - padT);

      // Axes
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const pct of [40, 60, 80, 100]) ctx.fillText(`${pct}%`, X(pct / 100), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const val of [0, 0.25, 0.5, 0.75, 1]) ctx.fillText(`${(val * 100).toFixed(0)}%`, padL - 4, Y(val) + 3);
      ctx.globalAlpha = 1;

      // Draw three curves: Q (linear), Δp (quadratic), P (cubic)
      const drawCurve = (fn: (nn: number) => number, color: string) => {
        ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.beginPath();
        for (let i = 0; i <= 200; i++) {
          const nn = 0.4 + (0.6 * i) / 200;
          const y = Y(fn(nn));
          i ? ctx.lineTo(X(nn), y) : ctx.moveTo(X(nn), y);
        }
        ctx.stroke(); ctx.lineWidth = 1;
      };

      drawCurve((nn) => nn, CURVE_Q);  // Flow ∝ n
      drawCurve((nn) => nn * nn, CURVE_DP);  // Pressure ∝ n²
      drawCurve((nn) => nn * nn * nn, CURVE_P);  // Power ∝ n³

      // Mark current point on all three curves
      const q_curr = n;
      const dp_curr = n * n;
      const p_curr = n * n * n;

      ctx.fillStyle = CURVE_Q;
      ctx.beginPath(); ctx.arc(X(n), Y(q_curr), 5, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = CURVE_DP;
      ctx.beginPath(); ctx.arc(X(n), Y(dp_curr), 5, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = CURVE_P;
      ctx.beginPath(); ctx.arc(X(n), Y(p_curr), 5, 0, Math.PI * 2); ctx.fill();

      // Cost calculation
      const power_curr = p0 * p_curr; // current power in W
      const kwh_day_curr = (power_curr / 1000) * hrs;
      const kwh_month_curr = kwh_day_curr * 30;
      const cost_month_curr = kwh_month_curr * COST_RATE;

      const kwh_month_full = (p0 / 1000) * hrs * 30;
      const cost_month_full = kwh_month_full * COST_RATE;

      // Draw bars below for cost comparison
      const bar_y = cssH - 3;
      const bar_h = 8;
      const bar_w = (cssW - padL - padR) / 4;
      const bar_x1 = padL + bar_w;
      const bar_x2 = padL + bar_w * 3;

      ctx.globalAlpha = 0.3;
      ctx.fillStyle = CURVE_P;
      ctx.fillRect(bar_x1, bar_y - bar_h, Math.min(cost_month_full / 100000 * bar_w, bar_w), bar_h);
      ctx.fillRect(bar_x2, bar_y - bar_h, Math.min(cost_month_curr / 100000 * bar_w, bar_w), bar_h);
      ctx.globalAlpha = 1;

      readout.innerHTML =
        `<b>${(n * 100).toFixed(0)}%</b> tốc độ → gió còn <b>${(q_curr * 100).toFixed(0)}%</b>, áp <b>${(dp_curr * 100).toFixed(0)}%</b>, công suất <b>${(p_curr * 100).toFixed(1)}%</b> ` +
        `(${power_curr.toFixed(0)} W) · tiền điện <b>${Math.round(cost_month_full).toLocaleString('vi-VN')}</b> đ/tháng (100%) → <b>${Math.round(cost_month_curr).toLocaleString('vi-VN')}</b> đ/tháng (${(n * 100).toFixed(0)}%) · tiết kiệm <b>${Math.round(cost_month_full - cost_month_curr).toLocaleString('vi-VN')}</b> đ`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="quat-tran-giam-toc-mot-nac-cat-nua-dien"]').forEach(setup);
</script>
