---
// Two-body barycentre + radial-velocity semi-amplitude (circular orbit, edge-on i = 90°):
//   r_sao = a·m/(M+m)                     [khoảng cách tâm sao → khối tâm]
//   P     = sqrt(a³/(M+m))  năm, a in AU, M in M_sun   [Kepler III]
//   K     = 2π·r_sao/P                    [biên độ vận tốc xuyên tâm]
// Kiểm chứng: 51 Peg b (m sin i = 0,47 M_Mộc, a = 0,0527 AU, M = 1,11) → K = 55,2 m/s,
// P = 4,19 ngày; đo thật 55,9 m/s và 4,2308 ngày (lệch ~1%, do quỹ đạo hơi lệch tâm).
// Bán kính sao dãy chính xấp xỉ R/R_mt = (M/M_mt)^0,8 nếu M < 1, ^0,57 nếu M ≥ 1
// (chỉ để vẽ đĩa sao đúng tỉ lệ, sai số ~10% ở hai đầu thang).
// Miền hợp lệ: quỹ đạo tròn, nhìn nghiêng 90°, m ≪ M vẫn không bắt buộc (dùng M+m đầy đủ);
// a ≥ 0,02 AU luôn nằm ngoài bề mặt sao trong cả dải khối lượng 0,1–3 M_mt.
---

<figure class="demo" data-demo="mat-troi-lac-45-km-moi-gio">
  <canvas></canvas>
  <div class="controls">
    <label>Khối lượng hành tinh (khối lượng Trái Đất) <output data-out="m"></output>
      <input type="range" data-in="m" min="-1" max="3.6021" step="0.0001" value="2.5022" /></label>
    <label>Bán trục lớn a (AU) <output data-out="a"></output>
      <input type="range" data-in="a" min="-1.6990" max="1.4771" step="0.0001" value="0.7164" /></label>
    <label>Khối lượng ngôi sao (khối lượng Mặt Trời) <output data-out="s"></output>
      <input type="range" data-in="s" min="0.1" max="3" step="0.01" value="1" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Khung trái: nhìn sát ngôi sao, đĩa sao vẽ đúng tỉ lệ — chấm đỏ là khối
    tâm, vòng cam là quỹ đạo tí hon mà tâm sao đi quanh nó. Khung phải: cả
    hệ ở tỉ lệ thật, vòng lắc của sao nhỏ tới mức thành một chấm. Hệ số
    phóng đại giữa hai khung ghi ngay trên hình. Dưới cùng: vận tốc xuyên
    tâm của ngôi sao theo thời gian — chính đường sin này là thứ máy quang
    phổ đọc được, và biên độ K của nó là toàn bộ bằng chứng về hành tinh.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', STAR = '#f59e0b';
  const AU = 1.495978707e11, ME = 5.9722e24, MSUN = 1.98892e30;
  const RSUN = 6.957e8, YR = 3.155815e7, CLIGHT = 2.99792458e8;

  const fmt = (n: number, d: number) => n.toFixed(d).replace('.', ',');
  const grp = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  const starRadius = (Ms: number) => RSUN * (Ms < 1 ? Math.pow(Ms, 0.8) : Math.pow(Ms, 0.57));

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const mE = Math.pow(10, Number(input('m').value));
      const aAU = Math.pow(10, Number(input('a').value));
      const Ms = Number(input('s').value);

      output('m').textContent = mE >= 100 ? fmt(mE, 1) : mE >= 1 ? fmt(mE, 2) : fmt(mE, 3);
      output('a').textContent = aAU >= 1 ? fmt(aAU, 2) : fmt(aAU, 4);
      output('s').textContent = fmt(Ms, 2);

      const m = mE * ME, M = Ms * MSUN, a = aAU * AU;
      const rStar = a * m / (M + m);
      const Pyr = Math.sqrt(Math.pow(aAU, 3) / (Ms + m / MSUN));
      const P = Pyr * YR;
      const K = 2 * Math.PI * rStar / P;
      const R = starRadius(Ms);
      const outside = rStar > R;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.66);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- layout ----------
      const topH = Math.round(cssH * 0.5);
      const splitX = Math.round(cssW * 0.47);

      // ---------- panel A: zoom on the star ----------
      const cxA = splitX / 2, cyA = topH / 2 + 4;
      const RA = Math.min(splitX, topH) / 2 - 20;
      const spanA = (Math.max(rStar, R * 0.55) + R) * 1.15;
      const sA = RA / spanA;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.22;
      ctx.beginPath(); ctx.moveTo(splitX, 8); ctx.lineTo(splitX, topH - 2); ctx.stroke();
      ctx.globalAlpha = 1;

      // star disk, drawn to scale, offset from barycentre by r_star
      ctx.fillStyle = STAR; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.arc(cxA + rStar * sA, cyA, R * sA, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1; ctx.strokeStyle = STAR; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(cxA + rStar * sA, cyA, R * sA, 0, Math.PI * 2); ctx.stroke();

      // the star centre's own orbit around the barycentre
      ctx.setLineDash([3, 3]); ctx.strokeStyle = STAR; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(cxA, cyA, Math.max(rStar * sA, 0.5), 0, Math.PI * 2); ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(cxA, cyA, 3.5, 0, Math.PI * 2); ctx.fill();

      ctx.fillStyle = fg; ctx.textAlign = 'center'; ctx.globalAlpha = 0.75;
      ctx.fillText('nhìn sát ngôi sao', cxA, 16);
      ctx.globalAlpha = 0.9; ctx.fillStyle = MARK;
      ctx.fillText(outside ? 'khối tâm NGOÀI bề mặt' : 'khối tâm trong lòng sao', cxA, topH - 16);
      ctx.fillStyle = fg; ctx.globalAlpha = 0.6;
      ctx.fillText(`r = ${grp(rStar / 1000)} km = ${fmt(rStar / R, 3)} R_sao`, cxA, topH - 4);
      ctx.globalAlpha = 1;

      // ---------- panel B: whole system, true scale ----------
      const cxB = splitX + (cssW - splitX) / 2, cyB = topH / 2 + 4;
      const RB = Math.min(cssW - splitX, topH) / 2 - 20;
      const sB = RB / (a * 1.12);

      ctx.strokeStyle = CURVE; ctx.lineWidth = 1.5; ctx.globalAlpha = 0.9;
      ctx.beginPath(); ctx.arc(cxB, cyB, a * sB, 0, Math.PI * 2); ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.fillStyle = CURVE;
      ctx.beginPath(); ctx.arc(cxB + a * sB, cyB, 3.5, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = STAR;
      ctx.beginPath(); ctx.arc(cxB - rStar * sB, cyB, Math.max(R * sB, 2.5), 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(cxB, cyB, 2.5, 0, Math.PI * 2); ctx.fill();

      ctx.fillStyle = fg; ctx.textAlign = 'center'; ctx.globalAlpha = 0.75;
      ctx.fillText('cả hệ, tỉ lệ thật', cxB, 16);
      ctx.globalAlpha = 0.6;
      ctx.fillText(`a = ${aAU >= 1 ? fmt(aAU, 2) : fmt(aAU, 4)} AU · khung trái phóng đại ×${grp(sA / sB)}`, cxB, topH - 4);
      ctx.globalAlpha = 1;

      // ---------- panel C: radial-velocity curve ----------
      const padL = 52, padR = 12, padT = topH + 16, padB = 24;
      const x0 = padL, x1 = cssW - padR, y0 = padT, y1 = cssH - padB;
      const yMax = K * 1.3;
      const X = (ph: number) => x0 + ph * (x1 - x0);
      const Y = (v: number) => (y0 + y1) / 2 - (v / yMax) * (y1 - y0) / 2;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x0, y1); ctx.lineTo(x1, y1); ctx.stroke();
      ctx.globalAlpha = 0.2;
      ctx.beginPath(); ctx.moveTo(x0, Y(0)); ctx.lineTo(x1, Y(0)); ctx.stroke();

      // ±K guide lines
      ctx.setLineDash([4, 4]); ctx.strokeStyle = MARK; ctx.globalAlpha = 0.55;
      ctx.beginPath(); ctx.moveTo(x0, Y(K)); ctx.lineTo(x1, Y(K)); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x0, Y(-K)); ctx.lineTo(x1, Y(-K)); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      const dec = K >= 100 ? 0 : K >= 10 ? 1 : K >= 1 ? 2 : 3;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.55; ctx.textAlign = 'right';
      for (const v of [K, K / 2, 0, -K / 2, -K]) ctx.fillText(`${fmt(v, dec)}`, x0 - 5, Y(v) + 3);
      ctx.textAlign = 'left'; ctx.globalAlpha = 0.45;
      ctx.fillText('m/s', x0 - 46, y0 + 8);
      ctx.globalAlpha = 0.55; ctx.textAlign = 'center';
      const dayMode = Pyr < 2;
      for (const ph of [0, 0.25, 0.5, 0.75, 1]) {
        const t = ph * (dayMode ? Pyr * 365.25 : Pyr);
        ctx.fillText(fmt(t, t >= 10 ? 1 : 2), X(ph), y1 + 13);
      }
      ctx.globalAlpha = 0.45;
      ctx.fillText(dayMode ? 'ngày' : 'năm', (x0 + x1) / 2, y1 + 23);
      ctx.globalAlpha = 1;

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const ph = i / 240, y = Y(K * Math.sin(2 * Math.PI * ph));
        i ? ctx.lineTo(X(ph), y) : ctx.moveTo(X(ph), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(0.25), Y(K), 5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.85; ctx.textAlign = 'left';
      ctx.fillText(`K = ${fmt(K, dec)} m/s`, X(0.25) + 8, Y(K) + 3);
      ctx.globalAlpha = 1;

      // ---------- readout ----------
      const shift = CLIGHT / K;
      const regime = K >= 30
        ? 'máy quang phổ thập niên 1990 đã bắt được'
        : K >= 1
          ? 'trong tầm lớp HARPS (~1 m/s)'
          : K >= 0.1
            ? 'cần lớp ESPRESSO (~10 cm/s) — và vẫn chìm dưới nhiễu đối lưu ~1 m/s của chính ngôi sao'
            : '<b>dưới mọi máy hiện có</b>';
      const kText = K >= 1 ? `${fmt(K, 2)} m/s = ${fmt(K * 3.6, 1)} km/h` : `${fmt(K * 100, 2)} cm/s`;
      readout.innerHTML =
        `Khối tâm cách tâm sao <b>${grp(rStar / 1000)} km</b> = ${fmt(rStar / R, 3)} bán kính sao ` +
        `(${outside ? 'nằm ngoài bề mặt' : 'nằm trong lòng sao'}) · chu kỳ ` +
        `${Pyr < 2 ? `${fmt(Pyr * 365.25, 2)} ngày` : `${fmt(Pyr, 2)} năm`} · biên độ <b>${kText}</b>` +
        ` · dịch bước sóng 1 phần ${grp(shift)} — ${regime}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="mat-troi-lac-45-km-moi-gio"]').forEach(setup);
</script>
