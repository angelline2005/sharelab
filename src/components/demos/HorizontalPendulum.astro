---
// Con lắc ngang (horizontal / "garden-gate" pendulum, Hengler 1832 – Zöllner 1869).
// Trục quay nghiêng góc α so với phương thẳng đứng; cần dài L vuông góc với trục.
// Thế năng U = m·g·L·sinα·(1 − cosθ)  →  ω² = g·sinα / L
//   T = 2π·√( L / (g·sinα) ),  chiều dài con lắc đơn tương đương L_eq = L / sinα
//   hệ số khuếch đại nghiêng nền (độ lệch cân bằng / độ nghiêng nền) = 1 / sinα
// Nguồn: lý thuyết con lắc ngang cổ điển, cơ sở của địa chấn kế thành phần ngang.
// Miền hợp lệ: dao động biên độ nhỏ (sinθ ≈ θ), α > 0 — nên slider dừng ở 0,2°.
// Tại α = 0 công thức phân kỳ: trục thẳng đứng, không còn lực hồi phục nào.
---

<figure class="demo" data-demo="con-lac-ngang-nghieng-truc-mot-do">
  <canvas></canvas>
  <div class="controls">
    <label>Góc nghiêng trục α so với phương thẳng đứng (°) <output data-out="a"></output>
      <input type="range" data-in="a" min="0.2" max="90" step="0.1" value="1" /></label>
    <label>Chiều dài cần L (m) <output data-out="l"></output>
      <input type="range" data-in="l" min="0.1" max="1" step="0.01" value="0.5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Cần nằm gần ngang, quay quanh một trục nghiêng α khỏi phương thẳng đứng.
    Nó chỉ dâng lên L·sinα·(1−cosθ) khi lệch, nên trọng lực chỉ góp được lát
    mỏng g·sinα thay vì cả g. Bên trái là hình chiếu của cơ cấu cùng con lắc
    dây có chu kỳ y hệt, vẽ đúng tỉ lệ; bên phải là T theo α (trục α thang
    loga). Đường đứt màu cam là cần dài 1 m để so sánh: đổi L gần như không
    dịch được đường cong, đổi α thì dịch tất cả.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', EQ = '#f59e0b';
  const G = 9.81;
  const A_MIN = 0.2, A_MAX = 90, T_MAX = 36;
  const LG0 = Math.log10(A_MIN), LGSPAN = Math.log10(A_MAX) - Math.log10(A_MIN);
  const rad = (d: number) => (d * Math.PI) / 180;
  const per = (L: number, a: number) => 2 * Math.PI * Math.sqrt(L / (G * Math.sin(rad(a))));
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const a = Number(input('a').value), L = Number(input('l').value);
      output('a').textContent = vn(a, 1);
      output('l').textContent = vn(L, 2);

      const s = Math.sin(rad(a)), ca = Math.cos(rad(a));
      const geff = G * s, T = per(L, a), Leq = L / s, amp = 1 / s;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';
      ctx.lineWidth = 1;

      // ---------- panel trái: hình chiếu cơ cấu ----------
      const SW = Math.round(cssW * 0.34);
      const px = Math.round(SW * 0.3), py = Math.round(cssH * 0.34);
      const axPx = Math.min(56, py - 16, SW * 0.28);
      const SC = Math.max(40, SW - px - 58);      // pixel trên mỗi mét, dùng chung
      const bpx = L * SC, ex = SW - 20;

      // phương thẳng đứng tham chiếu
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(px, py - axPx); ctx.lineTo(px, py + 6); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.5; ctx.fillStyle = fg; ctx.textAlign = 'left';
      ctx.fillText('thẳng đứng', px + 4, py - axPx - 4);

      // trục bản lề, nghiêng α
      ctx.globalAlpha = 0.85; ctx.strokeStyle = fg; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(px - s * axPx, py + ca * axPx);
      ctx.lineTo(px + s * axPx, py - ca * axPx);
      ctx.stroke(); ctx.lineWidth = 1;
      ctx.globalAlpha = 0.6;
      ctx.fillText('trục bản lề', px - s * axPx + 5, py + ca * axPx - 3);

      // mặt phẳng quét của cần (ellipse chiếu)
      ctx.strokeStyle = CURVE; ctx.globalAlpha = 0.35; ctx.setLineDash([2, 3]);
      ctx.beginPath();
      for (let i = 0; i <= 96; i++) {
        const th = (2 * Math.PI * i) / 96;
        const X = px + bpx * (Math.cos(th) * ca + Math.sin(th) * 0.45);
        const Y = py + bpx * (Math.cos(th) * s + Math.sin(th) * 0.2);
        i ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y);
      }
      ctx.stroke(); ctx.setLineDash([]); ctx.globalAlpha = 1;

      // cần + quả nặng ở vị trí cân bằng
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(px + ca * bpx, py + s * bpx); ctx.stroke();
      ctx.lineWidth = 1;
      ctx.fillStyle = CURVE;
      ctx.beginPath(); ctx.arc(px + ca * bpx, py + s * bpx, 4.5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.75; ctx.fillStyle = fg; ctx.textAlign = 'center';
      ctx.fillText(`cần ${vn(L, 2)} m`, px + (ca * bpx) / 2, py + (s * bpx) / 2 - 7);

      // con lắc dây tương đương, cùng tỉ lệ SC
      const eqBot = Math.min(py + Leq * SC, cssH - 22);
      ctx.strokeStyle = EQ; ctx.globalAlpha = 1; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(ex, py); ctx.lineTo(ex, eqBot); ctx.stroke();
      ctx.lineWidth = 1; ctx.fillStyle = EQ;
      if (py + Leq * SC > cssH - 22) {
        ctx.setLineDash([2, 4]); ctx.globalAlpha = 0.6;
        ctx.beginPath(); ctx.moveTo(ex, eqBot); ctx.lineTo(ex, cssH - 6); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
      } else {
        ctx.beginPath(); ctx.arc(ex, eqBot, 4.5, 0, Math.PI * 2); ctx.fill();
      }
      ctx.fillStyle = fg; ctx.globalAlpha = 0.75; ctx.textAlign = 'center';
      ctx.fillText('dây tương đương', ex, py - 18);
      ctx.fillStyle = EQ; ctx.globalAlpha = 1;
      ctx.fillText(`${vn(Leq, Leq < 10 ? 2 : 1)} m`, ex, py - 6);

      // ---------- panel phải: T theo α ----------
      const padL = SW + 44, padB = 26, padT = 12, padR = cssW < 420 ? 26 : 10;
      const X = (aa: number) => padL + ((Math.log10(aa) - LG0) / LGSPAN) * (cssW - padL - padR);
      const Y = (t: number) => padT + ((T_MAX - t) / T_MAX) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'center';
      for (const k of [0.2, 0.5, 1, 2, 5, 10, 30, 90])
        ctx.fillText(k < 1 ? `${vn(k, 1)}°` : `${k}°`, X(k), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const t of [10, 20, 30]) ctx.fillText(`${t} s`, padL - 4, Y(t) + 3);
      ctx.globalAlpha = 1;

      // đường tham chiếu: cần 1,00 m
      ctx.strokeStyle = EQ; ctx.globalAlpha = 0.6; ctx.setLineDash([4, 3]);
      ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const aa = Math.pow(10, LG0 + (LGSPAN * i) / 240);
        const y = Math.max(padT, Y(per(1, aa)));
        i ? ctx.lineTo(X(aa), y) : ctx.moveTo(X(aa), y);
      }
      ctx.stroke(); ctx.setLineDash([]); ctx.globalAlpha = 1;

      // đường cong chính
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const aa = Math.pow(10, LG0 + (LGSPAN * i) / 240);
        const y = Math.max(padT, Y(per(L, aa)));
        i ? ctx.lineTo(X(aa), y) : ctx.moveTo(X(aa), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.45; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(padL, Y(T)); ctx.lineTo(X(a), Y(T)); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(a), Y(T), 6, 0, Math.PI * 2); ctx.fill();
      ctx.textAlign = 'left';
      ctx.fillText(`T = ${vn(T, 2)} s`, Math.min(X(a) + 9, cssW - padR - 62), Y(T) - 8);

      const note = amp >= 30
        ? ` · <b>vùng cực nhạy: nền nghiêng bao nhiêu, cần lệch gấp ${amp.toFixed(0)} lần</b>`
        : '';
      readout.innerHTML =
        `L = <b>${vn(L, 2)} m</b> · α = <b>${vn(a, 1)}°</b> → g hiệu dụng ${vn(geff, 3)} m/s²` +
        ` (${vn(100 * s, 1)}% của g) → T = <b>${vn(T, 2)} s</b>` +
        ` · tương đương con lắc dây dài <b>${vn(Leq, Leq < 10 ? 2 : 1)} m</b>${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="con-lac-ngang-nghieng-truc-mot-do"]').forEach(setup);
</script>
