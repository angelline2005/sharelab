---
// Conservation of angular momentum: the spinning skater. The arm slider
// changes moment of inertia I; L = Iω stays fixed so ω = L/I follows, and the
// readout tracks rotational kinetic energy L²/2I — which rises when the arms
// pull in, because the skater's muscles do real work against the centrifugal
// tendency. The animation spins a simple figure at the true ω.
---

<figure class="demo" data-demo="angular">
  <canvas></canvas>
  <div class="controls">
    <label>Sải tay <output data-out="arm"></output>
      <input type="range" data-in="arm" min="0" max="1" step="0.01" value="1" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Vận động viên trượt băng xoay tự do — không mô-men ngoài, nên L = Iω bị
    khoá. Thu tay vào là giảm I; ω buộc phải tăng để giữ tích không đổi.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  // I interpolates between arms-in (0.4) and arms-out (1.0), in units of the
  // arms-out value; L is fixed at 1 so ω = 1/I.
  const I_MIN = 0.4, I_MAX = 1.0;
  const BODY = '#2563eb', ARM = '#dc2626';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="arm"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="arm"]') as HTMLOutputElement;

    let angle = 0, raf = 0, last = 0;

    function draw() {
      const s = Number(slider.value); // 0 = arms in, 1 = arms out
      out.textContent = s > 0.7 ? 'dang rộng' : s > 0.3 ? 'lưng chừng' : 'thu sát người';
      const I = I_MIN + (I_MAX - I_MIN) * s;
      const w = 1 / I; // ω, since L = 1
      const ke = 1 / (2 * I); // L²/2I with L = 1

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      if (canvas.width !== cssW * dpr) { canvas.width = cssW * dpr; canvas.height = cssH * dpr; canvas.style.height = `${cssH}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Top view of the skater: body disc plus two arm masses.
      const cx = cssW * 0.32, cy = cssH / 2;
      const armR = 20 + s * (Math.min(cssW, cssH) * 0.3);
      ctx.fillStyle = BODY; ctx.globalAlpha = 0.85;
      ctx.beginPath(); ctx.arc(cx, cy, 16, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
      for (const side of [0, Math.PI]) {
        const a = angle + side;
        const x = cx + Math.cos(a) * armR, y = cy + Math.sin(a) * armR;
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.4;
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(x, y); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.fillStyle = ARM;
        ctx.beginPath(); ctx.arc(x, y, 9, 0, Math.PI * 2); ctx.fill();
      }

      // Bars: I, ω, KE — the seesaw and the bill.
      const gx = cssW * 0.6, gw = cssW * 0.36, baseY = cssH - 36, hMax = cssH - 76;
      const bar = (i: number, val: number, max: number, colour: string, label: string) => {
        const w2 = gw / 3 - 10, x = gx + i * (gw / 3);
        const h = (val / max) * hMax;
        ctx.fillStyle = colour; ctx.globalAlpha = 0.85;
        ctx.fillRect(x, baseY - h, w2, h);
        ctx.globalAlpha = 0.7; ctx.fillStyle = fg;
        ctx.font = '11px system-ui,sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(label, x + w2 / 2, baseY + 14);
        ctx.fillText(val.toFixed(2), x + w2 / 2, baseY - h - 5);
        ctx.globalAlpha = 1;
      };
      bar(0, I, I_MAX, BODY, 'I');
      bar(1, w, 1 / I_MIN, ARM, 'ω');
      bar(2, ke, 1 / (2 * I_MIN), '#16a34a', 'K quay');

      readout.innerHTML =
        `L = Iω = <b>1,00 (khoá)</b> · thu tay: I ${I.toFixed(2)} → ω <b>×${w.toFixed(2)}</b> · ` +
        `động năng quay ×${(ke / 0.5).toFixed(2)} — phần dôi ra do <b>cơ bắp trả</b>, không miễn phí`;
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      const I = I_MIN + (I_MAX - I_MIN) * Number(slider.value);
      angle += (1 / I) * dt * 2.2;
      draw();
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) { last = 0; raf = requestAnimationFrame(frame); }
        else cancelAnimationFrame(raf);
      }
    });
    io.observe(root);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="angular"]').forEach(setup);
</script>
