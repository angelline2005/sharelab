---
// Linear surface-gravity-wave dispersion, exact form (Airy theory):
//   omega^2 = g*k*tanh(k*h),  c_pha = omega/k,
//   c_nhom  = c_pha/2 * (1 + 2kh/sinh(2kh))
// Deep-water limit (h > lambda/2): c_nhom = g*T/(4*pi), lambda = g*T^2/(2*pi).
// Shallow limit (h < lambda/20): c_pha = c_nhom = sqrt(g*h), no dispersion.
// k solved by Newton iteration; valid for small-amplitude (linear) waves,
// i.e. before the wave steepens and breaks. Travel time assumes a uniform
// ocean of the chosen depth along the whole path.
---

<figure class="demo" data-demo="vi-sao-song-lung-ve-truoc-con-bao-nam-ngay">
  <canvas></canvas>
  <div class="controls">
    <label>Khoảng cách tới cơn bão (km) <output data-out="d"></output>
      <input type="range" data-in="d" min="500" max="15000" step="100" value="10000" /></label>
    <label>Chu kỳ sóng T (s) <output data-out="t"></output>
      <input type="range" data-in="t" min="4" max="25" step="0.5" value="15" /></label>
    <label>Độ sâu biển trên đường đi (m) <output data-out="h"></output>
      <input type="range" data-in="h" min="5" max="4000" step="1" value="4000" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trục ngang là số ngày kể từ lúc bão nổi sóng, trục đứng là chu kỳ — đúng
    cái "thang sóng lừng" mà dân lướt sóng và trạm phao đọc hằng ngày. Cơn bão
    phát mọi chu kỳ cùng một lúc, nhưng sóng dài chạy nhanh hơn nên tới trước:
    đường cong càng nằm ngang thì đoàn sóng càng tách xa nhau. Dải dưới vẽ mặt
    biển đúng tỉ lệ bước sóng, với hai mũi tên so tốc độ một đỉnh sóng và tốc
    độ cả nhóm. Kéo độ sâu xuống thấp để xem sự tán sắc biến mất.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const G = 9.81, TAU = Math.PI * 2;
  const CURVE = '#2563eb', MARK = '#dc2626', REF = '#f59e0b';
  const T_LO = 4, T_HI = 25;

  const vn = (x: number, d = 1) => x.toFixed(d).replace('.', ',');
  const th = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');

  // Newton solve of omega^2 = g k tanh(k h) for k.
  function waveNumber(T: number, h: number) {
    const w = TAU / T;
    let k = (w * w) / G;
    if (k * h < 3) k = w / Math.sqrt(G * h);
    for (let i = 0; i < 80; i++) {
      const t = Math.tanh(k * h);
      const f = G * k * t - w * w;
      const df = G * t + G * k * (1 - t * t) * h;
      const nk = k - f / df;
      k = nk > 1e-9 ? nk : k / 2;
    }
    return k;
  }

  function wave(T: number, h: number) {
    const w = TAU / T, k = waveNumber(T, h), kh = k * h;
    const cp = w / k;
    const n = 0.5 * (1 + (2 * kh) / Math.sinh(Math.min(2 * kh, 700)));
    return { lambda: TAU / k, cp, cg: cp * n, ratio: h / (TAU / k) };
  }

  const niceStep = (span: number) => {
    const raw = span / 5, p = Math.pow(10, Math.floor(Math.log10(raw))), n = raw / p;
    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * p;
  };

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const Dkm = Number(input('d').value);
      const T = Number(input('t').value);
      const h = Number(input('h').value);
      output('d').textContent = th(Dkm);
      output('t').textContent = vn(T);
      output('h').textContent = th(h);

      const D = Dkm * 1000;
      const days = (tt: number) => D / wave(tt, h).cg / 86400;
      const here = wave(T, h);
      const tSel = days(T), tRef = days(10);
      const tMax = days(T_LO);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.62);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---- top panel: arrival ladder (time vs period) ----
      const padL = 46, padR = 12, padT = 12;
      const chartH = Math.round(cssH * 0.63), axisY = chartH;
      const X = (dd: number) => padL + (dd / tMax) * (cssW - padL - padR);
      const Y = (tt: number) => padT + ((T_HI - tt) / (T_HI - T_LO)) * (axisY - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, axisY); ctx.lineTo(cssW - padR, axisY); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      const step = niceStep(tMax);
      for (let d = step; d <= tMax * 1.001; d += step) ctx.fillText(`${vn(d, d < 1 ? 1 : 0)} ngày`, X(d), axisY + 14);
      ctx.textAlign = 'right';
      for (const tt of [5, 10, 15, 20, 25]) ctx.fillText(`${tt} s`, padL - 4, Y(tt) + 3);
      ctx.save(); ctx.translate(11, (padT + axisY) / 2); ctx.rotate(-Math.PI / 2);
      ctx.textAlign = 'center'; ctx.fillText('chu kỳ sóng', 0, 0); ctx.restore();
      ctx.globalAlpha = 1;

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const tt = T_LO + ((T_HI - T_LO) * i) / 240;
        i ? ctx.lineTo(X(days(tt)), Y(tt)) : ctx.moveTo(X(days(tt)), Y(tt));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // reference marker at T = 10 s
      ctx.fillStyle = REF;
      ctx.beginPath(); ctx.arc(X(tRef), Y(10), 4.5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 0.75; ctx.fillStyle = fg; ctx.textAlign = 'left';
      ctx.fillText(`10 s: ${vn(tRef)} ngày`, X(tRef) + 7, Y(10) + 3);
      ctx.globalAlpha = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(tSel), Y(T), 6, 0, Math.PI * 2); ctx.fill();
      ctx.textAlign = X(tSel) > cssW * 0.6 ? 'right' : 'left';
      ctx.fillText(`${vn(T)} s: ${vn(tSel)} ngày`, X(tSel) + (X(tSel) > cssW * 0.6 ? -9 : 9), Y(T) + 3);

      // ---- bottom panel: sea surface drawn to scale ----
      const seaTop = chartH + 30, seaH = cssH - seaTop - 6, mid = seaTop + seaH * 0.55;
      const seaW = cssW - padL - padR;
      const cycles = 2, pxPerM = seaW / (cycles * here.lambda);

      ctx.strokeStyle = CURVE; ctx.globalAlpha = 0.85; ctx.lineWidth = 1.8;
      ctx.beginPath();
      for (let px = 0; px <= seaW; px++) {
        const y = mid - Math.sin((px / seaW) * cycles * TAU) * (seaH * 0.2);
        px ? ctx.lineTo(padL + px, y) : ctx.moveTo(padL + px, y);
      }
      ctx.stroke(); ctx.lineWidth = 1; ctx.globalAlpha = 1;

      // wavelength bar under one cycle
      const barY = mid + seaH * 0.34, barW = here.lambda * pxPerM;
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.5;
      ctx.beginPath(); ctx.moveTo(padL, barY - 4); ctx.lineTo(padL, barY + 4);
      ctx.moveTo(padL, barY); ctx.lineTo(padL + barW, barY);
      ctx.moveTo(padL + barW, barY - 4); ctx.lineTo(padL + barW, barY + 4); ctx.stroke();
      ctx.globalAlpha = 0.75; ctx.fillStyle = fg; ctx.textAlign = 'center';
      ctx.fillText(`bước sóng ${th(here.lambda)} m`, padL + barW / 2, barY + 14);
      ctx.globalAlpha = 1;

      // speed arrows: length proportional to speed (crest vs group)
      const vScale = (seaW * 0.42) / Math.max(here.cp, 1e-6);
      const arrow = (y: number, len: number, col: string, lab: string) => {
        ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = 1.8;
        ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(padL + len, y); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(padL + len, y); ctx.lineTo(padL + len - 7, y - 4);
        ctx.lineTo(padL + len - 7, y + 4); ctx.closePath(); ctx.fill();
        ctx.lineWidth = 1; ctx.textAlign = 'left';
        ctx.fillText(lab, padL + len + 6, y + 3);
      };
      arrow(seaTop + 2, here.cp * vScale, REF, `một đỉnh sóng ${vn(here.cp)} m/s`);
      arrow(seaTop + 16, here.cg * vScale, CURVE, `cả nhóm ${vn(here.cg)} m/s`);

      // ---- readout ----
      const r = here.ratio;
      const regime = r > 0.5
        ? `<b>nước sâu</b> (h = ${vn(r, 2)}·λ) — sóng dài chạy nhanh hơn`
        : r > 0.05
          ? `<b>chuyển tiếp</b> (h = ${vn(r, 3)}·λ) — đáy biển bắt đầu can thiệp`
          : `<b>nước nông</b> (h = ${vn(r, 4)}·λ) — mọi chu kỳ chạy cùng √(gh) = ${vn(Math.sqrt(G * h))} m/s`;
      readout.innerHTML =
        `Bão cách ${th(Dkm)} km · T = ${vn(T)} s → nhóm <b>${vn(here.cg)} m/s</b> (${vn(here.cg * 3.6, 0)} km/h), ` +
        `bước sóng ${th(here.lambda)} m, tới sau <b>${vn(tSel)} ngày</b> · sóng 10 s tới sau ${vn(tRef)} ngày ` +
        `(chênh ${vn(Math.abs(tRef - tSel))} ngày) · chế độ ${regime}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="vi-sao-song-lung-ve-truoc-con-bao-nam-ngay"]').forEach(setup);
</script>
