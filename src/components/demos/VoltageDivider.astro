---
// Voltage divider: Vout = Vin·R2/(R1+R2), Vin fixed at 12 V. Sliders for the
// two resistors; the sketch is the classic two-resistor ladder with the tap
// point. Static redraw.
---

<figure class="demo" data-demo="divider">
  <canvas></canvas>
  <div class="controls">
    <label>R₁ — nấc trên (Ω) <output data-out="r1"></output>
      <input type="range" data-in="r1" min="100" max="10000" step="100" value="5000" /></label>
    <label>R₂ — nấc dưới (Ω) <output data-out="r2"></output>
      <input type="range" data-in="r2" min="100" max="10000" step="100" value="5000" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Nguồn 12 V rót qua hai điện trở nối tiếp; điểm lấy giữa hai nấc cho ra
    đúng phần điện áp mà R₂ "gánh". Núm volume, cảm biến ánh sáng, chân đọc
    pin của mọi vi điều khiển — đều là hai điện trở xếp cầu thang thế này.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const VIN = 12;
  const WIRE = '#2563eb', ROUT = '#dc2626', RES = '#f59e0b';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const r1 = Number(input('r1').value), r2 = Number(input('r2').value);
      output('r1').textContent = r1.toLocaleString('vi-VN');
      output('r2').textContent = r2.toLocaleString('vi-VN');
      const vout = (VIN * r2) / (r1 + r2);
      const iMa = (VIN / (r1 + r2)) * 1000;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.4);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const x = cssW * 0.32, top = 22, bot = cssH - 22;
      const mid = top + ((bot - top) * r1) / (r1 + r2); // tap point moves with the ratio

      // Zigzag resistor between two y's.
      const zig = (y0: number, y1: number) => {
        const n = 6, w = 10;
        ctx.beginPath(); ctx.moveTo(x, y0);
        for (let i = 0; i <= n; i++) {
          const y = y0 + ((y1 - y0) * i) / n;
          ctx.lineTo(x + (i % 2 === 0 ? 0 : i % 4 === 1 ? w : -w), y);
        }
        ctx.lineTo(x, y1); ctx.stroke();
      };

      ctx.strokeStyle = RES; ctx.lineWidth = 2;
      zig(top + 14, mid - 8);
      zig(mid + 8, bot - 14);
      ctx.strokeStyle = WIRE;
      ctx.beginPath(); ctx.moveTo(x, top); ctx.lineTo(x, top + 14); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x, mid - 8); ctx.lineTo(x, mid + 8); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x, bot - 14); ctx.lineTo(x, bot); ctx.stroke();
      // Tap wire.
      ctx.strokeStyle = ROUT;
      ctx.beginPath(); ctx.moveTo(x, mid); ctx.lineTo(x + cssW * 0.3, mid); ctx.stroke();
      ctx.fillStyle = ROUT;
      ctx.beginPath(); ctx.arc(x, mid, 4, 0, Math.PI * 2); ctx.fill();
      ctx.lineWidth = 1;

      ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.font = '11px system-ui,sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText('+12 V', x - 10, top + 6);
      ctx.fillText('0 V', x - 10, bot + 4);
      ctx.fillText('R₁', x - 16, (top + mid) / 2);
      ctx.fillText('R₂', x - 16, (mid + bot) / 2);
      ctx.globalAlpha = 1; ctx.textAlign = 'left'; ctx.fillStyle = ROUT;
      ctx.font = 'bold 13px system-ui,sans-serif';
      ctx.fillText(`V_ra = ${vout.toFixed(2).replace('.', ',')} V`, x + cssW * 0.3 + 8, mid + 4);

      readout.innerHTML =
        `V_ra = 12 × R₂/(R₁+R₂) = <b>${vout.toFixed(2).replace('.', ',')} V</b>` +
        ` · dòng chảy qua thang: ${iMa.toFixed(2).replace('.', ',')} mA — thang càng "nặng ohm" càng ít hao`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="divider"]').forEach(setup);
</script>
