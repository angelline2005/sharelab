---
// Xuyên hầm qua hàng rào thế chữ nhật, xấp xỉ WKB rào dày:
//   T ≈ exp(−2·κ·d),  κ = sqrt(2·m·(φ − E)) / ħ
// Bỏ hệ số tiền tố 16E(φ−E)/φ² (cỡ đơn vị) vì số mũ áp đảo hoàn toàn.
// Dùng khối lượng electron tự do m_e → κ = 5,1232·sqrt(φ−E [eV]) nm⁻¹.
// Miền hiệu lực: cần 2κd ≫ 1. Thanh trượt được chặn sao cho φ−E ≥ 0,2 eV
// và d ≥ 1 nm, tức 2κd ≥ 4,58 trên toàn miền — vẫn nằm trong vùng WKB tốt.
// Thời gian giữ điện tích lấy tần số va chạm ν = 10¹³ s⁻¹ (electron 0,1 eV
// nảy qua lại trong giếng 10 nm: v/2L = 9,4×10¹² Hz).
---

<figure class="demo" data-demo="xuyen-ham-luong-tu-trong-chiec-the-nho">
  <canvas></canvas>
  <div class="controls">
    <label>Bề dày lớp oxit d (nm) <output data-out="d"></output>
      <input type="range" data-in="d" min="1" max="10" step="0.1" value="8" /></label>
    <label>Chiều cao rào φ (eV) <output data-out="p"></output>
      <input type="range" data-in="p" min="1" max="5" step="0.05" value="3.2" /></label>
    <label>Năng lượng electron E (eV) <output data-out="e"></output>
      <input type="range" data-in="e" min="0.05" max="0.8" step="0.05" value="0.1" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trên: mặt cắt bức tường oxit. Sóng electron tới từ trái (bước sóng vẽ
    đúng theo E), vào trong tường thì tắt theo hàm mũ e^(−κx) — đường bao
    cam — và ló ra bên phải với biên độ đã phải phóng đại lên mới nhìn thấy.
    Dưới: xác suất xuyên T theo bề dày, trục dọc là luỹ thừa của 10; vạch đỏ
    đứt là ngưỡng rò hết điện tích trong 10 năm. Tính bằng khối lượng
    electron tự do; trong SiO₂ khối lượng hiệu dụng ~0,5 m₍e₎ làm số mũ nhẹ
    đi khoảng √2 lần, nhưng bức tranh không đổi.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', DECAY = '#f59e0b';
  const HBAR = 1.054571817e-34, ME = 9.1093837015e-31, QE = 1.602176634e-19;
  // κ [nm⁻¹] = K1 · sqrt(φ−E [eV])
  const K1 = Math.sqrt(2 * ME * QE) / HBAR / 1e9;   // = 5,1232
  const NU = 1e13;          // số lần electron đập vào tường mỗi giây
  const YR = 3.15576e7;     // giây trong một năm
  const XSPAN = 20, XBAR = 5;   // trục vị trí 0–20 nm, tường bắt đầu ở 5 nm

  const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';
  const supNum = (n: number) =>
    String(n).split('').map((c) => (c === '-' ? '⁻' : SUP[Number(c)])).join('');
  const sci = (x: number, dg = 1) => {
    let ex = Math.floor(Math.log10(Math.abs(x)));
    let m = x / Math.pow(10, ex);
    // 9,97 làm tròn thành 10,0 thì phải đẩy sang bậc mũ kế tiếp
    if (Math.abs(Number(m.toFixed(dg))) >= 10) { m /= 10; ex += 1; }
    return `${m.toFixed(dg).replace('.', ',')}×10${supNum(ex)}`;
  };
  const vn = (x: number, dg: number) => x.toFixed(dg).replace('.', ',');
  // số nằm trong tầm đọc được thì viết thẳng, ngoài tầm mới dùng luỹ thừa 10
  const fmt = (x: number) => {
    const a = Math.abs(x);
    if (a < 0.01 || a >= 1e5) return sci(x);
    return vn(x, a >= 100 ? 0 : a >= 10 ? 1 : 2);
  };

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const d = Number(input('d').value);
      const phi = Number(input('p').value);
      const E = Number(input('e').value);
      output('d').textContent = vn(d, 1);
      output('p').textContent = vn(phi, 2);
      output('e').textContent = vn(E, 2);

      const dphi = phi - E;
      const kap = K1 * Math.sqrt(dphi);            // nm⁻¹
      const lg = (dd: number) => -2 * kap * dd / Math.LN10;   // log10 T
      const T = Math.exp(-2 * kap * d);
      const perNm = Math.exp(2 * kap);
      const years = 1 / (NU * T) / YR;
      const lam = 2 * Math.PI / (K1 * Math.sqrt(E));          // bước sóng de Broglie, nm

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.72);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padL = 46, padR = cssW < 420 ? 26 : 12, padT = 12, padB = 24;
      const plotW = cssW - padL - padR;
      const usable = cssH - padT - padB;
      const hTop = Math.round(usable * 0.52);
      const topY1 = padT + hTop;
      const botY0 = topY1 + 40, botY1 = cssH - padB;
      const base = topY1 - 24;                       // mức năng lượng 0
      const eScale = (base - padT - 12) / 5.5;       // px mỗi eV
      const amp = Math.max(12, Math.round(hTop * 0.09));
      const Xn = (nm: number) => padL + (nm / XSPAN) * plotW;
      const Ey = (ev: number) => base - ev * eScale;

      // ---------- khung trên: mặt cắt hàng rào ----------
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, base); ctx.lineTo(cssW - padR, base); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'right';
      for (const ev of [1, 2, 3, 4, 5]) ctx.fillText(`${ev} eV`, padL - 4, Ey(ev) + 3);
      ctx.textAlign = 'center';
      for (const nm of [0, 5, 10, 15, 20]) ctx.fillText(nm === 20 ? '20 nm' : String(nm), Xn(nm), topY1 + 12);
      ctx.globalAlpha = 1;

      // tường
      const bx0 = Xn(XBAR), bx1 = Xn(XBAR + d), btop = Ey(phi);
      ctx.fillStyle = fg; ctx.globalAlpha = 0.12;
      ctx.fillRect(bx0, btop, bx1 - bx0, base - btop);
      ctx.globalAlpha = 0.45; ctx.strokeStyle = fg;
      ctx.strokeRect(bx0, btop, bx1 - bx0, base - btop);
      ctx.globalAlpha = 0.7; ctx.textAlign = 'center';
      ctx.fillText(`φ = ${vn(phi, 2)} eV`, (bx0 + bx1) / 2, btop - 5);
      ctx.fillText(`d = ${vn(d, 1)} nm`, (bx0 + bx1) / 2, base + 13);
      if (bx1 - bx0 > 66) ctx.fillText('e^(−κx)', (bx0 + bx1) / 2, base - 14);
      ctx.globalAlpha = 1;

      // mức năng lượng electron
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.4; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(padL, Ey(E)); ctx.lineTo(cssW - padR, Ey(E)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.6; ctx.fillStyle = fg; ctx.textAlign = 'right';
      ctx.fillText('E', cssW - padR, Ey(E) - 6);
      ctx.fillText(`biên độ sóng ra đã phóng đại ×${fmt(0.35 / Math.sqrt(T))}`, cssW - padR, padT + 9);
      ctx.globalAlpha = 1;

      // sóng tới
      ctx.strokeStyle = CURVE; ctx.lineWidth = 1.6; ctx.beginPath();
      for (let i = 0; i <= 160; i++) {
        const nm = (XBAR * i) / 160;
        const y = Ey(E) - amp * Math.sin((2 * Math.PI * nm) / lam);
        i ? ctx.lineTo(Xn(nm), y) : ctx.moveTo(Xn(nm), y);
      }
      ctx.stroke();

      // đường bao tắt dần trong tường
      ctx.strokeStyle = DECAY;
      for (const s of [1, -1]) {
        ctx.beginPath();
        for (let i = 0; i <= 200; i++) {
          const nm = (d * i) / 200;
          const y = Ey(E) - s * amp * Math.exp(-kap * nm);
          i ? ctx.lineTo(Xn(XBAR + nm), y) : ctx.moveTo(Xn(XBAR + nm), y);
        }
        ctx.stroke();
      }

      // sóng ra (đã phóng đại)
      ctx.strokeStyle = CURVE; ctx.beginPath();
      const ampOut = amp * 0.35;
      for (let i = 0; i <= 160; i++) {
        const nm = ((XSPAN - XBAR - d) * i) / 160;
        const y = Ey(E) - ampOut * Math.sin((2 * Math.PI * nm) / lam);
        i ? ctx.lineTo(Xn(XBAR + d + nm), y) : ctx.moveTo(Xn(XBAR + d + nm), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // ---------- khung dưới: log10 T theo bề dày ----------
      const lo = Math.floor(lg(10) / 10) * 10;
      const Xd = (dd: number) => padL + ((dd - 1) / 9) * plotW;
      const Yl = (l: number) => botY1 - ((l - lo) / -lo) * (botY1 - botY0);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, botY0); ctx.lineTo(padL, botY1); ctx.lineTo(cssW - padR, botY1); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      const step = Math.max(10, Math.round(-lo / 50) * 10);
      ctx.textAlign = 'right';
      for (let l = 0; l >= lo; l -= step) ctx.fillText(l === 0 ? '1' : `10${supNum(l)}`, padL - 4, Yl(l) + 3);
      ctx.textAlign = 'center';
      for (const dd of [2, 4, 6, 8, 10]) ctx.fillText(dd === 10 ? '10 nm' : String(dd), Xd(dd), botY1 + 14);
      ctx.textAlign = 'left';
      ctx.fillText('xác suất xuyên T', padL + 4, botY0 - 4);
      ctx.globalAlpha = 1;

      // ngưỡng giữ điện tích 10 năm
      const lThr = Math.log10(1 / (NU * 10 * YR));
      if (lThr > lo) {
        ctx.strokeStyle = MARK; ctx.globalAlpha = 0.55; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(padL, Yl(lThr)); ctx.lineTo(cssW - padR, Yl(lThr)); ctx.stroke();
        ctx.setLineDash([]); ctx.fillStyle = MARK; ctx.textAlign = 'left';
        ctx.globalAlpha = 0.85;
        ctx.fillText('ngưỡng giữ được 10 năm', padL + 6, Yl(lThr) - 7);
        ctx.globalAlpha = 1;
      }

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 220; i++) {
        const dd = 1 + (9 * i) / 220;
        i ? ctx.lineTo(Xd(dd), Yl(lg(dd))) : ctx.moveTo(Xd(dd), Yl(lg(dd)));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(Xd(d), Yl(lg(d)), 6, 0, Math.PI * 2); ctx.fill();

      // ---------- dòng số liệu ----------
      const hold = years < 1
        ? `${fmt(years * YR)} giây`
        : years > 1.38e10
          ? `${fmt(years)} năm — gấp ${fmt(years / 1.38e10)} lần tuổi vũ trụ`
          : `${fmt(years)} năm`;
      const note = years < 10
        ? ' · <b>dưới 10 năm: ô nhớ không giữ nổi dữ liệu</b>'
        : '';
      readout.innerHTML =
        `Rào hiệu dụng φ − E = <b>${vn(dphi, 2)} eV</b> → κ = ${vn(kap, 2)} nm⁻¹ · ` +
        `qua ${vn(d, 1)} nm oxit: T = <b>${sci(T)}</b> mỗi lần va chạm · ` +
        `mỏng đi 1 nm thì rò nhanh gấp <b>${fmt(perNm)}</b> lần · ` +
        `giữ được điện tích ${hold}${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="xuyen-ham-luong-tu-trong-chiec-the-nho"]').forEach(setup);
</script>
