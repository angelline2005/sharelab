---
// Radio horizon (LOS propagation for VHF/UHF):
// d = √(2kRh₁) + √(2kRh₂) where kR ≈ 8500 km (standard atmosphere, k ≈ 4/3).
// Sliders for transmitter height, receiver height, and atmospheric refraction factor.
// Valid for VHF/UHF (30–3000 MHz) in standard conditions.
---

<figure class="demo" data-demo="chan-troi-vo-tuyen-cua-cot-phat-song">
  <canvas></canvas>
  <div class="controls">
    <label>Chiều cao cột phát h₁ (m) <output data-out="h1"></output>
      <input type="range" data-in="h1" min="5" max="600" step="5" value="100" /></label>
    <label>Chiều cao máy thu h₂ (m) <output data-out="h2"></output>
      <input type="range" data-in="h2" min="1" max="100" step="1" value="10" /></label>
    <label>Hệ số bán kính hiệu dụng k <output data-out="k"></output>
      <input type="range" data-in="k" min="1.00" max="1.50" step="0.01" value="1.33" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Sóng VHF/UHF đi thẳng, bị chặn bởi độ cong Trái Đất. Tầm phủ tính bằng công thức
    Fresnel đơn giản: tổng của hai căn bậc hai, mỗi cái đại diện cho một bên liên kết.
    Khúc xạ khí quyển (k > 1) kéo dãn tầm phủ như nhấn chân trời xuống; trong điều kiện
    khí quyển chuẩn, k ≈ 1,33.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const R = 6378; // Earth radius km
  const CURVE = '#2563eb', MARK = '#dc2626', THIRD = '#f59e0b';

  // d = √(2kRh₁) + √(2kRh₂)
  const horizon = (h1: number, h2: number, k: number): number => {
    const h1_km = h1 / 1000, h2_km = h2 / 1000;
    const kR = k * R;
    return Math.sqrt(2 * kR * h1_km) + Math.sqrt(2 * kR * h2_km);
  };

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const h1 = Number(input('h1').value);
      const h2 = Number(input('h2').value);
      const k = Number(input('k').value);

      output('h1').textContent = String(h1);
      output('h2').textContent = String(h2);
      output('k').textContent = k.toFixed(2);

      const d = horizon(h1, h2, k);
      const d_no_refr = horizon(h1, h2, 1);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 50, padB = 28, padT = 14, padR = cssW < 420 ? 26 : 10;
      // Max range on display: 150 km
      const maxRange = 150;
      const X = (dist: number) => padL + (dist / maxRange) * (cssW - padL - padR);
      const Y = (hh: number) => cssH - padB - (hh / 250) * (cssH - padB - padT);

      // Draw axes
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();

      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const km of [30, 60, 90, 120]) ctx.fillText(`${km} km`, X(km), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const hh of [50, 100, 150, 200, 250]) ctx.fillText(`${hh} m`, padL - 4, Y(hh) + 3);
      ctx.globalAlpha = 1;

      // Draw Earth curvature (stylized: simplified horizon)
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.15; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(padL - 5, cssH - padB + 2, 80, -0.2, -Math.PI + 0.2);
      ctx.stroke();
      ctx.globalAlpha = 1;

      // Draw transmitter and receiver towers
      const tx_x = X(0), tx_y = Y(0);
      const rx_x = X(d), rx_y = Y(0);

      // Transmitter tower
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(tx_x, cssH - padB); ctx.lineTo(tx_x, Y(h1)); ctx.stroke();
      ctx.fillStyle = CURVE;
      ctx.beginPath(); ctx.arc(tx_x, Y(h1), 5, 0, Math.PI * 2); ctx.fill();

      // Receiver tower
      ctx.strokeStyle = fg; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(rx_x, cssH - padB); ctx.lineTo(rx_x, Y(h2)); ctx.stroke();
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(rx_x, Y(h2), 4, 0, Math.PI * 2); ctx.fill();

      // Line of sight (with refraction)
      ctx.strokeStyle = CURVE; ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(tx_x, Y(h1)); ctx.lineTo(rx_x, Y(h2)); ctx.stroke();
      ctx.setLineDash([]);

      // Shadow/blocked zone behind receiver
      ctx.fillStyle = fg; ctx.globalAlpha = 0.05;
      ctx.beginPath();
      ctx.moveTo(rx_x, cssH - padB);
      ctx.lineTo(cssW - padR, cssH - padB);
      ctx.lineTo(cssW - padR, Y(0));
      ctx.lineTo(rx_x, Y(0));
      ctx.fill();
      ctx.globalAlpha = 1;

      // Readout
      readout.innerHTML =
        `Cột phát ${h1} m → ${Math.sqrt(2 * k * R * (h1/1000)).toFixed(1).replace('.', ',')} km · ` +
        `máy thu cao ${h2} m thêm ${Math.sqrt(2 * k * R * (h2/1000)).toFixed(1).replace('.', ',')} km → ` +
        `<b>tổng ${d.toFixed(1).replace('.', ',')} km</b> · ` +
        `bỏ khúc xạ (k=1): chỉ ${d_no_refr.toFixed(1).replace('.', ',')} km`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="chan-troi-vo-tuyen-cua-cot-phat-song"]').forEach(setup);
</script>
