---
// Retroreflector (corner reflector): two mirrors at angle α
// Deviation angle = 2(90° − α); brightness = R_A·E with E = I/d²
// Retroreflectance 250 cd/(lx·m²), white paint 0.27 cd/(lx·m²)
// Valid for mirror angles 80–100°, incident angles 5–85°, distances 10–300 m.
---

<figure class="demo" data-demo="bien-bao-phan-quang-va-guong-goc-vuong">
  <canvas></canvas>
  <div class="controls">
    <label>Góc giữa hai gương α (°) <output data-out="alpha"></output>
      <input type="range" data-in="alpha" min="80" max="100" step="0.1" value="90" /></label>
    <label>Góc tới của tia (°) <output data-out="theta"></output>
      <input type="range" data-in="theta" min="5" max="85" step="1" value="35" /></label>
    <label>Khoảng cách xe–biển (m) <output data-out="d"></output>
      <input type="range" data-in="d" min="10" max="300" step="5" value="100" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Nửa trái: hai gương ghép tại góc α, tia tới phản xạ hai lần. Khi α = 90°,
    tia ra song song ngược chiều với tia tới, dù góc tới lên xuống. Lệch 1°
    khỏi 90° làm tia về xoè 2°. Nửa phải: độ chói biển báo (màng phản quang
    250 cd/(lx·m²)) so với sơn trắng khuếch tán (0,27 cd/(lx·m²)) theo thang
    log, với vệt sáng trả về vẽ đúng độ xoè theo khoảng cách.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', THIRD = '#f59e0b';
  const R_retro = 250;    // cd/(lx·m²)
  const R_white = 0.27;   // cd/(lx·m²)
  const I_normalized = 1000; // normalized intensity for distance calculation

  function computeDeviation(alpha: number): number {
    return 2 * (90 - alpha);
  }

  function computeBrightness(d: number, R: number): number {
    return R * (I_normalized / (d * d));
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const alpha = Number(input('alpha').value);
      const theta = Number(input('theta').value);
      const d = Number(input('d').value);

      output('alpha').textContent = alpha.toFixed(1).replace('.', ',');
      output('theta').textContent = String(theta);
      output('d').textContent = d.toLocaleString('vi-VN');

      const deviation = computeDeviation(alpha);
      const b_retro = computeBrightness(d, R_retro);
      const b_white = computeBrightness(d, R_white);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32;
      const cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const midX = cssW / 2;
      const leftW = midX - 8;
      const rightX = midX + 8;
      const rightW = cssW - rightX;

      // Left side: retroreflector geometry
      const mirrorLength = 80;
      const cx = 30, cy = cssH / 2;

      ctx.strokeStyle = fg;
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = 1.5;

      // Mirror 1 (vertical at alpha = 90°)
      const m1StartX = cx, m1StartY = cy - mirrorLength / 2;
      const m1EndX = cx, m1EndY = cy + mirrorLength / 2;

      // Mirror 2 (at angle alpha)
      const alpha_rad = (alpha - 90) * Math.PI / 180;
      const m2Len = mirrorLength / Math.cos(alpha_rad);
      const m2StartX = cx + m2Len / 2 * Math.cos(alpha_rad);
      const m2StartY = cy + m2Len / 2 * Math.sin(alpha_rad);
      const m2EndX = cx - m2Len / 2 * Math.cos(alpha_rad);
      const m2EndY = cy - m2Len / 2 * Math.sin(alpha_rad);

      ctx.beginPath();
      ctx.moveTo(m1StartX, m1StartY);
      ctx.lineTo(m1EndX, m1EndY);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(m2StartX, m2StartY);
      ctx.lineTo(m2EndX, m2EndY);
      ctx.stroke();

      // Draw incident ray
      const theta_rad = theta * Math.PI / 180;
      const rayLen = 50;
      const rayStartX = cx - rayLen * Math.cos(theta_rad);
      const rayStartY = cy - rayLen * Math.sin(theta_rad);

      ctx.strokeStyle = CURVE;
      ctx.globalAlpha = 0.7;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(rayStartX, rayStartY);
      ctx.lineTo(cx, cy);
      ctx.stroke();

      // Reflect ray off mirror 1
      const reflectedTheta1 = -theta_rad;
      const midX1 = cx + rayLen * 0.3 * Math.cos(reflectedTheta1);
      const midY1 = cy + rayLen * 0.3 * Math.sin(reflectedTheta1);

      ctx.strokeStyle = CURVE;
      ctx.globalAlpha = 0.6;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(midX1, midY1);
      ctx.stroke();

      // Reflect ray off mirror 2 and exit
      const deviation_rad = deviation * Math.PI / 180;
      const exitTheta = theta_rad + deviation_rad;
      const exitX = midX1 + rayLen * 0.4 * Math.cos(exitTheta);
      const exitY = midY1 + rayLen * 0.4 * Math.sin(exitTheta);

      ctx.strokeStyle = CURVE;
      ctx.globalAlpha = 0.9;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(midX1, midY1);
      ctx.lineTo(exitX, exitY);
      ctx.stroke();

      // Label for left side
      ctx.fillStyle = fg;
      ctx.globalAlpha = 0.6;
      ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Gương phản xạ', cx, cssH - 12);

      // Right side: brightness comparison
      ctx.globalAlpha = 1;
      ctx.fillStyle = fg;
      ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'left';
      ctx.globalAlpha = 0.6;
      ctx.fillText('Độ chói', rightX + 4, 16);

      const logScale = (v: number) => {
        if (v <= 0) return 0;
        return Math.log10(v + 1) / Math.log10(100); // normalize to 0-1 scale
      };

      const logB_retro = logScale(b_retro);
      const logB_white = logScale(b_white);
      const barH_retro = logB_retro * (cssH - 60);
      const barH_white = logB_white * (cssH - 60);

      const bar1X = rightX + 20;
      const bar2X = rightX + 65;
      const baseY = cssH - 20;

      // White paint bar
      ctx.fillStyle = '#999';
      ctx.globalAlpha = 0.4;
      ctx.fillRect(bar1X, baseY - barH_white, 25, barH_white);

      // Retroreflector bar
      ctx.fillStyle = CURVE;
      ctx.globalAlpha = 0.8;
      ctx.fillRect(bar2X, baseY - barH_retro, 25, barH_retro);

      // Labels
      ctx.fillStyle = fg;
      ctx.globalAlpha = 0.6;
      ctx.font = '9px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Sơn trắng', bar1X + 12.5, baseY + 10);
      ctx.fillText('Phản quang', bar2X + 12.5, baseY + 10);

      // Axis lines
      ctx.strokeStyle = fg;
      ctx.globalAlpha = 0.3;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(rightX, 12);
      ctx.lineTo(rightX, baseY);
      ctx.lineTo(rightX + 100, baseY);
      ctx.stroke();

      // Readout
      const ratio = R_retro / R_white;
      readout.innerHTML =
        `α = <b>${alpha.toFixed(1).replace('.', ',')}</b>° · góc tới <b>${theta}</b>° → tia ra lệch <b>${Math.abs(deviation).toFixed(1).replace('.', ',')}</b>° ` +
        `· biển ở <b>${d}</b> m: <b>${b_retro.toFixed(1).replace('.', ',')}</b> cd/m² (sơn trắng: <b>${b_white.toFixed(3).replace('.', ',')}</b>) ` +
        `· gấp <b>${ratio.toFixed(0)}</b> lần`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }

  document.querySelectorAll<HTMLElement>('[data-demo="bien-bao-phan-quang-va-guong-goc-vuong"]').forEach(setup);
</script>
