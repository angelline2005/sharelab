---
// Baffled-piston far-field on-axis pressure (half space, ka << 1):
//   p_peak = 2·pi·rho·f^2·Sd·x / r   ->   x = p_peak·r / (2·pi·rho·f^2·Sd)
// Beranek, Acoustics, ch. 4 (rigid circular piston in an infinite baffle).
// rho = 1,2 kg/m3, r = 1 m, p_peak = sqrt(2)·20 uPa·10^(SPL/20).
// Valid while the cone is acoustically compact: ka < 1, i.e. f < c/(2·pi·a)
// with a = sqrt(Sd/pi). For Sd = 133 cm2 that is 840 Hz, so the frequency
// slider stops at 500 Hz. X_max is a rule of thumb (4,5% of the effective
// cone diameter), not a law — it is drawn as a reference line only.
---

<figure class="demo" data-demo="loa-bass-mot-quang-tam-tra-gia-gap-bon">
  <canvas></canvas>
  <div class="controls">
    <label>Diện tích màng hiệu dụng Sd (cm²) <output data-out="sd"></output>
      <input type="range" data-in="sd" min="7" max="1200" step="1" value="133" /></label>
    <label>Tần số f (Hz) <output data-out="f"></output>
      <input type="range" data-in="f" min="10" max="500" step="1" value="30" /></label>
    <label>Mức âm cần ở 1 m (dB) <output data-out="spl"></output>
      <input type="range" data-in="spl" min="70" max="110" step="1" value="90" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trái: mặt cắt côn loa, vạch đỏ là hành trình đỉnh mà màng phải đi để đạt
    mức âm bạn chọn, dải vàng là giới hạn cơ khí X_max của driver. Phải: hành
    trình cần (mm, trục lôgarit) theo tần số — mỗi quãng tám đi xuống, đường
    cong nhảy lên gấp bốn. Chỗ nó cắt vạch X_max là tần số trầm thấp nhất loa
    còn phát sạch; dưới đó màng chạm giới hạn và tiếng méo.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', LIM = '#f59e0b';
  const RHO = 1.2, C = 343, R = 1;

  // Nominal driver size (cm) -> effective cone area Sd (cm2), catalogue values.
  const SIZES: Array<[number, number]> = [
    [4, 7], [5, 12], [8, 32], [10, 50], [13, 87], [16, 133],
    [20, 220], [25, 330], [30, 480], [38, 880], [46, 1210],
  ];

  const pPeak = (spl: number) => Math.SQRT2 * 20e-6 * Math.pow(10, spl / 20);
  // Required peak excursion, in mm, for Sd in cm2.
  const exc = (spl: number, f: number, sd: number) =>
    1000 * pPeak(spl) * R / (2 * Math.PI * RHO * f * f * (sd / 1e4));
  const dEff = (sd: number) => 2 * Math.sqrt(sd / Math.PI);      // cm
  const xMax = (sd: number) => 0.45 * dEff(sd);                  // mm, 4,5% of d_eff
  const nominal = (sd: number) =>
    SIZES.reduce((b, s) => Math.abs(Math.log(s[1] / sd)) < Math.abs(Math.log(b[1] / sd)) ? s : b)[0];
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const sd = Number(input('sd').value);
      const f = Number(input('f').value);
      const spl = Number(input('spl').value);
      output('sd').textContent = `${sd} — cỡ ${nominal(sd)} cm`;
      output('f').textContent = String(f);
      output('spl').textContent = String(spl);

      const xm = xMax(sd);
      const xr = exc(spl, f, sd);
      // Lowest frequency the driver can still reach inside X_max.
      const fLow = Math.sqrt(1000 * pPeak(spl) * R / (2 * Math.PI * RHO * (sd / 1e4) * xm));

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- left panel: the cone and its travel ----------
      const gW = Math.max(96, Math.round(cssW * 0.3));
      const gcx = gW * 0.46, gcy = cssH * 0.5, gh = cssH * 0.34;
      const span = Math.max(xr, xm) * 1.3;
      const GY = (mm: number) => gcy - (mm / span) * gh;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.25;
      ctx.beginPath(); ctx.moveTo(gcx, GY(span)); ctx.lineTo(gcx, GY(-span)); ctx.stroke();
      ctx.globalAlpha = 1;

      // X_max band.
      ctx.fillStyle = LIM; ctx.globalAlpha = 0.22;
      ctx.fillRect(gcx - 26, GY(xm), 52, GY(-xm) - GY(xm));
      ctx.globalAlpha = 1;
      ctx.strokeStyle = LIM;
      for (const s of [1, -1]) { ctx.beginPath(); ctx.moveTo(gcx - 26, GY(s * xm)); ctx.lineTo(gcx + 26, GY(s * xm)); ctx.stroke(); }

      // Required peak excursion.
      ctx.strokeStyle = MARK; ctx.lineWidth = 2; ctx.setLineDash([4, 3]);
      for (const s of [1, -1]) { ctx.beginPath(); ctx.moveTo(gcx - 34, GY(s * xr)); ctx.lineTo(gcx + 34, GY(s * xr)); ctx.stroke(); }
      ctx.setLineDash([]); ctx.lineWidth = 1;

      // Cone at rest, seen from the side.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.75; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(gcx - 24, gcy - 9); ctx.lineTo(gcx - 6, gcy); ctx.lineTo(gcx + 6, gcy); ctx.lineTo(gcx + 24, gcy - 9);
      ctx.stroke(); ctx.lineWidth = 1; ctx.globalAlpha = 1;

      ctx.fillStyle = MARK; ctx.textAlign = 'center';
      ctx.fillText(`cần ±${vn(xr, xr < 1 ? 3 : 2)} mm`, gcx, GY(xr) - 6);
      ctx.fillStyle = LIM;
      ctx.fillText(`X_max ±${vn(xm, 2)} mm`, gcx, GY(-xm) + 13);

      // ---------- right panel: required excursion vs frequency ----------
      const padL = gW + 40, padR = cssW < 420 ? 26 : 10, padT = 16, padB = 26;
      const fLo = 10, fHi = 500;
      const lo = Math.min(exc(spl, fHi, sd), xm), hi = Math.max(exc(spl, fLo, sd), xm);
      const dLo = Math.max(-4, Math.floor(Math.log10(lo))), dHi = Math.min(3, Math.ceil(Math.log10(hi)));
      const X = (ff: number) => padL + (Math.log10(ff / fLo) / Math.log10(fHi / fLo)) * (cssW - padL - padR);
      const Y = (mm: number) => padT + ((dHi - Math.log10(Math.max(mm, 1e-9))) / (dHi - dLo)) * (cssH - padT - padB);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'center';
      for (const t of [10, 20, 30, 50, 100, 200]) ctx.fillText(`${t}`, X(t), cssH - padB + 14);
      ctx.textAlign = 'right';
      ctx.fillText('500 Hz', cssW - padR, cssH - padB + 14);
      for (let d = dLo; d <= dHi; d++) {
        const v = Math.pow(10, d);
        ctx.fillText(`${v >= 1 ? v : vn(v, -d)} mm`, padL - 4, Y(v) + 3);
      }
      ctx.globalAlpha = 1;

      // X_max reference line.
      ctx.strokeStyle = LIM; ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(padL, Y(xm)); ctx.lineTo(cssW - padR, Y(xm)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = LIM; ctx.textAlign = 'right';
      ctx.fillText('X_max', cssW - padR, Y(xm) - 5);

      // Required-excursion curve.
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 220; i++) {
        const ff = fLo * Math.pow(fHi / fLo, i / 220);
        const y = Y(exc(spl, ff, sd));
        i ? ctx.lineTo(X(ff), y) : ctx.moveTo(X(ff), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Crossing frequency.
      if (fLow > fLo && fLow < fHi) {
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.45; ctx.setLineDash([3, 3]);
        ctx.beginPath(); ctx.moveTo(X(fLow), Y(xm)); ctx.lineTo(X(fLow), cssH - padB); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 0.75; ctx.fillStyle = fg; ctx.textAlign = 'left';
        ctx.fillText(`${vn(fLow, 0)} Hz`, X(fLow) + 4, cssH - padB - 6);
        ctx.globalAlpha = 1;
      }

      ctx.fillStyle = MARK;
      const my = Math.min(Math.max(Y(xr), padT), cssH - padB);
      ctx.beginPath(); ctx.arc(X(f), my, 6, 0, Math.PI * 2); ctx.fill();

      const verdict = xr > xm
        ? ` > X_max ${vn(xm, 2)} mm → <b>méo, không phát nổi</b>`
        : ` ≤ X_max ${vn(xm, 2)} mm → phát sạch`;
      const floor = fLow <= fLo
        ? `xuống hết dải 20 Hz vẫn còn dư hành trình`
        : `trầm thấp nhất ở mức này: <b>${vn(fLow, 0)} Hz</b>`;
      readout.innerHTML =
        `Sd ${sd} cm² (cỡ ${nominal(sd)} cm, đường kính hiệu dụng ${vn(dEff(sd), 1)} cm) · ` +
        `${spl} dB @ 1 m · ${f} Hz → cần <b>${vn(xr, xr < 1 ? 3 : 2)} mm</b> đỉnh ` +
        `(${vn(2 * xr, xr < 1 ? 3 : 1)} mm đỉnh–đỉnh)${verdict} · ${floor}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="loa-bass-mot-quang-tam-tra-gia-gap-bon"]').forEach(setup);
</script>
