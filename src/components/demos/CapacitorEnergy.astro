---
// Capacitor energy: E = ½CV². Drawn honestly as the triangle under the V–Q
// line (slope 1/C): each extra coulomb must be pushed in at the voltage the
// charge already there has built up. Sliders for C and V. Static redraw.
---

<figure class="demo" data-demo="cap-energy">
  <canvas></canvas>
  <div class="controls">
    <label>Điện dung C (µF) <output data-out="c"></output>
      <input type="range" data-in="c" min="10" max="2000" step="10" value="1000" /></label>
    <label>Điện áp nạp V (V) <output data-out="v"></output>
      <input type="range" data-in="v" min="10" max="2000" step="10" value="300" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Năng lượng là <em>diện tích tam giác</em> dưới đường V–Q: coulomb đầu tiên
    vào gần như miễn phí, coulomb cuối phải đẩy ngược đủ cả V vôn. Vì thế mới
    có hệ số ½ — và vì thế năng lượng tăng theo <em>bình phương</em> điện áp.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const FILL = '#2563eb', EDGE = '#dc2626';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    function draw() {
      const C = Number(input('c').value) * 1e-6;
      const V = Number(input('v').value);
      output('c').textContent = String(Number(input('c').value));
      output('v').textContent = String(V);
      const Q = C * V;
      const E = 0.5 * C * V * V;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.44);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 40, padB = 30, padT = 14, padR = cssW < 420 ? 26 : 14;
      // Axes normalized to the current maxima so the triangle always fills the frame;
      // the *labels* carry the real scale.
      const x1 = cssW - padR, y1 = padT, x0 = padL, y0 = cssH - padB;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(x0, padT); ctx.lineTo(x0, y0); ctx.lineTo(x1, y0); ctx.stroke();
      ctx.globalAlpha = 1;

      // Energy triangle.
      ctx.fillStyle = FILL; ctx.globalAlpha = 0.25;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y0); ctx.lineTo(x1, y1); ctx.closePath(); ctx.fill();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = EDGE; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
      ctx.lineWidth = 1;

      ctx.fillStyle = fg; ctx.globalAlpha = 0.65;
      ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      const fmtQ = Q >= 1 ? `${Q.toFixed(2).replace('.', ',')} C` : `${(Q * 1000).toFixed(1).replace('.', ',')} mC`;
      ctx.fillText(`Q = ${fmtQ}`, x1 - 30, y0 + 16);
      ctx.fillText('điện tích →', (x0 + x1) / 2, y0 + 16);
      ctx.save(); ctx.translate(x0 - 14, (y0 + y1) / 2); ctx.rotate(-Math.PI / 2);
      ctx.fillText(`điện áp → ${V} V`, 0, 0); ctx.restore();
      ctx.globalAlpha = 1;

      ctx.fillStyle = FILL; ctx.font = 'bold 13px system-ui,sans-serif';
      const fmtE = E >= 1 ? `${E.toFixed(1).replace('.', ',')} J` : `${(E * 1000).toFixed(1).replace('.', ',')} mJ`;
      ctx.fillText(`E = ½CV² = ${fmtE}`, x0 + (x1 - x0) * 0.62, y0 - (y0 - y1) * 0.18);

      const P1ms = E / 1e-3;
      const fmtP = P1ms >= 1000 ? `${(P1ms / 1000).toFixed(1).replace('.', ',')} kW` : `${P1ms.toFixed(0)} W`;
      readout.innerHTML =
        `E = <b>${fmtE}</b> · xả hết trong 1 ms → công suất tức thời <b>${fmtP}</b>` +
        ` · so sánh: pin AA trữ ~13 500 J nhưng chỉ nhả ra được vài oát`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="cap-energy"]').forEach(setup);
</script>
