---
// Block-stacking (single-wide) overhang: mỗi cuốn thứ k tính từ trên nhô hơn
// cuốn dưới đúng L/(2k), nên độ nhô tối đa = (L/2)·H_n với H_n = Σ 1/k.
// Nguồn: bài toán chồng gạch cổ điển (J. B. Phear 1850; Paterson–Winkler 2006
// tổng kết), suy ra từ điều kiện trọng tâm của chồng con nằm đúng mép cuốn dưới.
// Giả định: sách cứng tuyệt đối, đồng chất, một cuốn mỗi tầng, không trượt.
// Miền hợp lệ của hình vẽ: n = 1–40. Đường cong bên phải kéo tới n = 10 000
// (H_n lấy tổng chính xác tới 2 000, ngoài ra dùng ln n + γ + 1/2n).
---

<figure class="demo" data-demo="chong-sach-nho-ra-khoi-mep-ban-bao-xa">
  <canvas></canvas>
  <div class="controls">
    <label>Số cuốn n <output data-out="n"></output>
      <input type="range" data-in="n" min="1" max="40" step="1" value="4" /></label>
    <label>Chiều dài mỗi cuốn L (cm) <output data-out="l"></output>
      <input type="range" data-in="l" min="15" max="30" step="1" value="20" /></label>
    <label>Độ dày mỗi cuốn (cm) <output data-out="t"></output>
      <input type="range" data-in="t" min="1" max="5" step="0.5" value="3" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trái: hình chiếu cạnh của chồng sách. Chấm cam là trọng tâm của chồng con
    phía trên mỗi khe, đường đứt nét thả thẳng xuống — nó luôn rơi đúng mép
    cuốn ngay dưới, đó là điều kiện chưa đổ. Phải: độ nhô theo số cuốn, trục
    ngang chia theo lũy thừa của 10. Đường cong đi lên mãi nhưng mỗi thân sách
    thêm vào đòi số cuốn nhân lên hơn bảy lần. Độ dày chỉ đổi hình vẽ, không
    đổi độ nhô.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const GAMMA = 0.5772156649015329;

  // Tổng điều hòa: chính xác tới n = 2000, ngoài ra dùng khai triển tiệm cận.
  const HSUM: number[] = [0];
  for (let k = 1; k <= 2000; k++) HSUM.push(HSUM[k - 1] + 1 / k);
  const Hn = (n: number) => {
    if (n <= 1) return n;
    if (n <= 2000 && Number.isInteger(n)) return HSUM[n];
    return Math.log(n) + GAMMA + 1 / (2 * n) - 1 / (12 * n * n);
  };
  const vi = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const n = Number(input('n').value);
      const L = Number(input('l').value);
      const t = Number(input('t').value);
      output('n').textContent = String(n);
      output('l').textContent = String(L);
      output('t').textContent = vi(t, 1);

      // Mép phải của cuốn thứ k tính từ TRÊN, đo từ mép bàn. Cuốn đáy (k = n)
      // chỉ nhô L/(2n); mỗi cuốn cao hơn nhô thêm L/(2k), nên cộng dồn từ đáy:
      //   E_k = Σ_{j=k..n} L/(2j) = (L/2)·(H_n − H_(k−1)).
      // Cuốn trên cùng E_1 = (L/2)·H_n là toàn bộ độ nhô.
      const edge = (k: number) => (L / 2) * (Hn(n) - Hn(k - 1));
      const over = edge(1);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.52);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- Bảng trái: hình chiếu cạnh chồng sách ----------
      const pL = 6, pR = 8;
      const panelW = (cssW - pL - pR) * 0.53;
      const boxL = pL, boxT = 20, boxB = cssH - 26;
      const wxMin = -L * 1.2, wxMax = over + L * 0.18;
      const sx = panelW / (wxMax - wxMin);
      const sy = (boxB - boxT) / Math.max(n * t, t * 1.6);
      const s = Math.min(sx, sy);
      const X0 = boxL + (panelW - (wxMax - wxMin) * s) / 2 - wxMin * s;
      const Y0 = boxB;
      const PX = (x: number) => X0 + x * s;
      const PY = (y: number) => Y0 - y * s;

      // Mặt bàn.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.45;
      ctx.beginPath(); ctx.moveTo(boxL, PY(0)); ctx.lineTo(PX(0), PY(0)); ctx.lineTo(PX(0), PY(0) + 12); ctx.stroke();
      ctx.globalAlpha = 0.18;
      for (let x = boxL; x < PX(0); x += 7) { ctx.beginPath(); ctx.moveTo(x, PY(0)); ctx.lineTo(x + 5, PY(0) + 7); ctx.stroke(); }
      ctx.globalAlpha = 0.6; ctx.fillStyle = fg; ctx.textAlign = 'left';
      ctx.fillText('mép bàn', PX(0) + 3, PY(0) + 20);
      ctx.globalAlpha = 1;

      // Đường thẳng đứng qua mép bàn.
      ctx.strokeStyle = MARK; ctx.globalAlpha = 0.4; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(PX(0), PY(0)); ctx.lineTo(PX(0), boxT - 6); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // Các cuốn sách: k = n ở đáy, k = 1 trên cùng.
      for (let k = n; k >= 1; k--) {
        const r = edge(k), yb = (n - k) * t;
        const px = PX(r - L), py = PY(yb + t), pw = L * s, ph = t * s;
        ctx.fillStyle = CURVE; ctx.globalAlpha = k === 1 ? 0.32 : 0.16;
        ctx.fillRect(px, py, pw, ph);
        ctx.globalAlpha = 0.55; ctx.strokeStyle = CURVE;
        ctx.strokeRect(px, py, pw, ph);
        ctx.globalAlpha = 1;
      }

      // Trọng tâm của chồng con phía trên mỗi khe + đường dọi.
      for (let k = 1; k <= n; k++) {
        const pivot = k === n ? 0 : edge(k + 1);
        const comY = (n - k / 2) * t, footY = (n - k) * t;
        ctx.strokeStyle = LM; ctx.globalAlpha = 0.5; ctx.setLineDash([2, 3]);
        ctx.beginPath(); ctx.moveTo(PX(pivot), PY(comY)); ctx.lineTo(PX(pivot), PY(footY)); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
        ctx.fillStyle = LM;
        ctx.beginPath(); ctx.arc(PX(pivot), PY(comY), n > 24 ? 2 : 2.8, 0, Math.PI * 2); ctx.fill();
      }

      // Thước độ nhô ở đỉnh.
      const yTop = Math.max(boxT - 6, PY(n * t) - 10);
      ctx.strokeStyle = MARK; ctx.lineWidth = 1.4;
      ctx.beginPath(); ctx.moveTo(PX(0), yTop); ctx.lineTo(PX(over), yTop); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(PX(over), yTop - 3); ctx.lineTo(PX(over), yTop + 3); ctx.stroke();
      ctx.lineWidth = 1;
      ctx.fillStyle = MARK; ctx.textAlign = 'center';
      ctx.fillText(`${vi(over, 1)} cm`, (PX(0) + PX(over)) / 2, yTop - 5);

      // ---------- Bảng phải: độ nhô theo n, trục ngang log ----------
      const qL = boxL + panelW + 42, qR = cssW - pR, qT = 26, qB = cssH - 26;
      const yMax = 5.2;
      const QX = (nn: number) => qL + (Math.log10(nn) / 4) * (qR - qL);
      const QY = (o: number) => qB - (o / yMax) * (qB - qT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(qL, qT); ctx.lineTo(qL, qB); ctx.lineTo(qR, qB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      const XT: Array<[number, string]> = [[1, '1'], [10, '10'], [100, '100'], [1000, '1 000'], [10000, '10 000']];
      for (const [v, lab] of XT) ctx.fillText(lab, QX(v), qB + 13);
      ctx.fillText('số cuốn n', (qL + qR) / 2, qB + 24);
      ctx.textAlign = 'right';
      for (const o of [1, 2, 3, 4, 5]) ctx.fillText(String(o), qL - 4, QY(o) + 3);
      ctx.textAlign = 'left';
      ctx.fillText('độ nhô (thân sách)', qL - 30, qT - 8);
      ctx.globalAlpha = 1;

      // Vạch tham chiếu 1, 2, 3 thân sách và số cuốn cần có.
      const REF: Array<[number, number]> = [[1, 4], [2, 31], [3, 227]];
      for (const [o, need] of REF) {
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.18; ctx.setLineDash([3, 4]);
        ctx.beginPath(); ctx.moveTo(qL, QY(o)); ctx.lineTo(qR, QY(o)); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
        ctx.fillStyle = LM;
        ctx.beginPath(); ctx.arc(QX(need), QY(o), 3.2, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.75; ctx.textAlign = 'left';
        ctx.fillText(`${need} cuốn`, QX(need) + 6, QY(o) - 4);
        ctx.globalAlpha = 1;
      }

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const nn = Math.pow(10, (4 * i) / 240);
        const o = Hn(nn <= 1 ? 1 : nn) / 2;
        i ? ctx.lineTo(QX(Math.max(nn, 1)), QY(o)) : ctx.moveTo(QX(1), QY(o));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(QX(n), QY(Hn(n) / 2), 5.5, 0, Math.PI * 2); ctx.fill();

      // ---------- Readout ----------
      const ratio = over / L;
      const step = (L / (2 * n)) * 10; // bước của cuốn dưới cùng, mm
      const zone = ratio >= 1
        ? ' · <b>cuốn trên cùng đã hoàn toàn ra ngoài mép bàn</b>'
        : ' · cuốn trên cùng vẫn còn một phần tựa trên mặt bàn';
      readout.innerHTML =
        `n = ${n} cuốn · độ nhô = <b>${vi(ratio, 2)} thân sách = ${vi(over, 1)} cm</b>${zone}` +
        `<br />Cuốn dưới cùng chỉ được nhô thêm L/(2n) = ${vi(step, 2)} mm.`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="chong-sach-nho-ra-khoi-mep-ban-bao-xa"]').forEach(setup);
</script>
