---
// Nam châm điện hút vật qua khe hở x, mô hình từ trở khe không khí:
//   F(x) = k·I²/x²      (k gộp µ0, diện tích cực từ và số vòng dây)
// Hiệu chuẩn: ở I = 1,00 lần dòng danh định và tải danh định 1 000 kg,
// điểm cân bằng rơi đúng vào khe hở thiết kế x₀ → k = m₀·g·x₀².
// Cân bằng F = mg cho x_eq = x₀·I·√(m₀/m).
// Độ dốc tại cân bằng: dF/dx = −2F/x = −2mg/x_eq (âm ⇒ bất ổn).
// Tuyến tính hoá δ¨ = (2g/x_eq)·δ ⇒ hằng số tăng trưởng τ = √(x_eq/2g),
// không phụ thuộc khối lượng lẫn dòng điện.
// Nhịp lấy mẫu tối thiểu: sai lệch không được lớn quá 2% giữa hai lần đo
//   ⇒ f ≥ 1/(τ·ln 1,02).
// Giá trị đúng khi khe hở nhỏ so với bề mặt cực từ và lõi sắt chưa bão hoà
// (thực tế: khe dưới ~25 mm, dòng dưới ~2 lần danh định).
---

<figure class="demo" data-demo="tau-dem-tu-va-22-mili-giay-de-roi">
  <canvas></canvas>
  <div class="controls">
    <label>Khe hở thiết kế x₀ (mm) <output data-out="x0"></output>
      <input type="range" data-in="x0" min="2" max="20" step="0.5" value="10" /></label>
    <label>Dòng nam châm I (× danh định) <output data-out="i"></output>
      <input type="range" data-in="i" min="0.5" max="2" step="0.01" value="1" /></label>
    <label>Tải mỗi nam châm gánh (kg) <output data-out="m"></output>
      <input type="range" data-in="m" min="100" max="2000" step="50" value="1000" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường xanh là lực hút F = k·I²/x², đường ngang là trọng lượng mg. Chúng
    cắt nhau đúng một điểm — điểm cân bằng, khoanh đỏ. Hai mũi tên vàng là
    chiều của lực dư khi khe hở lệch đi một chút: cả hai đều chỉ ra xa điểm
    cắt, nên mọi sai lệch đều tự lớn lên. Thời gian để sai lệch nhân e chỉ
    phụ thuộc khe hở, không phụ thuộc con tàu nặng bao nhiêu.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', ARROW = '#f59e0b';
  const G = 9.81, M0 = 1000;

  const vi = (v: number, d: number) => v.toFixed(d).replace('.', ',');
  const grp = (v: number) => Math.round(v).toLocaleString('vi-VN');

  function niceStep(raw: number) {
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    for (const m of [1, 2, 2.5, 5, 10]) if (raw <= m * p) return m * p;
    return 10 * p;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function arrow(x1: number, y: number, x2: number, label: string) {
      const dir = Math.sign(x2 - x1);
      ctx.strokeStyle = ARROW; ctx.fillStyle = ARROW; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(x1, y); ctx.lineTo(x2, y); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x2, y); ctx.lineTo(x2 - dir * 7, y - 4); ctx.lineTo(x2 - dir * 7, y + 4);
      ctx.closePath(); ctx.fill();
      ctx.lineWidth = 1;
      ctx.font = '10px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(label, (x1 + x2) / 2, y - 8);
    }

    function draw() {
      const x0 = Number(input('x0').value);
      const I = Number(input('i').value);
      const m = Number(input('m').value);
      output('x0').textContent = vi(x0, 1);
      output('i').textContent = vi(I, 2);
      output('m').textContent = grp(m);

      const xEq = x0 * I * Math.sqrt(M0 / m);          // mm
      const mgN = m * G;                                // N
      const tau = Math.sqrt(xEq / 1000 / (2 * G));      // s
      const slope = 2 * mgN / xEq / 1000;               // kN/mm
      const fMin = 1 / (tau * Math.log(1.02));          // Hz

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 54, padB = 28, padT = 16, padR = 14;
      const xMax = niceStep(Math.max(xEq * 1.6, x0 * 1.6, 4));
      const yMax = niceStep(mgN * 2.4 / 1000);          // kN
      const X = (x: number) => padL + (x / xMax) * (cssW - padL - padR);
      const Y = (f: number) => cssH - padB - (f / yMax) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();

      const xs = niceStep(xMax / 6), ys = niceStep(yMax / 6);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (let t = xs; t <= xMax + 1e-9; t += xs) ctx.fillText(`${vi(t, t < 10 ? 1 : 0)} mm`, X(t), cssH - padB + 15);
      ctx.textAlign = 'right';
      for (let t = ys; t <= yMax + 1e-9; t += ys) ctx.fillText(`${vi(t, ys < 1 ? 1 : 0)} kN`, padL - 5, Y(t) + 3);
      ctx.globalAlpha = 1;

      // Trọng lượng mg: đường ngang.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.45; ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(padL, Y(mgN / 1000)); ctx.lineTo(cssW - padR, Y(mgN / 1000)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.7; ctx.fillStyle = fg; ctx.textAlign = 'right';
      ctx.fillText(`trọng lượng mg = ${vi(mgN / 1000, 2)} kN`, cssW - padR, Y(mgN / 1000) - 6);
      ctx.globalAlpha = 1;

      // Lực hút F = mg·(xEq/x)².
      const F = (x: number) => (mgN / 1000) * (xEq / x) * (xEq / x);
      const xStart = xEq / Math.sqrt(yMax * 1000 / mgN);
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 300; i++) {
        const x = xStart + ((xMax - xStart) * i) / 300;
        i ? ctx.lineTo(X(x), Y(F(x))) : ctx.moveTo(X(x), Y(F(x)));
      }
      ctx.stroke(); ctx.lineWidth = 1;
      ctx.fillStyle = CURVE; ctx.textAlign = 'left';
      ctx.fillText('lực hút F = k·I²/x²', X(xStart) + 8, padT + 12);

      // Mũi tên lực dư: hai bên đều rời xa điểm cân bằng.
      const yA = Y(mgN / 1000) + 26;
      if (X(xEq) > padL + 60 && X(xEq) < cssW - padR - 60 && yA < cssH - padB - 4) {
        arrow(X(xEq) - 12, yA, X(xEq) - 58, 'dính chặt');
        arrow(X(xEq) + 12, yA, X(xEq) + 58, 'rơi');
      }

      // Điểm cân bằng.
      if (xEq <= xMax) {
        ctx.fillStyle = MARK;
        ctx.beginPath(); ctx.arc(X(xEq), Y(mgN / 1000), 6, 0, Math.PI * 2); ctx.fill();
      }

      let note = '';
      if (xEq <= 4) note = ' · <b>khe dưới 4 mm: mọi mối nối ray là một cú sốc</b>';
      else if (xEq >= 40) note = ' · <b>khe này đòi dòng điện và khối sắt ngoài tầm thực tế</b>';

      readout.innerHTML =
        `Khe hở cân bằng <b>${vi(xEq, 1)} mm</b> · dF/dx = −2mg/x = <b>−${vi(slope, 2)} kN/mm</b>` +
        ` · sai lệch nhân e sau <b>${vi(tau * 1000, 1)} ms</b>` +
        ` · phải đo khe hở ít nhất <b>${grp(fMin)} lần/giây</b>${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="tau-dem-tu-va-22-mili-giay-de-roi"]').forEach(setup);
</script>
