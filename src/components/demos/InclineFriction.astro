---
// Block on an incline with static friction. Static redraw on input: the tilt
// slider sweeps the angle, the force triangle updates, and the block "lets go"
// exactly at tan θ = μ — a threshold that does not care about the mass at all.
---

<figure class="demo" data-demo="incline">
  <canvas></canvas>
  <div class="controls">
    <label>Góc nghiêng <output data-out="ang"></output>
      <input type="range" data-in="ang" min="0" max="50" step="0.5" value="15" /></label>
    <label>Hệ số ma sát nghỉ μ <output data-out="mu"></output>
      <input type="range" data-in="mu" min="0.1" max="1" step="0.05" value="0.5" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Thành phần kéo xuống dọc mặt nghiêng là mg·sinθ; ma sát nghỉ giữ được tối đa
    μ·mg·cosθ. Khối bắt đầu trượt khi hai lực này gặp nhau — tại tanθ = μ.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const HOLD = '#2563eb', PULL = '#dc2626';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    function draw() {
      const deg = Number(input('ang').value);
      const mu = Number(input('mu').value);
      const th = (deg * Math.PI) / 180;
      output('ang').textContent = `${deg.toFixed(1)}°`;
      output('mu').textContent = mu.toFixed(2);

      const slipDeg = (Math.atan(mu) * 180) / Math.PI;
      const slipping = deg > slipDeg + 1e-9;
      const pull = Math.sin(th); // per unit weight
      const holdMax = mu * Math.cos(th);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.48);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Incline: hinge at bottom-left of the left panel.
      const bx = 24, by = cssH - 28, L = cssW * 0.5;
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.7;
      ctx.beginPath(); ctx.moveTo(bx, by);
      ctx.lineTo(bx + L * Math.cos(th), by - L * Math.sin(th)); ctx.stroke();
      ctx.globalAlpha = 0.25;
      ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(bx + L, by); ctx.stroke();
      ctx.globalAlpha = 1;

      // Block, drawn mid-slope in the slope's frame; slid down a bit if slipping.
      const s = slipping ? 0.38 : 0.55;
      const cx = bx + L * s * Math.cos(th), cy = by - L * s * Math.sin(th);
      ctx.save();
      ctx.translate(cx, cy); ctx.rotate(-th);
      ctx.fillStyle = slipping ? PULL : HOLD;
      ctx.fillRect(-18, -26, 36, 26);
      ctx.restore();

      // Force bars (per unit weight) on the right: pull vs max hold.
      const gx = cssW * 0.62, gw = cssW * 0.34, baseY = cssH - 40, hMax = cssH - 84;
      const bar = (i: number, val: number, colour: string, label: string) => {
        const w = gw / 2 - 12, x = gx + i * (gw / 2);
        const h = Math.min(val, 1) * hMax;
        ctx.fillStyle = colour; ctx.globalAlpha = 0.85;
        ctx.fillRect(x, baseY - h, w, h);
        ctx.globalAlpha = 0.7; ctx.fillStyle = fg;
        ctx.font = '11px system-ui,sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(label, x + w / 2, baseY + 14);
        ctx.fillText(val.toFixed(2) + '·mg', x + w / 2, baseY - h - 6);
        ctx.globalAlpha = 1;
      };
      bar(0, pull, PULL, 'kéo xuống');
      bar(1, holdMax, HOLD, 'giữ tối đa');

      readout.innerHTML = slipping
        ? `<b>Trượt!</b> Góc đã vượt ngưỡng arctan(μ) = <b>${slipDeg.toFixed(1)}°</b>. ` +
          `Gia tốc trượt: g(sinθ − μ_k·cosθ) — từ đây μ động mới là người quyết định.`
        : `<b>Đứng yên.</b> Ma sát nghỉ đang dùng ${((pull / holdMax) * 100).toFixed(0)}% sức giữ. ` +
          `Ngưỡng trượt: <b>${slipDeg.toFixed(1)}°</b> — không phụ thuộc khối lượng.`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="incline"]').forEach(setup);
</script>
