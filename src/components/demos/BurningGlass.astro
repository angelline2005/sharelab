---
// Burning glass: the lens images the Sun (angular size 9.31 mrad) into a spot
// of diameter f·θ; concentration = (D/(f·θ))², thermodynamically capped at
// ~46 000× (spot can never exceed the Sun's own 5772 K). Static redraw.
---

<figure class="demo" data-demo="burning-glass">
  <canvas></canvas>
  <div class="controls">
    <label>Đường kính kính lúp D (cm) <output data-out="d"></output>
      <input type="range" data-in="d" min="2" max="15" step="0.5" value="5" /></label>
    <label>Tiêu cự f (cm) <output data-out="f"></output>
      <input type="range" data-in="f" min="5" max="30" step="0.5" value="10" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Kính lúp không "gom nắng thành một điểm" — nó tạo ẢNH của Mặt Trời, và
    ảnh có kích thước hẳn hoi: d = f·θ với θ = 0,53° là góc trông Mặt Trời.
    Muốn đốt khét hơn: D to (hứng nhiều) và f ngắn (ảnh nhỏ).
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const TH = 0.00931; // rad
  const SUN = '#f59e0b', SPOT = '#dc2626', LENS = '#2563eb';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const D = Number(input('d').value) / 100, f = Number(input('f').value) / 100;
      output('d').textContent = (D * 100).toFixed(1).replace('.', ',');
      output('f').textContent = (f * 100).toFixed(1).replace('.', ',');
      const img = f * TH;
      const conc = Math.pow(D / img, 2);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.34);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const midY = cssH / 2;
      const lensX = cssW * 0.34;
      const half = 14 + (D / 0.15) * (cssH * 0.34);
      const focusX = Math.min(cssW - 30, lensX + 60 + (f / 0.3) * (cssW * 0.5));

      ctx.strokeStyle = SUN; ctx.globalAlpha = 0.8;
      for (const s of [-1, -0.5, 0, 0.5, 1]) {
        ctx.beginPath(); ctx.moveTo(14, midY + half * s); ctx.lineTo(lensX, midY + half * s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(lensX, midY + half * s); ctx.lineTo(focusX, midY); ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.strokeStyle = LENS; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.ellipse(lensX, midY, 7, half, 0, 0, Math.PI * 2); ctx.stroke();
      ctx.lineWidth = 1;
      const spotR = Math.max(2, (img / 0.0028) * 6);
      ctx.fillStyle = SPOT;
      ctx.beginPath(); ctx.arc(focusX, midY, spotR, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`ảnh Mặt Trời ${(img * 1000).toFixed(2).replace('.', ',')} mm`, focusX, midY + spotR + 16);
      ctx.fillText(`f = ${(f * 100).toFixed(0)} cm`, (lensX + focusX) / 2, midY - 12);
      ctx.globalAlpha = 1;

      readout.innerHTML =
        `Điểm đốt Ø <b>${(img * 1000).toFixed(2).replace('.', ',')} mm</b> · nắng đậm gấp ` +
        `<b>${Math.round(conc).toLocaleString('vi-VN')} lần</b>` +
        (conc > 46200 ? ' — <b>vượt trần vật lý ~46 000×: không thấu kính nào làm nổi</b> (xem bài)' : ' · trần tuyệt đối: ~46 000×');
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="burning-glass"]').forEach(setup);
</script>
