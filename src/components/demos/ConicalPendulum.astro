---
// Con lắc nón (conical pendulum), nghiệm chính xác — không dùng gần đúng góc nhỏ:
//   T·cosθ = mg ; T·sinθ = m·ω²·L·sinθ  ⇒  T = m·ω²·L ; cosθ = g/(ω²L)
//   ⇒ h = L·cosθ = g/ω²   với ω = 2π·rpm/60
// Nguồn: cơ học cổ điển tiêu chuẩn (Kleppner & Kolenkow, ch. 2; lý thuyết bộ
// điều tốc ly tâm Watt). Miền hợp lệ: chỉ tồn tại nghiệm nón khi h ≤ L, tức
// ω ≥ √(g/L); dưới ngưỡng đó vật chỉ đung đưa như con lắc thường. Bỏ qua khối
// lượng dây, sức cản không khí. g = 9,81 m/s².
---

<figure class="demo" data-demo="con-lac-non-chieu-cao-chi-theo-vong-quay">
  <canvas></canvas>
  <div class="controls">
    <label>Tốc độ quay (vòng/phút) <output data-out="rpm"></output>
      <input type="range" data-in="rpm" min="20" max="200" step="1" value="60" /></label>
    <label>Chiều dài dây L (m) <output data-out="l"></output>
      <input type="range" data-in="l" min="0.1" max="1" step="0.01" value="0.4" /></label>
    <label>Khối lượng quả nặng (kg) <output data-out="m"></output>
      <input type="range" data-in="m" min="0.05" max="2" step="0.05" value="0.2" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trái: hình nón vẽ đúng tỉ lệ, đoạn cam là chiều cao h từ điểm treo xuống
    mặt phẳng quay. Phải: h theo số vòng/phút, chấm đỏ là trạng thái hiện tại.
    Kéo dây dài ra hay ngắn lại: nón phình ra, thu vào, nhưng đoạn cam đứng
    yên tuyệt đối. Kéo khối lượng: không một nét nào nhúc nhích — chỉ lực căng
    dây trong dòng số đổi.
    Dưới ngưỡng ω = √(g/L) (đường cam đứng) không tồn tại hình nón nào.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const G = 9.81;
  const CURVE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const omega = (rpm: number) => (2 * Math.PI * rpm) / 60;
  const height = (rpm: number) => G / omega(rpm) ** 2;          // h = g/ω², mét
  const critRpm = (L: number) => (Math.sqrt(G / L) * 60) / (2 * Math.PI);
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const rpm = Number(input('rpm').value);
      const L = Number(input('l').value);
      const m = Number(input('m').value);
      output('rpm').textContent = String(rpm);
      output('l').textContent = vn(L, 2);
      output('m').textContent = vn(m, 2);

      const h = height(rpm);
      const cone = h <= L;
      const theta = cone ? Math.acos(h / L) : 0;
      const r = L * Math.sin(theta);
      const rc = critRpm(L);
      const tension = m * omega(rpm) ** 2 * L;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- Bảng trái: hình nón vẽ đúng tỉ lệ (thang mét cố định) ----------
      const LW = Math.round(cssW * 0.46);
      const topY = 20, botY = cssH - 22;
      const ax = Math.round(LW / 2);
      // Thang px/mét: cố định (không phụ thuộc slider) nhưng phải chứa nổi cả
      // hình nón rộng nhất — bán kính r = L·sinθ tiến tới Lmax khi θ → 90°.
      // Thiếu ràng buộc ngang này thì ở L = 1 m nón tràn ra ngoài canvas và
      // vẽ đè lên biểu đồ bên phải.
      const Lmax = Number(input('l').max) || 1;
      const S = Math.min((botY - topY) / (Lmax * 1.08), (ax - 14) / Lmax);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.5;
      ctx.beginPath(); ctx.moveTo(ax - 22, topY); ctx.lineTo(ax + 22, topY); ctx.stroke();
      ctx.globalAlpha = 1;

      if (cone) {
        // ry: nửa trục đứng của vòng tròn nhìn nghiêng. Nón càng dẹt (rpm cao)
        // thì cy càng sát điểm treo, nên phải kẹp ry lại kẻo vòng tròn bị cắt
        // cụt ở mép trên canvas.
        const cy = topY + h * S, rx = r * S, ry = Math.max(3, Math.min(rx * 0.3, cy - 4));
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.35;
        ctx.beginPath(); ctx.ellipse(ax, cy, rx, ry, 0, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(ax, topY); ctx.lineTo(ax - rx, cy); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(ax, topY); ctx.lineTo(ax + rx, cy); ctx.stroke();
        ctx.lineWidth = 1;
        ctx.fillStyle = MARK;
        ctx.beginPath(); ctx.arc(ax + rx, cy, 6, 0, Math.PI * 2); ctx.fill();

        // đoạn h
        ctx.strokeStyle = LM; ctx.lineWidth = 2; ctx.setLineDash([5, 3]);
        ctx.beginPath(); ctx.moveTo(ax, topY); ctx.lineTo(ax, cy); ctx.stroke();
        ctx.setLineDash([]); ctx.lineWidth = 1;
        ctx.fillStyle = LM; ctx.textAlign = 'left';
        ctx.fillText(`h = ${vn(h * 100, 2)} cm`, ax + 5, Math.max(topY + 14, topY + (cy - topY) / 2));

        ctx.strokeStyle = fg; ctx.globalAlpha = 0.4;
        ctx.beginPath(); ctx.arc(ax, topY, 26, Math.PI / 2 - theta, Math.PI / 2); ctx.stroke();
        ctx.globalAlpha = 0.7; ctx.fillStyle = fg; ctx.textAlign = 'left';
        ctx.fillText(`${vn((theta * 180) / Math.PI, 1)}°`, ax + 12, topY + 34);
        ctx.textAlign = 'center';
        ctx.fillText(`L = ${vn(L, 2)} m`, ax, Math.min(topY + L * S + 16, botY + 14));
        ctx.globalAlpha = 1;
      } else {
        const by = topY + L * S;
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.45; ctx.setLineDash([4, 4]);
        ctx.beginPath(); ctx.arc(ax, topY, L * S, Math.PI / 2 - 0.5, Math.PI / 2 + 0.5); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1;
        ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(ax, topY); ctx.lineTo(ax, by); ctx.stroke();
        ctx.lineWidth = 1;
        ctx.fillStyle = MARK; ctx.beginPath(); ctx.arc(ax, by, 6, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = LM; ctx.textAlign = 'center';
        ctx.fillText('quá chậm: không có nón', ax, topY + 40);
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7;
        ctx.fillText(`L = ${vn(L, 2)} m`, ax, Math.min(by + 16, botY + 14));
        ctx.globalAlpha = 1;
      }

      // ---------- Bảng phải: h theo vòng/phút ----------
      const padL = LW + 44, padR = 8, padT = 14, padB = 26;
      const yMax = 100;                                   // cm
      const X = (n: number) => padL + ((n - 20) / 180) * (cssW - padL - padR);
      const Y = (c: number) => padT + ((yMax - c) / yMax) * (cssH - padT - padB);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      for (const n of [50, 100, 150, 200]) ctx.fillText(`${n}`, X(n), cssH - padB + 14);
      ctx.fillText('vòng/phút', (padL + cssW - padR) / 2, cssH - 3);
      ctx.textAlign = 'right';
      for (const c of [25, 50, 75, 100]) ctx.fillText(`${c} cm`, padL - 4, Y(c) + 3);
      ctx.globalAlpha = 1;

      // ngưỡng h = L và vùng không có nghiệm nón
      const LcmY = Y(Math.min(L * 100, yMax));
      ctx.strokeStyle = LM; ctx.globalAlpha = 0.8; ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(padL, LcmY); ctx.lineTo(cssW - padR, LcmY); ctx.stroke();
      if (rc <= 200) {
        ctx.beginPath(); ctx.moveTo(X(rc), padT); ctx.lineTo(X(rc), cssH - padB); ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.fillStyle = LM; ctx.textAlign = 'left';
      ctx.fillText(`h = L`, padL + 4, LcmY - 4);
      if (rc <= 190) ctx.fillText(`${vn(rc, 1)} v/p`, X(rc) + 4, padT + 10);
      ctx.globalAlpha = 0.12;
      ctx.fillRect(padL, padT, Math.max(0, X(Math.min(rc, 200)) - padL), cssH - padT - padB);
      ctx.globalAlpha = 1;

      // đường cong h(rpm)
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      let started = false;
      for (let i = 0; i <= 240; i++) {
        const n = 20 + (180 * i) / 240;
        const cm = height(n) * 100;
        if (cm > yMax) { started = false; continue; }
        started ? ctx.lineTo(X(n), Y(cm)) : ctx.moveTo(X(n), Y(cm));
        started = true;
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(rpm), Y(Math.min(h * 100, yMax)), 6, 0, Math.PI * 2); ctx.fill();

      readout.innerHTML = cone
        ? `L = ${vn(L, 2)} m · ${rpm} v/p → θ = <b>${vn((theta * 180) / Math.PI, 1)}°</b>, `
          + `h = <b>${vn(h * 100, 2)} cm</b> · lực căng dây ${vn(tension, 2)} N `
          + `(= ${vn(tension / (m * G), 2)} lần trọng lượng) · khối lượng ${vn(m, 2)} kg không đổi được h`
        : `L = ${vn(L, 2)} m · ${rpm} v/p → h = ${vn(h * 100, 1)} cm <b>lớn hơn cả sợi dây</b>: `
          + `không tồn tại hình nón, quả nặng chỉ đung đưa như con lắc thường `
          + `— cần ít nhất <b>${vn(rc, 1)} vòng/phút</b>`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="con-lac-non-chieu-cao-chi-theo-vong-quay"]').forEach(setup);
</script>
