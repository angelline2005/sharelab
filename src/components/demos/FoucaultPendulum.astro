---
// Foucault: Omega = Omega_E · sin(phi), Omega_E = 360°/86164,0905 s = 15,0411 °/h.
// Exact for an ideal Foucault pendulum at any latitude (northern hemisphere:
// clockwise seen from above). Small-angle period T = 2π√(L/g), g = 9,80665.
// Airy ellipse precession (spurious rotation) = (3/8)·(a·b/L²)·√(g/L), valid for
// a, b ≪ L; here a = L/10 (swing ≈ 5,7°) and b = 1 mm of release error.
---

<figure class="demo" data-demo="con-lac-foucault-va-vi-do-cua-ban">
  <canvas></canvas>
  <div class="controls">
    <label>Vĩ độ φ (° Bắc) <output data-out="p"></output>
      <input type="range" data-in="p" min="0" max="90" step="0.1" value="21" /></label>
    <label>Thời gian đã trôi (giờ) <output data-out="t"></output>
      <input type="range" data-in="t" min="0" max="72" step="0.5" value="24" /></label>
    <label>Chiều dài dây (m) <output data-out="l"></output>
      <input type="range" data-in="l" min="5" max="70" step="1" value="20" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Nhìn từ trên xuống. Vạch đứt màu cam là mặt phẳng dao động lúc thả, đường
    xanh là mặt phẳng ở thời điểm hiện tại — quạt giữa hai đường là góc đã quay
    (Bắc bán cầu: theo chiều kim đồng hồ). Đồ thị dưới là định luật sin của
    Foucault: tốc độ quay chỉ phụ thuộc vĩ độ, không phụ thuộc dây dài hay quả
    nặng bao nhiêu. Dây càng ngắn thì sai số elip lúc thả càng giả mạo được nhiều.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', REF = '#f59e0b';
  const OMEGA_E = 360 / (86164.0905 / 3600); // 15,0411 °/h
  const G = 9.80665;
  const D2R = Math.PI / 180;
  const rate = (phi: number) => OMEGA_E * Math.sin(phi * D2R);
  const period = (L: number) => 2 * Math.PI * Math.sqrt(L / G);
  // Spurious Airy precession from a 1 mm elliptical opening, in °/h.
  const airy = (L: number) =>
    0.375 * ((L / 10) * 0.001 / (L * L)) * Math.sqrt(G / L) * 3600 / D2R;
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  const SPOTS: Array<[number, string]> = [
    [10.8, 'TP.HCM'], [21.0, 'Hà Nội'], [48.9, 'Paris'], [90, 'cực'],
  ];

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const phi = Number(input('p').value);
      const t = Number(input('t').value);
      const L = Number(input('l').value);
      output('p').textContent = vn(phi, 1);
      output('t').textContent = vn(t, 1);
      output('l').textContent = String(L);

      const om = rate(phi);
      const turned = om * t;
      const full = om > 0 ? 360 / om : Infinity;
      const Ta = period(L);
      const fake = airy(L);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.78);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---- Panel 1: compass rose seen from above ----
      const hc = cssH * 0.58;
      const cx = cssW / 2, cy = hc / 2;
      const R = Math.min(hc / 2 - 24, cssW * 0.28);

      ctx.strokeStyle = fg; ctx.fillStyle = fg;
      ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
      for (let a = 0; a < 360; a += 10) {
        const s = Math.sin(a * D2R), c = Math.cos(a * D2R);
        const r0 = a % 30 === 0 ? R - 9 : R - 5;
        ctx.beginPath();
        ctx.moveTo(cx + r0 * s, cy - r0 * c);
        ctx.lineTo(cx + R * s, cy - R * c);
        ctx.stroke();
      }
      ctx.globalAlpha = 0.6;
      ctx.textAlign = 'center';
      const labStep = R > 100 ? 30 : 90;
      for (let a = 0; a < 360; a += labStep) {
        const s = Math.sin(a * D2R), c = Math.cos(a * D2R);
        ctx.fillText(`${a}°`, cx + (R - 17) * s, cy - (R - 17) * c + 3);
      }
      ctx.globalAlpha = 0.75;
      ctx.fillText('B', cx, cy - R - 7);
      ctx.fillText('N', cx, cy + R + 14);
      ctx.textAlign = 'left'; ctx.fillText('Đ', cx + R + 5, cy + 3);
      ctx.textAlign = 'right'; ctx.fillText('T', cx - R - 5, cy + 3);
      ctx.globalAlpha = 1;

      // Swept wedge (both halves; only the fractional turn is shaded).
      const frac = ((turned % 360) + 360) % 360;
      ctx.fillStyle = CURVE; ctx.globalAlpha = 0.14;
      for (const off of [0, Math.PI]) {
        ctx.beginPath(); ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, R, -Math.PI / 2 + off, -Math.PI / 2 + off + frac * D2R, false);
        ctx.closePath(); ctx.fill();
      }
      ctx.globalAlpha = 1;

      // Plane at t = 0 (north–south), dashed.
      ctx.strokeStyle = REF; ctx.lineWidth = 1.5; ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(cx, cy - R); ctx.lineTo(cx, cy + R); ctx.stroke();
      ctx.setLineDash([]);

      // Plane now.
      const s = Math.sin(frac * D2R), c = Math.cos(frac * D2R);
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(cx + R * s, cy - R * c);
      ctx.lineTo(cx - R * s, cy + R * c);
      ctx.stroke();
      ctx.fillStyle = CURVE;
      for (const k of [1, -1]) {
        ctx.beginPath(); ctx.arc(cx + k * R * s, cy - k * R * c, 4, 0, Math.PI * 2); ctx.fill();
      }
      ctx.lineWidth = 1;

      const mid = (frac / 2) * D2R;
      ctx.fillStyle = fg; ctx.textAlign = 'center'; ctx.globalAlpha = 0.85;
      ctx.fillText(`${vn(turned, 1)}°`, cx + 0.5 * R * Math.sin(mid), cy - 0.5 * R * Math.cos(mid) + 3);
      ctx.globalAlpha = 1;

      // ---- Panel 2: the sine law, Omega vs latitude ----
      const padL = 42, padR = 12, padT = hc + 14, padB = 24;
      const X = (p: number) => padL + (p / 90) * (cssW - padL - padR);
      const Y = (o: number) => cssH - padB - (o / 16) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB);
      ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      for (const p of [0, 15, 30, 45, 60, 75, 90]) ctx.fillText(`${p}°`, X(p), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const o of [0, 5, 10, 15]) ctx.fillText(o === 15 ? '15 °/h' : String(o), padL - 4, Y(o) + 3);
      ctx.globalAlpha = 1;

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 180; i++) {
        const p = (90 * i) / 180;
        i ? ctx.lineTo(X(p), Y(rate(p))) : ctx.moveTo(X(p), Y(rate(p)));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      SPOTS.forEach(([p, lab], k) => {
        ctx.fillStyle = REF;
        ctx.beginPath(); ctx.arc(X(p), Y(rate(p)), 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7;
        ctx.textAlign = p > 80 ? 'right' : 'center';
        ctx.fillText(lab, X(p), Y(rate(p)) - 8 - (k % 2) * 11);
        ctx.globalAlpha = 1;
      });

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(phi), Y(om), 6, 0, Math.PI * 2); ctx.fill();

      const noise = om > 0 ? (100 * fake) / om : Infinity;
      const flag =
        om < 0.6
          ? ' · <b>vùng xích đạo: hiệu ứng gần như tắt</b>'
          : noise > 30
            ? ' · <b>nhiễu elip lấn át phép đo</b>'
            : '';
      const turns = full === Infinity ? 'không bao giờ' : `${vn(full, 1)} giờ (${vn(full / 24, 1)} ngày)`;
      readout.innerHTML =
        `Vĩ độ <b>${vn(phi, 1)}°</b> → <b>${vn(om, 2)}°/giờ</b> · sau ${vn(t, 1)} giờ đã quay ` +
        `<b>${vn(turned, 1)}°</b> · trọn vòng sau ${turns}` +
        `<br>Dây ${L} m: chu kỳ lắc ${vn(Ta, 2)} s · quỹ đạo hở 1 mm tự quay ` +
        `${vn(fake, 3)}°/giờ = ${om > 0 ? vn(noise, 0) : '∞'}% hiệu ứng thật${flag}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="con-lac-foucault-va-vi-do-cua-ban"]').forEach(setup);
</script>
