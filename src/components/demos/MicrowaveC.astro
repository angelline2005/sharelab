---
// Measure c with a microwave and a chocolate bar: hot spots sit half a
// wavelength apart in the oven's standing wave. Slider = the spacing you
// measured; c_est = 2·d·f with f = 2.45 GHz printed on the oven's label.
// The canvas draws the standing-wave intensity with melt spots. Static.
---

<figure class="demo" data-demo="microwave-c">
  <canvas></canvas>
  <div class="controls">
    <label>Khoảng cách hai vệt chảy đo được (cm) <output data-out="d"></output>
      <input type="range" data-in="d" min="4" max="8.5" step="0.05" value="6.1" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Tắt đĩa xoay, đặt thanh sô-cô-la vào lò vi sóng vài chục giây: nó chảy
    thành các vệt cách đều — đó là các bụng sóng đứng, cách nhau nửa bước
    sóng. Nhân đôi, nhân tần số 2,45 GHz ghi trên nhãn lò: bạn vừa đo tốc
    độ ánh sáng bằng đồ ăn vặt.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const F = 2.45e9, C_TRUE = 2.998e8;
  const WAVE = '#2563eb', MELT = '#dc2626', CHOC = '#f59e0b';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="d"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="d"]') as HTMLOutputElement;

    function draw() {
      const dCm = Number(slider.value);
      out.textContent = dCm.toFixed(2).replace('.', ',');
      const lam = 2 * dCm / 100; // m
      const cEst = lam * F;
      const errPct = ((cEst - C_TRUE) / C_TRUE) * 100;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.36);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // A 30 cm tray; wave drawn with the chosen spacing.
      const trayCm = 30, pad = 24;
      const X = (cm: number) => pad + (cm / trayCm) * (cssW - 2 * pad);
      const midY = cssH * 0.36, amp = cssH * 0.22;

      // Standing-wave intensity |sin(kx)|.
      ctx.strokeStyle = WAVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 400; i++) {
        const cm = (trayCm * i) / 400;
        const y = midY - amp * Math.abs(Math.sin((Math.PI * cm) / dCm));
        i ? ctx.lineTo(X(cm), y) : ctx.moveTo(X(cm), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      // Chocolate bar with melt spots at the antinodes.
      const barY = cssH * 0.58, barH = cssH * 0.2;
      ctx.fillStyle = CHOC; ctx.globalAlpha = 0.5;
      ctx.fillRect(X(1), barY, X(trayCm - 1) - X(1), barH);
      ctx.globalAlpha = 1;
      for (let k = 0; ; k++) {
        const cm = dCm / 2 + k * dCm;
        if (cm > trayCm - 1) break;
        ctx.fillStyle = MELT; ctx.globalAlpha = 0.8;
        ctx.beginPath(); ctx.ellipse(X(cm), barY + barH / 2, 9, barH * 0.42, 0, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
      }
      // Spacing annotation between first two melts.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.6;
      ctx.beginPath(); ctx.moveTo(X(dCm / 2), barY + barH + 10); ctx.lineTo(X(dCm / 2 + dCm), barY + barH + 10); ctx.stroke();
      ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(`${dCm.toFixed(1).replace('.', ',')} cm = λ/2`, X(dCm / 2 + dCm / 2), barY + barH + 24);
      ctx.globalAlpha = 1;

      readout.innerHTML =
        `λ = 2 × ${dCm.toFixed(2).replace('.', ',')} cm = ${(lam * 100).toFixed(1).replace('.', ',')} cm` +
        ` → c ước lượng = λ·f = <b>${(cEst / 1e8).toFixed(2).replace('.', ',')} × 10⁸ m/s</b>` +
        ` · lệch giá trị thật ${Math.abs(errPct).toFixed(1).replace('.', ',')}%`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="microwave-c"]').forEach(setup);
</script>
