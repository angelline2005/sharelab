---
// Kéo chếch lên vs đẩy chúc xuống một vật trên sàn (ma sát khô Coulomb).
// Kéo lên góc θ:  N = W − F·sinθ  →  F_kéo = μW / (cosθ + μ·sinθ)
//   cực tiểu tại θ* = arctan μ, giá trị F_min = μW/√(1+μ²)
//   ở θ* thì N = W/(1+μ²)
// Đẩy chúc xuống góc θ: N = W + F·sinθ  →  F_đẩy = μW / (cosθ − μ·sinθ)
//   phân kỳ (tự khoá) tại θ = arctan(1/μ)
// Tỉ số F_kéo/F_đẩy tại θ* = (1 − μ²)/(1 + μ²) — không phụ thuộc khối lượng.
// Nguồn: Meriam & Kraige, "Engineering Mechanics: Statics", chương ma sát khô;
// đây là bài toán "minimum force to move a block" chuẩn của mọi giáo trình.
// Giả thiết: vật cứng trượt (không lật, không lăn), μ_tĩnh ≈ μ_động, lực đặt
// đúng một điểm và đi qua tâm khối để bỏ qua phương trình mô-men, tĩnh học
// thuần (kéo đều, không gia tốc), g = 9,81 m/s².
// Miền slider: μ 0,02–0,90 · θ 0–75,0° · khối lượng 20–200 kg (μ 0,02 là
// cỡ hệ số cản lăn của bánh xe, đầu kia của dải là cao su trên bê tông khô).
// Ngoài 75° thì với μ nhỏ nhánh "đẩy" vẫn hữu hạn nhưng vô nghĩa thực tế;
// đường cong bị cắt trần ở 1,5·W để đọc được phần có ý nghĩa.
---

<figure class="demo" data-demo="keo-hay-day-va-goc-toi-uu-arctan-mu">
  <canvas></canvas>
  <div class="controls">
    <label>Hệ số ma sát μ <output data-out="mu"></output>
      <input type="range" data-in="mu" min="2" max="90" step="1" value="50" /></label>
    <label>Góc đặt lực θ (°) <output data-out="th"></output>
      <input type="range" data-in="th" min="0" max="750" step="1" value="266" /></label>
    <label>Khối lượng vật (kg) <output data-out="m"></output>
      <input type="range" data-in="m" min="20" max="200" step="5" value="100" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Cùng một góc θ, hai cách đặt lực trái ngược nhau. Kéo chếch lên nhấc bớt
    vật khỏi sàn nên cột phản lực pháp tuyến (màu cam) ngắn lại và ma sát nhẹ
    đi; đẩy chúc xuống ép vật xuống sàn nên cột ấy dài ra. Đồ thị bên phải là
    lực cần thiết quét theo góc: nhánh xanh có cực tiểu đúng tại θ* = arctan μ,
    nhánh đỏ vọt lên vô hạn tại arctan(1/μ) — qua đó thì đẩy kiểu gì cũng vô ích.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const PULL = '#2563eb', PUSH = '#dc2626', NORM = '#f59e0b';
  const RAD = Math.PI / 180, G = 9.81, YCAP = 1.5;

  // Lực (đơn vị: bội của trọng lượng W). Trả về Infinity khi mẫu số ≤ 0.
  const fPull = (mu: number, th: number) =>
    mu / (Math.cos(th * RAD) + mu * Math.sin(th * RAD));
  const fPush = (mu: number, th: number) => {
    const den = Math.cos(th * RAD) - mu * Math.sin(th * RAD);
    return den <= 1e-6 ? Infinity : mu / den;
  };
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');
  const newton = (x: number) => Math.round(x).toLocaleString('vi-VN');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function arrow(x: number, y: number, dx: number, dy: number, col: string) {
      const len = Math.hypot(dx, dy) || 1;
      const ux = dx / len, uy = dy / len;
      ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + dx, y + dy); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x + dx, y + dy);
      ctx.lineTo(x + dx - 8 * ux + 4.5 * uy, y + dy - 8 * uy - 4.5 * ux);
      ctx.lineTo(x + dx - 8 * ux - 4.5 * uy, y + dy - 8 * uy + 4.5 * ux);
      ctx.closePath(); ctx.fill();
      ctx.lineWidth = 1;
    }

    function draw() {
      const mu = Number(input('mu').value) / 100;
      const th = Number(input('th').value) / 10;
      const m = Number(input('m').value);
      output('mu').textContent = vn(mu, 2);
      output('th').textContent = vn(th, 1);
      output('m').textContent = String(m);

      const W = m * G;
      const thStar = Math.atan(mu) / RAD;
      const thLock = Math.atan(1 / mu) / RAD;
      const fk = fPull(mu, th), fd = fPush(mu, th);
      const nPull = Math.cos(th * RAD) / (Math.cos(th * RAD) + mu * Math.sin(th * RAD));
      const nPush = Number.isFinite(fd) ? 1 + fd * Math.sin(th * RAD) : Infinity;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.62);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---------- Bên trái: hai hình chiếu cạnh (kéo trên, đẩy dưới) ----------
      const sceneW = Math.min(Math.round(cssW * 0.42), 260);
      const box = Math.max(20, Math.min(40, Math.round(sceneW * 0.20)));
      const maxArr = Math.min(sceneW * 0.38, 74);
      const LEN = (f: number) =>
        Number.isFinite(f) ? Math.min(maxArr, 9 + 46 * f) : maxArr;

      function scene(top: number, h: number, name: string, f: number, nRel: number,
                     sign: number, col: string) {
        const gy = top + h - 20;
        const cx = sceneW * 0.55;
        // sàn
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.35; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(8, gy); ctx.lineTo(sceneW - 6, gy); ctx.stroke();
        ctx.lineWidth = 1; ctx.globalAlpha = 1;
        // cột phản lực pháp tuyến, dài theo N
        const nh = Math.min(h - 24, LEN(nRel));
        const barX = sign < 0 ? cx - box / 2 - 11 : cx + box / 2 + 4;
        ctx.fillStyle = NORM; ctx.globalAlpha = 0.85;
        ctx.fillRect(barX, gy - nh, 7, nh);
        ctx.globalAlpha = 1;
        // thùng hàng
        ctx.strokeStyle = fg; ctx.globalAlpha = 0.75; ctx.lineWidth = 1.5;
        ctx.strokeRect(cx - box / 2, gy - box, box, box);
        ctx.beginPath(); ctx.moveTo(cx - box / 2, gy - box * 0.66);
        ctx.lineTo(cx + box / 2, gy - box * 0.66); ctx.stroke();
        ctx.lineWidth = 1; ctx.globalAlpha = 1;
        // mũi tên lực: kéo xuất phát từ mặt phải, đẩy kết thúc ở mặt trái
        const L = LEN(f);
        const dx = L * Math.cos(th * RAD), dy = sign * L * Math.sin(th * RAD);
        if (sign < 0) arrow(cx + box / 2, gy - box * 0.5, dx, dy, col);
        else arrow(cx - box / 2 - dx, gy - box * 0.62 - dy, dx, dy, col);
        // nhãn
        ctx.fillStyle = fg; ctx.globalAlpha = 0.6; ctx.textAlign = 'left';
        ctx.fillText(name, 8, top + 11);
        ctx.textAlign = 'right';
        ctx.fillText(Number.isFinite(f) ? `${newton(f * W)} N` : 'không thể', sceneW - 6, top + 11);
        ctx.globalAlpha = 0.5; ctx.textAlign = 'center';
        ctx.fillText(Number.isFinite(nRel) ? `N = ${newton(nRel * W)} N` : 'N → ∞', cx, gy + 13);
        ctx.globalAlpha = 1;
      }
      scene(4, cssH / 2 - 6, 'KÉO chếch lên', fk, nPull, -1, PULL);
      scene(cssH / 2 + 2, cssH / 2 - 6, 'ĐẨY chúc xuống', fd, nPush, 1, PUSH);

      // ---------- Bên phải: lực cần thiết quét theo góc ----------
      const cL = sceneW + 42, cR = cssW - 8, cT = 16, cB = cssH - 34;
      const CX = (t: number) => cL + (t / 75) * (cR - cL);
      const CY = (f: number) => cB - (Math.min(f, YCAP) / YCAP) * (cB - cT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.35;
      ctx.beginPath(); ctx.moveTo(cL, cT); ctx.lineTo(cL, cB); ctx.lineTo(cR, cB); ctx.stroke();
      ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(cL, CY(1)); ctx.lineTo(cR, CY(1)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'right';
      for (const f of [0.5, 1, 1.5]) ctx.fillText(`${newton(f * W)} N`, cL - 5, CY(f) + 3);
      ctx.textAlign = 'center';
      for (const t of [0, 15, 30, 45, 60, 75]) {
        ctx.beginPath(); ctx.moveTo(CX(t), cB); ctx.lineTo(CX(t), cB + 3); ctx.stroke();
        ctx.fillText(`${t}°`, CX(t), cB + 14);
      }
      ctx.fillText('góc đặt lực θ → lực cần thiết', (cL + cR) / 2, cB + 28);
      ctx.textAlign = 'left';
      ctx.fillText('trọng lượng vật', cL + 5, CY(1) - 4);
      ctx.globalAlpha = 1;

      // đường tiệm cận tự khoá
      if (thLock <= 75) {
        ctx.strokeStyle = PUSH; ctx.globalAlpha = 0.5; ctx.setLineDash([3, 3]);
        ctx.beginPath(); ctx.moveTo(CX(thLock), cT); ctx.lineTo(CX(thLock), cB); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 0.8; ctx.fillStyle = PUSH;
        ctx.textAlign = 'right';
        ctx.fillText(`tự khoá ${vn(thLock, 1)}°`, CX(thLock) - 4, cT + 9);
        ctx.globalAlpha = 1;
      }

      for (const [col, fn] of [[PULL, fPull], [PUSH, fPush]] as const) {
        ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.beginPath();
        let started = false;
        for (let i = 0; i <= 300; i++) {
          const t = (75 * i) / 300;
          const v = fn(mu, t);
          if (!Number.isFinite(v) || v > YCAP * 1.02) { started = false; continue; }
          started ? ctx.lineTo(CX(t), CY(v)) : ctx.moveTo(CX(t), CY(v));
          started = true;
        }
        ctx.stroke(); ctx.lineWidth = 1;
      }

      // cực tiểu của nhánh kéo
      const fStar = mu / Math.sqrt(1 + mu * mu);
      ctx.strokeStyle = NORM; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(CX(thStar), CY(fStar), 5.5, 0, Math.PI * 2); ctx.stroke();
      ctx.lineWidth = 1; ctx.fillStyle = NORM; ctx.textAlign = 'center';
      ctx.fillText(`θ* = ${vn(thStar, 1)}°`, CX(thStar), CY(fStar) + 18);

      // vị trí hiện tại
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(CX(th), cT); ctx.lineTo(CX(th), cB); ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.fillStyle = PULL;
      ctx.beginPath(); ctx.arc(CX(th), CY(fk), 5, 0, Math.PI * 2); ctx.fill();
      if (Number.isFinite(fd) && fd <= YCAP) {
        ctx.fillStyle = PUSH;
        ctx.beginPath(); ctx.arc(CX(th), CY(fd), 5, 0, Math.PI * 2); ctx.fill();
      }

      // ---------- Readout ----------
      let msg = `μ = ${vn(mu, 2)} · θ = ${vn(th, 1)}° · vật ${m} kg (${newton(W)} N) · `;
      msg += `kéo cần <b>${newton(fk * W)} N</b> (${vn(fk, 3)}·W)`;
      if (Number.isFinite(fd)) {
        const r = fd / fk;
        msg += ` · đẩy cùng góc cần <b>${newton(fd * W)} N</b> — ` +
          (r > 5 ? `gấp <b>${vn(r, 1)} lần</b>` : `nặng hơn ${vn(100 * (r - 1), 0)}%`);
      } else {
        msg += ` · đẩy: <b>vùng tự khoá (θ ≥ ${vn(thLock, 1)}°)</b> — càng đẩy mạnh vật càng bám sàn, không lực nào làm nó nhúc nhích`;
      }
      msg += ` · góc tối ưu θ* = <b>${vn(thStar, 1)}°</b>, tại đó kéo chỉ cần ${newton(fStar * W)} N`;
      readout.innerHTML = msg;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="keo-hay-day-va-goc-toi-uu-arctan-mu"]').forEach(setup);
</script>
