---
// PV = nRT as a piston you can squeeze and heat. Sliders set V and T for one
// mole; P follows from the law. Molecule speed in the sketch scales with √T
// and the dot density with 1/V, so the picture carries the kinetic story the
// equation abbreviates.
---

<figure class="demo" data-demo="ideal-gas">
  <canvas></canvas>
  <div class="controls">
    <label>Thể tích V <output data-out="v"></output>
      <input type="range" data-in="v" min="5" max="50" step="0.5" value="24.6" /></label>
    <label>Nhiệt độ T <output data-out="t"></output>
      <input type="range" data-in="t" min="100" max="600" step="5" value="300" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Một mol khí trong xy-lanh có pit-tông. Áp suất không được chỉnh trực tiếp —
    nó là hệ quả: P = nRT/V. Ở 300 K và 1 atm, một mol chiếm 24,6 lít, con số
    đáng thuộc của hoá học.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const R = 8.314;
  const GASD = '#2563eb', PISTON = '#dc2626';
  const N_DOTS = 60;

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    // Molecules live in unit coordinates of the current gas volume.
    const dots = Array.from({ length: N_DOTS }, () => ({
      x: Math.random(), y: Math.random(),
      a: Math.random() * Math.PI * 2,
    }));
    let raf = 0, last = 0;

    function draw(dt = 0) {
      const V = Number(input('v').value); // litres
      const T = Number(input('t').value);
      output('v').textContent = `${V.toFixed(1)} L`;
      output('t').textContent = `${T.toFixed(0)} K (${(T - 273.15).toFixed(0)} °C)`;
      const P = (1 * R * T) / (V / 1000); // Pa
      const atm = P / 101325;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.42);
      if (canvas.width !== cssW * dpr) { canvas.width = cssW * dpr; canvas.height = cssH * dpr; canvas.style.height = `${cssH}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Cylinder: fixed height, width ∝ V; piston at the right edge of the gas.
      const cylX = 24, cylY = 24, cylH = cssH - 48;
      const maxW = cssW - 120;
      const gasW = (V / 50) * maxW;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.5;
      ctx.strokeRect(cylX, cylY, maxW + 20, cylH);
      ctx.globalAlpha = 1;
      ctx.fillStyle = GASD; ctx.globalAlpha = 0.08;
      ctx.fillRect(cylX, cylY, gasW, cylH);
      ctx.globalAlpha = 1;
      ctx.fillStyle = PISTON;
      ctx.fillRect(cylX + gasW, cylY - 2, 10, cylH + 4);

      // Molecules: speed ∝ √T (kinetic theory), bouncing in unit box.
      const speed = 0.25 * Math.sqrt(T / 300);
      for (const d of dots) {
        d.x += Math.cos(d.a) * speed * dt;
        d.y += Math.sin(d.a) * speed * dt;
        if (d.x < 0 || d.x > 1) { d.a = Math.PI - d.a; d.x = Math.min(Math.max(d.x, 0), 1); }
        if (d.y < 0 || d.y > 1) { d.a = -d.a; d.y = Math.min(Math.max(d.y, 0), 1); }
        ctx.fillStyle = GASD;
        ctx.beginPath();
        ctx.arc(cylX + d.x * gasW, cylY + d.y * cylH, 2.4, 0, Math.PI * 2);
        ctx.fill();
      }

      readout.innerHTML =
        `P = nRT/V = <b>${atm.toFixed(2)} atm</b> (${(P / 1000).toFixed(0)} kPa) · ` +
        `nén nửa thể tích → áp suất ×2 · nhân đôi T (kelvin!) → áp suất ×2`;
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      draw(dt);
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => draw(0)));
    addEventListener('resize', () => draw(0));
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) { last = 0; raf = requestAnimationFrame(frame); }
        else cancelAnimationFrame(raf);
      }
    });
    io.observe(root);
    draw(0);
  }
  document.querySelectorAll<HTMLElement>('[data-demo="ideal-gas"]').forEach(setup);
</script>
