---
// Steady-state 1-D conduction through a layered wall (ISO 6946 method):
//   R_total = R_si + Σ(L_i/k_i) + R_se ;  U = 1/R_total ;  Q = U·A·ΔT
// Surface films R_si = 0,13 and R_se = 0,04 m²K/W (horizontal flow, ISO 6946).
// Layers: vữa 15 mm (k = 0,93) | gạch đặc 110 mm (k = 0,80) | vữa 15 mm |
//         xốp EPS 0–100 mm (k = 0,035).  Valid only for steady state: no
//         thermal mass, no solar gain on the surface, no air leakage.
---

<figure class="demo" data-demo="tuong-gach-nuot-nua-cai-may-lanh">
  <canvas></canvas>
  <div class="controls">
    <label>Bề dày xốp EPS (mm) <output data-out="t"></output>
      <input type="range" data-in="t" min="0" max="100" step="1" value="0" /></label>
    <label>Chênh nhiệt độ trong–ngoài ΔT (°C) <output data-out="d"></output>
      <input type="range" data-in="d" min="3" max="20" step="0.5" value="10" /></label>
    <label>Diện tích tường (m²) <output data-out="a"></output>
      <input type="range" data-in="a" min="10" max="80" step="1" value="40" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Mặt cắt tường vẽ đúng tỉ lệ bề dày, phía trên là nhiệt độ chạy xuyên qua.
    Mỗi lớp là một đoạn thẳng, dốc tỉ lệ nghịch với khả năng dẫn nhiệt — xốp
    dốc đứng, gạch thoai thoải. Hai bậc nhảy ở hai mép là màng không khí đứng
    yên bám vào bề mặt: chúng dày vài milimét mà gánh một nửa khả năng cách
    nhiệt của bức tường trần.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', FOAM = '#f59e0b';
  const R_SI = 0.13, R_SE = 0.04;
  const K_PLASTER = 0.93, K_BRICK = 0.80, K_EPS = 0.035;
  const T_PLASTER = 15, T_BRICK = 110;           // mm
  const T_IN = 26;                                // °C, nhiệt độ phòng
  const AC_9000 = 9000 * 1055.05585262 / 3600;    // 2 637,6 W lạnh
  const vn = (x: number, d = 1) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const tFoam = Number(input('t').value);      // mm
      const dT = Number(input('d').value);         // K
      const area = Number(input('a').value);       // m²
      output('t').textContent = String(tFoam);
      output('d').textContent = vn(dT);
      output('a').textContent = String(area);

      // Layers, outside → inside: [dày mm, k, nhãn, màu]
      const layers: Array<[number, number, string, string]> = [
        [T_PLASTER, K_PLASTER, 'vữa', ''],
        [T_BRICK, K_BRICK, 'gạch đặc 110', ''],
        [T_PLASTER, K_PLASTER, 'vữa', ''],
      ];
      if (tFoam > 0) layers.push([tFoam, K_EPS, 'xốp', FOAM]);

      let rSolid = 0;
      for (const [L, k] of layers) rSolid += (L / 1000) / k;
      const rTot = R_SI + rSolid + R_SE;
      const U = 1 / rTot;
      const q = U * dT;                 // W/m²
      const Q = q * area;               // W
      const pct = 100 * Q / AC_9000;
      const tOut = T_IN + dT;
      const wallMm = 140 + tFoam;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.58);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padL = 44, padR = 12, padT = 14, padB = 26;
      const wallH = 40, gap = 12;
      const gBot = cssH - padB - wallH - gap;      // đáy khung nhiệt độ
      const wallTop = gBot + gap;
      const XMIN = -22, XMAX = 262;                // mm, chừa hai dải không khí
      const X = (mm: number) => padL + ((mm - XMIN) / (XMAX - XMIN)) * (cssW - padL - padR);
      const yLo = T_IN - 1, yHi = tOut + 1;
      const Y = (T: number) => padT + ((yHi - T) / (yHi - yLo)) * (gBot - padT);

      // Trục
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, gBot); ctx.lineTo(cssW - padR, gBot);
      ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      const step = Math.max(1, Math.round((yHi - yLo) / 5));
      ctx.textAlign = 'right';
      for (let T = Math.ceil(yLo); T <= yHi; T += step) ctx.fillText(`${T} °C`, padL - 4, Y(T) + 3);
      ctx.textAlign = 'center';
      for (const mm of [0, 50, 100, 150, 200, 250]) {
        if (mm > XMAX) continue;
        ctx.fillText(`${mm}`, X(mm), cssH - padB + 14);
      }
      ctx.textAlign = 'left';
      ctx.fillText('mm', X(XMAX) - 24, cssH - padB + 14);
      ctx.globalAlpha = 1;

      // Dải tường vẽ đúng tỉ lệ
      let x0 = 0;
      for (const [L, , label, color] of layers) {
        const xa = X(x0), xb = X(x0 + L);
        ctx.fillStyle = color || fg;
        ctx.globalAlpha = color ? 0.55 : (L === T_BRICK ? 0.4 : 0.2);
        ctx.fillRect(xa, wallTop, xb - xa, wallH);
        ctx.globalAlpha = 0.35; ctx.strokeStyle = fg;
        ctx.strokeRect(xa, wallTop, xb - xa, wallH);
        ctx.globalAlpha = 0.8; ctx.fillStyle = fg; ctx.textAlign = 'center';
        if (xb - xa > 34) ctx.fillText(label, (xa + xb) / 2, wallTop + wallH / 2 + 3);
        ctx.globalAlpha = 1;
        x0 += L;
      }
      ctx.globalAlpha = 0.5; ctx.fillStyle = fg; ctx.textAlign = 'right';
      ctx.fillText('ngoài', X(0) - 4, wallTop + wallH / 2 + 3);
      ctx.textAlign = 'left';
      ctx.fillText('trong', X(wallMm) + 4, wallTop + wallH / 2 + 3);
      ctx.globalAlpha = 1;

      // Mũi tên dòng nhiệt, ngoài → trong
      const yArr = wallTop + wallH + 9;
      ctx.strokeStyle = MARK; ctx.fillStyle = MARK; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(X(0), yArr); ctx.lineTo(X(wallMm) - 5, yArr); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(X(wallMm), yArr); ctx.lineTo(X(wallMm) - 7, yArr - 3.5); ctx.lineTo(X(wallMm) - 7, yArr + 3.5);
      ctx.closePath(); ctx.fill();
      ctx.lineWidth = 1; ctx.textAlign = 'left';
      ctx.fillText(`${vn(q)} W/m²`, X(wallMm) + 4, yArr + 3);

      // Đường nhiệt độ: hai bậc nhảy ở hai màng khí, gãy khúc trong lõi
      const pts: Array<[number, number]> = [[XMIN, tOut], [0, tOut]];
      let T = tOut - q * R_SE;
      pts.push([0, T]);
      let xm = 0;
      for (const [L, k] of layers) {
        xm += L; T -= q * (L / 1000) / k;
        pts.push([xm, T]);
      }
      const tSurf = T;                    // nhiệt độ mặt tường phía trong
      pts.push([xm, tSurf - q * R_SI]);
      pts.push([XMAX, T_IN]);

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      pts.forEach(([mm, tt], i) => (i ? ctx.lineTo(X(mm), Y(tt)) : ctx.moveTo(X(mm), Y(tt))));
      ctx.stroke(); ctx.lineWidth = 1;

      // Đánh dấu nhiệt độ mặt trong
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(wallMm), Y(tSurf), 5, 0, Math.PI * 2); ctx.fill();
      ctx.textAlign = 'right';
      ctx.fillText(`mặt trong ${vn(tSurf)} °C`, X(wallMm) - 8, Y(tSurf) - 7);

      const note = pct >= 30
        ? ' · <b>riêng tường đã ăn hơn 30% công suất máy</b>'
        : (tFoam >= 60 ? ' · lớp xốp đã vào vùng lợi ích giảm dần' : '');
      readout.innerHTML =
        `R_tổng = <b>${vn(rTot, 3)} m²K/W</b> · U = <b>${vn(U, 2)} W/m²K</b> · q = ${vn(q)} W/m²` +
        ` → qua ${area} m², ΔT ${vn(dT)} °C: <b>${Q.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} W</b>` +
        ` = ${vn(pct, 0)}% máy lạnh 9 000 BTU${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="tuong-gach-nuot-nua-cai-may-lanh"]').forEach(setup);
</script>
