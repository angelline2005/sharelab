---
// Darcy's law + seepage (pore) velocity:
//   q = K·i            (Darcy flux, m/s)
//   v = K·i/n_e = q/n  (velocity a water molecule actually travels)
//   t = L / v          (travel time over distance L)
// K ranges after Freeze & Cherry (1979), Groundwater, Table 2.2:
//   clay 10⁻¹¹–10⁻⁸, silt/fine sand 10⁻⁸–10⁻⁵, sand 10⁻⁵–10⁻³, gravel 10⁻³–10⁰ m/s.
// Valid only for laminar pore flow, Reynolds (on grain diameter) below ~1–10.
// Over this slider range Re stays under ~5, so Darcy holds everywhere on it.
// Well distance fixed at L = 3 000 m; year = 365,25 d.
---

<figure class="demo" data-demo="dinh-luat-darcy-nuoc-ngam-di-ba-muoi-centimet-moi-ngay">
  <canvas></canvas>
  <div class="controls">
    <label>Hệ số thấm K (m/s) <output data-out="k"></output>
      <input type="range" data-in="k" min="-9" max="-2" step="0.1" value="-4" /></label>
    <label>Gradient thuỷ lực i <output data-out="i"></output>
      <input type="range" data-in="i" min="0.0005" max="0.05" step="0.0005" value="0.01" /></label>
    <label>Độ rỗng hiệu dụng n <output data-out="n"></output>
      <input type="range" data-in="n" min="0.05" max="0.45" step="0.01" value="0.30" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Mặt cắt một tầng chứa nước: mưa thấm xuống ở mép trái, giếng khoan ở mép
    phải cách 3 km. Các chấm đỏ là vị trí của cùng một giọt nước sau 1, 5, 10
    và 30 năm — không phải hoạt hình, mà là bốn nghiệm của cùng một công thức.
    Thanh dưới là thang hệ số thấm K, trải bảy bậc mười từ sét tới sỏi: kéo nó
    là đổi hẳn thang thời gian của bài toán.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', BAND = '#f59e0b';
  const YR = 365.25 * 86400, DAY = 86400, L = 3000;
  const YEARS = [1, 5, 10, 30];
  const BANDS: Array<[number, number, string]> = [
    [-9, -8, 'sét'], [-8, -5, 'bùn, cát bụi'], [-5, -3, 'cát'], [-3, -2, 'sỏi'],
  ];
  const SUP: Record<string, string> = {
    '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³',
    '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹',
  };
  const sup = (n: number) => String(n).split('').map((c) => SUP[c] || c).join('');
  const fv = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  const bandOf = (lg: number) =>
    (BANDS.find(([a, b]) => lg >= a && lg < b) || BANDS[BANDS.length - 1])[2];

  function kText(lg: number) {
    const e = Math.floor(lg + 1e-9);
    const m = Math.pow(10, lg - e);
    return `${fv(m, 1)}·10${sup(e)}`;
  }

  function speedText(v: number) {
    const d = v * DAY, y = v * YR;
    if (d >= 1) return `<b>${fv(d, 1)} m/ngày</b> = ${fv(y / 1000, 1)} km/năm`;
    if (y >= 10) return `<b>${fv(d, 3)} m/ngày</b> = ${fv(y, 1)} m/năm`;
    if (y >= 1) return `<b>${fv(y, 2)} m/năm</b>`;
    if (y >= 1e-3) return `<b>${fv(y * 1000, 2)} mm/năm</b>`;
    return `<b>${fv(y * 1e6, 0)} µm/năm</b>`;
  }

  function timeText(v: number) {
    const yrs = L / (v * YR);
    if (yrs < 1) return `${fv(yrs * 365.25, 0)} ngày`;
    if (yrs < 1000) return `${fv(yrs, 1)} năm`;
    if (yrs < 1e6) return `${fv(yrs / 1000, 1)} nghìn năm`;
    return `${fv(yrs / 1e6, 1)} triệu năm`;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const lg = Number(input('k').value);
      const K = Math.pow(10, lg);
      const i = Number(input('i').value);
      const n = Number(input('n').value);
      const v = (K * i) / n;
      const band = bandOf(lg);

      output('k').textContent = `${kText(lg)} — ${band}`;
      output('i').textContent = fv(i, 4);
      output('n').textContent = fv(n, 2);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.58);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padL = 46, padR = cssW < 420 ? 26 : 14, padT = 14;
      const aBot = Math.round(cssH * 0.60);
      const X = (x: number) => padL + (x / L) * (cssW - padL - padR);

      // ---- panel A: aquifer cross-section (vertical scale exaggerated ~20×) ----
      const yGround = padT + 12;
      const H = aBot - 12 - yGround;                 // usable height above the distance axis
      const yBase = yGround + H;
      const drop = H * (0.04 + 0.2 * (i / 0.05));    // water-table fall, drawn, not to scale
      const wt = (x: number) => yGround + 0.18 * H + (x / L) * drop;

      ctx.fillStyle = fg; ctx.globalAlpha = 0.08;
      ctx.beginPath();
      ctx.moveTo(X(0), yGround); ctx.lineTo(X(L), yGround);
      ctx.lineTo(X(L), wt(L)); ctx.lineTo(X(0), wt(0)); ctx.closePath(); ctx.fill();

      ctx.fillStyle = CURVE; ctx.globalAlpha = 0.15;
      ctx.beginPath();
      ctx.moveTo(X(0), wt(0)); ctx.lineTo(X(L), wt(L));
      ctx.lineTo(X(L), yBase); ctx.lineTo(X(0), yBase); ctx.closePath(); ctx.fill();
      ctx.globalAlpha = 1;

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.45;
      ctx.beginPath(); ctx.moveTo(X(0), yGround); ctx.lineTo(X(L), yGround); ctx.stroke();
      ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(X(0), yBase); ctx.lineTo(X(L), yBase); ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(X(0), wt(0)); ctx.lineTo(X(L), wt(L)); ctx.stroke();
      ctx.lineWidth = 1;

      ctx.fillStyle = fg; ctx.globalAlpha = 0.6; ctx.textAlign = 'left';
      ctx.fillText('mặt đất', X(0) + 22, yGround - 4);
      ctx.globalAlpha = 0.85; ctx.fillStyle = CURVE;
      ctx.fillText(`mực nước ngầm — hạ ${fv(i * L, 1)} m trên 3 km`, X(0) + 4, wt(0) - 5);
      ctx.globalAlpha = 1;

      // recharge arrow: rain soaking in at the left edge
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.5;
      ctx.beginPath();
      ctx.moveTo(X(0) + 10, padT); ctx.lineTo(X(0) + 10, yGround - 2);
      ctx.moveTo(X(0) + 6, yGround - 8); ctx.lineTo(X(0) + 10, yGround - 2); ctx.lineTo(X(0) + 14, yGround - 8);
      ctx.stroke(); ctx.globalAlpha = 1;

      // well
      const xw = X(L) - 5;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.75;
      ctx.fillRect(xw - 3, yGround - 8, 6, yBase - yGround + 4);
      ctx.textAlign = 'right';
      ctx.fillText('giếng', xw - 6, yGround - 12);
      ctx.globalAlpha = 1;

      // travelling drop markers: same drop, four snapshots in time
      YEARS.forEach((t, k) => {
        const d = Math.min(v * t * YR, L);
        const px = X(d), py = wt(d) + 9;
        ctx.fillStyle = MARK;
        ctx.beginPath(); ctx.arc(px, py, 4.5, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.75;
        ctx.textAlign = d > 0.9 * L ? 'right' : 'center';
        ctx.fillText(`${t} năm`, d > 0.9 * L ? px + 6 : px, py + 12 + k * 10);
        ctx.globalAlpha = 1;
      });

      // distance axis
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, aBot + 12); ctx.lineTo(cssW - padR, aBot + 12); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'center';
      for (const x of [0, 1000, 2000, 3000]) {
        ctx.beginPath(); ctx.moveTo(X(x), aBot + 9); ctx.lineTo(X(x), aBot + 15);
        ctx.strokeStyle = fg; ctx.stroke();
        ctx.fillText(`${x / 1000} km`, X(x), aBot + 27);
      }
      ctx.globalAlpha = 1;

      // ---- panel B: log-K scale ----
      const bBot = cssH - 20, bTop = bBot - 16;
      const XK = (g: number) => padL + ((g + 9) / 7) * (cssW - padL - padR);

      BANDS.forEach(([a, b, name], k) => {
        ctx.fillStyle = k % 2 ? BAND : CURVE; ctx.globalAlpha = 0.22;
        ctx.fillRect(XK(a), bTop, XK(b) - XK(a), bBot - bTop);
        ctx.globalAlpha = 0.8; ctx.fillStyle = fg; ctx.textAlign = 'center';
        ctx.fillText(name, (XK(a) + XK(b)) / 2, bTop - 5);
        ctx.globalAlpha = 1;
      });

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.strokeRect(XK(-9), bTop, XK(-2) - XK(-9), bBot - bTop);
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'center';
      for (let g = -9; g <= -2; g++) ctx.fillText(`10${sup(g)}`, XK(g), bBot + 12);
      ctx.textAlign = 'right'; ctx.fillText('K (m/s)', padL - 4, bBot - 3);
      ctx.globalAlpha = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath();
      ctx.moveTo(XK(lg), bTop - 1);
      ctx.lineTo(XK(lg) - 5, bTop - 9);
      ctx.lineTo(XK(lg) + 5, bTop - 9);
      ctx.closePath(); ctx.fill();
      ctx.fillRect(XK(lg) - 1, bTop, 2, bBot - bTop);

      readout.innerHTML =
        `K = ${kText(lg)} m/s (${band}) · i = ${fv(i, 4)} · n = ${fv(n, 2)} → ` +
        `${speedText(v)} · tới giếng cách 3 km: <b>${timeText(v)}</b>`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dinh-luat-darcy-nuoc-ngam-di-ba-muoi-centimet-moi-ngay"]').forEach(setup);
</script>
