---
// Rayleigh scattering: intensity ∝ 1/λ⁴, normalized here to red 700 nm = 1.
// Slider picks a wavelength; the curve shows why blue loses the straight-line
// race through air and wins the sky. Static redraw.
---

<figure class="demo" data-demo="rayleigh">
  <canvas></canvas>
  <div class="controls">
    <label>Bước sóng λ (nm) <output data-out="l"></output>
      <input type="range" data-in="l" min="400" max="700" step="5" value="450" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Xác suất một tia sáng bị phân tử không khí "đá" khỏi đường thẳng, so với
    đỏ 700 nm. Số mũ 4 làm chênh lệch tưởng nhỏ hoá khổng lồ: xanh lam bị tán
    xạ gần 6 lần mạnh hơn đỏ — bầu trời là chỗ số ánh sáng bị đá văng đó rơi
    xuống mắt bạn.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  // Rough wavelength → CSS colour for the marker and strip.
  function wlColor(nm: number): string {
    let r = 0, g = 0, b = 0;
    if (nm < 440) { r = (440 - nm) / 60; b = 1; }
    else if (nm < 490) { g = (nm - 440) / 50; b = 1; }
    else if (nm < 510) { g = 1; b = (510 - nm) / 20; }
    else if (nm < 580) { r = (nm - 510) / 70; g = 1; }
    else if (nm < 645) { r = 1; g = (645 - nm) / 65; }
    else { r = 1; }
    const q = (x: number) => Math.round(255 * Math.max(0, Math.min(1, x)));
    return `rgb(${q(r)},${q(g)},${q(b)})`;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="l"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="l"]') as HTMLOutputElement;

    function draw() {
      const lam = Number(slider.value);
      out.textContent = String(lam);
      const rel = Math.pow(700 / lam, 4);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.46);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 40, padB = 40, padT = 12, padR = cssW < 420 ? 26 : 10;
      const relMax = Math.pow(700 / 400, 4); // ≈ 9.4
      const X = (nm: number) => padL + ((nm - 400) / 300) * (cssW - padL - padR);
      const Y = (v: number) => cssH - padB - (v / relMax) * (cssH - padB - padT);

      // Spectrum strip along the x-axis.
      for (let x = X(400); x < X(700); x += 2) {
        const nm = 400 + ((x - X(400)) / (X(700) - X(400))) * 300;
        ctx.fillStyle = wlColor(nm);
        ctx.fillRect(x, cssH - padB + 6, 2.2, 10);
      }

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const nm of [400, 500, 600, 700]) ctx.fillText(`${nm}`, X(nm), cssH - padB + 28);
      ctx.textAlign = 'right';
      for (const v of [1, 3, 5, 7, 9]) ctx.fillText(`${v}×`, padL - 4, Y(v) + 3);
      ctx.globalAlpha = 1;

      // 1/λ⁴ curve.
      ctx.strokeStyle = fg; ctx.lineWidth = 2; ctx.globalAlpha = 0.8; ctx.beginPath();
      for (let i = 0; i <= 200; i++) {
        const nm = 400 + (300 * i) / 200;
        const v = Math.pow(700 / nm, 4);
        i ? ctx.lineTo(X(nm), Y(v)) : ctx.moveTo(X(nm), Y(v));
      }
      ctx.stroke(); ctx.globalAlpha = 1; ctx.lineWidth = 1;

      // Marker in the light's own colour.
      ctx.fillStyle = wlColor(lam); ctx.strokeStyle = fg;
      ctx.beginPath(); ctx.arc(X(lam), Y(rel), 6, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

      readout.innerHTML =
        `λ = ${lam} nm bị tán xạ <b>${rel.toFixed(2).replace('.', ',')}×</b> mạnh hơn đỏ 700 nm` +
        ` · lam 450: 5,86× · lục 550: 2,62×`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="rayleigh"]').forEach(setup);
</script>
