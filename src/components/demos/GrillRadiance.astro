---
// Thermal radiation from a glowing charcoal bed to a small skin patch above it.
//   q = eps·sigma·(T^4 − T_skin^4) · F,  F = R²/(R² + h²)
// F is the standard configuration factor from a differential planar element to
// a coaxial parallel disk of radius R at distance h (Howell, catalogue B-6);
// exact for a flat element facing the disk centre. eps = 0,85 (than hồng),
// T_skin = 33 °C, sigma = 5,670374419e-8 W/m²K⁴.
// Burn time from ISO 13571 radiant-heat relation t = 1,33·q^(−1,33) min,
// with q in kW/m² — only valid above ~2,5 kW/m², so it is shown only there.
// Slider ranges: 400–1 000 °C (than tàn → than quạt lửa), R 5–40 cm, h 10–100 cm.
---

<figure class="demo" data-demo="bep-than-quan-nuong-va-buc-xa-nhiet">
  <canvas></canvas>
  <div class="controls">
    <label>Nhiệt độ than (°C) <output data-out="t"></output>
      <input type="range" data-in="t" min="400" max="1000" step="10" value="800" /></label>
    <label>Bán kính bếp R (cm) <output data-out="r"></output>
      <input type="range" data-in="r" min="5" max="40" step="1" value="15" /></label>
    <label>Khoảng cách h (cm) <output data-out="h"></output>
      <input type="range" data-in="h" min="10" max="100" step="1" value="30" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trái: mặt cắt đứng. Đĩa than đỏ bán kính R, mặt da nhỏ treo cách h — chỉ
    phần bầu trời bị đĩa than che (nón cam) mới rót bức xạ vào da, và phần
    ấy chính là hệ số góc nhìn R²/(R²+h²). Phải: thông lượng tới da theo
    khoảng cách, trục dọc chia theo bậc mười. Hai vạch đứt là nắng trưa
    (1 kW/m²) và ngưỡng đau của da khi phơi lâu (1,4 kW/m²).
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', WARM = '#f59e0b';
  const SIG = 5.670374419e-8, EPS = 0.85, TSKIN = 33 + 273.15;
  const SUN = 1.0, PAIN = 1.4;          // kW/m²
  const YLO = 0.3, YHI = 150;           // kW/m², log axis

  // Surface emissive power of the coal bed, kW/m².
  const q0 = (tC: number) => EPS * SIG * (Math.pow(tC + 273.15, 4) - Math.pow(TSKIN, 4)) / 1000;
  // View factor: differential element to coaxial parallel disk.
  const vf = (R: number, h: number) => (R * R) / (R * R + h * h);
  // ISO 13571 time to second-degree burn, seconds (q in kW/m²).
  const tBurn = (q: number) => 1.33 * Math.pow(q, -1.33) * 60;
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const T = Number(input('t').value);
      const R = Number(input('r').value);
      const h = Number(input('h').value);
      output('t').textContent = String(T);
      output('r').textContent = String(R);
      output('h').textContent = String(h);

      const face = q0(T), F = vf(R, h), q = face * F;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.5);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';
      ctx.lineWidth = 1;

      // ---- Left panel: vertical cross-section -----------------------------
      const SW = Math.round(cssW * 0.34);
      const topY = 16, baseY = cssH - 30, cx = SW / 2;
      const sc = Math.min((baseY - topY) / 115, (SW / 2 - 8) / 45);
      const ex = cx, ey = baseY - h * sc;
      const halfR = R * sc;

      // cone of directions blocked by the coal disk
      ctx.fillStyle = WARM; ctx.globalAlpha = 0.18;
      ctx.beginPath();
      ctx.moveTo(ex, ey); ctx.lineTo(cx - halfR, baseY); ctx.lineTo(cx + halfR, baseY);
      ctx.closePath(); ctx.fill();
      ctx.globalAlpha = 1;

      ctx.strokeStyle = WARM;
      ctx.beginPath();
      ctx.moveTo(cx - halfR, baseY); ctx.lineTo(ex, ey); ctx.lineTo(cx + halfR, baseY);
      ctx.stroke();

      // coal bed
      ctx.strokeStyle = MARK; ctx.lineWidth = 5; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(cx - halfR, baseY); ctx.lineTo(cx + halfR, baseY); ctx.stroke();
      ctx.lineWidth = 1; ctx.lineCap = 'butt';

      // skin patch
      ctx.strokeStyle = fg; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(ex - 13, ey); ctx.lineTo(ex + 13, ey); ctx.stroke();
      ctx.lineWidth = 1;

      // distance tick
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.35;
      ctx.beginPath(); ctx.moveTo(cx - halfR - 12, baseY); ctx.lineTo(cx - halfR - 12, ey); ctx.stroke();
      ctx.globalAlpha = 0.75; ctx.fillStyle = fg;
      ctx.textAlign = 'left';
      ctx.fillText(`da · h = ${h} cm`, ex + 16, ey + 3);
      ctx.textAlign = 'center';
      ctx.fillText(`than ${T} °C · R = ${R} cm`, cx, baseY + 16);
      ctx.fillText(`góc nhìn ${vn(F, 3)}`, cx, Math.max(topY + 10, (baseY + ey) / 2));
      ctx.globalAlpha = 1;

      // ---- Right panel: flux vs distance, log y ---------------------------
      const padL = SW + 40, padR = cssW < 420 ? 26 : 8, padT = 14, padB = 30;
      const plotW = cssW - padL - padR, plotH = cssH - padT - padB;
      const lo = Math.log10(YLO), hi = Math.log10(YHI);
      const X = (d: number) => padL + ((d - 10) / 90) * plotW;
      const Yraw = (kw: number) => padT + ((hi - Math.log10(kw)) / (hi - lo)) * plotH;
      const Y = (kw: number) => Math.max(padT - 2, Math.min(padT + plotH + 2, Yraw(kw)));

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath();
      ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + plotH); ctx.lineTo(padL + plotW, padT + plotH);
      ctx.stroke();
      ctx.globalAlpha = 0.6; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      for (const d of [10, 30, 50, 75, 100]) ctx.fillText(`${d}`, X(d), padT + plotH + 14);
      ctx.fillText('khoảng cách h (cm)', padL + plotW / 2, padT + plotH + 26);
      ctx.textAlign = 'right';
      for (const kw of [0.5, 1, 2, 5, 10, 20, 50, 100])
        ctx.fillText(kw < 1 ? vn(kw, 1) : String(kw), padL - 5, Yraw(kw) + 3);
      ctx.globalAlpha = 1;

      // reference levels
      ctx.setLineDash([4, 3]);
      for (const [lvl, col, txt] of [[SUN, WARM, 'nắng trưa 1 kW/m²'], [PAIN, MARK, 'ngưỡng đau 1,4']] as Array<[number, string, string]>) {
        ctx.strokeStyle = col; ctx.globalAlpha = 0.8;
        ctx.beginPath(); ctx.moveTo(padL, Yraw(lvl)); ctx.lineTo(padL + plotW, Yraw(lvl)); ctx.stroke();
        ctx.fillStyle = col; ctx.textAlign = 'right';
        ctx.fillText(txt, padL + plotW - 3, Yraw(lvl) - 4);
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // curve
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 180; i++) {
        const d = 10 + (90 * i) / 180;
        const y = Y(face * vf(R, d));
        i ? ctx.lineTo(X(d), y) : ctx.moveTo(X(d), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(h), Y(q), 5.5, 0, Math.PI * 2); ctx.fill();

      // ---- readout --------------------------------------------------------
      let note = ' · <b>dưới ngưỡng đau</b>';
      if (q >= 2.5) note = ` · <b>đủ gây bỏng độ hai sau ~${vn(tBurn(q), 1)} giây</b>`;
      else if (q >= PAIN) note = ' · <b>trên ngưỡng đau nếu ngồi lâu</b>';
      readout.innerHTML =
        `Mặt than bức xạ <b>${vn(face, 1)} kW/m²</b> · hệ số góc nhìn ${vn(F, 3)} ` +
        `→ da bạn hứng <b>${vn(q, 2)} kW/m²</b>, gấp ${vn(q / SUN, 1)} lần nắng trưa${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="bep-than-quan-nuong-va-buc-xa-nhiet"]').forEach(setup);
</script>
