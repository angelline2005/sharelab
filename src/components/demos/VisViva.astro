---
// Halley's comet on its true orbit (a = 17.83 AU, e = 0.967). Slider moves
// the comet by eccentric anomaly; speed from vis-viva v² = GM(2/r − 1/a).
// The velocity arrow and readout show the 60:1 perihelion/aphelion swing.
---

<figure class="demo" data-demo="vis-viva">
  <canvas></canvas>
  <div class="controls">
    <label>Vị trí trên quỹ đạo (góc lệch tâm E, °) <output data-out="e"></output>
      <input type="range" data-in="e" min="0" max="360" step="1" value="25" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Sao chổi Halley: cận nhật 0,586 AU (trong quỹ đạo Kim Tinh), viễn nhật
    35 AU (ngoài Hải Vương Tinh). Mũi tên vận tốc dài ngắn theo đúng công
    thức vis-viva — cùng một hòn đá, lúc 54 km/s, lúc chưa đầy 1 km/s.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const AU = 1.496e11, GM = 1.327e20;
  const A = 17.83 * AU, E0 = 0.967;
  const ORBIT = '#2563eb', SUN = '#f59e0b', VEL = '#dc2626';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="e"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="e"]') as HTMLOutputElement;

    function draw() {
      const Edeg = Number(slider.value);
      out.textContent = String(Edeg);
      const E = (Edeg * Math.PI) / 180;
      const r = A * (1 - E0 * Math.cos(E));
      const v = Math.sqrt(GM * (2 / r - 1 / A));

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.4);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      // Ellipse in canvas coords: centre offset so the Sun-focus sits left.
      const sa = cssW * 0.44, sb = sa * Math.sqrt(1 - E0 * E0);
      const cx = cssW / 2 + 10, cy = cssH / 2;
      const fx = cx - sa * E0; // focus (Sun)
      const P = (Ee: number): [number, number] => [cx - sa * Math.cos(Ee), cy - sb * Math.sin(Ee)];

      ctx.strokeStyle = ORBIT; ctx.globalAlpha = 0.7;
      ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const [x, y] = P((2 * Math.PI * i) / 240);
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.closePath(); ctx.stroke(); ctx.globalAlpha = 1;

      // Sun at the focus.
      ctx.fillStyle = SUN;
      ctx.beginPath(); ctx.arc(fx, cy, 8, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = fg; ctx.globalAlpha = 0.6; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center'; ctx.fillText('Mặt Trời', fx, cy + 22);
      ctx.fillText('cận nhật', cx - sa, cy - 12);
      ctx.fillText('viễn nhật', cx + sa - 8, cy - 12);
      ctx.globalAlpha = 1;

      // Comet and velocity arrow (tangent direction, length ∝ log v for visibility).
      const [px, py] = P(E);
      const [tx1, ty1] = P(E + 0.03);
      const dx = tx1 - px, dy = ty1 - py;
      const norm = Math.hypot(dx, dy) || 1;
      const len = 14 + 46 * (Math.log10(v / 900) / Math.log10(54600 / 900));
      ctx.strokeStyle = VEL; ctx.lineWidth = 2.5; ctx.fillStyle = VEL;
      ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(px + (dx / norm) * len, py + (dy / norm) * len); ctx.stroke();
      const hx = px + (dx / norm) * (len + 7), hy = py + (dy / norm) * (len + 7);
      ctx.beginPath(); ctx.moveTo(hx, hy);
      ctx.lineTo(hx - (dx / norm) * 8 - (dy / norm) * 4, hy - (dy / norm) * 8 + (dx / norm) * 4);
      ctx.lineTo(hx - (dx / norm) * 8 + (dy / norm) * 4, hy - (dy / norm) * 8 - (dx / norm) * 4);
      ctx.fill(); ctx.lineWidth = 1;
      ctx.fillStyle = fg;
      ctx.beginPath(); ctx.arc(px, py, 4, 0, Math.PI * 2); ctx.fill();

      readout.innerHTML =
        `r = <b>${(r / AU).toFixed(2).replace('.', ',')} AU</b> · v = √(GM(2/r − 1/a)) = ` +
        `<b>${(v / 1000).toFixed(v < 3000 ? 2 : 1).replace('.', ',')} km/s</b>` +
        ` · cận nhật 54,6 — viễn nhật 0,91 km/s: gấp 60 lần`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="vis-viva"]').forEach(setup);
</script>
