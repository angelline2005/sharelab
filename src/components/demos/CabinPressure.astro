---
// Barometric formula P = 101.325·exp(−h/8435) kPa. Slider = altitude with
// landmarks (Sa Pa, Fansipan, airliner cabin, Everest, cruise altitude);
// readout adds the snack-bag expansion ratio vs sea level.
---

<figure class="demo" data-demo="cabin-pressure">
  <canvas></canvas>
  <div class="controls">
    <label>Độ cao (m) <output data-out="h"></output>
      <input type="range" data-in="h" min="0" max="11000" step="100" value="2400" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Khí quyển mỏng dần theo hàm mũ: cứ lên ~5,8 km là áp suất giảm nửa.
    Máy bay bay ở 11 km (27% áp suất mặt biển) nhưng bơm cabin lên tương
    đương ~2 400 m — vì thế tai bạn ù đúng hai lần và túi snack phồng căng.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const H = 8435, P0 = 101.325;
  const CURVE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const MARKS: Array<[number, string]> = [
    [1500, 'Sa Pa'], [2400, 'cabin máy bay'], [3143, 'Fansipan'], [8848, 'Everest'], [11000, 'độ cao bay'],
  ];
  const P = (h: number) => P0 * Math.exp(-h / H);

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="h"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="h"]') as HTMLOutputElement;

    function draw() {
      const h = Number(slider.value);
      out.textContent = h.toLocaleString('vi-VN');
      const p = P(h);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.44);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 46, padB = 26, padT = 12, padR = 10;
      const X = (hh: number) => padL + (hh / 11000) * (cssW - padL - padR);
      const Y = (pp: number) => cssH - padB - (pp / 105) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const km of [2000, 5000, 8000, 11000]) ctx.fillText(`${km / 1000} km`, X(km), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const pp of [25, 50, 75, 100]) ctx.fillText(`${pp} kPa`, padL - 4, Y(pp) + 3);
      ctx.globalAlpha = 1;

      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 220; i++) {
        const hh = (11000 * i) / 220;
        i ? ctx.lineTo(X(hh), Y(P(hh))) : ctx.moveTo(X(hh), Y(P(hh)));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      MARKS.forEach(([hh, lab], k) => {
        ctx.fillStyle = LM;
        ctx.beginPath(); ctx.arc(X(hh), Y(P(hh)), 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'center';
        ctx.fillText(lab, X(hh), Y(P(hh)) - 8 - (k % 2) * 11);
        ctx.globalAlpha = 1;
      });

      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(h), Y(p), 6, 0, Math.PI * 2); ctx.fill();

      readout.innerHTML =
        `P(${h.toLocaleString('vi-VN')} m) = <b>${p.toFixed(1).replace('.', ',')} kPa</b> — còn ${(100 * p / P0).toFixed(0)}% mặt biển` +
        ` · túi snack đóng ở đồng bằng phồng <b>${(P0 / p).toFixed(2).replace('.', ',')}×</b> thể tích`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="cabin-pressure"]').forEach(setup);
</script>
