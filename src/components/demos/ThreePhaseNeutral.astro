---
// Dòng dây trung tính của hệ ba pha 4 dây, tải một pha:
//   I_N = √(I_A² + I_B² + I_C² − I_A·I_B − I_B·I_C − I_C·I_A)
//       = √(½[(I_A−I_B)² + (I_B−I_C)² + (I_C−I_A)²])
// Nguồn: tổng ba vector lệch nhau 120° (định lý cosin); kiểm chứng bằng
// RMS của tổng tức thời — khớp tới 5 chữ số.
// Điều kiện áp dụng: dòng hình sin thuần, ba pha lệch đúng 120°, và cả ba
// tải cùng một góc lệch pha cosφ. Lệch cosφ giữa các pha, hoặc dòng méo có
// hài bậc ba (đèn LED, sạc, máy tính), đều làm I_N LỚN HƠN giá trị này.
// Thang trượt 0–16 A, bước 0,5 A.
---

<figure class="demo" data-demo="dien-ba-pha-va-day-trung-tinh-khong-tai">
  <canvas></canvas>
  <div class="controls">
    <label>Dòng pha A (A) <output data-out="a"></output>
      <input type="range" data-in="a" min="0" max="16" step="0.5" value="10" /></label>
    <label>Dòng pha B (A) <output data-out="b"></output>
      <input type="range" data-in="b" min="0" max="16" step="0.5" value="10" /></label>
    <label>Dòng pha C (A) <output data-out="c"></output>
      <input type="range" data-in="c" min="0" max="16" step="0.5" value="10" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Trên: ba dòng pha lệch nhau 120° trong hai chu kỳ, và đường đậm màu đỏ là
    tổng tức thời của chúng — chính là dòng chảy trong dây trung tính. Cân
    bằng thì đường đỏ nằm bẹp trên trục 0. Dưới: ba vector nối đuôi nhau; khi
    ba dòng bằng nhau chúng khép thành tam giác đều và điểm cuối về đúng gốc.
    Vector đỏ hở ra giữa gốc và điểm cuối là dòng trung tính.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const PHA = '#2563eb', NEU = '#dc2626', PHB = '#f59e0b';
  const IMAX = 16, TAU = Math.PI * 2;
  const vn = (x: number, d: number) => x.toFixed(d).replace('.', ',');
  const neutral = (a: number, b: number, c: number) =>
    Math.sqrt(Math.max(0, a * a + b * b + c * c - a * b - b * c - c * a));

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function arrow(x0: number, y0: number, x1: number, y1: number, col: string, w: number) {
      const ang = Math.atan2(y1 - y0, x1 - x0), h = 7 + w;
      ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = w;
      ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x1 - h * Math.cos(ang - 0.4), y1 - h * Math.sin(ang - 0.4));
      ctx.lineTo(x1 - h * Math.cos(ang + 0.4), y1 - h * Math.sin(ang + 0.4));
      ctx.closePath(); ctx.fill(); ctx.lineWidth = 1;
    }

    function draw() {
      const a = Number(input('a').value), b = Number(input('b').value), c = Number(input('c').value);
      output('a').textContent = vn(a, 1);
      output('b').textContent = vn(b, 1);
      output('c').textContent = vn(c, 1);
      const iN = neutral(a, b, c);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.78);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      // ---- Panel trên: ba hình sin + tổng tức thời ----
      const padL = 40, padR = 10, padT = 14;
      const topH = Math.round(cssH * 0.5), axB = topH;
      const yPk = 24; // A, đủ chứa đỉnh √2·16 = 22,6 A
      const X = (deg: number) => padL + (deg / 720) * (cssW - padL - padR);
      const Y = (i: number) => padT + ((yPk - i) / (2 * yPk)) * (axB - padT);
      const wave = (amp: number, phi: number) => (deg: number) =>
        Math.SQRT2 * amp * Math.sin((deg * Math.PI) / 180 + phi);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, axB); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(padL, Y(0)); ctx.lineTo(cssW - padR, Y(0)); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'center';
      for (const d of [180, 360, 540, 720]) ctx.fillText(`${d}°`, X(d), Y(0) + 13);
      ctx.textAlign = 'right';
      for (const i of [-20, -10, 10, 20]) ctx.fillText(`${i} A`, padL - 4, Y(i) + 3);
      ctx.globalAlpha = 1;

      const series: Array<[number, number, string, string]> = [
        [a, 0, PHA, 'A'], [b, -TAU / 3, PHB, 'B'], [c, TAU / 3, fg, 'C'],
      ];
      for (const [amp, phi, col, lab] of series) {
        const f = wave(amp, phi);
        ctx.strokeStyle = col; ctx.lineWidth = 1.5;
        ctx.globalAlpha = col === fg ? 0.75 : 1;
        ctx.beginPath();
        for (let k = 0; k <= 360; k++) {
          const d = k * 2, y = Y(f(d));
          k ? ctx.lineTo(X(d), y) : ctx.moveTo(X(d), y);
        }
        ctx.stroke(); ctx.globalAlpha = 1;
        ctx.fillStyle = col; ctx.textAlign = 'left';
        ctx.fillText(lab, X(90 - (phi * 180) / Math.PI) + 3, Y(f(90 - (phi * 180) / Math.PI)) - 4);
      }

      // Tổng tức thời = dòng trung tính.
      const fa = wave(a, 0), fb = wave(b, -TAU / 3), fc = wave(c, TAU / 3);
      ctx.strokeStyle = NEU; ctx.lineWidth = 2.5; ctx.beginPath();
      for (let k = 0; k <= 720; k++) {
        const d = k, y = Y(fa(d) + fb(d) + fc(d));
        k ? ctx.lineTo(X(d), y) : ctx.moveTo(X(d), y);
      }
      ctx.stroke(); ctx.lineWidth = 1;
      ctx.fillStyle = NEU; ctx.textAlign = 'left';
      ctx.fillText('tổng = dòng trung tính', padL + 6, padT + 9);

      // ---- Panel dưới: ba vector nối đuôi ----
      const cy = topH + (cssH - topH) / 2 + 6;
      const cx = cssW / 2;
      const s = Math.min((cssW / 2 - 30) / 17, (cssH - topH - 34) / 2 / 15);
      const P = (x: number, y: number): [number, number] => [cx + x * s, cy - y * s];

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.22;
      for (const r of [5, 10, 15]) {
        ctx.beginPath(); ctx.arc(cx, cy, r * s, 0, TAU); ctx.stroke();
      }
      ctx.beginPath(); ctx.moveTo(cx - 16 * s, cy); ctx.lineTo(cx + 16 * s, cy); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.textAlign = 'left';
      for (const r of [5, 10, 15]) ctx.fillText(`${r} A`, cx + r * s + 2, cy - 3);
      ctx.globalAlpha = 1;

      const ang = [0, -TAU / 3, TAU / 3], mag = [a, b, c];
      const cols = [PHA, PHB, fg], labs = ['A', 'B', 'C'];
      let px = 0, py = 0;
      for (let k = 0; k < 3; k++) {
        const nx = px + mag[k] * Math.cos(ang[k]), ny = py + mag[k] * Math.sin(ang[k]);
        if (mag[k] > 0.01) {
          const p0 = P(px, py), p1 = P(nx, ny);
          ctx.globalAlpha = cols[k] === fg ? 0.75 : 1;
          arrow(p0[0], p0[1], p1[0], p1[1], cols[k], 1.6);
          ctx.globalAlpha = 1;
          ctx.fillStyle = cols[k]; ctx.textAlign = 'center';
          ctx.fillText(labs[k], (p0[0] + p1[0]) / 2 + 9, (p0[1] + p1[1]) / 2 - 5);
        }
        px = nx; py = ny;
      }

      const o = P(0, 0), e = P(px, py);
      if (iN > 0.05) {
        arrow(o[0], o[1], e[0], e[1], NEU, 2.4);
        ctx.fillStyle = NEU; ctx.textAlign = 'center';
        ctx.fillText(`I_N = ${vn(iN, 2)} A`, (o[0] + e[0]) / 2, (o[1] + e[1]) / 2 + 16);
      } else {
        ctx.fillStyle = NEU;
        ctx.beginPath(); ctx.arc(o[0], o[1], 5, 0, TAU); ctx.fill();
        ctx.textAlign = 'center';
        ctx.fillText('khép kín — I_N = 0', o[0], o[1] + 18);
      }

      const big = Math.max(a, b, c);
      let note = '';
      if (iN < 0.005) note = ' · <b>ba pha cân bằng, dây trung tính không tải</b>';
      else if (iN >= big - 0.005 && big > 0) note = ' · <b>trung tính gánh bằng hoặc hơn dây pha nặng nhất</b>';
      readout.innerHTML =
        `I_A = ${vn(a, 1)} A · I_B = ${vn(b, 1)} A · I_C = ${vn(c, 1)} A ` +
        `→ I<sub>trung tính</sub> = <b>${vn(iN, 2)} A</b>${note}`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dien-ba-pha-va-day-trung-tinh-khong-tai"]').forEach(setup);
</script>
