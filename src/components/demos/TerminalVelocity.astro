---
// Free fall with quadratic drag: v(t) = v_t·tanh(g·t/v_t), closed form, so the
// whole demo is a static redraw on input — no animation loop to depend on.
// v_t = √(2mg/(ρ·C_d·A)); the sliders move mass and drag area, the curve shows
// how fast the fall stops accelerating.
---

<figure class="demo" data-demo="terminal-v">
  <canvas></canvas>
  <div class="controls">
    <label>Khối lượng <output data-out="m"></output>
      <input type="range" data-in="m" min="40" max="120" step="1" value="80" /></label>
    <label>Diện tích cản C·A <output data-out="ca"></output>
      <input type="range" data-in="ca" min="0.1" max="25" step="0.1" value="0.42" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Đường liền: vận tốc rơi thật với lực cản tỉ lệ bình phương vận tốc. Đường
    nét đứt: rơi tự do lý tưởng v = gt của sách. C·A = 0,42 m² là người nhảy dù
    nằm sấp; kéo lên ~25 m² là dù đã mở.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const G = 9.81, RHO = 1.225;
  const REAL = '#dc2626', IDEAL = '#2563eb';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (n: string) => root.querySelector(`[data-in="${n}"]`) as HTMLInputElement;
    const output = (n: string) => root.querySelector(`[data-out="${n}"]`) as HTMLOutputElement;

    function draw() {
      const m = Number(input('m').value);
      const ca = Number(input('ca').value);
      output('m').textContent = `${m} kg`;
      output('ca').textContent = `${ca.toFixed(2)} m²`;
      const vt = Math.sqrt((2 * m * G) / (RHO * ca));
      const t99 = Math.atanh(0.99) * vt / G; // time to reach 99% of v_t

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.52);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const pad = 34, T = Math.max(t99 * 1.15, 6);
      const vMax = Math.max(vt * 1.15, G * T * 0.35);
      const X = (t: number) => pad + (t / T) * (cssW - pad - 10);
      const y = (v: number) => cssH - pad - (v / vMax) * (cssH - pad - 12);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(pad, 10); ctx.lineTo(pad, cssH - pad); ctx.lineTo(cssW - 8, cssH - pad); ctx.stroke();
      // v_t asymptote
      ctx.setLineDash([3, 4]);
      ctx.beginPath(); ctx.moveTo(pad, y(vt)); ctx.lineTo(cssW - 8, y(vt)); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 0.6;
      ctx.fillStyle = fg; ctx.font = '11px system-ui,sans-serif';
      ctx.fillText(`v_t = ${vt.toFixed(1)} m/s`, pad + 6, y(vt) - 5);
      ctx.fillText('t (s)', cssW - 34, cssH - pad + 14);
      ctx.globalAlpha = 1;

      // Ideal v = g·t (dashed blue).
      ctx.strokeStyle = IDEAL; ctx.setLineDash([6, 5]); ctx.beginPath();
      for (let i = 0; i <= 100; i++) { const t = (T * i) / 100, v = Math.min(G * t, vMax);
        i ? ctx.lineTo(X(t), y(v)) : ctx.moveTo(X(t), y(v)); }
      ctx.stroke(); ctx.setLineDash([]);

      // Real v(t) = v_t tanh(gt/v_t).
      ctx.strokeStyle = REAL; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 200; i++) { const t = (T * i) / 200, v = vt * Math.tanh((G * t) / vt);
        i ? ctx.lineTo(X(t), y(v)) : ctx.moveTo(X(t), y(v)); }
      ctx.stroke(); ctx.lineWidth = 1;

      readout.innerHTML =
        `Vận tốc tới hạn <b>${vt.toFixed(1)} m/s</b> (${(vt * 3.6).toFixed(0)} km/h) · ` +
        `đạt 99% sau <b>${t99.toFixed(1)} s</b> rơi`;
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="terminal-v"]').forEach(setup);
</script>
