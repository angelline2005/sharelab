---
// Thin-film interference on a soap film (n = 1.33). For each visible
// wavelength the reflected intensity follows the two-beam formula with the
// π phase flip at the first surface: bright when 2nt = (m+½)λ. The thickness
// slider sweeps the film; the strip shows the reflected colour mix and the
// readout names which wavelength is being killed.
---

<figure class="demo" data-demo="thin-film">
  <canvas></canvas>
  <div class="controls">
    <label>Bề dày màng xà phòng <output data-out="t"></output>
      <input type="range" data-in="t" min="50" max="800" step="2" value="200" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Màu phản xạ của màng xà phòng theo bề dày, tính từ giao thoa hai tia phản
    xạ ở mặt trước và mặt sau màng. Trên bong bóng thật, trọng lực làm màng
    mỏng dần từ dưới lên — các "đới màu" bạn thấy chính là thang đo bề dày này.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; border-radius: 6px; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const N = 1.33;

  // Reflected relative intensity for wavelength λ at thickness t (normal
  // incidence): the first reflection flips phase by π, so
  // I ∝ sin²(2πnt/λ).
  const refl = (tNm: number, lamNm: number) =>
    Math.sin((2 * Math.PI * N * tNm) / lamNm) ** 2;

  // λ (nm) → linear-ish RGB.
  function lamRGB(nm: number): [number, number, number] {
    let r = 0, g = 0, b = 0;
    if (nm < 440) { r = (440 - nm) / 60; b = 1; }
    else if (nm < 490) { g = (nm - 440) / 50; b = 1; }
    else if (nm < 510) { g = 1; b = (510 - nm) / 20; }
    else if (nm < 580) { r = (nm - 510) / 70; g = 1; }
    else if (nm < 645) { r = 1; g = (645 - nm) / 65; }
    else { r = 1; }
    return [r, g, b];
  }

  function filmColour(tNm: number): [number, number, number] {
    let R = 0, G = 0, B = 0, W = 0;
    for (let lam = 400; lam <= 700; lam += 5) {
      const I = refl(tNm, lam);
      const [r, g, b] = lamRGB(lam);
      R += r * I; G += g * I; B += b * I; W += 1;
    }
    // Normalise against a flat white reflector for consistent brightness.
    return [(R / W) * 2.2, (G / W) * 2.2, (B / W) * 2.2];
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="t"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="t"]') as HTMLOutputElement;

    function draw() {
      const t = Number(slider.value);
      out.textContent = `${t} nm`;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.42);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = '#111';
      ctx.fillRect(0, 0, cssW, cssH);

      // Top band: colour vs thickness with the marker; bottom: spectrum bars.
      const bandY = 12, bandH = cssH * 0.34;
      for (let px = 0; px < cssW; px++) {
        const tt = 50 + (px / cssW) * 750;
        const [r, g, b] = filmColour(tt);
        ctx.fillStyle = `rgb(${Math.min(r * 255, 255)},${Math.min(g * 255, 255)},${Math.min(b * 255, 255)})`;
        ctx.fillRect(px, bandY, 1, bandH);
      }
      const mx = ((t - 50) / 750) * cssW;
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
      ctx.strokeRect(mx - 2, bandY - 3, 4, bandH + 6);
      ctx.lineWidth = 1;
      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      ctx.font = '10px system-ui,sans-serif'; ctx.textAlign = 'left';
      ctx.fillText('50 nm', 4, bandY + bandH + 14);
      ctx.textAlign = 'right'; ctx.fillText('800 nm', cssW - 4, bandY + bandH + 14);

      // Per-wavelength reflectance at the current thickness.
      const gy = cssH * 0.62, gh = cssH - gy - 8;
      for (let lam = 400; lam <= 700; lam += 3) {
        const I = refl(t, lam);
        const [r, g, b] = lamRGB(lam);
        const x = ((lam - 400) / 300) * cssW;
        ctx.fillStyle = `rgba(${r * 255},${g * 255},${b * 255},0.95)`;
        ctx.fillRect(x, gy + gh - I * gh, Math.max(cssW / 100, 3), I * gh);
      }
      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      ctx.textAlign = 'left'; ctx.fillText('phổ phản xạ tại bề dày này', 4, gy - 4);

      // Find the strongest suppressed visible wavelength: 2nt = mλ.
      let killed = 0;
      for (let m = 1; m <= 5; m++) {
        const lam = (2 * N * t) / m;
        if (lam >= 400 && lam <= 700) { killed = lam; break; }
      }
      readout.innerHTML = t < 80
        ? `Màng sắp vỡ: mỏng hơn mọi bước sóng nhìn thấy, mọi màu đều bị triệt gần hết — màng hoá <b>đen</b> ngay trước khi nổ.`
        : killed
          ? `2nt = ${(2 * N * t).toFixed(0)} nm → triệt tiêu λ = <b>${killed.toFixed(0)} nm</b>; màu bạn thấy là ánh sáng trắng <b>trừ đi</b> màu đó`
          : `Không bước sóng nhìn thấy nào bị triệt hẳn — màu nhạt, pha trộn nhiều thành phần`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="thin-film"]').forEach(setup);
</script>
