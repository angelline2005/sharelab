---
// Schwarzschild radius r_s = 2GM/c², on a log–log chart from a human to the
// largest known black holes. The slider walks log10(M); the readout gives r_s
// in a sensible unit plus the mean density inside r_s (∝ 1/M² — the surprise).
---

<figure class="demo" data-demo="schwarzschild">
  <canvas></canvas>
  <div class="controls">
    <label>Khối lượng M = 10^x kg, chọn x <output data-out="x"></output>
      <input type="range" data-in="x" min="1" max="42" step="0.1" value="30.3" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Nén một vật gọn hơn bán kính Schwarzschild của nó là không gì — kể cả ánh
    sáng — thoát ra nữa. Đường thẳng trên giấy log–log vì r_s tỉ lệ thuận M;
    điều không thẳng chút nào là mật độ trung bình cần đạt, rơi theo 1/M².
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const G = 6.674e-11, C2 = 8.988e16;
  const LINE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const LANDMARKS: Array<[number, string]> = [
    [Math.log10(70), 'bạn (70 kg)'],
    [Math.log10(5.97e24), 'Trái Đất'],
    [Math.log10(1.989e30), 'Mặt Trời'],
    [Math.log10(8.26e36), 'Sgr A*'],
    [Math.log10(1.31e41), 'TON 618'],
  ];

  function fmtLen(m: number): string {
    const f = (v: number, u: string) => `${v >= 100 ? v.toFixed(0) : v.toPrecision(3)} ${u}`.replace('.', ',');
    if (m < 1e-12) return `${m.toExponential(1).replace('.', ',')} m`;
    if (m < 1e-6) return f(m * 1e9, 'nm');
    if (m < 1e-2) return f(m * 1e3, 'mm');
    if (m < 1e3) return f(m, 'm');
    if (m < 1e9) return f(m / 1e3, 'km');
    if (m < 9.46e14) return f(m / 1e9, 'triệu km');
    return f(m / 9.461e15, 'năm ánh sáng');
  }
  function fmtRho(r: number): string {
    if (r > 1e17) return 'đặc hơn hạt nhân nguyên tử';
    if (r > 1000) return `${r.toExponential(1).replace('.', ',')} kg/m³ — đặc hơn nước`;
    if (r > 1.2) return `${r.toFixed(0)} kg/m³ — loãng hơn nước, đặc hơn không khí`;
    return `${r.toExponential(1).replace('.', ',')} kg/m³ — loãng hơn cả không khí!`;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const slider = root.querySelector('[data-in="x"]') as HTMLInputElement;
    const out = root.querySelector('[data-out="x"]') as HTMLOutputElement;

    function draw() {
      const x = Number(slider.value);
      out.textContent = x.toFixed(1).replace('.', ',');
      const M = Math.pow(10, x);
      const rs = (2 * G * M) / C2;
      const rho = M / ((4 / 3) * Math.PI * rs * rs * rs);

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.44);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;

      const padL = 46, padB = 26, padT = 14, padR = cssW < 420 ? 26 : 12;
      // log10(r_s) spans about [-26, 15] over M in [10^1, 10^42].
      const lr = (mx: number) => Math.log10((2 * G) / C2) + mx;
      const X = (mx: number) => padL + ((mx - 1) / 41) * (cssW - padL - padR);
      const Y = (lrs: number) => cssH - padB - ((lrs + 26.5) / 42.5) * (cssH - padB - padT);

      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, cssH - padB); ctx.lineTo(cssW - padR, cssH - padB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg; ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'center';
      for (const mx of [10, 20, 30, 40]) ctx.fillText(`10^${mx}`, X(mx), cssH - padB + 14);
      ctx.textAlign = 'right';
      for (const [lv, lab] of [[-3, '1 mm'], [3, '1 km'], [9, 'triệu km']] as Array<[number, string]>)
        ctx.fillText(lab, padL - 4, Y(lv) + 3);
      ctx.globalAlpha = 1;

      // The r_s line.
      ctx.strokeStyle = LINE; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(X(1), Y(lr(1))); ctx.lineTo(X(42), Y(lr(42))); ctx.stroke();
      ctx.lineWidth = 1;

      // Landmarks.
      ctx.font = '10px system-ui,sans-serif';
      LANDMARKS.forEach(([mx, label], k) => {
        ctx.fillStyle = LM;
        ctx.beginPath(); ctx.arc(X(mx), Y(lr(mx)), 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'center';
        ctx.fillText(label, X(mx), Y(lr(mx)) - 8 - (k % 2) * 11);
        ctx.globalAlpha = 1;
      });

      // Current marker.
      ctx.fillStyle = MARK;
      ctx.beginPath(); ctx.arc(X(x), Y(lr(x)), 6, 0, Math.PI * 2); ctx.fill();

      readout.innerHTML =
        `M = 10^${x.toFixed(1).replace('.', ',')} kg → r_s = <b>${fmtLen(rs)}</b>` +
        ` · mật độ trung bình cần nén tới: ${fmtRho(rho)}`;
    }

    slider.addEventListener('input', draw);
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="schwarzschild"]').forEach(setup);
</script>
