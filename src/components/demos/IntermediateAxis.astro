---
// Intermediate axis theorem (Dzhanibekov effect), torque-free rigid body.
// Euler equations linearised about spin ω on principal axis p:
//   growth² = −ω²·(Ip−Iq)(Ip−Ir)/(Iq·Ir)  → real only for the middle axis.
// Middle-axis case reduces to σ = ω·√((I₂−I₁)(I₃−I₂)/(I₁I₃)); deviation
// grows as θ(t) = θ₀·e^(σt). Cuboid a×b×c: I = m(sum of the other two²)/12.
// Validity: linearisation holds while θ ≪ 1 rad, so the quoted flip time
// (θ₀ = 1° → 90°) is the separatrix estimate, good to a fraction of 1/σ.
// Thickness fixed at 0,8 cm and mass at 200 g — σ does not depend on mass.
---

<figure class="demo" data-demo="dinh-ly-truc-trung-gian-tung-dien-thoai">
  <canvas></canvas>
  <div class="controls">
    <label>Chiều dài a (cm) <output data-out="a"></output>
      <input type="range" data-in="a" min="5" max="25" step="0.5" value="15" /></label>
    <label>Chiều rộng b (cm) <output data-out="b"></output>
      <input type="range" data-in="b" min="3" max="15" step="0.5" value="7" /></label>
    <label>Tốc độ quay (vòng/s) <output data-out="f"></output>
      <input type="range" data-in="f" min="0.5" max="5" step="0.1" value="2" /></label>
  </div>
  <p class="readout" data-readout></p>
  <figcaption>
    Ba thanh dưới là hệ số mất ổn định σ khi tung vật quay quanh từng trục:
    hai trục cho đúng 0 (quay ổn định), chỉ trục có mô-men quán tính TRUNG
    GIAN cho σ &gt; 0. Đường cong trên là góc lệch, khởi đầu 1° và lớn theo
    e^(σt) tới mốc lật 90°. Bề dày cố định 0,8 cm, khối lượng 200 g — nhưng
    σ không phụ thuộc khối lượng, chỉ phụ thuộc hình dáng và tốc độ quay.
  </figcaption>
</figure>

<style>
  .demo { margin: 2rem 0; padding: 1rem; border: 1px solid rgba(128,128,128,.3); border-radius: 10px; }
  .demo canvas { width: 100%; height: auto; display: block; }
  .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: .75rem 1.25rem; margin-top: 1rem; }
  .controls label { display: flex; flex-direction: column; font-size: .85rem; gap: .3rem; }
  .controls output { font-variant-numeric: tabular-nums; opacity: .7; }
  .controls input { width: 100%; }
  .readout { margin: .9rem 0 0; font-size: .9rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  figcaption { margin-top: .75rem; font-size: .8rem; opacity: .7; line-height: 1.5; }
</style>

<script>
  const CURVE = '#2563eb', MARK = '#dc2626', LM = '#f59e0b';
  const THICK = 0.008, MASS = 0.2, THETA0 = 1, SIG_SCALE = 30;
  const LADDER = [0.2, 0.3, 0.5, 0.75, 1, 1.5, 2, 3, 5, 8, 12, 20];
  const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';

  const num = (x: number, d: number) => x.toFixed(d).replace('.', ',');
  function expFmt(x: number) {
    const e = Math.floor(Math.log10(x));
    const digits = String(Math.abs(e)).split('').map((d) => SUP[Number(d)]).join('');
    return `${num(x / Math.pow(10, e), 2)}·10${e < 0 ? '⁻' : ''}${digits}`;
  }
  // Growth rate for a spin about axis p, with the other two axes q and r.
  function growth(Ip: number, Iq: number, Ir: number, om: number) {
    const s2 = -om * om * (Ip - Iq) * (Ip - Ir) / (Iq * Ir);
    return s2 > 0 ? Math.sqrt(s2) : 0;
  }

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const readout = root.querySelector('[data-readout]') as HTMLElement;
    const input = (k: string) => root.querySelector(`[data-in="${k}"]`) as HTMLInputElement;
    const output = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLOutputElement;

    function draw() {
      const aCm = Number(input('a').value), bCm = Number(input('b').value);
      const f = Number(input('f').value);
      output('a').textContent = num(aCm, 1);
      output('b').textContent = num(bCm, 1);
      output('f').textContent = num(f, 1);

      const a = aCm / 100, b = bCm / 100, c = THICK, om = 2 * Math.PI * f;
      // Principal moments of a uniform cuboid about its three body axes.
      const Ia = MASS * (b * b + c * c) / 12;   // along the a edge
      const Ib = MASS * (a * a + c * c) / 12;   // along the b edge
      const Ic = MASS * (a * a + b * b) / 12;   // through the thickness
      const bars = [
        { lab: `cạnh a = ${num(aCm, 1)} cm`, s: growth(Ia, Ib, Ic, om) },
        { lab: `cạnh b = ${num(bCm, 1)} cm`, s: growth(Ib, Ia, Ic, om) },
        { lab: `bề dày ${num(THICK * 100, 1)} cm`, s: growth(Ic, Ia, Ib, om) },
      ];
      const [I1, I2, I3] = [Ia, Ib, Ic].slice().sort((x, y) => x - y);
      const sig = Math.max(bars[0].s, bars[1].s, bars[2].s);
      const tFlip = sig > 0 ? Math.log(90 / THETA0) / sig : Infinity;
      const nFlip = f * tFlip;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cssW = root.clientWidth - 32, cssH = Math.round(cssW * 0.66);
      canvas.width = cssW * dpr; canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);
      const fg = getComputedStyle(root).color;
      ctx.font = '10px system-ui,sans-serif';

      const padL = 46, padR = cssW < 420 ? 26 : 12, padT = 14, barsH = 66, axisH = 32;
      const plotB = cssH - barsH - axisH;
      const tMax = isFinite(tFlip)
        ? (LADDER.find((v) => v >= tFlip * 1.6) ?? 20)
        : 4;
      const X = (t: number) => padL + (t / tMax) * (cssW - padL - padR);
      const Y = (th: number) => plotB - (th / 100) * (plotB - padT);

      // Axes and ticks.
      ctx.strokeStyle = fg; ctx.globalAlpha = 0.3;
      ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, plotB); ctx.lineTo(cssW - padR, plotB); ctx.stroke();
      ctx.globalAlpha = 0.55; ctx.fillStyle = fg;
      ctx.textAlign = 'right';
      for (const th of [0, 30, 60, 90]) ctx.fillText(`${th}°`, padL - 4, Y(th) + 3);
      ctx.textAlign = 'center';
      for (let i = 1; i <= 4; i++) {
        const t = (tMax * i) / 4;
        ctx.fillText(`${num(t, 2)} s`, X(t), plotB + 14);
        ctx.globalAlpha = 0.4;
        ctx.fillText(`${num(f * t, 2)} vòng`, X(t), plotB + 26);
        ctx.globalAlpha = 0.55;
      }
      ctx.globalAlpha = 1;

      // The 90° flip threshold.
      ctx.strokeStyle = LM; ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(padL, Y(90)); ctx.lineTo(cssW - padR, Y(90)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = LM; ctx.textAlign = 'left';
      ctx.fillText('lật 90°', padL + 6, Y(90) - 5);

      // Deviation angle θ(t) = 1°·e^(σt).
      ctx.strokeStyle = CURVE; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i <= 240; i++) {
        const t = (tMax * i) / 240;
        const th = Math.min(THETA0 * Math.exp(sig * t), 100);
        i ? ctx.lineTo(X(t), Y(th)) : ctx.moveTo(X(t), Y(th));
      }
      ctx.stroke(); ctx.lineWidth = 1;

      if (isFinite(tFlip) && tFlip <= tMax) {
        ctx.fillStyle = MARK;
        ctx.beginPath(); ctx.arc(X(tFlip), Y(90), 6, 0, Math.PI * 2); ctx.fill();
      } else if (!isFinite(tFlip)) {
        ctx.fillStyle = fg; ctx.globalAlpha = 0.7; ctx.textAlign = 'center';
        ctx.fillText('σ = 0 — góc lệch đứng yên, vật không bao giờ lật', (padL + cssW - padR) / 2, Y(45));
        ctx.globalAlpha = 1;
      }

      // Three bars: instability of a spin about each axis.
      const barL = 118, barTop = plotB + axisH + 4, rowH = 20;
      ctx.fillStyle = fg; ctx.globalAlpha = 0.55; ctx.textAlign = 'left';
      ctx.fillText('σ khi tung quay quanh trục…', padL - 34, barTop - 6);
      ctx.globalAlpha = 1;
      bars.forEach((bar, i) => {
        const y = barTop + i * rowH + 6;
        ctx.fillStyle = fg; ctx.globalAlpha = 0.65; ctx.textAlign = 'right';
        ctx.fillText(bar.lab, barL - 6, y + 8);
        ctx.globalAlpha = 1;
        const wMax = cssW - padR - barL - 52;
        const w = Math.max(1.5, (Math.min(bar.s, SIG_SCALE) / SIG_SCALE) * wMax);
        ctx.fillStyle = bar.s > 0 ? MARK : fg;
        ctx.globalAlpha = bar.s > 0 ? 1 : 0.3;
        ctx.fillRect(barL, y, w, 11);
        ctx.globalAlpha = bar.s > 0 ? 1 : 0.5;
        ctx.textAlign = 'left';
        ctx.fillText(bar.s > 0 ? `${num(bar.s, 2)} 1/s` : '0 · ổn định', barL + w + 6, y + 9);
        ctx.globalAlpha = 1;
      });

      const shape = `Hộp ${num(aCm, 1)}×${num(bCm, 1)}×${num(THICK * 100, 1)} cm quay ${num(f, 1)} vòng/s`;
      const inertia = `I₁ = ${expFmt(I1)}, I₂ = ${expFmt(I2)}, I₃ = ${expFmt(I3)} kg·m²`;
      readout.innerHTML = sig > 0
        ? `${shape} → ${inertia} · σ = <b>${num(sig, 2)} 1/s</b> · lệch 1° → 90° sau <b>${num(tFlip, 2)} s</b>`
          + ` (${num(nFlip, 2)} vòng)${nFlip < 1 ? ' — <b>chưa hết một vòng đã lật</b>' : ''}`
        : `${shape} → ${inertia} · hai mô-men quán tính bằng nhau nên <b>σ = 0</b>:`
          + ' không có trục trung gian, cú lật biến mất hoàn toàn';
    }

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', draw));
    addEventListener('resize', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-demo="dinh-ly-truc-trung-gian-tung-dien-thoai"]').forEach(setup);
</script>
