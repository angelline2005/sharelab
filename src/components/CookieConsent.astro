---
// Minimal cookie consent banner. Required before showing personalized ads to
// visitors in the EEA/UK once AdSense is live — see /privacy-policy.
// Stores the choice in localStorage as "cookie-consent": "accepted" | "declined".

interface Props {
  message?: string;
  acceptLabel?: string;
  declineLabel?: string;
}

const {
  message = 'This site uses cookies for analytics and ads.',
  acceptLabel = 'Accept',
  declineLabel = 'Decline',
} = Astro.props;
---

<div id="cookie-consent" class="cookie-consent" hidden>
  <p>{message}</p>
  <div class="cookie-consent-actions">
    <button id="cookie-decline" type="button">{declineLabel}</button>
    <button id="cookie-accept" type="button">{acceptLabel}</button>
  </div>
</div>

<script>
  const KEY = 'cookie-consent';
  const banner = document.getElementById('cookie-consent');
  const accept = document.getElementById('cookie-accept');
  const decline = document.getElementById('cookie-decline');

  function pushEvent(event: string, params: Record<string, unknown> = {}) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event, ...params });
  }

  function setChoice(value: 'accepted' | 'declined') {
    localStorage.setItem(KEY, value);
    banner?.setAttribute('hidden', '');
    document.dispatchEvent(new CustomEvent('cookie-consent-changed', { detail: value }));
    pushEvent('consent_choice', { consent_choice: value });
  }

  const existing = localStorage.getItem(KEY);
  if (!existing && banner) {
    banner.hidden = false;
    pushEvent('consent_banner_shown');
  }

  accept?.addEventListener('click', () => setChoice('accepted'));
  decline?.addEventListener('click', () => setChoice('declined'));
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 32rem;
    margin: 0 auto;
    background: #1a1a1a;
    color: #fff;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    z-index: 100;
    font-size: 0.9rem;
  }
  .cookie-consent p {
    margin: 0 0 0.75rem;
  }
  .cookie-consent-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }
  .cookie-consent-actions button {
    border: none;
    border-radius: 6px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  #cookie-accept {
    background: #fff;
    color: #111;
    font-weight: 600;
  }
  #cookie-decline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
</style>
