---
import CookieConsent from '../components/CookieConsent.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import { useTranslations, type Locale } from '../i18n';
import { withBase } from '../utils/url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  // Overrides the <title> tag only (SEO): og:title and the on-page H1 keep the
  // display title. Used by posts whose magazine hook hides the search keyword.
  metaTitle?: string;
  // Path (root-relative) to a page-specific OG image; defaults to the shared one.
  ogImagePath?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // Pages with nothing for Google to index yet (the Pagefind shell before its
  // JS runs) set this instead of being left to the sitemap/robots defaults.
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  metaTitle,
  ogImagePath,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;
const t = useTranslations(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// "sharelab · sharelab" told visitors nothing; the homepage tab now carries
// the pitch instead. Other pages keep the usual "Page · site" pattern.
const tabTitle =
  title === t('site.title')
    ? `${t('site.title')} — ${t('site.shortTagline')}`
    : `${metaTitle ?? title} · ${t('site.title')}`;

// Google Search Console ownership token. Optional: unset simply omits the tag.
// Validated rather than trusted so a stray value cannot end up in the markup —
// Google's tokens are a run of URL-safe base64 characters.
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
const gscValid = typeof gscToken === 'string' && /^[A-Za-z0-9_-]{20,128}$/.test(gscToken);

// AdSense loader. Doubles as the site-verification snippet during AdSense
// review and as the script Auto ads / AdSlot units need at runtime. Unset —
// or malformed — renders nothing, same policy as the GSC token above.
const adsClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const adsValid = typeof adsClient === 'string' && /^ca-pub-\d{10,20}$/.test(adsClient);

const absolute = (path: string) => new URL(path, Astro.site).href;
const ogImage = absolute(withBase(ogImagePath ?? '/og-default.png'));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gscValid && <meta name="google-site-verification" content={gscToken} />}
    {/* High in <head> as Google asks, and ahead of everything else so the
        consent defaults are set before any tag can fire. */}
    <GoogleTagManager />
    {adsValid && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsClient}`}
        crossorigin="anonymous"
      />
    )}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('site.title')}
      href={withBase(`/${locale}/rss.xml`)}
    />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.title')} />
    <meta property="og:locale" content="vi_VN" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={withBase(`/${locale}/`)}>{t('site.title')}</a>
      <nav class="site-nav">
        <a href={withBase(`/${locale}/`)}>{t('nav.home')}</a>
        <a href={withBase(`/${locale}/bai-viet/`)}>{t('nav.all')}</a>
        <a href={withBase(`/${locale}/tim-kiem/`)}>{t('nav.search')}</a>
        <a href={withBase(`/${locale}/about/`)}>{t('nav.about')}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {t('site.title')}</p>
      <nav>
        <a href={withBase(`/${locale}/privacy-policy/`)}>{t('nav.privacy')}</a>
        <a href={withBase(`/${locale}/terms/`)}>{t('nav.terms')}</a>
        <a href={withBase(`/${locale}/rss.xml`)}>{t('footer.rss')}</a>
      </nav>
    </footer>

    <CookieConsent
      message={t('cookie.message')}
      acceptLabel={t('cookie.accept')}
      declineLabel={t('cookie.decline')}
    />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    /* The blue every demo already draws with — promoted to the site's accent. */
    --accent: #2563eb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --accent: #60a5fa;
    }
  }
  body {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
    line-height: 1.65;
  }
  main a {
    color: var(--accent);
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.5rem 0;
  }
  .site-title {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--accent);
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.95rem;
  }
  .site-nav a {
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    /* Without this, a narrow phone doesn't just wrap whole links onto a
       second row — it breaks mid-word inside each one ("Trang" / "chủ"). */
    white-space: nowrap;
  }
  .site-nav a:hover {
    opacity: 1;
  }
  .site-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(128, 128, 128, 0.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .site-footer nav {
    display: flex;
    gap: 1rem;
  }
  .site-footer a {
    color: inherit;
  }
</style>
