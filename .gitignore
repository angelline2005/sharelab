# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Claude Code memory (local only, may contain personal notes)
.claude/memory/

# Internal work orders and research notes — local only. They describe account
# architecture and carry candid assessments that do not belong in a public repo.
docs/

# Workflow scripts occasionally land at the repo root with a mangled absolute
# path as their filename, which leaks the local Windows user. Never commit them.
/CUsers*
/*workflowsscripts*

# Content planning and batch tooling — local only. Pre-written slug/title/SEO
# queues and per-batch verifiers describe how the catalogue gets produced, which
# is nobody's business but ours, and reads badly out of context. The real build
# gates (validate-posts, check-mdx, smoke-demos) stay tracked.
/remaining-batches.json
scripts/topic-queue.json
scripts/vatly12-queue.json
scripts/backdate-posts.mjs
scripts/verify-batch*.mjs
scripts/verify-vatly12.mjs
